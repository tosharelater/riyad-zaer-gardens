---
import { getHome } from '../data/content';
import { localePath, type Locale } from '../i18n/paths';
import Icon from './Icon.astro';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { contact } = getHome(locale);
---
<section class="contact" id="contact">
  <div class="wrap contact-shell">
    <div class="contact-copy" data-reveal data-split>
      <p class="kick">Contact</p>
      <h2 class="display">{contact.h2}</h2>
      <p class="lead">{contact.body}</p>
      <a class="phone" href={`tel:${contact.phoneTel}`} dir="ltr">{contact.phone}</a>
      <div class="contact-actions">
        <a class="btn btn-solid" href={`tel:${contact.phoneTel}`}><Icon name="phone" />{contact.primary}</a>
        <a class="btn btn-ghost wa" href={contact.whatsapp}><Icon name="message-circle" />{contact.secondary}</a>
      </div>
    </div>
    <form class="form" data-reveal onsubmit="return false;">
      <label><span>Nom</span><input name="name" required autocomplete="name" /></label>
      <label><span>Téléphone</span><input name="phone" type="tel" required autocomplete="tel" dir="ltr" /></label>
      <label>
        <span>Intérêt</span>
        <select name="interest" required>
          <option value="">Choisir…</option>
          <option>Appartement F3</option>
          <option>Appartement F4</option>
          <option>Fonds de commerce</option>
          <option>Investissement locatif</option>
          <option>Je me renseigne depuis l’étranger</option>
        </select>
      </label>
      <button class="btn btn-solid" type="submit">Envoyer</button>
    </form>
  </div>
</section>
<style>
  .contact {
    padding: var(--sec) 0;
    background: var(--ink);
    color: var(--cream);
  }
  .contact .kick { color: var(--gold); }
  .contact .lead { color: rgb(244 238 226 / 0.74); }
  .contact .btn-ghost { color: var(--cream); --fill: var(--cream); --on-fill: var(--ink); }
  .contact-shell {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: clamp(3rem, 8vw, 7rem);
    align-items: end;
  }
  .contact .display { margin-top: 1rem; max-width: 12ch; }
  .phone {
    font-weight: 300;
    display: block;
    margin-top: 1.75rem;
    width: fit-content;
    font-family: var(--display);
    font-size: clamp(2.2rem, 4.5vw, 3.6rem);
    line-height: 1.1;
    color: var(--cream);
    background: linear-gradient(var(--gold), var(--gold)) no-repeat 0 100% / 0 1px;
    transition: background-size 0.7s var(--ease);
  }
  .phone:hover { background-size: 100% 1px; }
  .contact-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }
  .wa { border-color: rgb(244 238 226 / 0.5); }
  .form {
    display: grid;
    gap: 1.75rem;
  }
  .form label { display: grid; gap: 0.35rem; position: relative; }
  .form span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(244 238 226 / 0.6);
    transition: color 0.3s ease;
  }
  .form label:focus-within span { color: var(--gold); }
  .form input, .form select {
    min-height: 3rem;
    padding: 0.5rem 0;
    border: 0;
    border-bottom: 1px solid rgb(244 238 226 / 0.3);
    color: var(--cream);
    border-radius: 0;
    background: transparent;
    font-size: 1.1rem;
    outline: none;
  }
  .form select option { color: var(--ink); background: var(--bg); }
  .form label::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }
  .form label:focus-within::after { transform: scaleX(1); }
  .form .btn { margin-top: 0.5rem; justify-self: start; min-width: 12rem; }
  @media (max-width: 800px) {
    .contact-shell { grid-template-columns: 1fr; }
  }
</style>
