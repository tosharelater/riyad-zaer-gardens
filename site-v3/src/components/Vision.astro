---
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const ar = locale === 'ar';
/** Project renders — the gallery is the one place they appear together */
const gallery = [
  { src: '/photos/facade-sunset.jpg', alt: ar ? 'الواجهة عند الغروب' : 'Façade au coucher du soleil' },
  { src: '/photos/allee-jardin.jpg', alt: ar ? 'ممر مشجر داخل الإقامة' : 'Allée plantée de la résidence' },
  { src: '/photos/facade-angle.jpg', alt: ar ? 'المبنى من الزاوية' : 'Immeuble vu depuis l’angle' },
  { src: '/photos/cuisine.jpg', alt: ar ? 'المطبخ' : 'Cuisine' },
  { src: '/photos/rue-facade.jpg', alt: ar ? 'الواجهة على الشارع' : 'Façade sur rue' },
  { src: '/photos/chambre.jpg', alt: ar ? 'غرفة نوم' : 'Chambre' },
];
---
<section class="vision" aria-label="Galerie du projet">
  <div class="wrap vision-top">
    <div class="vision-head" data-reveal data-split>
      <p class="kick">{ar ? 'المشروع بالصور' : 'Le projet en images'}</p>
      <h2 class="display">{ar ? 'شاهدوا الحي وهو يتشكّل' : 'Regarder le quartier prendre forme'}</h2>
    </div>
    <div class="vision-nav" data-reveal>
      <button type="button" class="vision-btn" data-vision-prev aria-label="Image précédente">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="M15 5 8 12l7 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
      <button type="button" class="vision-btn" data-vision-next aria-label="Image suivante">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
          <path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>
  </div>

  <div class="vision-rail" data-vision-rail>
    {gallery.map((g, i) => (
      <button
        type="button"
        class="vision-card"
        data-gallery-open
        data-index={i}
        aria-label={`Agrandir : ${g.alt}`}
        data-caption={g.alt}
      >
        <img src={g.src} alt={g.alt} loading="lazy" draggable="false" />
      </button>
    ))}
  </div>
</section>

<dialog class="gallery-lightbox" data-gallery-lightbox aria-label="Aperçu de la galerie">
  <button type="button" class="gallery-close" data-gallery-close aria-label="Fermer">×</button>
  <button type="button" class="gallery-nav is-prev" data-gallery-prev aria-label="Précédente">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="M15 5 8 12l7 7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
  <figure>
    <img data-gallery-img alt="" />
    <figcaption data-gallery-caption></figcaption>
  </figure>
  <button type="button" class="gallery-nav is-next" data-gallery-next aria-label="Suivante">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true">
      <path d="m9 5 7 7-7 7" stroke-linecap="round" stroke-linejoin="round" />
    </svg>
  </button>
</dialog>

<style>
  .vision {
    padding: var(--sec) 0;
    background: var(--cream);
    color: var(--ink);
  }

  .vision-top {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .vision .display {
    margin-top: 1rem;
    max-width: 16ch;
  }

  .vision-nav {
    display: flex;
    gap: 0.55rem;
    flex-shrink: 0;
    padding-bottom: 0.2rem;
  }

  .vision-btn {
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background 0.25s var(--ease), border-color 0.25s var(--ease);
  }
  .vision-btn:hover {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }
  .vision-btn svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .vision-rail {
    display: flex;
    gap: 0.75rem;
    overflow-x: auto;
    padding: 0 var(--pad) 0.5rem;
    scroll-snap-type: x mandatory;
    scroll-behavior: smooth;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    cursor: grab;
    user-select: none;
  }
  .vision-rail.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
    scroll-snap-type: none;
  }

  .vision-card {
    flex: 0 0 min(72vw, 22rem);
    margin: 0;
    padding: 0;
    border: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    scroll-snap-align: start;
    background: var(--cream);
    cursor: pointer;
    position: relative;
  }

  .vision-card:nth-child(3n) {
    flex-basis: min(78vw, 26rem);
    aspect-ratio: 5 / 4;
  }

  .vision-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
    transition: transform 1.2s var(--ease), filter 0.6s ease;
  }
  .vision-rail:hover .vision-card img { filter: saturate(0.6) brightness(0.92); }
  .vision-rail .vision-card:hover img {
    transform: scale(1.05);
    filter: none;
  }
  .vision-card::after {
    content: attr(data-caption);
    position: absolute;
    inset: auto 0 0 0;
    padding: 2.5rem 1rem 0.9rem;
    font-size: 0.78rem;
    letter-spacing: 0.04em;
    text-align: start;
    color: #fff;
    background: linear-gradient(to top, rgb(1 22 21 / 0.7), transparent);
    opacity: 0;
    transform: translateY(0.5rem);
    transition: opacity 0.5s ease, transform 0.6s var(--ease);
  }
  .vision-card:hover::after,
  .vision-card:focus-visible::after { opacity: 1; transform: none; }

  @media (min-width: 901px) {
    .vision-card {
      flex-basis: min(28vw, 20rem);
    }
    .vision-card:nth-child(3n) {
      flex-basis: min(34vw, 24rem);
    }
  }

  @media (max-width: 700px) {
    .vision-top {
      align-items: start;
      flex-direction: column;
    }
  }
</style>

<style is:global>
  .gallery-lightbox {
    border: 0;
    padding: 0;
    max-width: none;
    max-height: none;
    width: 100vw;
    height: 100vh;
    background: rgb(0 18 18 / 0.94);
    color: #f7f2e8;
  }
  .gallery-lightbox::backdrop {
    background: rgb(0 10 10 / 0.72);
  }
  .gallery-lightbox[open] {
    display: grid;
    place-items: center;
  }
  .gallery-lightbox figure {
    margin: 0;
    width: min(92vw, 72rem);
    max-height: 84vh;
    display: grid;
    gap: 0.85rem;
    justify-items: center;
  }
  .gallery-lightbox img {
    max-width: 100%;
    max-height: 76vh;
    width: auto;
    height: auto;
    object-fit: contain;
  }
  .gallery-lightbox figcaption {
    font-size: 0.85rem;
    letter-spacing: 0.04em;
    color: rgb(247 242 232 / 0.7);
    text-align: center;
  }
  .gallery-close {
    position: fixed;
    top: 1.25rem;
    right: 1.25rem;
    width: 2.75rem;
    height: 2.75rem;
    border: 0;
    border-radius: 999px;
    background: rgb(247 242 232 / 0.1);
    color: #f7f2e8;
    font-size: 1.6rem;
    line-height: 1;
    cursor: pointer;
  }
  .gallery-nav {
    position: fixed;
    top: 50%;
    transform: translateY(-50%);
    width: 2.75rem;
    height: 2.75rem;
    display: grid;
    place-items: center;
    border: 1px solid rgb(247 242 232 / 0.22);
    border-radius: 999px;
    background: rgb(0 45 45 / 0.55);
    color: #f7f2e8;
    cursor: pointer;
  }
  .gallery-nav.is-prev { left: 1.25rem; }
  .gallery-nav.is-next { right: 1.25rem; }
  .gallery-nav svg {
    width: 1.1rem;
    height: 1.1rem;
  }
</style>
