---
import type { Locale } from '../i18n/paths';
import { getLocaleFromPath, localePath, switchLocalePath } from '../i18n/paths';
import { ui } from '../i18n/ui';

interface Props {
  solid?: boolean;
  locale?: Locale;
}
const { solid = false, locale: localeProp } = Astro.props;
const locale: Locale =
  localeProp ?? (Astro.currentLocale === 'ar' ? 'ar' : getLocaleFromPath(Astro.url.pathname));
const t = ui(locale);
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const frPath = switchLocalePath(path, 'fr');
const arPath = switchLocalePath(path, 'ar');
---
<header class:list={['top', { 'is-solid': solid }]} data-top data-always-solid={solid ? '' : undefined}>
  <a class="top-logo" href={localePath(locale, '/')} aria-label={t.brand.name}>
    <img class="on-dark" src="/brand/logo-light.png" alt="" width="160" height="104" />
    <img class="on-light" src="/brand/logo-green.png" alt="" width="160" height="104" />
  </a>
  <nav class="top-nav" aria-label="Navigation">
    {t.nav.map((l) => {
      const href = localePath(locale, l.path);
      const active = path === href || (l.path !== '/' && path.endsWith(l.path));
      return (
        <a href={href} aria-current={active ? 'page' : undefined}>
          {l.label}
        </a>
      );
    })}
  </nav>
  <div class="top-end">
    <div class="lang" aria-label="Language">
      <a href={frPath} class:list={{ active: locale === 'fr' }} hreflang="fr" lang="fr">{t.lang.fr}</a>
      <span aria-hidden="true">/</span>
      <a href={arPath} class:list={{ active: locale === 'ar' }} hreflang="ar" lang="ar">{t.lang.ar}</a>
    </div>
    <a class="btn btn-solid top-cta" href={localePath(locale, '/contact')}>{t.cta}</a>
  </div>
  <button class="top-menu" type="button" data-menu aria-expanded="false" aria-label={t.menu}>
    <span></span><span></span>
  </button>
  <div class="top-drawer" data-drawer hidden>
    {t.nav.map((l) => <a href={localePath(locale, l.path)}>{l.label}</a>)}
    <div class="lang drawer-lang">
      <a href={frPath} class:list={{ active: locale === 'fr' }} hreflang="fr" lang="fr">{t.lang.fr}</a>
      <span aria-hidden="true">/</span>
      <a href={arPath} class:list={{ active: locale === 'ar' }} hreflang="ar" lang="ar">{t.lang.ar}</a>
    </div>
    <a class="btn btn-solid" href={localePath(locale, '/contact')}>{t.cta}</a>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLButtonElement>('[data-menu]');
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const closeDrawer = () => {
    menu?.setAttribute('aria-expanded', 'false');
    drawer?.setAttribute('hidden', '');
  };
  menu?.addEventListener('click', () => {
    const open = menu.getAttribute('aria-expanded') === 'true';
    menu.setAttribute('aria-expanded', String(!open));
    drawer?.toggleAttribute('hidden', open);
  });
  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', closeDrawer));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && menu?.getAttribute('aria-expanded') === 'true') closeDrawer();
  });
</script>

<style>
  .top {
    position: fixed; inset: 0 0 auto; z-index: 60;
    display: flex; align-items: center; gap: 1.25rem;
    height: var(--nav);
    padding: 0 var(--pad);
    transition: background 0.45s ease, box-shadow 0.45s ease, color 0.45s ease, transform 0.6s var(--ease);
    color: #f7f2e8;
  }
  .top.is-hidden { transform: translateY(-100%); }
  .top.is-solid {
    background: rgb(252 250 246 / 0.9);
    backdrop-filter: blur(12px);
    box-shadow: 0 1px 0 var(--line);
    color: var(--ink);
  }
  .top-logo img { height: 2.5rem; width: auto; }
  .top-logo .on-light { display: none; }
  .top.is-solid .on-light { display: block; }
  .top.is-solid .on-dark { display: none; }
  .top-nav {
    display: flex; gap: clamp(0.65rem, 1.5vw, 1.35rem);
    margin-inline-start: auto;
    flex-wrap: nowrap;
  }
  .top-nav a {
    position: relative;
    padding-block: 0.4rem;
    font-size: 0.75rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase;
    opacity: 0.82; white-space: nowrap;
    transition: opacity 0.3s ease;
  }
  .top-nav a::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.5s var(--ease);
  }
  .top-nav a:hover::after,
  .top-nav a[aria-current='page']::after { transform: scaleX(1); transform-origin: left; }
  .top-nav a:hover,
  .top-nav a[aria-current='page'] { opacity: 1; }
  .top-end {
    display: flex; align-items: center; gap: 0.85rem;
  }
  .lang {
    display: inline-flex; align-items: center; gap: 0.35rem;
    font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase;
    opacity: 0.85;
  }
  .lang a.active { color: var(--gold); opacity: 1; }
  .lang a:hover { color: var(--gold); }
  .top-cta { min-height: 2.5rem; padding: 0.5rem 1.1rem; font-size: 0.75rem; }
  .top-menu {
    display: none; width: 2.5rem; height: 2.5rem;
    flex-direction: column; justify-content: center; gap: 6px; margin-inline-start: auto;
  }
  .top-menu span { display: block; height: 1.5px; background: currentColor; transition: transform 0.5s var(--ease); }
  .top-menu[aria-expanded='true'] span:first-child { transform: translateY(3.75px) rotate(45deg); }
  .top-menu[aria-expanded='true'] span:last-child { transform: translateY(-3.75px) rotate(-45deg); }
  .top-drawer {
    position: absolute; inset: 100% 0 auto;
    display: flex; flex-direction: column; align-items: center; gap: 1.25rem;
    padding: 2rem 1.75rem 2.25rem; background: var(--bg); color: var(--ink);
    border-bottom: 1px solid var(--line);
    animation: drawer-in 0.6s var(--ease) both;
  }
  @keyframes drawer-in {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  .top-drawer[hidden] { display: none; }
  .top-drawer a:not(.btn) { font-family: var(--display); font-size: 1.6rem; }
  .drawer-lang { margin-top: 0.25rem; }
  @media (max-width: 1100px) {
    .top-nav, .top-end { display: none; }
    .top-menu { display: flex; }
  }
</style>
