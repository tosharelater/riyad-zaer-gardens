---
import { getHome } from '../data/content';
import Icon from './Icon.astro';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { finishes } = getHome(locale);
const icons = ['layers', 'bath', 'blinds'];
---
<section class="finishes" id="finitions">
  <div class="wrap finishes-grid">
    <figure class="finishes-media" data-reveal>
      <img src="/photos/cuisine.webp" alt="Finitions soignées" loading="lazy" decoding="async" />
    </figure>

    <div class="finishes-copy">
      <header data-reveal data-split>
        <p class="kick">{locale === 'ar' ? 'التشطيبات' : 'Finitions'}</p>
        <h2 class="display">{finishes.h2}</h2>
      </header>
      <div class="finishes-text" data-reveal>
        <p class="lead">{finishes.p1}</p>
        <p class="lead">{finishes.p2}</p>
      </div>
      <ol class="finishes-points" data-reveal>
        {finishes.points.map((p, i) => (
          <li>
            <span class="finishes-ico" aria-hidden="true"><Icon name={icons[i % icons.length]} size="1.35rem" /></span>
            <span class="finishes-txt">
              <strong>{p.title}</strong>
              <span>{p.body}</span>
            </span>
            <span class="finishes-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .finishes {
    padding: var(--sec) 0;
    background: var(--cream);
  }
  .finishes-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .finishes-media {
    margin: 0;
    aspect-ratio: 4 / 5;
    max-height: 36rem;
    width: 100%;
    overflow: hidden;
    border-radius: clamp(6rem, 16vw, 12rem) 0 0 0;
  }
  .finishes-media img { width: 100%; height: 100%; object-fit: cover; }
  .finishes-copy { display: grid; gap: 1.1rem; max-width: 36rem; }
  .finishes-copy .kick { margin: 0; }
  .finishes-copy .display {
    margin: 0.5rem 0 0;
    max-width: none;
    font-size: clamp(2rem, 3.8vw, 3rem);
  }
  .finishes-text { display: grid; gap: 0.7rem; }
  .finishes-text .lead { margin: 0; font-size: 1rem; }
  /* Divided list: no cards, just hairlines, an icon and two lines of text */
  .finishes-points {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
    display: grid;
    border-top: 1px solid color-mix(in srgb, var(--canopy) 22%, transparent);
  }
  .finishes-points li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    gap: 1.1rem;
    padding: 1.1rem 0.25rem;
    border-bottom: 1px solid color-mix(in srgb, var(--canopy) 22%, transparent);
    transition: padding-inline-start 0.35s var(--ease);
  }
  .finishes-points li:hover { padding-inline-start: 0.75rem; }
  .finishes-ico {
    display: grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--canopy);
  }
  .finishes-ico :global(svg) { width: 1.9rem; height: 1.9rem; stroke-width: 1.4; }
  .finishes-txt { display: grid; gap: 0.2rem; }
  .finishes-points strong { font-weight: 600; font-size: 1.05rem; color: var(--ink); }
  .finishes-txt > span { font-size: 0.92rem; color: var(--muted); line-height: 1.45; }
  .finishes-idx { display: none; }

  @media (max-width: 900px) {
    .finishes-grid { grid-template-columns: 1fr; }
    .finishes-media {
      aspect-ratio: 16 / 11;
      max-height: none;
      border-radius: var(--radius) var(--radius) 0 0;
    }
    .finishes-copy { max-width: none; }
    .finishes-copy .display { font-size: clamp(1.75rem, 7vw, 2.4rem); }
  }

  /* Photo as tall as the content beside it; two small corners (top right, bottom left) */
  @media (min-width: 901px) {
    .finishes-grid { align-items: stretch; }
    .finishes-copy { align-content: center; }
    .finishes-media {
      position: relative;
      aspect-ratio: auto;
      max-height: none;
      min-height: 24rem;
      align-self: stretch;
      border-radius: 0 2.25rem 0 2.25rem;
    }
    [dir='rtl'] .finishes-media { border-radius: 2.25rem 0 2.25rem 0; }
    .finishes-media img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  }
  @media (max-width: 900px) {
    .finishes-media { border-radius: 0 1.5rem 0 1.5rem; }
    [dir='rtl'] .finishes-media { border-radius: 1.5rem 0 1.5rem 0; }
  }
</style>
