---
import { getHome } from '../data/content';
import Icon from './Icon.astro';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { finishes } = getHome(locale);
const icons = ['layers', 'bath', 'blinds'];
---
<section class="finishes" id="finitions">
  <div class="wrap finishes-grid">
    <figure class="finishes-media" data-reveal>
      <img src="/photos/cuisine.jpg" alt="Finitions soignées" loading="lazy" decoding="async" />
    </figure>

    <div class="finishes-copy">
      <header data-reveal data-split>
        <p class="kick">{locale === 'ar' ? 'التشطيبات' : 'Finitions'}</p>
        <h2 class="display">{finishes.h2}</h2>
      </header>
      <div class="finishes-text" data-reveal>
        <p class="lead">{finishes.p1}</p>
        <p class="lead">{finishes.p2}</p>
      </div>
      <ol class="finishes-points" data-reveal>
        {finishes.points.map((p, i) => (
          <li>
            <span class="finishes-ico" aria-hidden="true"><Icon name={icons[i % icons.length]} size="1.35rem" /></span>
            <span class="finishes-txt">
              <strong>{p.title}</strong>
              <span>{p.body}</span>
            </span>
            <span class="finishes-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .finishes {
    padding: var(--sec) 0;
    background: var(--cream);
  }
  .finishes-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .finishes-media {
    margin: 0;
    aspect-ratio: 4 / 5;
    max-height: 36rem;
    width: 100%;
    overflow: hidden;
    border-radius: clamp(6rem, 16vw, 12rem) 0 0 0;
  }
  .finishes-media img { width: 100%; height: 100%; object-fit: cover; }
  .finishes-copy { display: grid; gap: 1.1rem; max-width: 36rem; }
  .finishes-copy .kick { margin: 0; }
  .finishes-copy .display {
    margin: 0.5rem 0 0;
    max-width: none;
    font-size: clamp(2rem, 3.8vw, 3rem);
  }
  .finishes-text { display: grid; gap: 0.7rem; }
  .finishes-text .lead { margin: 0; font-size: 1rem; }
  .finishes-points {
    list-style: none;
    margin: 0.5rem 0 0;
    padding: 0;
    display: grid;
    gap: 0.7rem;
  }
  .finishes-points li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 1rem;
    padding: 0.95rem 1.25rem 0.95rem 0.95rem;
    border-radius: 18px;
    background: var(--paper);
    border: 1px solid color-mix(in srgb, var(--canopy) 14%, transparent);
    transition: transform 0.35s var(--ease), border-color 0.35s var(--ease), box-shadow 0.35s var(--ease);
  }
  .finishes-points li:hover {
    transform: translateX(6px);
    border-color: color-mix(in srgb, var(--canopy) 45%, transparent);
    box-shadow: 0 10px 26px rgb(0 45 45 / 0.08);
  }
  .finishes-ico {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--canopy);
    color: var(--gold-soft, #e6d9a8);
  }
  .finishes-txt { display: grid; gap: 0.15rem; }
  .finishes-points strong { font-weight: 600; font-size: 1rem; color: var(--ink); }
  .finishes-txt > span { font-size: 0.9rem; color: var(--muted); line-height: 1.4; }
  .finishes-idx {
    font-family: var(--display);
    font-weight: 300;
    font-size: 1.9rem;
    line-height: 1;
    color: color-mix(in srgb, var(--gold-text) 55%, transparent);
  }

  @media (max-width: 900px) {
    .finishes-grid { grid-template-columns: 1fr; }
    .finishes-media {
      aspect-ratio: 16 / 11;
      max-height: none;
      border-radius: var(--radius) var(--radius) 0 0;
    }
    .finishes-copy { max-width: none; }
    .finishes-copy .display { font-size: clamp(1.75rem, 7vw, 2.4rem); }
  }
</style>
