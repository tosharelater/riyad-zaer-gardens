---
import { getHome } from '../data/content';
import { localePath, type Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { aid } = getHome(locale);
// Never let a price break across lines
const keep = (t: string) => t.replace(/(\d) (?=\d|DH|درهم)/g, '$1 ');
// "à partir de 420 000 DH" -> small prefix + figure
const split = (t: string) => {
  const m = t.match(/^(à partir de|ابتداءً?\s*من|من)\s+(.*)$/u);
  return m ? { pre: m[1], fig: keep(m[2]) } : { pre: '', fig: keep(t) };
};
const before = split(aid.without);
const after = split(aid.withAid);
---
<section class="aid" id="aide">
  <div class="wrap aid-shell">
    <header class="aid-head" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'دعم السكن' : 'Aide au logement'}</p>
      <h2 class="display">{aid.h2}</h2>
    </header>

    <div class="aid-copy" data-reveal>
      <p class="lead">{aid.p1}</p>
      <p class="lead">{aid.p2}</p>
      <p class="lead">{aid.p3}</p>
    </div>

    <aside class="aid-ticket" data-reveal aria-label="Comparaison de prix">
      <div class="aid-row is-before">
        <div class="aid-lab">
          <span class="aid-tag">Sans aide</span>
          {before.pre && <small>{before.pre}</small>}
        </div>
        <strong>{before.fig}</strong>
      </div>

      <div class="aid-row is-after">
        <div class="aid-lab">
          <span class="aid-tag">Avec l’aide au logement</span>
          {after.pre && <small>{after.pre}</small>}
        </div>
        <strong>{after.fig}</strong>
      </div>
    </aside>

    <a class="btn btn-solid" href={aid.cta.href.startsWith('/') ? localePath(locale, aid.cta.href) : aid.cta.href}>
      {aid.cta.label}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .aid {
    padding: var(--sec) 0;
    background:
      radial-gradient(50% 60% at 0% 100%, rgb(200 181 104 / 0.1), transparent 60%),
      radial-gradient(45% 55% at 100% 0%, rgb(200 181 104 / 0.12), transparent 60%),
      var(--ink);
    color: var(--cream);
  }
  .aid-shell {
    display: grid;
    justify-items: center;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    text-align: center;
  }
  .aid-head { display: grid; justify-items: center; gap: 0.8rem; max-width: 40rem; }
  .aid-head .kick { margin: 0; color: var(--gold-soft); }
  .aid-head .display { margin: 0; max-width: none; color: var(--cream); }
  .aid-copy { display: grid; gap: 0.8rem; max-width: 40rem; }
  .aid-copy .lead { margin: 0; color: var(--muted-on-dark); font-size: 1rem; }

  /* two price lines: without and with the housing aid */
  .aid-ticket {
    display: grid;
    gap: 0.75rem;
    width: min(100%, 36rem);
    margin-block: 0.5rem;
  }
  .aid-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.15rem 1.5rem;
    border-radius: var(--radius);
    text-align: start;
  }
  .aid-row .aid-lab { display: grid; gap: 0.1rem; }
  .aid-tag {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .aid-row small { font-size: 0.85rem; opacity: 0.8; }
  .aid-row strong {
    font-family: var(--font);
    font-weight: 300;
    font-size: clamp(1.7rem, 3.4vw, 2.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .aid-row.is-before { background: rgb(246 240 228 / 0.08); }
  .aid-row.is-before .aid-tag, .aid-row.is-before small { color: var(--muted-on-dark); }
  .aid-row.is-before strong { color: var(--cream); }
  .aid-row.is-after { background: var(--gold); }
  .aid-row.is-after .aid-tag, .aid-row.is-after small { color: var(--ink); }
  .aid-row.is-after strong { color: var(--ink); }

  .aid .btn { background: var(--gold); color: var(--ink); }
  .aid .btn:hover { background: var(--gold-soft); }

  @media (max-width: 640px) {
    .aid-row { flex-direction: column; align-items: flex-start; gap: 0.35rem; }
    .aid-head .display { font-size: clamp(1.7rem, 7vw, 2.35rem); }
    .aid .btn { width: min(100%, 22rem); }
  }
</style>
