---
import { getHome } from '../data/content';
import { localePath, type Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { aid } = getHome(locale);
// Never let a price break across lines
const keep = (t: string) => t.replace(/(\d) (?=\d|DH|درهم)/g, '$1 ');
// "à partir de 420 000 DH" -> small prefix + figure
const split = (t: string) => {
  const m = t.match(/^(à partir de|ابتداءً?\s*من|من)\s+(.*)$/u);
  return m ? { pre: m[1], fig: keep(m[2]) } : { pre: '', fig: keep(t) };
};
const before = split(aid.without);
const after = split(aid.withAid);
---
<section class="aid" id="aide">
  <div class="wrap aid-shell">
    <header class="aid-head" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'دعم السكن' : 'Aide au logement'}</p>
      <h2 class="display">{aid.h2}</h2>
    </header>

    <div class="aid-copy" data-reveal>
      <p class="lead">{aid.p1}</p>
      <p class="lead">{aid.p2}</p>
      <p class="lead">{aid.p3}</p>
    </div>

    <aside class="aid-ticket" data-reveal aria-label="Comparaison de prix">
      <div class="aid-row is-before">
        <div class="aid-lab">
          <span class="aid-tag">Prix standard (sans aide)</span>
          {before.pre && <small>{before.pre}</small>}
        </div>
        <strong>{before.fig}</strong>
      </div>

      <svg class="aid-flow" viewBox="0 0 600 48" preserveAspectRatio="none" aria-hidden="true">
        <path class="aid-flow-a" d="M0 8 H270 C310 8 290 40 330 40 H586" vector-effect="non-scaling-stroke" />
        <path class="aid-flow-head" d="M578 33 L588 40 L578 47" vector-effect="non-scaling-stroke" />
        <circle class="aid-flow-dot" cx="150" cy="8" r="5" />
      </svg>

      <div class="aid-row is-after">
        <div class="aid-lab">
          <span class="aid-tag">Avec l’aide au logement</span>
          {after.pre && <small>{after.pre}</small>}
        </div>
        <strong>{after.fig}</strong>
      </div>
    </aside>

    <a class="btn btn-solid" href={aid.cta.href.startsWith('/') ? localePath(locale, aid.cta.href) : aid.cta.href}>
      {aid.cta.label}
      <span aria-hidden="true">→</span>
    </a>
  </div>
</section>

<style>
  .aid {
    padding: var(--sec) 0;
    background:
      radial-gradient(50% 60% at 0% 100%, rgb(200 181 104 / 0.1), transparent 60%),
      radial-gradient(45% 55% at 100% 0%, rgb(200 181 104 / 0.12), transparent 60%),
      var(--ink);
    color: var(--cream);
  }
  .aid-shell {
    display: grid;
    justify-items: center;
    gap: clamp(1.5rem, 3vw, 2.25rem);
    text-align: center;
  }
  .aid-head { display: grid; justify-items: center; gap: 0.8rem; max-width: 40rem; }
  .aid-head .kick { margin: 0; color: var(--gold-soft); }
  .aid-head .display { margin: 0; max-width: none; color: var(--cream); }
  .aid-copy { display: grid; gap: 0.8rem; max-width: 40rem; }
  .aid-copy .lead { margin: 0; color: var(--muted-on-dark); font-size: 1rem; }

  /* price flow: standard price steps down to the aided price */
  .aid-ticket {
    display: grid;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: auto 3rem auto;
    column-gap: clamp(1rem, 4vw, 3rem);
    width: min(100%, 52rem);
    margin-block: 0.75rem;
    align-items: end;
  }
  .aid-row { display: contents; }
  .aid-row .aid-lab { display: grid; gap: 0.1rem; align-content: end; padding-bottom: 0.5rem; }
  .aid-row.is-before .aid-lab { grid-area: 1 / 1; justify-items: start; text-align: start; }
  .aid-row.is-before strong { grid-area: 3 / 1; justify-self: start; }
  .aid-row.is-after .aid-lab { grid-area: 1 / 2; justify-items: end; text-align: end; }
  .aid-row.is-after strong { grid-area: 3 / 2; justify-self: end; }
  .aid-flow { grid-area: 2 / 1 / 3 / 3; width: 100%; height: 100%; overflow: visible; }

  .aid-tag {
    font-size: 0.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
  }
  .aid-row small { font-size: 0.85rem; opacity: 0.8; }
  .aid-row strong {
    font-family: var(--font);
    font-weight: 300;
    font-size: clamp(2rem, 4.4vw, 3.4rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .aid-row.is-before .aid-tag, .aid-row.is-before small { color: var(--muted-on-dark); }
  .aid-row.is-before strong { color: var(--cream); }
  .aid-row.is-after .aid-tag, .aid-row.is-after small { color: var(--gold-soft); }
  .aid-row.is-after strong { color: var(--gold); }

  .aid-flow path { fill: none; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .aid-flow-a { stroke: var(--gold); }
  .aid-flow-head { stroke: var(--gold); }
  .aid-flow-dot { fill: var(--cream); }

  .aid .btn { background: var(--gold); color: var(--ink); }
  .aid .btn:hover { background: var(--gold-soft); }

  @media (max-width: 640px) {
    .aid-ticket {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      row-gap: 0.25rem;
      justify-items: center;
    }
    .aid-row { display: grid; justify-items: center; gap: 0.25rem; }
    .aid-row .aid-lab, .aid-row strong { grid-area: auto !important; justify-self: center !important; justify-items: center !important; text-align: center !important; }
    .aid-flow { display: none; }
    .aid-row.is-after::before {
      content: '↓';
      color: var(--gold);
      font-size: 1.6rem;
      line-height: 1;
      margin-block: 0.5rem;
    }
    .aid-head .display { font-size: clamp(1.7rem, 7vw, 2.35rem); }
    .aid .btn { width: min(100%, 22rem); }
  }
</style>
