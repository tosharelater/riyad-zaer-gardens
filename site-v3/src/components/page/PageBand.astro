---
import { contactInfo } from '../../data/site';
import { ui } from '../../i18n/ui';
import { getLocaleFromPath, localePath, type Locale } from '../../i18n/paths';

const locale: Locale =
  Astro.currentLocale === 'ar' ? 'ar' : getLocaleFromPath(Astro.url.pathname);
const dict = ui(locale);
const convert = {
  h2: dict.convert.h2,
  body: dict.convert.body,
  primary: { label: dict.convert.primary, href: localePath(locale, '/contact') },
  secondary: { label: dict.convert.secondary, href: contactInfo.whatsapp },
};
const aidBand = {
  h2: dict.aidBand.h2,
  body: dict.aidBand.body,
  link: { label: dict.aidBand.link, href: localePath(locale, '/contact') },
};

interface Props {
  title?: string;
  body?: string;
  mode?: 'convert' | 'aid' | 'custom';
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  image?: string;
}
const {
  title,
  body,
  mode = 'convert',
  primary,
  secondary,
  image,
} = Astro.props;

const copy =
  mode === 'aid'
    ? { h2: aidBand.h2, body: aidBand.body, primary: aidBand.link, secondary: undefined }
    : mode === 'convert'
      ? {
          h2: convert.h2,
          body: convert.body,
          primary: convert.primary,
          secondary: convert.secondary,
        }
      : {
          h2: title ?? convert.h2,
          body: body ?? convert.body,
          primary: primary ?? convert.primary,
          secondary: secondary,
        };
---
<section class:list={['band', mode === 'aid' ? 'band-aid' : 'band-convert']}>
  {mode !== 'aid' && image && (
    <figure class="band-bg" aria-hidden="true" data-band-bg>
      <img src={image} alt="" loading="lazy" />
    </figure>
  )}
  <div class="wrap band-inner" data-reveal>
    <div>
      <h2 class="display">{copy.h2}</h2>
      <p class="lead">{copy.body}</p>
    </div>
    <div class="band-actions">
      <a class="btn btn-solid" href={copy.primary.href}>{copy.primary.label}</a>
      {copy.secondary && (
        <a
          class="btn btn-ghost"
          href={copy.secondary.href}
          target={copy.secondary.href.startsWith('http') ? '_blank' : undefined}
          rel={copy.secondary.href.startsWith('http') ? 'noopener' : undefined}
        >
          {copy.secondary.label}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .band {
    position: relative;
    padding: var(--sec) 0;
    overflow: hidden;
    isolation: isolate;
  }
  .band-bg {
    position: absolute;
    inset: -8% 0;
    z-index: -2;
    margin: 0;
  }
  .band-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* No image: cream band — never a yellow fill */
  .band-convert {
    background: var(--cream);
    color: var(--ink);
  }
  .band-convert .lead {
    color: var(--muted);
  }
  .band-convert .btn-ghost {
    color: var(--canopy);
    border-color: var(--canopy);
  }
  /* With photo: ink veil over the image */
  .band-convert:has(.band-bg) {
    color: var(--cream);
    background: var(--ink);
  }
  .band-convert:has(.band-bg)::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.72), rgb(0 0 0 / 0.42) 55%, rgb(0 0 0 / 0.3));
  }
  .band-convert:has(.band-bg) .lead { color: var(--muted-on-dark); }
  .band-convert:has(.band-bg) .btn-ghost {
    color: #fff;
    border-color: rgb(255 255 255 / 0.6);
  }
  .band-convert:has(.band-bg) .btn-ghost:hover { background: #fff; color: var(--ink); }
  .band-aid {
    background: var(--cream);
  }
  .band-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .band-inner .display {
    max-width: none;
    margin-bottom: 0.5rem;
  }
  .band-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 800px) {
    .band-inner { grid-template-columns: 1fr; }
  }
</style>
