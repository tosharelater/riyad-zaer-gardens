---
import { contactInfo } from '../../data/site';
import { ui } from '../../i18n/ui';
import { getLocaleFromPath, localePath, type Locale } from '../../i18n/paths';
import Icon from '../Icon.astro';

const locale: Locale =
  Astro.currentLocale === 'ar' ? 'ar' : getLocaleFromPath(Astro.url.pathname);
const dict = ui(locale);
const convert = {
  h2: dict.convert.h2,
  body: dict.convert.body,
  primary: { label: dict.convert.primary, href: localePath(locale, '/contact') },
  secondary: { label: dict.convert.secondary, href: contactInfo.whatsapp },
};
const aidBand = {
  h2: dict.aidBand.h2,
  body: dict.aidBand.body,
  link: { label: dict.aidBand.link, href: localePath(locale, '/contact') },
};

interface Props {
  title?: string;
  body?: string;
  mode?: 'convert' | 'aid' | 'custom';
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
  image?: string;
  /** 'canopy': deep-green band with gold actions, no photo (le-projet) */
  tone?: 'photo' | 'canopy';
}
const {
  title,
  body,
  mode = 'convert',
  primary,
  secondary,
  image,
  tone = 'photo',
} = Astro.props;
const canopy = tone === 'canopy' && mode !== 'aid';

const copy =
  mode === 'aid'
    ? { h2: aidBand.h2, body: aidBand.body, primary: aidBand.link, secondary: undefined }
    : mode === 'convert'
      ? {
          h2: convert.h2,
          body: convert.body,
          primary: convert.primary,
          secondary: convert.secondary,
        }
      : {
          h2: title ?? convert.h2,
          body: body ?? convert.body,
          primary: primary ?? convert.primary,
          secondary: secondary,
        };
---
<section class:list={['band', mode === 'aid' ? 'band-aid' : canopy ? 'band-canopy' : 'band-convert']}>
  {canopy && (
    <Icon name="leaf" size="22rem" strokeWidth={0.5} class="band-leaf" />
  )}
  {!canopy && mode !== 'aid' && image && (
    <figure class="band-bg" aria-hidden="true" data-band-bg>
      <img src={image} alt="" loading="lazy" />
    </figure>
  )}
  <div class="wrap band-inner" data-reveal>
    <div>
      <h2 class="display">{copy.h2}</h2>
      <p class="lead">{copy.body}</p>
    </div>
    <div class="band-actions">
      <a class="btn btn-solid" href={copy.primary.href}>
        {copy.primary.label}
        {canopy && <Icon name="phone" size="1rem" />}
      </a>
      {copy.secondary && (
        <a
          class="btn btn-ghost"
          href={copy.secondary.href}
          target={copy.secondary.href.startsWith('http') ? '_blank' : undefined}
          rel={copy.secondary.href.startsWith('http') ? 'noopener' : undefined}
        >
          {copy.secondary.label}
          {canopy && <Icon name="message-circle" size="1rem" />}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .band {
    position: relative;
    padding: var(--sec) 0;
    overflow: hidden;
    isolation: isolate;
  }
  .band-bg {
    position: absolute;
    inset: -8% 0;
    z-index: -2;
    margin: 0;
  }
  .band-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* No image: cream band — never a yellow fill */
  .band-convert {
    background: var(--cream);
    color: var(--ink);
  }
  .band-convert .lead {
    color: var(--muted);
  }
  .band-convert .btn-ghost {
    color: var(--canopy);
    border-color: var(--canopy);
  }
  /* With photo: ink veil over the image */
  .band-convert:has(.band-bg) {
    color: var(--cream);
    background: var(--ink);
  }
  .band-convert:has(.band-bg)::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(90deg, rgb(0 36 34 / 0.55) 0%, rgb(0 36 34 / 0.1) 70%),
      linear-gradient(to top, rgb(0 36 34 / 0.78), rgb(0 36 34 / 0.5) 55%, rgb(0 36 34 / 0.38));
  }
  .band-convert:has(.band-bg) .lead { color: var(--muted-on-dark); }
  .band-convert:has(.band-bg) .btn-ghost {
    color: var(--paper);
    border-color: rgb(255 252 244 / 0.6);
  }
  .band-convert:has(.band-bg) .btn-ghost:hover { background: var(--paper); color: var(--ink); }
  /* Canopy: deep green, a faint leaf in the corner, actions as gold and outline pills */
  .band-canopy {
    padding: clamp(2.75rem, 5vw, 3.75rem) 0;
    color: var(--cream);
    background:
      radial-gradient(45% 90% at 100% 50%, rgb(200 181 104 / 0.14), transparent 70%),
      var(--canopy);
  }
  .band-canopy :global(.band-leaf) {
    position: absolute;
    z-index: -1;
    inset-inline-start: -5rem;
    bottom: -9rem;
    color: rgb(217 201 135 / 0.12);
    transform: rotate(-24deg);
    pointer-events: none;
  }
  .band-canopy .band-inner { align-items: center; }
  .band-canopy .display { color: var(--paper); }
  .band-canopy .lead { color: var(--muted-on-dark); max-width: 36rem; }
  .band-canopy .btn { border-radius: 99px; }
  .band-canopy .btn-solid { background: var(--gold); color: var(--ink); }
  .band-canopy .btn-solid:hover { background: var(--gold-soft); }
  .band-canopy .btn-ghost {
    color: var(--paper);
    border-color: rgb(255 252 244 / 0.6);
  }
  .band-canopy .btn-ghost:hover { background: var(--paper); color: var(--ink); }
  .band-aid {
    background: var(--cream);
  }
  .band-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .band-inner .display {
    max-width: none;
    margin-bottom: 0.5rem;
  }
  .band-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }
  @media (max-width: 800px) {
    .band-inner { grid-template-columns: 1fr; }
  }
</style>
