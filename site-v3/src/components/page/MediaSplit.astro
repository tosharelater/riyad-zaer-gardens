---
interface Props {
  image?: string;
  alt?: string;
  kicker?: string;
  title: string;
  body?: string | readonly string[];
  reverse?: boolean;
  tone?: 'light' | 'cream' | 'ink';
  id?: string;
}
const {
  image,
  alt = '',
  kicker,
  title,
  body,
  reverse = false,
  tone = 'light',
  id,
} = Astro.props;
const paras = body == null ? [] : Array.isArray(body) ? [...body] : [body];
---
<section class:list={['split', `tone-${tone}`, { reverse, 'is-text': !image }]} id={id}>
  {image && (
    <figure class="split-media" data-media>
      <img src={image} alt={alt} loading="lazy" />
    </figure>
  )}
  <div class="split-panel" data-reveal data-split>
    {kicker && <p class="kick">{kicker}</p>}
    <h2 class="display">{title}</h2>
    <div class="split-body">
      {paras.map((p) => <p class="lead">{p}</p>)}
      <slot />
    </div>
  </div>
</section>

<style>
  .split {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    grid-template-areas: 'media panel';
    min-height: min(72svh, 40rem);
  }
  .split.reverse {
    grid-template-areas: 'panel media';
  }
  .split-media {
    grid-area: media;
    margin: 0;
    min-height: 24rem;
    overflow: hidden;
  }
  .split-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 0.8s var(--ease);
  }
  .split:hover .split-media img {
    transform: scale(1);
  }
  .split-panel {
    grid-area: panel;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1rem;
    padding: clamp(2.25rem, 5vw, 4rem) clamp(1.5rem, 4vw, 3.5rem);
  }
  .split-panel .display {
    font-size: clamp(1.85rem, 3.4vw, 2.75rem);
    max-width: none;
    margin: 0;
  }
  .split-panel .lead {
    margin: 0;
    max-width: 34rem;
  }
  .split-panel .lead + .lead { margin-top: 0.35rem; }

  .tone-light .split-panel { background: var(--bg); }
  .tone-cream .split-panel { background: var(--cream); }
  .tone-ink .split-panel {
    background: var(--ink);
    color: var(--cream);
  }
  .tone-ink .kick { color: var(--gold-soft); }
  .tone-ink .lead { color: var(--muted-on-dark); }

  .tone-ink .split-panel .btn-ghost {
    color: var(--cream);
    border-color: color-mix(in srgb, var(--cream) 40%, transparent);
  }
  .split-panel :global(.btn) {
    align-self: start;
    margin-top: 0.85rem;
  }

  /* Text only: title left, copy right, on the page grid */
  .split.is-text {
    display: block;
    min-height: 0;
    padding: var(--sec) 0;
  }
  .split.is-text .split-panel {
    width: min(var(--wrap), calc(100% - 2 * var(--pad)));
    margin-inline: auto;
    padding: 0;
    display: grid;
    gap: 0.75rem;
    align-items: start;
    max-width: 40rem;
  }
  .split.is-text .display { max-width: none; margin: 0; }
  .split.is-text .kick { margin: 0; }
  .split.is-text .lead { margin: 0; }
  .tone-cream.is-text { background: var(--cream); }
  .tone-light.is-text { background: var(--bg); }
  .tone-ink.is-text { background: var(--ink); color: var(--cream); }
  .split.is-text .split-panel { background: none; }

  @media (max-width: 900px) {
    .split.is-text .split-panel { grid-template-columns: 1fr; }
    .split,
    .split.reverse {
      grid-template-columns: 1fr;
      grid-template-areas:
        'media'
        'panel';
      min-height: 0;
    }
    .split-media { min-height: 0; aspect-ratio: 16 / 10; }
  }
</style>
