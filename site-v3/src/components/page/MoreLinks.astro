---
import { media } from '../../data/media';
import { stripLocale } from '../../i18n/paths';

interface Link {
  title: string;
  body: string;
  href: string;
  image?: string;
}
interface Props {
  h2: string;
  links: readonly Link[];
}
const { h2, links } = Astro.props;

const defaults: Record<string, string> = {
  '/le-projet': media.aerial.src,
  '/appartements': media.apartment.src,
  '/fonds-de-commerce': media.commerce.src,
  '/localisation': media.avenue.src,
  '/contact': media.hero.src,
  '/blog': media.terrace.src,
};
---
<section class="more">
  <div class="wrap">
    <h2 class="display" data-reveal>{h2}</h2>
    <div class="more-grid">
      {links.map((l) => (
        <a class="more-item" href={l.href} data-reveal>
          <figure>
            <img src={l.image ?? defaults[stripLocale(l.href)] ?? media.hero.src} alt="" loading="lazy" />
          </figure>
          <div>
            <strong>{l.title}</strong>
            <span>{l.body}</span>
            <i aria-hidden="true"></i>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .more {
    padding: clamp(3.5rem, 8vw, 5.5rem) 0;
    background: #fff;
  }
  .more .display {
    font-size: clamp(1.7rem, 3vw, 2.35rem);
    margin-bottom: 1.75rem;
  }
  .more-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(17rem, 1fr));
    gap: 1.15rem;
  }
  .more-item {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    background: var(--cream);
    transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
  }
  .more-item:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgb(0 45 45 / 0.08);
  }
  .more-item figure {
    margin: 0;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }
  .more-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .more-item:hover img { transform: scale(1.05); }
  .more-item > div {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 0.35rem 0.75rem;
    align-items: start;
    padding: 1.3rem 1.25rem 1.45rem;
  }
  .more-item strong {
    grid-column: 1;
    font-size: 1.1rem;
    font-weight: 500;
  }
  .more-item span {
    grid-column: 1;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }
  .more-item i {
    grid-column: 2;
    grid-row: 1 / span 2;
    align-self: center;
    width: 0.55rem;
    height: 0.55rem;
    border-inline-end: 1.5px solid var(--gold);
    border-block-end: 1.5px solid var(--gold);
    transform: rotate(-45deg);
    transition: transform 0.3s var(--ease);
  }
  :global([dir='rtl']) .more-item i {
    transform: rotate(135deg);
  }
  .more-item:hover i {
    transform: rotate(-45deg) translate(2px, 2px);
  }
  :global([dir='rtl']) .more-item:hover i {
    transform: rotate(135deg) translate(2px, 2px);
  }
</style>
