---
interface Props {
  rows: readonly (readonly [string, string])[];
  tone?: 'light' | 'ink';
}
const { rows, tone = 'light' } = Astro.props;
---
<dl class:list={['facts', `tone-${tone}`]}>
  {rows.map(([k, v]) => (
    <div>
      <dt>{k}</dt>
      <dd>{v}</dd>
    </div>
  ))}
</dl>

<style>
  .facts {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.5rem;
  }
  .facts > div {
    display: grid;
    grid-template-columns: minmax(8rem, 0.85fr) 1.4fr;
    gap: 1rem;
    padding: 0.55rem 0;
  }
  .facts dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.2rem;
  }
  .facts dd {
    font-size: 1.05rem;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .tone-ink dt { color: color-mix(in srgb, var(--cream) 50%, transparent); }
  .tone-ink dd { color: var(--cream); }
  @media (max-width: 600px) {
    .facts > div { grid-template-columns: 1fr; gap: 0.3rem; }
  }
</style>
