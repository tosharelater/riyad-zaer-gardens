---
/**
 * Shared hero for every inner page — same language as the home hero:
 * photo, serif title anchored low, a hairline, then lead and key figures.
 */
interface Fact {
  n: string;
  l: string;
  count?: number;
}
interface Props {
  h1: string;
  lead?: string | readonly string[];
  kicker?: string;
  index?: string;
  image?: string;
  alt?: string;
  compact?: boolean;
  facts?: readonly Fact[];
  position?: string;
}
const {
  h1,
  lead,
  kicker = 'Riyad Zaer Gardens',
  index,
  image,
  alt = '',
  compact = false,
  facts = [],
  position = 'center 40%',
} = Astro.props;
const leads = lead == null ? [] : Array.isArray(lead) ? [...lead] : [lead];
const hasExtras = Astro.slots.has('default');
const plain = !image;
---
<header class:list={['ph', { 'is-compact': compact, 'is-plain': plain }]} data-page-hero>
  {!plain && (
    <figure class="ph-media" data-ph-media>
      <img src={image} alt={alt} fetchpriority="high" decoding="async" style={`object-position: ${position}`} />
    </figure>
  )}
  {!plain && <div class="ph-shade" aria-hidden="true"></div>}

  <div class="ph-copy wrap">
    <p class="ph-kick" data-ph-in>
      {index && <span class="ph-index">{index}</span>}
      {index && <i aria-hidden="true"></i>}
      <span>{kicker}</span>
    </p>
    <h1 class="ph-title" data-ph-title>{h1}</h1>

    {(leads.length > 0 || hasExtras) && (
      <div class="ph-foot">
        <div class="ph-leads" data-ph-in>
          {leads.slice(0, 2).map((p) => <p class="ph-lead">{p}</p>)}
        </div>
        {hasExtras && (
          <div class="ph-extra" data-ph-in>
            <slot />
          </div>
        )}
      </div>
    )}
  </div>

  {facts.length > 0 && (
    <dl class="ph-facts wrap">
      {facts.map((f) => (
        <div data-ph-fact>
          <dt data-count={f.count != null ? String(f.count) : undefined}>{f.n}</dt>
          <dd>{f.l}</dd>
        </div>
      ))}
    </dl>
  )}
</header>

<style>
  .ph {
    position: relative;
    min-height: min(100svh, 60rem);
    display: grid;
    grid-template-rows: 1fr auto;
    color: var(--cream);
    overflow: hidden;
    isolation: isolate;
  }
  .ph.is-compact {
    min-height: min(68svh, 40rem);
  }

  .ph-media {
    position: absolute;
    inset: -10% -2% -2%;
    z-index: -2;
    margin: 0;
    animation: ph-curtain 1.5s var(--ease-io) both;
  }
  .ph-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: ph-settle 2.8s var(--ease) both;
  }
  .ph-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(1 22 21 / 0.94) 0%, rgb(1 22 21 / 0.62) 45%, rgb(1 22 21 / 0.3) 100%),
      linear-gradient(to bottom, rgb(1 22 21 / 0.5), transparent 24%);
  }

  .ph-copy {
    align-self: end;
    padding: calc(var(--nav) + 3rem) 0 clamp(2rem, 4vw, 3rem);
  }

  .ph-kick {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 1rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: rgb(244 238 226 / 0.78);
  }
  .ph-index {
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }
  .ph-kick i {
    width: 2.5rem;
    height: 1px;
    background: rgb(244 238 226 / 0.4);
  }

  .ph-title {
    margin-top: clamp(1rem, 2vw, 1.6rem);
    font-family: var(--audrey);
    font-size: clamp(2.7rem, 6.4vw, 6.25rem);
    font-weight: 400;
    letter-spacing: -0.04em;
    word-spacing: 0.06em;
    line-height: 0.98;
    max-width: 15ch;
    text-wrap: balance;
  }
  .is-compact .ph-title {
    font-size: clamp(2.6rem, 6vw, 5.5rem);
  }

  .ph-foot {
    margin-top: clamp(1.75rem, 3.5vw, 2.75rem);
    padding-top: clamp(1.25rem, 2.5vw, 1.75rem);
    border-top: 1px solid rgb(244 238 226 / 0.22);
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: end;
    animation: ph-rule 1.4s 0.6s var(--ease) both;
  }
  .ph-leads {
    max-width: 40rem;
  }
  .ph-lead {
    font-size: clamp(1rem, 1.3vw, 1.1rem);
    line-height: 1.7;
    color: rgb(244 238 226 / 0.84);
    text-wrap: pretty;
  }
  .ph-lead + .ph-lead { margin-top: 0.65rem; }
  .ph-extra {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .ph-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    border-top: 1px solid rgb(244 238 226 / 0.14);
  }
  .ph-facts > div {
    padding: 1.1rem 0 1.4rem;
  }
  .ph-facts > div + div {
    padding-inline-start: clamp(1rem, 2.5vw, 2rem);
    border-inline-start: 1px solid rgb(244 238 226 / 0.14);
  }
  .ph-facts dt {
    font-weight: 300;
    font-family: var(--display);
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    line-height: 1;
    color: var(--gold);
    font-variant-numeric: tabular-nums;
  }
  .ph-facts dd {
    margin-top: 0.45rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: rgb(244 238 226 / 0.6);
  }

  [data-ph-in],
  [data-ph-fact] {
    animation: ph-rise 1.1s var(--ease) both;
  }
  .ph-kick { animation-delay: 0.3s; }
  .ph-leads { animation-delay: 0.8s; }
  .ph-extra { animation-delay: 0.9s; }
  [data-ph-fact]:nth-child(1) { animation-delay: 1s; }
  [data-ph-fact]:nth-child(2) { animation-delay: 1.07s; }
  [data-ph-fact]:nth-child(3) { animation-delay: 1.14s; }
  [data-ph-fact]:nth-child(4) { animation-delay: 1.21s; }
  .ph-title :global(.w > span) { transform: translateY(110%); }

  /* Plain: no photo, type on cream */
  .ph.is-plain {
    min-height: 0;
    background: var(--cream);
    color: var(--ink);
  }
  .ph.is-plain .ph-copy { padding-top: calc(var(--nav) + clamp(4rem, 10vw, 8rem)); }
  .is-plain .ph-kick { color: var(--muted); }
  .is-plain .ph-kick i { background: var(--line); }
  .is-plain .ph-index { color: var(--gold-deep); }
  .is-plain .ph-foot { border-top-color: var(--line); }
  .is-plain .ph-lead { color: var(--muted); }
  .is-plain .ph-facts { border-top-color: var(--line); }
  .is-plain .ph-facts > div + div { border-inline-start-color: var(--line); }
  .is-plain .ph-facts dt { color: var(--ink); }
  .is-plain .ph-facts dd { color: var(--muted); }
  .is-plain .ph-extra :global(.btn-light) { color: var(--ink); border-color: var(--ink); --fill: var(--ink); --on-fill: var(--bg); }

  @keyframes ph-curtain {
    from { clip-path: inset(0 0 100% 0); }
    to { clip-path: inset(0 0 0 0); }
  }
  @keyframes ph-settle {
    from { transform: scale(1.12); }
    to { transform: scale(1.02); }
  }
  @keyframes ph-rise {
    from { opacity: 0; transform: translateY(1.1rem); }
    to { opacity: 1; transform: none; }
  }
  @keyframes ph-rule {
    from { border-top-color: transparent; }
  }

  @media (max-width: 800px) {
    .ph-foot { grid-template-columns: 1fr; }
    /* One paragraph is enough on a phone; the page repeats the rest */
    .ph-lead + .ph-lead { display: none; }
    .ph-facts { grid-template-columns: 1fr 1fr; }
    .ph-facts > div:nth-child(3) {
      padding-inline-start: 0;
      border-inline-start: 0;
    }
    .ph-facts > div:nth-child(n + 3) {
      border-top: 1px solid rgb(244 238 226 / 0.14);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ph-media,
    .ph-media img,
    .ph-foot,
    [data-ph-in],
    [data-ph-fact] {
      animation: none;
    }
    .ph-title :global(.w > span) { transform: none; }
  }
</style>
