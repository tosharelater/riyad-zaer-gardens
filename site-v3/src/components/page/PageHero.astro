---
/**
 * Shared hero for every inner page — photo, serif title anchored low,
 * then lead and optional key figures (no divider lines).
 */
interface Fact {
  n: string;
  l: string;
  count?: number;
}
interface Props {
  h1: string;
  lead?: string | readonly string[];
  kicker?: string;
  index?: string;
  image?: string;
  alt?: string;
  compact?: boolean;
  facts?: readonly Fact[];
  position?: string;
}
const {
  h1,
  lead,
  kicker = 'Riyad Zaer Gardens',
  index,
  image,
  alt = '',
  compact = false,
  facts = [],
  position = 'center 40%',
} = Astro.props;
const leads = lead == null ? [] : Array.isArray(lead) ? [...lead] : [lead];
const hasExtras = Astro.slots.has('default');
const plain = !image;
---
<header class:list={['ph', { 'is-compact': compact, 'is-plain': plain }]} data-page-hero>
  {!plain && (
    <figure class="ph-media" data-ph-media>
      <img src={image} alt={alt} fetchpriority="high" decoding="async" style={`object-position: ${position}`} />
    </figure>
  )}
  {!plain && <div class="ph-shade" aria-hidden="true"></div>}

  <div class="ph-copy wrap">
    <p class="ph-kick" data-ph-in>
      {index && <span class="ph-index">{index}</span>}
      {index && <i aria-hidden="true"></i>}
      <span>{kicker}</span>
    </p>
    <h1 class="ph-title" data-ph-title>{h1}</h1>

    {(leads.length > 0 || hasExtras) && (
      <div class="ph-foot">
        <div class="ph-leads" data-ph-in>
          {leads.slice(0, 3).map((p) => <p class="ph-lead">{p}</p>)}
        </div>
        {hasExtras && (
          <div class="ph-extra" data-ph-in>
            <slot />
          </div>
        )}
      </div>
    )}
  </div>

  {facts.length > 0 && (
    <dl class="ph-facts wrap">
      {facts.map((f) => (
        <div data-ph-fact>
          <dt data-count={f.count != null ? String(f.count) : undefined}>{f.n}</dt>
          <dd>{f.l}</dd>
        </div>
      ))}
    </dl>
  )}
</header>

<style>
  .ph {
    position: relative;
    min-height: min(100svh, 60rem);
    display: grid;
    grid-template-rows: 1fr auto;
    color: var(--cream);
    overflow: hidden;
    isolation: isolate;
  }
  .ph.is-compact {
    min-height: min(72svh, 42rem);
  }

  .ph-media {
    position: absolute;
    inset: -10% -2% -2%;
    z-index: -2;
    margin: 0;
    animation: ph-curtain 1.5s var(--ease-io) both;
  }
  .ph-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    animation: ph-settle 2.8s var(--ease) both;
  }
  .ph-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.74) 0%, rgb(0 0 0 / 0.34) 42%, rgb(0 0 0 / 0) 70%),
      linear-gradient(to bottom, rgb(0 0 0 / 0.35), transparent 22%);
  }

  .ph-copy {
    align-self: end;
    padding: calc(var(--nav) + 3.25rem) 0 clamp(2.25rem, 4.5vw, 3.25rem);
  }

  .ph-kick {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.9rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: rgb(255 255 255 / 0.85);
  }
  .ph-index {
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .ph-kick i {
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.6;
  }

  .ph-title {
    margin-top: 0.85rem;
    font-family: var(--display);
    font-size: clamp(2.4rem, 5.6vw, 4.5rem);
    font-weight: 600;
    letter-spacing: -0.03em;
    line-height: 1.06;
    max-width: min(46rem, 100%);
    text-wrap: balance;
  }
  .is-compact .ph-title {
    font-size: clamp(1.95rem, 4vw, 3.1rem);
  }

  .ph-foot {
    margin-top: 1.25rem;
    display: grid;
    gap: 1.5rem;
    align-items: start;
  }
  .ph-leads {
    max-width: 36rem;
  }
  .ph-lead {
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.45;
    color: rgb(255 255 255 / 0.86);
    text-wrap: pretty;
  }
  .ph-lead + .ph-lead { margin-top: 0.65rem; }
  .ph-extra {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  .ph-facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    padding: 1.15rem 0 1.35rem;
  }
  .ph-facts > div {
    padding: 0;
    display: grid;
    gap: 0.15rem;
  }
  .ph-facts dt {
    font-weight: 600;
    font-family: var(--display);
    font-size: clamp(1.7rem, 3vw, 2.5rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: #fff;
    font-variant-numeric: tabular-nums;
  }
  .ph-facts dd {
    margin-top: 0.45rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--muted-on-dark);
  }

  [data-ph-in],
  [data-ph-fact] {
    animation: ph-rise 1.1s var(--ease) both;
  }
  .ph-kick { animation-delay: 0.3s; }
  .ph-leads { animation-delay: 0.8s; }
  .ph-extra { animation-delay: 0.9s; }
  [data-ph-fact]:nth-child(1) { animation-delay: 1s; }
  [data-ph-fact]:nth-child(2) { animation-delay: 1.07s; }
  [data-ph-fact]:nth-child(3) { animation-delay: 1.14s; }
  [data-ph-fact]:nth-child(4) { animation-delay: 1.21s; }
  .ph-title :global(.w > span) { transform: translateY(110%); }

  /* Plain: no photo, type on cream */
  .ph.is-plain {
    min-height: 0;
    background: var(--bg);
    color: var(--ink);
  }
  .ph.is-plain .ph-copy { padding-top: calc(var(--nav) + clamp(4rem, 10vw, 8rem)); }
  .is-plain .ph-kick { color: var(--canopy); }
  .is-plain .ph-kick i { background: var(--line); }
  .is-plain .ph-index { color: var(--gold-deep); }
  .is-plain .ph-lead { color: var(--muted); }
  .is-plain .ph-facts dt { color: var(--ink); }
  .is-plain .ph-facts dd { color: var(--muted); }
  .is-plain .ph-extra :global(.btn-light) { color: var(--canopy); border-color: var(--canopy); background: transparent; }
  .is-plain .ph-extra :global(.btn-light:hover) { color: #fff; background: var(--canopy); }

  @keyframes ph-curtain {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes ph-settle {
    from { transform: scale(1.06); }
    to { transform: scale(1); }
  }
  @keyframes ph-rise {
    from { opacity: 0; transform: translateY(1.1rem); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 800px) {
    .ph-lead + .ph-lead + .ph-lead { display: none; }
    .ph-facts { grid-template-columns: 1fr 1fr; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ph-media,
    .ph-media img,
    [data-ph-in],
    [data-ph-fact] {
      animation: none;
    }
    .ph-title :global(.w > span) { transform: none; }
  }
</style>
