---
import { getHome } from '../data/content';
import { localePath, type Locale } from '../i18n/paths';
import Icon from './Icon.astro';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { projet } = getHome(locale);

/** One icon per amenity, same order as the data */
const amenityIcons = ['arrow-up-down', 'trees', 'square-parking', 'shield-check', 'paint-roller', 'store'];

---
<section class="projet" id="projet">
  <div class="wrap">
    <div class="projet-grid">
      <div class="projet-copy" data-reveal data-split>
        <p class="kick">{locale === 'ar' ? 'المشروع' : 'Le projet'}</p>
        <h2 class="display">{projet.h2}</h2>
        <p class="lead">{projet.p1}</p>
        <p class="lead">{projet.p2}</p>
        <a class="projet-link" href={projet.link.href.startsWith('/') ? localePath(locale, projet.link.href) : projet.link.href}>{projet.link.label}</a>
      </div>
      <figure class="projet-photo" data-media>
        <img src="/photos/aerial-ilot.jpg" alt={projet.alt} loading="lazy" decoding="async" />
      </figure>
    </div>

    <ul class="projet-amenities" data-reveal>
      {projet.amenities.map((a, i) => (
        <li>
          <Icon name={amenityIcons[i]} size="1.5rem" />
          <span>{a}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .projet {
    padding: var(--sec) 0;
    background: var(--bg);
  }
  .projet-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 6vw, 6rem);
    align-items: center;
  }
  .projet-copy .display {
    margin: 1rem 0 0.25rem;
    max-width: 16ch;
  }
  .projet-copy .lead + .lead { margin-top: 0.85rem; }
  .projet-photo {
    margin: 0;
    aspect-ratio: 1 / 1;
  }
  .projet-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .projet-amenities {
    margin-top: clamp(3rem, 6vw, 4.5rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    column-gap: clamp(1.5rem, 4vw, 3rem);
    border-top: 1px solid var(--line);
  }
  .projet-amenities li {
    display: grid;
    grid-template-columns: 1.6rem 1fr;
    gap: 1rem;
    align-items: center;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 1.02rem;
    line-height: 1.45;
  }
  .projet-amenities :global(.icon) { color: var(--gold-deep); }

  @media (max-width: 900px) {
    .projet-grid { grid-template-columns: 1fr; }
    .projet-photo { aspect-ratio: 4 / 3; }
    .projet-amenities { grid-template-columns: 1fr; }
  }
  @media (min-width: 901px) and (max-width: 1100px) {
    .projet-amenities { grid-template-columns: 1fr 1fr; }
  }
</style>
