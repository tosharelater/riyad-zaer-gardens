---
import { projet } from '../data/home';

/** Stroke icons — one set of paths per amenity */
const amenityIcons = [
  // Ascenseur
  [
    'M6 3h12v18H6z',
    'M10 9.5 12 7l2 2.5',
    'M10 14.5 12 17l2-2.5',
  ],
  // Cœur d’îlot / végétal
  [
    'M12 22v-7',
    'M9 22h6',
    'M12 15c-3.8 0-6.5-2.4-6.5-5.8C5.5 6.2 8.6 4 12 4s6.5 2.2 6.5 5.2C18.5 12.6 15.8 15 12 15Z',
    'M12 8.5c-.8 1.2-1.2 2.4-1.2 3.5',
  ],
  // Parking couvert
  [
    'M4 19h16',
    'M6 19 7.5 13h9L18 19',
    'M8 13V9.5h8V13',
    'M9 19v2',
    'M15 19v2',
    'M5 9.5 12 5l7 4.5',
  ],
  // Sécurité
  [
    'M12 3 5 6.2v5c0 4.1 2.9 7.1 7 8.8 4.1-1.7 7-4.7 7-8.8v-5L12 3Z',
    'M9.5 12.2 11.2 14l3.8-4',
  ],
  // Finitions
  [
    'M4 20h16',
    'M7 20V9l5-5 5 5v11',
    'M10 20v-5h4v5',
  ],
  // Commerces
  [
    'M4 10h16l-1.2 10H5.2L4 10Z',
    'M5.5 6h13l1 4h-15l1-4Z',
    'M9 14v4',
    'M15 14v4',
  ],
] as const;
---
<section class="projet" id="projet">
  <div class="projet-stage">
    <figure class="projet-hero" data-media>
      <img src={projet.img} alt={projet.alt} loading="lazy" />
    </figure>
    <div class="projet-panel" data-reveal>
      <div class="projet-left" data-split>
        <p class="kick">Le projet</p>
        <h2 class="display">{projet.h2}</h2>
        <p class="lead">{projet.p1}</p>
        <p class="lead">{projet.p2}</p>
      </div>
      <ul class="projet-amenities">
        {projet.amenities.map((a, i) => (
          <li style={`--i: ${i}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              {amenityIcons[i].map((d) => (
                <path d={d} />
              ))}
            </svg>
            <span>{a}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>
<style>
  .projet {
    padding-bottom: 0;
  }

  .projet-stage {
    position: relative;
    display: grid;
    place-items: center;
  }

  .projet-hero {
    grid-area: 1 / 1;
    margin: 0;
    width: 100%;
    height: clamp(34rem, 78vw, 56rem);
    max-height: 86svh;
  }

  .projet-hero img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .projet-panel {
    grid-area: 1 / 1;
    position: relative;
    z-index: 1;
    width: min(92rem, calc(100% - 2 * var(--pad)));
    margin-block: clamp(2rem, 5vw, 3.25rem);
    background: var(--bg);
    padding: clamp(2.5rem, 5vw, 4.25rem);
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: clamp(2.25rem, 5vw, 4.5rem);
    align-items: end;
    box-shadow: 0 22px 60px rgb(0 45 45 / 0.14);
  }

  .projet-left .display {
    margin-top: 0.45rem;
    margin-bottom: 1.5rem;
    font-size: clamp(2.4rem, 4.8vw, 3.85rem);
    max-width: none;
  }
  .projet-left .lead {
    font-size: clamp(1.05rem, 1.55vw, 1.2rem);
    line-height: 1.65;
    max-width: 44rem;
  }
  .projet-left .lead:first-of-type { margin-top: 0; }
  .projet-left .lead + .lead { margin-top: 1.1rem; }

  .projet-amenities {
    display: grid;
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .projet-amenities li {
    display: grid;
    grid-template-columns: 1.7rem 1fr;
    gap: 1rem;
    align-items: start;
    padding: 1.2rem 0;
    border-bottom: 1px solid rgb(0 45 45 / calc(0.14 - (var(--i) * 0.022)));
    font-size: clamp(1.05rem, 1.45vw, 1.2rem);
    line-height: 1.45;
    color: var(--ink);
  }
  .projet-amenities li:last-child { border-bottom: 0; }
  .projet-amenities svg {
    width: 1.5rem;
    height: 1.5rem;
    margin-top: 0.1rem;
    color: var(--gold);
  }

  @media (max-width: 900px) {
    .projet-stage {
      display: flex;
      flex-direction: column;
      place-items: stretch;
    }
    .projet-hero {
      height: auto;
      aspect-ratio: 16 / 10;
      max-height: none;
    }
    .projet-panel {
      width: auto;
      margin: -3.5rem var(--pad) 0;
      grid-template-columns: 1fr;
      align-items: start;
      box-shadow: 0 16px 44px rgb(0 45 45 / 0.12);
    }
  }
</style>
