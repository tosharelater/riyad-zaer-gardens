---
import { getHome } from '../data/content';
import { localePath, type Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { projet } = getHome(locale);
---
<section class="projet" id="projet">
  <div class="wrap">
    <div class="projet-grid">
      <div class="projet-copy" data-reveal data-split>
        <p class="kick">{locale === 'ar' ? 'المشروع' : 'Le projet'}</p>
        <h2 class="display">{projet.h2}</h2>
        <p class="lead">{projet.p1}</p>
        <p class="lead">{projet.p2}</p>
        <a class="projet-link" href={projet.link.href.startsWith('/') ? localePath(locale, projet.link.href) : projet.link.href}>{projet.link.label}</a>
      </div>
      <figure class="projet-photo" data-media>
        <img src="/photos/aerial-ilot.webp" alt={projet.alt} loading="lazy" decoding="async" />
      </figure>
    </div>

    <ul class="projet-amenities" data-reveal>
      {projet.amenities.map((a) => (
        <li>
          <span class="amenity-mark" aria-hidden="true"></span>
          <span>{a}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .projet {
    padding: var(--sec) 0;
    background: var(--bg);
  }
  .projet-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap);
    align-items: center;
  }
  .projet-copy .kick { margin: 0; }
  .projet-copy .display {
    margin: 0.55rem 0 0;
    max-width: none;
    font-size: clamp(1.65rem, 3.2vw, 2.35rem);
  }
  .projet-copy .lead {
    margin-top: 0.7rem;
    font-size: clamp(0.95rem, 1.15vw, 1.05rem);
    line-height: 1.55;
    max-width: 34rem;
  }
  .projet-copy .lead + .lead { margin-top: 0.65rem; }
  .projet-photo {
    margin: 0;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    position: relative;
    isolation: isolate;
    border-radius: 16px;
    box-shadow:
      0 18px 40px rgb(45 35 15 / 0.1),
      0 0 0 1px color-mix(in srgb, var(--gold-text) 16%, transparent);
  }
  .projet-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    transition: transform 0.8s var(--ease);
  }
  .projet:hover .projet-photo img {
    transform: scale(1.02);
  }

  .projet-amenities {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem var(--gap);
  }
  .projet-amenities li {
    display: grid;
    grid-template-columns: 0.65rem 1fr;
    gap: 0.85rem;
    align-items: start;
    font-size: 0.98rem;
    line-height: 1.45;
  }
  .amenity-mark {
    width: 0.4rem;
    height: 0.4rem;
    margin-top: 0.45rem;
    border-radius: 1px;
    background: var(--gold-text);
  }

  @media (max-width: 900px) {
    .projet-grid { grid-template-columns: 1fr; }
    .projet-photo { aspect-ratio: 4 / 3; }
    .projet-amenities { grid-template-columns: 1fr; }
  }
  @media (min-width: 901px) and (max-width: 1100px) {
    .projet-amenities { grid-template-columns: 1fr 1fr; }
  }
</style>
