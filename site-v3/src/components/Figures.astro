---
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { figures } = getHome(locale);
---
<section class="fig" id="chiffres" data-figures-board>
  <div class="wrap fig-shell">
    <header class="fig-copy" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'المرحلة الأولى' : 'Tranche 1'}</p>
      <h2 class="display">{figures.h2}</h2>
      <span class="fig-title-rule" aria-hidden="true"></span>
      <p class="lead">{figures.lead}</p>
    </header>

    <div class="fig-stack">
      {figures.items.map((f, i) => (
        <article class="fig-card" data-figures-item style={`--i: ${i}`}>
          <p class="fig-n" data-count data-to={f.n}>
            <span data-count-val>{f.n}</span>
          </p>
          <div class="fig-meta">
            <span class="fig-label">{f.label}</span>
            <span class="fig-rule" aria-hidden="true"></span>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style is:global>
  #chiffres.fig {
    position: relative;
    z-index: 1;
    padding: clamp(2.25rem, 4.5vw, 3.25rem) 0 var(--sec);
    overflow: visible;
    color: var(--ink);
    background: transparent;
  }

  #chiffres .fig-shell {
    position: relative;
    z-index: 1;
    display: grid !important;
    grid-template-columns: minmax(0, 1.05fr) minmax(19rem, 0.95fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  #chiffres .fig-copy {
    display: grid;
    gap: 0.75rem;
    max-width: 34rem;
  }
  #chiffres .fig-copy .kick {
    margin: 0;
    color: var(--gold-text);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  #chiffres .fig-copy .display {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.1rem, 4.4vw, 3.35rem);
  }
  #chiffres .fig-title-rule {
    display: block;
    width: 2.75rem;
    height: 1.5px;
    background: var(--gold-text);
  }
  #chiffres .fig-copy .lead {
    margin: 0.15rem 0 0;
    max-width: 32rem;
    color: var(--muted);
    line-height: 1.55;
  }

  #chiffres .fig-stack {
    display: grid;
    gap: 0;
    justify-items: end;
    width: 100%;
    padding-block: 0.25rem;
  }

  #chiffres .fig-card {
    position: relative;
    box-sizing: border-box;
    width: min(100%, 21rem);
    display: grid;
    gap: 0.7rem;
    padding: 1.45rem 1.6rem 1.35rem;
    background: rgb(255 253 248 / 0.55);
    border: 1px solid rgb(255 255 255 / 0.7);
    border-radius: 16px;
    -webkit-backdrop-filter: blur(18px) saturate(150%);
    backdrop-filter: blur(18px) saturate(150%);
    box-shadow:
      0 20px 44px rgb(0 45 45 / 0.1),
      0 2px 8px rgb(0 45 45 / 0.04),
      inset 0 1px 0 rgb(255 255 255 / 0.85);
    overflow: hidden;
    transition:
      transform 0.55s var(--ease),
      box-shadow 0.55s var(--ease),
      border-color 0.55s var(--ease);
    will-change: transform;
  }
  #chiffres .fig-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 35%,
      rgb(255 255 255 / 0.55) 48%,
      transparent 62%
    );
    transform: translateX(-130%);
    opacity: 0;
  }
  #chiffres .fig-card.is-in::before {
    animation: fig-shine 1.15s var(--ease) both;
  }
  @keyframes fig-shine {
    from { transform: translateX(-130%); opacity: 0; }
    30% { opacity: 0.9; }
    to { transform: translateX(130%); opacity: 0; }
  }
  #chiffres .fig-card:hover {
    transform: translateY(-6px) scale(1.015);
    border-color: color-mix(in srgb, var(--gold) 45%, white);
    box-shadow:
      0 28px 50px rgb(0 45 45 / 0.14),
      0 4px 14px rgb(200 181 104 / 0.18),
      inset 0 1px 0 rgb(255 255 255 / 0.9);
  }
  /* Diagonal: top furthest right → bottom steps left */
  #chiffres .fig-card:nth-child(1) {
    width: min(100%, 17rem);
    margin-inline-end: 0;
    z-index: 3;
  }
  #chiffres .fig-card:nth-child(2) {
    width: min(100%, 19.5rem);
    margin-top: -0.55rem;
    margin-inline-end: clamp(1.5rem, 5vw, 3.25rem);
    z-index: 2;
  }
  #chiffres .fig-card:nth-child(3) {
    width: min(100%, 22rem);
    margin-top: -0.55rem;
    margin-inline-end: clamp(3rem, 10vw, 6.5rem);
    z-index: 1;
  }

  #chiffres .fig-n {
    margin: 0;
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(3.5rem, 7vw, 5.25rem);
    line-height: 0.88;
    letter-spacing: -0.055em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  #chiffres .fig-n [data-count-val] {
    display: inline-block;
    transform-origin: left bottom;
  }

  #chiffres .fig-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 0.9rem;
  }
  #chiffres .fig-label {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  #chiffres .fig-rule {
    display: block;
    width: 2.5rem;
    height: 1.5px;
    background: var(--gold-text);
    transform-origin: left center;
    opacity: 0.9;
  }

  @media (max-width: 800px) {
    #chiffres .fig-shell {
      grid-template-columns: 1fr;
      gap: 2.5rem;
    }
    #chiffres .fig-stack {
      justify-items: stretch;
      max-width: 26rem;
    }
    #chiffres .fig-card,
    #chiffres .fig-card:nth-child(1),
    #chiffres .fig-card:nth-child(2),
    #chiffres .fig-card:nth-child(3) {
      width: 100%;
      margin-inline-end: 0;
      margin-top: 0;
    }
    #chiffres .fig-stack {
      gap: 0.85rem;
    }
  }

  @media (prefers-reduced-transparency: reduce) {
    #chiffres .fig-card {
      background: var(--paper);
      -webkit-backdrop-filter: none;
      backdrop-filter: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    #chiffres .fig-card::before { display: none; }
    #chiffres .fig-card,
    #chiffres .fig-card:hover {
      transition: none;
      transform: none;
    }
  }
</style>
