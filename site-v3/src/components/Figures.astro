---
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { figures } = getHome(locale);
---
<section class="figures" id="chiffres">
  <div class="wrap">
    <header class="head-split" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'المرحلة الأولى' : 'Tranche 1'}</p>
      <h2 class="display">{figures.h2}</h2>
      <p class="lead">{figures.lead}</p>
    </header>

    <dl class="figures-board" data-figures-board>
      {figures.items.map((f) => (
        <div class="figures-item">
          <dt data-count data-to={f.n}>{f.n}</dt>
          <dd>{f.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
<style>
  .figures {
    padding: var(--sec) 0;
    background: var(--paper);
  }
  .figures-board {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }
  .figures-item {
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }
  .figures-item dt {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(3rem, 6.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .figures-item dd {
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .figures-board { gap: 1rem; }
    .figures-item dt { font-size: clamp(2.25rem, 11vw, 3rem); }
    .figures-item dd { font-size: 0.9375rem; }
  }
</style>
