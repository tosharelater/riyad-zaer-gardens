---
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { figures } = getHome(locale);
---
<section class="figures" id="chiffres">
  <div class="wrap">
    <header class="figures-head head-split" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'المرحلة الأولى' : 'Tranche 1'}</p>
      <h2 class="display">{figures.h2}</h2>
      <p class="lead">{figures.lead}</p>
    </header>

    <dl class="figures-board" data-figures-board>
      {figures.items.map((f) => (
        <div class="figures-item">
          <dt data-count data-to={f.n}>{f.n}</dt>
          <dd>{f.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
<style>
  .figures {
    padding: var(--sec) 0;
    background: var(--bg);
  }
  .figures-head { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }

  .figures-board {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-block: 1px solid var(--line);
  }
  .figures-item {
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
  }
  .figures-item + .figures-item {
    padding-inline-start: clamp(1.25rem, 3vw, 2.5rem);
    border-inline-start: 1px solid var(--line);
  }
  .figures-item dt {
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(3.25rem, 6.5vw, 5.75rem);
    line-height: 1;
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .figures-item dd {
    margin-top: 0.6rem;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .figures-board { grid-template-columns: 1fr; }
    .figures-item + .figures-item {
      padding-inline-start: 0;
      border-inline-start: 0;
      border-top: 1px solid var(--line);
    }
  }
</style>
