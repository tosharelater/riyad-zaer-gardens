---
import { getHome } from '../data/content';
import { media } from '../data/media';
import { localePath, type Locale } from '../i18n/paths';
import Icon from './Icon.astro';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { figures } = getHome(locale);
---
<section class="fig" id="chiffres" data-figures-board>
  <div class="wrap">
   <div class="fig-card" data-reveal>
    <div class="fig-shell">
    <figure class="fig-media">
      <img src={media.day.src} alt={media.day.alt} loading="lazy" decoding="async" />
    </figure>

    <div class="fig-copy" data-split>
      <p class="kick">{locale === 'ar' ? 'المرحلة الأولى' : 'La première tranche'}</p>
      <h2 class="display">{figures.h2}</h2>
      <p class="lead">{figures.lead}</p>
      <a class="link-cta fig-link" href={localePath(locale, '/le-projet')}>{locale === 'ar' ? 'اكتشفوا المشروع' : 'Découvrir le projet'}<Icon name="arrow-right" size="1.1em" /></a>
    </div>
    </div>

    <div class="fig-stats" role="list">
      {figures.items.map((f, i) => (
        <div class="fig-stat" role="listitem" data-figures-item style={`--i: ${i}`}>
          <p class="fig-n" data-count data-to={f.n}>
            <span data-count-val>{f.n}</span>
          </p>
          <span class="fig-label">{f.label}</span>
        </div>
      ))}
    </div>
   </div>
  </div>
</section>

<style>
  .fig {
    position: relative;
    z-index: 1;
    padding: clamp(3.5rem, 7vw, 6rem) 0;
    color: var(--ink);
    background: var(--paper);
  }

  /* One single panel: photo + copy + figures */
  .fig-card {
    /* Breaks out of the narrow column: takes most of the screen on desktop */
    width: min(100% - 2rem, 1560px);
    margin-inline: auto;
    --fig-bg: var(--cream);
    overflow: hidden;
    border-radius: 28px;
    border: 1px solid color-mix(in srgb, var(--canopy) 40%, transparent);
    background: var(--fig-bg);
  }
  .fig-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.9fr);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: stretch;
  }

  .fig-media {
    position: relative;
    margin: 0;
    min-height: clamp(20rem, 52vh, 44rem);
    overflow: hidden;
  }
  .fig-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }
  /* Soft fade into cream */
  .fig-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to top, var(--fig-bg) 0%, transparent 22%),
      linear-gradient(
      to right,
      transparent 48%,
      color-mix(in srgb, var(--fig-bg) 40%, transparent) 70%,
      color-mix(in srgb, var(--fig-bg) 88%, transparent) 88%,
      var(--fig-bg)
    );
    pointer-events: none;
  }

  .fig-copy {
    display: grid;
    gap: 0.85rem;
    max-width: 40rem;
    justify-items: start;
    align-content: center;
    padding: clamp(1.5rem, 3vw, 2.5rem) clamp(1.5rem, 4vw, 3rem) clamp(1.5rem, 3vw, 2.5rem) 0;
  }
  .fig-copy .kick {
    margin: 0;
    color: var(--gold-text);
  }
  .fig-copy .display {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2rem, 4vw, 3.6rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }
  .fig-copy .lead {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
    font-size: clamp(1rem, 1.3vw, 1.2rem);
    max-width: 36rem;
  }

  /* Stats panel — bare numerals, no icon circles */
  .fig-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0 clamp(1rem, 3vw, 2rem);
    padding: clamp(1.5rem, 3vw, 2.25rem) 0 clamp(1.75rem, 3.5vw, 2.5rem);
    color: var(--ink);
    text-align: center;
  }
  .fig-stat {
    display: grid;
    gap: 0.5rem;
    justify-items: center;
    align-content: start;
    padding: 0.25rem 1rem 0.5rem;
  }
  .fig-n {
    margin: 0;
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(3rem, 5.4vw, 4.4rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
  }
  .fig-n [data-count-val] { display: inline-block; }
  .fig-link { margin-top: 0.4rem; }
  .fig-label {
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .fig-shell {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .fig-media { min-height: 0; aspect-ratio: 16 / 11; }
    .fig-media::after {
      background: linear-gradient(
        to bottom,
        transparent 62%,
        color-mix(in srgb, var(--fig-bg) 50%, transparent) 82%,
        var(--fig-bg)
      );
    }
    .fig-copy {
      max-width: none;
      padding: 0 1.5rem 1.5rem;
    }
    .fig-copy .display {
      max-width: none;
      font-size: clamp(1.7rem, 7vw, 2.35rem);
    }
  }

  @media (max-width: 700px) {
    .fig-card { border-radius: 22px; }
    .fig-shell { gap: 1.25rem; }
    .fig-media { aspect-ratio: 4 / 3; }
    .fig-copy { padding: 0 1.25rem 0.5rem; gap: 0.7rem; }
    .fig-link { justify-self: center; }
    /* Three figures stay side by side: compact, no stacking */
    .fig-stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin: 0 0.75rem;
      padding: 1.1rem 0 1.4rem;
    }
    .fig-stat { padding: 0.25rem 0.35rem; gap: 0.4rem; }
    .fig-n { font-size: clamp(2.1rem, 11vw, 2.8rem); }
    .fig-label { letter-spacing: 0.06em; font-size: 0.625rem; text-align: center; line-height: 1.35; }
  }
</style>
