---
import { getHome } from '../data/content';
import { media } from '../data/media';
import Icon from './Icon.astro';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { figures } = getHome(locale);
---
<section class="fig" id="chiffres" data-figures-board>
  <div class="wrap fig-shell">
    <figure class="fig-media" data-reveal>
      <img src={media.day.src} alt={media.day.alt} loading="lazy" decoding="async" />
    </figure>

    <div class="fig-copy" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'المرحلة الأولى' : 'La première tranche'}</p>
      <h2 class="display">{figures.h2}</h2>
      <span class="fig-rule" aria-hidden="true"></span>
      <p class="lead">{figures.lead}</p>

    </div>
  </div>

  <div class="wrap">
    <div class="fig-stats" role="list" data-reveal>
      {figures.items.map((f, i) => (
        <div class="fig-stat" role="listitem" data-figures-item style={`--i: ${i}`}>
          <span class="fig-ico" aria-hidden="true"><Icon name={f.icon === 'home' ? 'house' : f.icon} size="1.6rem" /></span>
          <p class="fig-n" data-count data-to={f.n}>
            <span data-count-val>{f.n}</span>
          </p>
          <span class="fig-label">{f.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .fig {
    position: relative;
    z-index: 1;
    padding: clamp(3.5rem, 7vw, 6rem) 0;
    color: var(--ink);
    background: var(--cream);
  }

  .fig-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.95fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .fig-media {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 0 0 0 clamp(2rem, 5vw, 3.5rem);
  }
  .fig-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    display: block;
  }
  /* Soft fade into cream — matches the reference composition */
  .fig-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      transparent 48%,
      color-mix(in srgb, var(--cream) 40%, transparent) 70%,
      color-mix(in srgb, var(--cream) 88%, transparent) 88%,
      var(--cream)
    );
    pointer-events: none;
  }

  .fig-copy {
    display: grid;
    gap: 0.85rem;
    max-width: 34rem;
    justify-items: start;
  }
  .fig-copy .kick {
    margin: 0;
    color: var(--gold-text);
  }
  .fig-copy .display {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2rem, 3.6vw, 2.9rem);
    font-weight: 500;
    line-height: 1.12;
    letter-spacing: -0.02em;
    max-width: 14ch;
  }
  .fig-rule { display: none !important;
    display: block;
    width: 2.75rem;
    height: 1.5px;
    margin: 0.15rem 0 0.35rem;
    background: var(--gold);
  }
  .fig-copy .lead {
    margin: 0;
    color: var(--muted);
    line-height: 1.7;
    font-size: clamp(0.98rem, 1.15vw, 1.08rem);
    max-width: 36rem;
  }

  .fig-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin-top: clamp(2.5rem, 5vw, 4rem);
    padding: clamp(2rem, 4.5vw, 3.25rem) clamp(1rem, 3vw, 2.5rem);
    border-radius: var(--radius);
    background: var(--ink);
    color: var(--cream);
    text-align: center;
  }
  .fig-stat {
    display: grid;
    gap: 0.5rem;
    justify-items: center;
    align-content: start;
    padding-inline: 1rem;
  }
  .fig-ico {
    display: grid;
    place-items: center;
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 0.5rem;
    border: 1.25px solid var(--gold);
    border-radius: 50%;
    color: var(--gold-soft);
  }
  .fig-n {
    margin: 0;
    font-family: var(--display);
    font-weight: 200;
    font-size: clamp(3.5rem, 7vw, 5.5rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--paper);
  }
  .fig-n [data-count-val] { display: inline-block; }
  .fig-label {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-soft);
  }

  @media (max-width: 640px) {
    .fig-stats { grid-template-columns: 1fr; gap: 2rem; }
  }
  @media (max-width: 900px) {
    .fig-shell {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
    .fig-media {
      aspect-ratio: 16 / 11;
      border-radius: 0 0 0 2.25rem;
    }
    .fig-media::after {
      background: linear-gradient(
        to bottom,
        transparent 62%,
        color-mix(in srgb, var(--cream) 50%, transparent) 82%,
        var(--cream)
      );
    }
    .fig-copy {
      max-width: none;
    }
    .fig-copy .display {
      max-width: none;
      font-size: clamp(1.7rem, 7vw, 2.35rem);
    }
  }

  @media (max-width: 700px) {
    .fig-stats {
      grid-template-columns: 1fr;
      gap: 1.1rem;
      padding: 1.35rem 1.25rem;
    }
    .fig-stat {
      padding-inline: 0;
    }
    .fig-stat + .fig-stat {
      border-inline-start: 0;
      border-top: 0;
      padding-top: 1.1rem;
    }
    .fig-n { font-size: clamp(2.35rem, 10vw, 3rem); }
    .fig-label {
      letter-spacing: 0.1em;
      font-size: 0.75rem;
    }
  }
</style>
