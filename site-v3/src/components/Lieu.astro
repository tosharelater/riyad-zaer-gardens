---
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
import Icon from './Icon.astro';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { lieu } = getHome(locale);
---
<section class="lieu" id="lieu">
  <div class="wrap lieu-grid">
    <div class="lieu-copy" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'الموقع' : 'Localisation'}</p>
      <h2 class="display">{lieu.h2}</h2>
      <p class="lead">{lieu.body}</p>
      <p class="lieu-address"><Icon name="map-pin" />{lieu.address}</p>
      <a class="btn btn-ghost" href={lieu.cta.href} target="_blank" rel="noopener noreferrer">{lieu.cta.label}<Icon name="arrow-up-right" /></a>
    </div>
    <div class="lieu-map" data-reveal>
      <iframe
        title="Carte de situation de Riyad Zaer Gardens à Aïn Aouda"
        src={lieu.mapEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
        allowfullscreen
      ></iframe>
    </div>
  </div>
</section>

<style>
  .lieu {
    padding: var(--sec) 0;
    background: var(--cream);
  }
  .lieu-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: center;
  }
  .lieu-copy .display { margin: 1rem 0 0.25rem; max-width: 12ch; }
  .lieu-address {
    margin: 1.75rem 0;
    padding: 1rem 0;
    border-block: 1px solid var(--line);
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .lieu-address :global(.icon) { color: var(--gold-deep); }
  .lieu-map {
    aspect-ratio: 4 / 3;
    background: var(--bg);
  }
  .lieu-map iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    filter: grayscale(0.3);
  }
  @media (max-width: 900px) {
    .lieu-grid { grid-template-columns: 1fr; }
  }
</style>
