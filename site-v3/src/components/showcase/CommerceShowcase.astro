---
import PageHero from '../page/PageHero.astro';
import PageBand from '../page/PageBand.astro';
import Icon from '../Icon.astro';
import { media } from '../../data/media';
import { contactInfo } from '../../data/site';
import { localePath, type Locale } from '../../i18n/paths';
import { commercePage as comFr } from '../../data/pages';
import { commercePage as comAr } from '../../data/pages.ar';

interface Props {
  locale?: Locale;
}
const { locale = 'fr' } = Astro.props;
const p = locale === 'ar' ? comAr : comFr;
const L =
  locale === 'ar'
    ? {
        kick: 'المحلات التجارية',
        offer: 'العرض',
        reasons: 'لماذا هنا',
        invest: 'الاستثمار',
        call: 'اطلب اتصالاً',
        wa: 'واتساب',
        map: 'على الخريطة',
        mapTitle: 'Km 25، شارع محمد السادس',
        iframeTitle: 'خريطة — رياض زعير غاردنز',
        mapsCta: 'فتح في Google Maps',
      }
    : {
        kick: 'Fonds de commerce',
        offer: 'L’offre',
        reasons: 'Emplacement',
        invest: 'Investissement',
        call: 'Être rappelé',
        wa: 'Écrire sur WhatsApp',
        map: 'Sur la carte',
        mapTitle: 'Km 25, Avenue Mohammed VI',
        iframeTitle: 'Carte — Riyad Zaer Gardens',
        mapsCta: 'Ouvrir dans Google Maps',
      };

const keep = (t: string) => t.replace(/(\d) (?=\d|DH|m)/g, '$1 ');
// Icons follow the order of offre.rows and raisons.items in data/pages(.ar).ts
const factIcons = ['store', 'maximize-2', 'coins', 'map-pin', 'calendar-days'];
const reasonIcons = ['users', 'signpost', 'chart-column-increasing', 'car-front'];
---
<div data-com-page class="com-page">
  <PageHero
    h1={p.h1}
    lead={p.lead}
    kicker={L.kick}
    image="/photos/commerce-angle.webp"
    alt={media.commerce.alt}
  >
    <a class="btn btn-solid com-pill" href={localePath(locale, '/contact')}>{L.call} <Icon name="phone" size="1rem" /></a>
    <a class="btn btn-light com-pill" href={contactInfo.whatsapp} target="_blank" rel="noopener">{L.wa} <Icon name="message-circle" size="1rem" /></a>
  </PageHero>

  <section class="offer soft-band">
    <div class="wrap">
      <div class="text-photo offer-top">
        <header class="offer-head" data-reveal data-split>
          <p class="kick">{L.offer}</p>
          <h2 class="display">{p.offre.h2}</h2>
          <p class="lead">{p.offre.body}</p>
        </header>
        <figure data-media>
          <img src="/photos/commerce-trottoir.webp" alt={media.shops.alt} loading="lazy" decoding="async" />
        </figure>
      </div>

      <dl class="com-facts">
        {p.offre.rows.map(([k, v], i) => (
          <div>
            <span class="fact-icon" aria-hidden="true">
              <Icon name={factIcons[i] ?? 'store'} size="2rem" strokeWidth={1.3} />
            </span>
            <dt>{k}</dt>
            <dd>{keep(v)}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="reasons">
    <Icon name="leaf" size="26rem" strokeWidth={0.4} class="reasons-leaf" />
    <div class="wrap">
      <header class="reasons-head" data-reveal data-split>
        <p class="kick">{L.reasons}</p>
        <h2 class="display">{p.raisons.h2}</h2>
      </header>
      <ol class="reasons-grid">
        {p.raisons.items.map((item, i) => (
          <li class="reason" data-reason>
            <div class="reason-top" aria-hidden="true">
              <span class="reason-num">{String(i + 1).padStart(2, '0')}</span>
              <Icon name={reasonIcons[i] ?? 'store'} size="2.1rem" strokeWidth={1.3} class="reason-icon" />
            </div>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="invest">
    <div class="wrap text-photo">
      <div data-reveal data-split>
        <p class="kick">{L.invest}</p>
        <h2 class="display">{p.invest.h2}</h2>
        {p.invest.body.map((t) => <p class="lead">{t}</p>)}
      </div>
      <figure data-media>
        <img src="/photos/commerce-interieur.webp" alt={media.commerceIn.alt} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <PageBand
    mode="custom"
    title={p.convert.h2}
    body={p.convert.body}
    primary={{ label: L.call, href: localePath(locale, '/contact') }}
    secondary={{ label: L.wa, href: contactInfo.whatsapp }}
    image="/photos/commerce-angle.webp"
  />

  <section class="map">
    <div class="wrap map-grid">
      <div class="map-copy" data-reveal>
        <p class="kick">{L.map}</p>
        <h2 class="display">{L.mapTitle}</h2>
        <a class="btn btn-solid com-pill" href={contactInfo.mapsHref} target="_blank" rel="noopener">
          {L.mapsCta}
          <Icon name="arrow-right" size="1rem" class="map-arrow" />
        </a>
      </div>
      <div class="map-frame" data-map-frame>
        <iframe
          title={L.iframeTitle}
          src={contactInfo.mapEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</div>

<script>
  import '../../scripts/commerce-motion';
</script>

<style>
  .com-pill { border-radius: 99px; }

  /* L'offre: copy beside a photo, then the five key facts in one row */
  .offer {
    padding: var(--sec) 0;
  }
  .offer-head .display { margin: 1rem 0 0.25rem; max-width: none; }
  .offer-top > figure { aspect-ratio: 16 / 10; }
  .com-facts {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    margin-top: clamp(2.25rem, 4.5vw, 3.25rem);
  }
  .com-facts > div {
    display: grid;
    align-content: start;
    gap: 0.35rem;
    min-width: 0;
    padding: 0.25rem clamp(1rem, 2vw, 1.75rem);
  }
  .com-facts > div:first-child { padding-inline-start: 0; }
  .com-facts > div + div { border-inline-start: 1px solid var(--line); }
  .fact-icon {
    color: var(--gold-text);
    margin-bottom: 0.65rem;
  }
  .com-facts dt {
    font-size: 0.85rem;
    color: var(--muted);
  }
  .com-facts dd {
    margin: 0;
    font-weight: 500;
    font-size: clamp(1.05rem, 1.6vw, 1.3rem);
    line-height: 1.3;
    color: var(--ink);
    text-wrap: balance;
  }

  /* Emplacement: four cards on deep green */
  .reasons {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: var(--sec) 0;
    background:
      radial-gradient(45% 60% at 100% 0%, rgb(200 181 104 / 0.12), transparent 60%),
      var(--canopy);
    color: var(--cream);
  }
  .reasons :global(.reasons-leaf) {
    position: absolute;
    z-index: -1;
    inset-inline-end: -6rem;
    top: -5rem;
    color: rgb(217 201 135 / 0.08);
    transform: rotate(150deg);
    pointer-events: none;
  }
  .reasons .kick { color: var(--gold-soft); }
  .reasons .display { color: var(--paper); }
  .reasons-head { margin-bottom: var(--head-gap); }
  .reasons-head .display { margin-top: 1rem; max-width: none; }
  .reasons-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.85rem, 1.6vw, 1.15rem);
  }
  .reason {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: clamp(1.25rem, 2vw, 1.6rem);
    border-radius: var(--radius);
    border: 1px solid var(--line-on-dark);
    background: rgb(255 252 244 / 0.04);
    transition: border-color 0.3s var(--ease), background 0.3s var(--ease);
  }
  .reason:hover {
    border-color: rgb(217 201 135 / 0.4);
    background: rgb(255 252 244 / 0.07);
  }
  .reason-top {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }
  .reason-num {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    font-size: 0.75rem;
    font-weight: 600;
  }
  .reason-top :global(.reason-icon) { color: var(--gold-soft); }
  .reason h3 {
    font-weight: 500;
    font-size: 1.05rem;
    line-height: 1.3;
    color: var(--paper);
  }
  .reason p {
    font-size: 0.9rem;
    color: var(--muted-on-dark);
    line-height: 1.6;
  }

  .invest {
    padding: var(--sec) 0;
    background: var(--paper);
  }

  /* Sur la carte: address and link beside a rounded map */
  .map {
    padding: var(--sec) 0;
    background: var(--cream);
  }
  .map-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: var(--gap);
    align-items: center;
  }
  .map-copy .display { margin: 1rem 0 1.5rem; max-width: none; }
  :global([dir='rtl']) .map-copy :global(.map-arrow) { transform: scaleX(-1); }
  .map-frame {
    height: clamp(18rem, 32vw, 24rem);
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    filter: grayscale(0.25) sepia(0.08);
  }

  @media (max-width: 1100px) {
    .com-facts { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: 1.75rem; }
    .com-facts > div:nth-child(4) { padding-inline-start: 0; border-inline-start: 0; }
    .reasons-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 900px) {
    .com-facts { grid-template-columns: 1fr 1fr; }
    .com-facts > div { padding-inline: 0 1rem; }
    .com-facts > div + div { border-inline-start: 0; }
    .reasons-grid { grid-template-columns: 1fr; }
    .map-grid { grid-template-columns: 1fr; }
  }
</style>
