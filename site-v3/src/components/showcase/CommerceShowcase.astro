---
import PageHero from '../page/PageHero.astro';
import PageBand from '../page/PageBand.astro';
import FactTable from '../page/FactTable.astro';
import { media } from '../../data/media';
import { contactInfo } from '../../data/site';
import { localePath, type Locale } from '../../i18n/paths';
import { commercePage as comFr } from '../../data/pages';
import { commercePage as comAr } from '../../data/pages.ar';

interface Props {
  locale?: Locale;
}
const { locale = 'fr' } = Astro.props;
const p = locale === 'ar' ? comAr : comFr;
const L =
  locale === 'ar'
    ? {
        kick: 'المحلات التجارية',
        offer: 'العرض',
        reasons: 'لماذا هنا',
        invest: 'الاستثمار',
        call: 'اطلب اتصالاً',
        wa: 'واتساب',
        map: 'على الخريطة',
        mapTitle: 'Km 25، شارع محمد السادس',
        iframeTitle: 'خريطة — رياض زعير غاردنز',
        mapsCta: 'فتح في Google Maps',
      }
    : {
        kick: 'Fonds de commerce',
        offer: 'L’offre',
        reasons: 'Emplacement',
        invest: 'Investissement',
        call: 'Être rappelé',
        wa: 'Écrire sur WhatsApp',
        map: 'Sur la carte',
        mapTitle: 'Km 25, Avenue Mohammed VI',
        iframeTitle: 'Carte — Riyad Zaer Gardens',
        mapsCta: 'Ouvrir dans Google Maps',
      };
---
<div data-com-page class="com-page">
  <PageHero
    h1={p.h1}
    lead={p.lead}
    kicker={L.kick}
    image="/photos/commerce-angle.jpg"
    alt={media.commerce.alt}
  />

  <section class="offer">
    <div class="wrap offer-grid">
      <div data-reveal data-split>
        <p class="kick">{L.offer}</p>
        <h2 class="display">{p.offre.h2}</h2>
        <p class="lead">{p.offre.body}</p>
      </div>
      <div data-reveal>
        <FactTable rows={p.offre.rows} />
      </div>
    </div>
  </section>

  <section class="reasons">
    <div class="wrap">
      <header class="reasons-head" data-reveal data-split>
        <p class="kick">{L.reasons}</p>
        <h2 class="display">{p.raisons.h2}</h2>
      </header>
      <ol class="reasons-grid">
        {p.raisons.items.map((item, i) => (
          <li class="reason" data-reason>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="invest">
    <div class="wrap text-photo">
      <div data-reveal data-split>
        <p class="kick">{L.invest}</p>
        <h2 class="display">{p.invest.h2}</h2>
        {p.invest.body.map((t) => <p class="lead">{t}</p>)}
      </div>
      <figure data-media>
        <img src="/photos/commerce-interieur.jpg" alt={media.commerceIn.alt} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <PageBand
    mode="custom"
    title={p.convert.h2}
    body={p.convert.body}
    primary={{ label: L.call, href: localePath(locale, '/contact') }}
    secondary={{ label: L.wa, href: contactInfo.whatsapp }}
    image="/photos/commerce-angle.jpg"
  />

  <section class="map">
    <div class="map-frame" data-map-frame>
      <iframe
        title={L.iframeTitle}
        src={contactInfo.mapEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
    <div class="map-card" data-reveal>
      <p class="kick">{L.map}</p>
      <h2>{L.mapTitle}</h2>
      <a class="btn btn-solid" href={contactInfo.mapsHref} target="_blank" rel="noopener">{L.mapsCta}</a>
    </div>
  </section>
</div>

<script>
  import '../../scripts/commerce-motion';
</script>

<style>
  .offer {
    padding: var(--sec) 0;
    background: var(--cream);
  }
  .offer-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap);
    align-items: start;
  }
  .offer .display { margin: 1rem 0 0.25rem; max-width: none; }

  .reasons {
    background: var(--ink);
    color: var(--cream);
    padding: var(--sec) 0;
  }
  .reasons .kick { color: var(--gold-soft); }
  .reasons .display { color: var(--cream); }
  .reasons .lead { color: var(--muted-on-dark); }
  .reasons-head { margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .reasons-head .display { margin-top: 1rem; max-width: none; }
  .reasons-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.75rem, 4vw, 3rem) clamp(2rem, 6vw, 6rem);
  }
  .reason {
    display: grid;
    align-content: start;
    row-gap: 0.6rem;
  }
  .reason-num {
    grid-row: 1 / span 2;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--gold-soft);
    padding-top: 0.35rem;
  }
  .reason h3 {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.2;
  }
  .reason p {
    color: var(--muted-on-dark);
    line-height: 1.7;
  }

  .invest {
    padding: var(--sec) 0;
    background: var(--paper);
  }

  .map {
    position: relative;
    background: var(--ink);
  }
  .map-frame {
    height: min(70svh, 38rem);
    overflow: hidden;
  }
  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    filter: grayscale(0.4) contrast(1.05) sepia(0.12);
  }
  .map-card {
    position: absolute;
    inset-inline-start: max(var(--pad), calc((100% - var(--wrap)) / 2));
    bottom: clamp(2rem, 4vw, 3rem);
    width: min(26rem, calc(100% - 2 * var(--pad)));
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--cream);
    display: grid;
    gap: 0.85rem;
    border-radius: var(--radius);
    box-shadow: 0 10px 40px rgb(0 36 34 / 0.18);
  }
  .map-card h2 {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    line-height: 1.1;
  }
  .map-card .btn { justify-self: start; margin-top: 0.5rem; }

  @media (max-width: 900px) {
    .offer-grid { grid-template-columns: 1fr; }
    .reasons-grid { grid-template-columns: 1fr; }
    .map-frame { height: min(60svh, 32rem); }
    .map-card { position: relative; inset: auto; width: auto; }
  }
</style>
