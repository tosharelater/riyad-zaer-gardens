---
import PageHero from '../page/PageHero.astro';
import Icon from '../Icon.astro';
import PageBand from '../page/PageBand.astro';
import MoreLinks from '../page/MoreLinks.astro';
import FactTable from '../page/FactTable.astro';
import { media } from '../../data/media';
import { contactInfo } from '../../data/site';
import { localePath, type Locale } from '../../i18n/paths';
import { commercePage as comFr } from '../../data/pages';
import { commercePage as comAr } from '../../data/pages.ar';

interface Props {
  locale?: Locale;
}
const { locale = 'fr' } = Astro.props;
const p = locale === 'ar' ? comAr : comFr;
const L =
  locale === 'ar'
    ? {
        kick: 'المحلات التجارية',
        offer: 'العرض',
        reasons: 'لماذا هنا',
        invest: 'الاستثمار',
        call: 'اطلب اتصالاً',
        wa: 'واتساب',
        lots: 'محلات',
        perM2: 'للمتر المربع، ابتداءً من',
        dh: '15 000 درهم',
        delivery: 'التسليم',
      }
    : {
        kick: 'Fonds de commerce',
        offer: 'L’offre',
        reasons: 'Emplacement',
        invest: 'Investissement',
        call: 'Être rappelé',
        wa: 'Écrire sur WhatsApp',
        lots: 'locaux',
        perM2: 'le m², à partir de',
        dh: '15 000 DH',
        delivery: 'livraison',
      };

const moreLinks = p.more.links.map((l) => ({ ...l, href: localePath(locale, l.href) }));
/** Same order as the reasons in the data */
const reasonIcons = ['users', 'signpost', 'trending-up', 'square-parking'];
---
<div data-com-page class="com-page">
  <PageHero
    h1={p.h1}
    lead={p.lead}
    kicker={L.kick}
    image="/photos/commerces-jour.jpg"
    alt={media.commerce.alt}
    facts={[
      { n: '49', l: L.lots, count: 49 },
      { n: '13–30', l: 'm²' },
      { n: L.dh, l: L.perM2 },
      { n: '2028', l: L.delivery },
    ]}
  />

  <section class="offer">
    <div class="wrap offer-grid">
      <div data-reveal data-split>
        <p class="kick">{L.offer}</p>
        <h2 class="display">{p.offre.h2}</h2>
        <p class="lead">{p.offre.body}</p>
      </div>
      <div data-reveal>
        <FactTable rows={p.offre.rows} />
      </div>
    </div>
  </section>

  <section class="reasons">
    <div class="wrap">
      <header class="reasons-head" data-reveal data-split>
        <p class="kick">{L.reasons}</p>
        <h2 class="display">{p.raisons.h2}</h2>
      </header>
      <ol class="reasons-grid">
        {p.raisons.items.map((item, i) => (
          <li class="reason" data-reason>
            <span class="reason-num"><Icon name={reasonIcons[i] ?? 'check'} size="1.5rem" /></span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="invest">
    <div class="wrap text-photo">
      <div data-reveal data-split>
        <p class="kick">{L.invest}</p>
        <h2 class="display">{p.invest.h2}</h2>
        {p.invest.body.map((t) => <p class="lead">{t}</p>)}
      </div>
      <figure data-media>
        <img src="/photos/facade-soir.jpg" alt={media.commerce.alt} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <PageBand
    mode="custom"
    title={p.convert.h2}
    body={p.convert.body}
    primary={{ label: L.call, href: localePath(locale, '/contact') }}
    secondary={{ label: L.wa, href: contactInfo.whatsapp }}
  />
  <MoreLinks h2={p.more.h2} links={moreLinks} />
</div>

<script>
  import '../../scripts/commerce-motion';
</script>

<style>
  .offer {
    padding: var(--sec) 0;
    background: var(--bg);
  }
  .offer-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: end;
  }
  .offer .display { margin: 1rem 0 0.25rem; max-width: 12ch; }

  /* Reasons — 2 × 2, numbered */
  .reasons {
    background: var(--cream);
    padding: var(--sec) 0;
  }
  .reasons-head { margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .reasons-head .display { margin-top: 1rem; max-width: 16ch; }
  .reasons-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(2rem, 6vw, 6rem);
    border-top: 1px solid var(--line);
  }
  .reason {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: 1rem;
    row-gap: 0.6rem;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .reason-num {
    grid-row: 1 / span 2;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--gold-deep);
    padding-top: 0.1rem;
  }
  .reason h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.2;
  }
  .reason p {
    color: var(--muted);
    line-height: 1.7;
  }

  .invest {
    padding: var(--sec) 0;
    background: var(--bg);
  }

  @media (max-width: 900px) {
    .offer-grid { grid-template-columns: 1fr; }
    .reasons-grid { grid-template-columns: 1fr; }
  }
</style>
