---
import PageHero from '../page/PageHero.astro';
import Icon from '../Icon.astro';
import PageBand from '../page/PageBand.astro';
import FactTable from '../page/FactTable.astro';
import { media } from '../../data/media';
import { contactInfo } from '../../data/site';
import { localePath, type Locale } from '../../i18n/paths';
import { appartementsPage as aptFr } from '../../data/pages';
import { appartementsPage as aptAr } from '../../data/pages.ar';

interface Props {
  locale?: Locale;
}
const { locale = 'fr' } = Astro.props;
const p = locale === 'ar' ? aptAr : aptFr;
const L =
  locale === 'ar'
    ? {
        kick: 'الشقق',
        types: 'الأنواع',
        inclus: 'عند التسليم',
        finish: 'التشطيبات',
        price: 'الأسعار',
        without: 'بدون دعم',
        withAid: 'مع دعم السكن',
        leadTitle: 'احصلوا على الكتيّب والأسعار',
        leadBody: 'مستشار يتصل بكم مع الشقق المتاحة وتفاصيل التشطيبات.',
        map: 'على الخريطة',
        mapTitle: 'Km 25، شارع محمد السادس',
        iframeTitle: 'خريطة — رياض زعير غاردنز',
        mapsCta: 'فتح في Google Maps',
      }
    : {
        kick: 'Appartements',
        types: 'Typologies',
        inclus: 'Livraison',
        finish: 'Finitions',
        price: 'Prix',
        without: 'Sans aide',
        withAid: 'Avec l’aide au logement',
        leadTitle: 'Recevoir la brochure et les prix',
        leadBody: 'Un conseiller vous rappelle avec les lots disponibles et le détail des prestations.',
        map: 'Sur la carte',
        mapTitle: 'Km 25, Avenue Mohammed VI',
        iframeTitle: 'Carte — Riyad Zaer Gardens',
        mapsCta: 'Ouvrir dans Google Maps',
      };

const withoutLabel = 'withoutLabel' in p.prix ? (p.prix as { withoutLabel: string }).withoutLabel : L.without;
const withAidLabel = 'withAidLabel' in p.prix ? (p.prix as { withAidLabel: string }).withAidLabel : L.withAid;
const keep = (t: string) => t.replace(/(\d) (?=\d|DH|درهم)/g, '$1 ');
const figures = 'figures' in p ? p.figures : null;
---
<div data-apt-page class="apt-page">
  <PageHero
    h1={p.h1}
    lead={p.lead}
    kicker={L.kick}
    image="/photos/salon.jpg"
    alt={media.apartment.alt}
    position="center 45%"
    compact
  />

  {figures && (
    <section class="figures">
      <div class="wrap figures-grid">
        {figures.map((f) => (
          <div class="figure" data-reveal>
            <strong>{f.n}</strong>
            <span>{f.label}</span>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="types">
    <div class="wrap">
      <header class="head-split types-head" data-reveal data-split>
        <p class="kick">{L.types}</p>
        <h2 class="display">{p.types.h2}</h2>
        <p class="lead">{p.types.note}</p>
      </header>

      <div class="types-grid">
        {p.types.items.map((item) => {
          return (
            <article class="type" data-type>
              <p class="type-mark" aria-hidden="true">{'mark' in item ? item.mark : item.title.replace(/.* /, '')}</p>
              <div class="type-body">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
                {item.surface && <p class="type-surface">{item.surface}</p>}
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <section class="inclus" data-inclus>
    <div class="wrap text-photo">
      <div data-reveal data-split>
        <p class="kick">{L.inclus}</p>
        <h2 class="display">{p.inclus.h2}</h2>
        <p class="lead">{p.inclus.body}</p>
        <ul class="ruled" data-ruled>
          {p.inclus.list.map((item) => <li><span class="tick"><Icon name="check" size="1rem" /></span>{item}</li>)}
        </ul>
      </div>
      <div class="inclus-photos">
        <figure data-media><img src="/photos/salon-balcon.jpg" alt="Salon" loading="lazy" decoding="async" /></figure>
        <figure data-media><img src="/photos/salon-coin.jpg" alt="Coin salon" loading="lazy" decoding="async" /></figure>
        <figure data-media class="is-wide"><img src="/photos/cuisine.jpg" alt="Cuisine" loading="lazy" decoding="async" /></figure>
      </div>
    </div>
  </section>

  <section class="finish" id="finitions">
    <div class="wrap finish-grid">
      <div class="finish-copy" data-reveal data-split>
        <p class="kick">{L.finish}</p>
        <h2 class="display">{p.finitions.h2}</h2>
        <p class="lead">{p.finitions.body}</p>
        <p class="fin-end">{p.finitions.end}</p>
        <a class="btn btn-ghost" href={localePath(locale, p.finitions.cta.href)}>{p.finitions.cta.label}</a>
      </div>
      <div data-reveal>
        <FactTable rows={p.finitions.rows} />
      </div>
    </div>
  </section>

  <section class="prix" data-prix>
    <div class="wrap prix-grid">
      <div data-reveal data-split>
        <p class="kick">{L.price}</p>
        <h2 class="display">{p.prix.h2}</h2>
        {p.prix.body.map((t) => <p class="lead">{t}</p>)}
        <a class="btn btn-solid" href={localePath(locale, p.prix.cta.href)}>{p.prix.cta.label}</a>
      </div>
      <aside class="prix-ticket" aria-label={L.price}>
        <div class="is-before">
          <span>{withoutLabel}</span>
          <strong data-price-from>{keep(p.prix.without)}</strong>
        </div>
        <div class="is-aid">
          <span>{withAidLabel}</span>
          <strong data-price-to>{keep(p.prix.withAid)}</strong>
        </div>
      </aside>
    </div>
  </section>

  <PageBand
    mode="custom"
    title={L.leadTitle}
    body={L.leadBody}
    primary={{ label: p.prix.cta.label, href: localePath(locale, '/contact') }}
    image="/photos/chambre-enfants.jpg"
  />

  <section class="map">
    <div class="map-frame" data-map-frame>
      <iframe
        title={L.iframeTitle}
        src={contactInfo.mapEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
    <div class="map-card" data-reveal>
      <p class="kick">{L.map}</p>
      <h2>{L.mapTitle}</h2>
      <a class="btn btn-solid" href={contactInfo.mapsHref} target="_blank" rel="noopener">{L.mapsCta}</a>
    </div>
  </section>
</div>

<script>
  import '../../scripts/appartements-motion';
</script>

<style>
  .figures {
    padding: clamp(2.75rem, 5.5vw, 4.5rem) 0;
    background: var(--cream);
  }
  .figures-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
  }
  .figure {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    align-content: start;
  }
  .figure strong {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .figure > span:last-child {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--muted);
  }
  @media (max-width: 800px) {
    .figures-grid { grid-template-columns: 1fr 1fr; }
  }

  .types {
    padding: var(--sec) 0;
    background: var(--paper);
  }
  .types-head { margin-bottom: clamp(3rem, 6vw, 5rem); }
  .types-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--gap);
  }
  .type {
    padding: 0;
  }
  .type-mark {
    font-weight: 300;
    font-family: var(--display);
    font-size: clamp(5.5rem, 12vw, 10rem);
    line-height: 0.88;
    letter-spacing: -0.05em;
    color: var(--gold-text);
    transition: color 0.3s ease;
  }
  .type:hover .type-mark { color: var(--canopy); }
  .type-body {
    display: grid;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    max-width: 30rem;
  }
  .type-body h3 {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.1;
  }
  .type-body > p:not(.type-surface) {
    color: var(--muted);
    line-height: 1.7;
  }
  .type-surface {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--ink);
  }

  .inclus {
    padding: var(--sec) 0;
    background: var(--ink);
    color: var(--cream);
  }
  .inclus .kick { color: var(--gold-soft); }
  .inclus .lead { color: var(--muted-on-dark); }
  .inclus .display { color: var(--cream); margin: 1rem 0 0.25rem; max-width: none; }
  .ruled {
    display: grid;
    gap: 0.85rem;
  }
  .ruled li {
    display: grid;
    grid-template-columns: 1.5rem 1fr;
    gap: 0.75rem;
    line-height: 1.5;
    align-items: start;
  }
  .ruled span {
    color: color-mix(in srgb, var(--cream) 45%, transparent);
    padding-top: 0.15rem;
  }

  .finish {
    padding: var(--sec) 0;
    background: var(--paper);
  }
  .finish-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap);
    align-items: start;
  }
  .finish-copy { position: sticky; top: calc(var(--nav) + 2rem); }
  .finish .display { margin: 1rem 0 0.25rem; max-width: none; }
  .fin-end {
    margin: 1.25rem 0 1.75rem;
    color: var(--muted);
    line-height: 1.65;
    max-width: 34rem;
  }

  .prix {
    padding: var(--sec) 0;
    background: var(--cream);
    color: var(--ink);
  }
  .prix-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap);
    align-items: start;
  }
  .prix .display { margin: 1rem 0 0.25rem; max-width: none; }
  .prix .lead + .lead { margin-top: 0.75rem; }
  .prix .btn { margin-top: 2rem; }
  .prix-ticket {
    display: grid;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }
  .prix-ticket > div {
    padding: 0;
  }
  .prix-ticket span {
    display: block;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--canopy);
    margin-bottom: 0.6rem;
  }
  .prix-ticket strong {
    display: block;
    font-family: var(--display);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.05;
  }
  .prix-ticket .is-before strong {
    font-size: clamp(1.3rem, 2vw, 1.6rem);
    color: color-mix(in srgb, var(--ink) 45%, transparent);
    text-decoration: line-through;
    text-decoration-thickness: 1px;
  }
  .prix-ticket .is-aid span { color: var(--canopy); }
  .prix-ticket .is-aid strong {
    font-size: clamp(2.2rem, 4.2vw, 3.6rem);
    color: var(--ink);
  }

  .map {
    position: relative;
    background: var(--ink);
  }
  .map-frame {
    height: min(70svh, 38rem);
    overflow: hidden;
  }
  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    filter: grayscale(0.4) contrast(1.05) sepia(0.12);
  }
  .map-card {
    position: absolute;
    inset-inline-start: var(--pad);
    bottom: var(--pad);
    width: min(26rem, calc(100% - 2 * var(--pad)));
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--cream);
    display: grid;
    gap: 0.85rem;
    border-radius: var(--radius);
    box-shadow: 0 10px 40px rgb(0 36 34 / 0.18);
  }
  .map-card h2 {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    line-height: 1.1;
  }
  .map-card .btn { justify-self: start; margin-top: 0.5rem; }

  @media (max-width: 900px) {
    .figures-grid { grid-template-columns: 1fr 1fr; }
    .types-grid,
    .finish-grid,
    .prix-grid { grid-template-columns: 1fr; }
    .finish-copy { position: static; }
    .map-frame { height: min(60svh, 32rem); }
    .map-card { position: relative; inset: auto; width: auto; }
  }
  .inclus-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    align-items: start;
  }
  .inclus-photos figure { margin: 0; aspect-ratio: 3 / 4; overflow: hidden; }
  .inclus-photos figure:first-child { margin-bottom: clamp(2rem, 6vw, 5rem); }
  .inclus-photos figure.is-wide {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 10;
    margin-bottom: 0;
  }
  .inclus-photos img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .inclus-photos figure:hover img { transform: scale(1.02); }
  .ruled { margin-top: 1.75rem; }
</style>
