---
import PageHero from '../page/PageHero.astro';
import PageBand from '../page/PageBand.astro';
import Icon from '../Icon.astro';
import { media } from '../../data/media';
import { contactInfo } from '../../data/site';
import { localePath, type Locale } from '../../i18n/paths';
import { appartementsPage as aptFr } from '../../data/pages';
import { appartementsPage as aptAr } from '../../data/pages.ar';

interface Props {
  locale?: Locale;
}
const { locale = 'fr' } = Astro.props;
const p = locale === 'ar' ? aptAr : aptFr;
const L =
  locale === 'ar'
    ? {
        kick: 'الشقق',
        types: 'الأنواع',
        inclus: 'عند التسليم',
        finish: 'التشطيبات',
        price: 'الأسعار',
        without: 'بدون دعم',
        withAid: 'مع دعم السكن',
        leadTitle: 'احصلوا على الكتيّب والأسعار',
        leadBody: 'مستشار يتصل بكم مع الشقق المتاحة وتفاصيل التشطيبات.',
        map: 'على الخريطة',
        mapTitle: 'Km 25، شارع محمد السادس',
        iframeTitle: 'خريطة — رياض زعير غاردنز',
        mapsCta: 'فتح في Google Maps',
      }
    : {
        kick: 'Appartements',
        types: 'Typologies',
        inclus: 'Livraison',
        finish: 'Finitions',
        price: 'Prix',
        without: 'Sans aide',
        withAid: 'Avec l’aide au logement',
        leadTitle: 'Recevoir la brochure et les prix',
        leadBody: 'Un conseiller vous rappelle avec les lots disponibles et le détail des prestations.',
        map: 'Sur la carte',
        mapTitle: 'Km 25, Avenue Mohammed VI',
        iframeTitle: 'Carte — Riyad Zaer Gardens',
        mapsCta: 'Ouvrir dans Google Maps',
      };

const withoutLabel = 'withoutLabel' in p.prix ? (p.prix as { withoutLabel: string }).withoutLabel : L.without;
const withAidLabel = 'withAidLabel' in p.prix ? (p.prix as { withAidLabel: string }).withAidLabel : L.withAid;
const keep = (t: string) => t.replace(/(\d) (?=\d|DH|درهم)/g, '$1 ');
const figures = 'figures' in p ? p.figures : null;
// Icons and photos follow the order of the items in data/pages(.ar).ts
const figureIcons: Record<string, string> = { home: 'house', calendar: 'calendar-days' };
const typePhotos = ['/photos/chambre.webp', '/photos/chambre-enfants-2.webp'];
const inclusIcons = ['lamp-ceiling', 'app-window', 'arrow-up-down', 'shield-check', 'trees', 'circle-parking'];
const finishIcons = ['grid-2x2', 'bath', 'app-window', 'blinds', 'door-open', 'lamp-ceiling', 'cooking-pot', 'lightbulb'];
---
<div data-apt-page class="apt-page">
  <PageHero
    h1={p.h1}
    lead={p.lead}
    kicker={L.kick}
    image="/photos/salon.webp"
    alt={media.apartment.alt}
    position="center 45%"
  >
    <a class="btn btn-solid" href={localePath(locale, '/contact')}>{locale === 'ar' ? 'احصلوا على الكتيّب' : 'Recevoir la brochure'}</a>
    <a class="btn btn-light" href={localePath(locale, '/contact')}>{locale === 'ar' ? 'اطلب اتصالاً' : 'Être rappelé'}</a>
  </PageHero>

  {figures && (
    <section class="figures soft-band">
      <div class="wrap figures-grid">
        {figures.map((f) => (
          <div class="figure" data-reveal>
            <Icon name={figureIcons[f.icon] ?? f.icon} size="2.2rem" strokeWidth={1.3} class="figure-icon" />
            <div>
              <strong>{f.n}</strong>
              <span>{f.label}</span>
            </div>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="types">
    <div class="wrap">
      <header class="head-split types-head" data-reveal data-split>
        <p class="kick">{L.types}</p>
        <h2 class="display">{p.types.h2}</h2>
        <p class="lead">{p.types.note}</p>
      </header>

      <div class="types-grid">
        {p.types.items.map((item, i) => (
          <article class="type" data-type>
            <div class="type-copy">
              <p class="type-mark" aria-hidden="true">{'mark' in item ? item.mark : item.title.replace(/.* /, '')}</p>
              <div class="type-body">
                <h3>{item.title}</h3>
                <p>{item.body}</p>
                {item.surface && <p class="type-surface">{item.surface}</p>}
              </div>
            </div>
            <figure class="type-media">
              <img src={typePhotos[i] ?? media.apartment.src} alt="" loading="lazy" decoding="async" />
            </figure>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="inclus" data-inclus>
    <div class="wrap text-photo">
      <div data-reveal data-split>
        <p class="kick">{L.inclus}</p>
        <h2 class="display">{p.inclus.h2}</h2>
        <p class="lead">{p.inclus.body}</p>
        <ul class="ruled" data-ruled>
          {p.inclus.list.map((item, i) => (
            <li>
              <span class="ruled-icon" aria-hidden="true">
                <Icon name={inclusIcons[i] ?? 'check'} size="0.95rem" strokeWidth={1.8} />
              </span>
              {item}
            </li>
          ))}
        </ul>
      </div>
      <div class="inclus-photos">
        <figure data-media><img src="/photos/salon-balcon.webp" alt="Salon" loading="lazy" decoding="async" /></figure>
        <figure data-media><img src="/photos/salon-coin.webp" alt="Coin salon" loading="lazy" decoding="async" /></figure>
        <figure data-media class="is-wide"><img src="/photos/cuisine.webp" alt="Cuisine" loading="lazy" decoding="async" /></figure>
      </div>
    </div>
  </section>

  <section class="finish" id="finitions">
    <div class="wrap finish-grid">
      <div class="finish-copy" data-reveal data-split>
        <p class="kick">{L.finish}</p>
        <h2 class="display">{p.finitions.h2}</h2>
        <p class="lead">{p.finitions.body}</p>
        <p class="fin-end">{p.finitions.end}</p>
        <a class="btn btn-ghost apt-pill" href={localePath(locale, p.finitions.cta.href)}>
          {p.finitions.cta.label}
          <Icon name="arrow-right" size="1rem" class="apt-arrow" />
        </a>
      </div>
      <dl class="fin-rows">
        {p.finitions.rows.map(([k, v], i) => (
          <div>
            <dt>
              <Icon name={finishIcons[i] ?? 'check'} size="1.2rem" strokeWidth={1.5} class="fin-icon" />
              {k}
            </dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="prix" data-prix>
    <div class="wrap prix-grid">
      <div data-reveal data-split>
        <p class="kick">{L.price}</p>
        <h2 class="display">{p.prix.h2}</h2>
        {p.prix.body.map((t) => <p class="lead">{t}</p>)}
        <a class="btn btn-solid" href={localePath(locale, p.prix.cta.href)}>
          {p.prix.cta.label}
          <Icon name="arrow-right" size="1rem" class="apt-arrow" />
        </a>
      </div>
      <aside class="prix-ticket" aria-label={L.price}>
        <div class="is-before">
          <Icon name="coins" size="2.2rem" strokeWidth={1.3} class="prix-icon" />
          <div>
            <span>{withoutLabel}</span>
            <strong data-price-from>{keep(p.prix.without)}</strong>
          </div>
        </div>
        <div class="is-aid">
          <Icon name="house-plus" size="2.2rem" strokeWidth={1.3} class="prix-icon" />
          <div>
            <span>{withAidLabel}</span>
            <strong data-price-to>{keep(p.prix.withAid)}</strong>
          </div>
        </div>
      </aside>
    </div>
  </section>

  <PageBand
    mode="custom"
    title={L.leadTitle}
    body={L.leadBody}
    primary={{ label: p.prix.cta.label, href: localePath(locale, '/contact') }}
    image="/photos/chambre-enfants.webp"
  />

  <section class="map">
    <div class="wrap map-grid">
      <div class="map-copy" data-reveal>
        <p class="kick">{L.map}</p>
        <h2 class="display">{L.mapTitle}</h2>
        <p class="map-addr">
          <Icon name="map-pin" size="1.35rem" strokeWidth={1.5} class="map-pin" />
          {contactInfo.address}
        </p>
        <a class="btn btn-solid apt-pill" href={contactInfo.mapsHref} target="_blank" rel="noopener">
          {L.mapsCta}
          <Icon name="arrow-right" size="1rem" class="apt-arrow" />
        </a>
      </div>
      <div class="map-frame" data-map-frame>
        <iframe
          title={L.iframeTitle}
          src={contactInfo.mapEmbed}
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
        ></iframe>
      </div>
    </div>
  </section>
</div>

<script>
  import '../../scripts/appartements-motion';
</script>

<style>
  .apt-pill { border-radius: 99px; }
  :global([dir='rtl']) .apt-page :global(.apt-arrow) { transform: scaleX(-1); }

  /* Key figures: icon, number, label, split by thin rules */
  .figures {
    padding: clamp(2rem, 4vw, 3rem) 0;
  }
  .figures-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }
  .figure {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.35rem clamp(1rem, 2.5vw, 2rem);
  }
  .figure:first-child { padding-inline-start: 0; }
  .figure + .figure { border-inline-start: 1px solid var(--line); }
  .figure :global(.figure-icon) { color: var(--gold-text); }
  .figure strong {
    display: block;
    font-weight: 500;
    font-size: clamp(1.3rem, 2.2vw, 1.65rem);
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .figure span {
    display: block;
    margin-top: 0.3rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }

  /* Typologies: one card per type, mark and copy beside a photo */
  .types {
    padding: var(--sec) 0;
    background: var(--paper);
  }
  .types-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1rem, 2vw, 1.5rem);
  }
  .type {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr);
    gap: clamp(1rem, 2vw, 1.5rem);
    align-items: center;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border-radius: var(--radius);
    background: var(--cream);
    border: 1px solid var(--line);
  }
  .type-mark {
    font-weight: 500;
    font-family: var(--display);
    font-size: clamp(3rem, 5.5vw, 4.5rem);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--gold-text);
  }
  .type-body {
    display: grid;
    gap: 0.6rem;
    margin-top: 1.1rem;
  }
  .type-body h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.15rem, 1.7vw, 1.4rem);
    line-height: 1.2;
  }
  .type-body > p:not(.type-surface) {
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.6;
  }
  .type-surface {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--ink);
  }
  .type-media {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: calc(var(--radius) - 4px);
    box-shadow: 0 12px 30px rgb(0 45 45 / 0.12);
  }
  .type-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .type:hover .type-media img { transform: scale(1.04); }

  /* Livraison: what comes with the keys, each with a gold icon */
  .inclus {
    padding: var(--sec) 0;
    background: var(--cream);
    color: var(--ink);
  }
  .inclus .kick { color: var(--gold-text); }
  .inclus .display { margin: 1rem 0 0.25rem; max-width: none; }
  .ruled {
    display: grid;
    gap: 0.85rem;
    margin-top: 1.75rem;
  }
  .ruled li {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    line-height: 1.45;
  }
  .ruled-icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 50%;
    background: var(--gold);
    color: var(--ink);
  }
  .inclus-photos {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(0.75rem, 1.5vw, 1rem);
  }
  .inclus-photos figure { margin: 0; aspect-ratio: 4 / 4.4; overflow: hidden; }
  .inclus-photos figure.is-wide { grid-column: 1 / -1; aspect-ratio: 16 / 9; }
  .inclus-photos img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .inclus-photos figure:hover img { transform: scale(1.02); }

  /* Finitions: copy beside an icon list of materials */
  .finish {
    padding: var(--sec) 0;
    background: var(--paper);
  }
  .finish-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap);
    align-items: start;
  }
  .finish-copy { position: sticky; top: calc(var(--nav) + 2rem); }
  .finish .display { margin: 1rem 0 0.25rem; max-width: none; }
  .fin-end {
    margin: 1.25rem 0 1.75rem;
    color: var(--muted);
    line-height: 1.65;
    max-width: 34rem;
  }
  .fin-rows > div {
    display: grid;
    grid-template-columns: minmax(10rem, 0.9fr) 1.3fr;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
  }
  .fin-rows > div:first-child { padding-top: 0; }
  .fin-rows dt {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .fin-rows dt :global(.fin-icon) { color: var(--gold-text); }
  .fin-rows dd {
    margin: 0;
    font-size: 0.95rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Prix: copy beside two price cards */
  .prix {
    padding: var(--sec) 0;
    background: var(--canopy);
    color: var(--cream);
  }
  .prix .kick { color: var(--gold-soft); }
  .prix .display { color: var(--paper); margin: 1rem 0 0.25rem; max-width: none; }
  .prix .lead { color: var(--muted-on-dark); }
  .prix .lead + .lead { margin-top: 0.75rem; }
  .prix-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap);
    align-items: center;
  }
  .prix .btn { margin-top: 2rem; border-radius: 99px; background: var(--gold); color: var(--ink); }
  .prix .btn:hover { background: var(--gold-soft); }
  .prix-ticket {
    display: grid;
    gap: 1rem;
  }
  .prix-ticket > div {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: clamp(1.25rem, 3vw, 1.75rem) clamp(1.25rem, 3vw, 2rem);
    border-radius: var(--radius);
  }
  .prix-ticket .is-before {
    background: rgb(246 240 228 / 0.08);
    border: 1px solid var(--line-on-dark);
    color: var(--cream);
  }
  .prix-ticket .is-aid {
    background: var(--gold);
    color: var(--ink);
  }
  .prix-ticket .is-before :global(.prix-icon) { color: var(--gold-soft); }
  .prix-ticket span {
    display: block;
    margin-bottom: 0.3rem;
    font-size: 0.85rem;
    opacity: 0.8;
  }
  .prix-ticket strong {
    display: block;
    font-weight: 500;
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
  }
  .prix-ticket .is-before strong { font-size: clamp(1.15rem, 1.8vw, 1.4rem); }
  .prix-ticket .is-aid strong { font-size: clamp(1.5rem, 2.6vw, 2rem); }

  /* Sur la carte: address and link beside a rounded map */
  .map {
    padding: var(--sec) 0;
    background: var(--paper);
  }
  .map-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr);
    gap: var(--gap);
    align-items: center;
  }
  .map-copy .display { margin: 1rem 0 1.25rem; max-width: none; }
  .map-addr {
    display: flex;
    align-items: start;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
    color: var(--muted);
    line-height: 1.5;
  }
  .map-addr :global(.map-pin) { color: var(--gold-text); }
  .map-frame {
    height: clamp(18rem, 32vw, 24rem);
    overflow: hidden;
    border-radius: var(--radius);
    border: 1px solid var(--line);
  }
  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    filter: grayscale(0.25) sepia(0.08);
  }

  @media (max-width: 1100px) {
    .type { grid-template-columns: 1fr; }
    .type-media { aspect-ratio: 16 / 10; }
  }
  @media (max-width: 900px) {
    .figures-grid { grid-template-columns: 1fr 1fr; row-gap: 1.5rem; }
    .figure:nth-child(odd) { padding-inline-start: 0; border-inline-start: 0; }
    .types-grid,
    .finish-grid,
    .prix-grid,
    .map-grid { grid-template-columns: 1fr; }
    .finish-copy { position: static; }
    .fin-rows > div { grid-template-columns: 1fr; gap: 0.3rem; }
  }
</style>
