---
import PageHero from '../page/PageHero.astro';
import PageBand from '../page/PageBand.astro';
import MoreLinks from '../page/MoreLinks.astro';
import Icon from '../Icon.astro';
import { media } from '../../data/media';
import { localePath, type Locale } from '../../i18n/paths';
import { projetPage as projetFr } from '../../data/pages';
import { projetPage as projetAr } from '../../data/pages.ar';

interface Props {
  locale?: Locale;
}
const { locale = 'fr' } = Astro.props;
const p = locale === 'ar' ? projetAr : projetFr;
const L =
  locale === 'ar'
    ? {
        kick: 'المشروع',
        ctaApt: 'عرض الشقق',
        ctaCall: 'اطلب اتصالاً',
        promoteur: 'المطوّر',
        conception: 'التصميم',
        life: 'إطار العيش',
        amenities: 'الخدمات',
        management: 'الإدارة',
        develop: 'التطور',
      }
    : {
        kick: 'Le projet',
        ctaApt: 'Voir les appartements',
        ctaCall: 'Être rappelé',
        promoteur: 'Le promoteur',
        conception: 'Conception',
        life: 'Cadre de vie',
        amenities: 'Prestations',
        management: 'Gestion',
        develop: 'Développement',
      };

// Icons and photos follow the order of the items in data/pages(.ar).ts
const conceptionIcons = ['map-pin', 'leaf', 'sun', 'car-front'];
const amenityLook = [
  { icon: 'arrow-up-down', img: '/photos/facade-day.webp' },
  { icon: 'trees', img: '/photos/allee-jardin.webp' },
  { icon: 'circle-parking', img: '/photos/facade-street.webp' },
  { icon: 'shield-check', img: '/photos/facade-nuit.webp' },
  { icon: 'sofa', img: '/photos/salon.webp' },
  { icon: 'store', img: '/photos/commerce-vitrine.webp' },
];
const missionIcons = ['building-2', 'wrench', 'shield-user', 'key-round', 'clipboard-list'];
const finishesLink = p.equipements.items.map((item) => ('link' in item ? item.link : null)).find(Boolean);
const num = (i: number) => String(i + 1).padStart(2, '0');

const moreLinks = p.more.links.map((l) => ({ ...l, href: localePath(locale, l.href) }));
const promoteur = 'promoteur' in p ? p.promoteur : null;
---
<div data-projet-page class="projet-page">
  <PageHero
    h1={p.h1}
    lead={p.lead}
    kicker={L.kick}
    image="/photos/aerial-ilot.webp"
    alt="Vue de la résidence Riyad Zaer Gardens"
  >
    <a class="btn btn-solid" href={localePath(locale, '/appartements')}>{L.ctaApt}</a>
    <a class="btn btn-light" href={localePath(locale, '/contact')}>{L.ctaCall}</a>
  </PageHero>

  {promoteur && (
    <section class="promoteur">
      <div class="wrap text-photo">
        <div data-reveal data-split>
          <p class="kick">{L.promoteur}</p>
          <h2 class="display">{promoteur.h2}</h2>
          {promoteur.body.map((t) => <p class="lead">{t}</p>)}
          <a class="text-link" href={localePath(locale, promoteur.link.href)}>{promoteur.link.label}</a>
        </div>
        <figure data-media>
          <img src="/photos/facade-golden.webp" alt={media.facade.alt} loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>
  )}

  <section class="chapters soft-band">
    <div class="wrap">
      <header class="head-split chapters-head" data-reveal data-split>
        <p class="kick">{L.conception}</p>
        <h2 class="display">{p.conception.h2}</h2>
        <p class="lead">{p.conception.intro}</p>
      </header>
      <ol class="chapters-grid">
        {p.conception.items.map((item, i) => (
          <li class="chapter" data-chapter>
            <span class="chapter-icon" aria-hidden="true">
              <Icon name={conceptionIcons[i] ?? 'leaf'} size="2.1rem" strokeWidth={1.4} />
            </span>
            <div class="chapter-copy">
              <span class="chapter-num" aria-hidden="true">{num(i)}</span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="cour-scene" data-cour-scene>
    <div class="wrap text-photo is-flip">
      <div>
        <p class="kick" data-cour-line>{L.life}</p>
        <h2 class="display" data-cour-line>{p.cadre.h2}</h2>
        {p.cadre.body.map((t) => (
          <p class="lead" data-cour-line>{t}</p>
        ))}
      </div>
      <figure data-media>
        <img src="/photos/allee-jardin.webp" alt={media.courtyard.alt} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="amenity">
    <div class="wrap">
      <header class="amenity-head" data-reveal data-split>
        <div class="head-split">
          <p class="kick">{L.amenities}</p>
          <h2 class="display">{p.equipements.h2}</h2>
          <p class="lead">{p.equipements.intro}</p>
        </div>
        {finishesLink && (
          <a class="btn btn-solid amenity-cta" href={localePath(locale, finishesLink.href)}>
            {finishesLink.label}
            <Icon name="arrow-right" size="1rem" class="cta-arrow" />
          </a>
        )}
      </header>
      <ol class="amenity-grid">
        {p.equipements.items.map((item, i) => (
          <li class="amenity-card" data-amenity>
            <img src={amenityLook[i]?.img ?? '/photos/aerial-ilot.webp'} alt="" loading="lazy" decoding="async" />
            <div class="amenity-copy">
              <span class="amenity-icon" aria-hidden="true">
                <Icon name={amenityLook[i]?.icon ?? 'leaf'} size="1.25rem" />
              </span>
              <h3>{item.title}</h3>
              <p>{item.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="syndic">
    <div class="wrap syndic-grid">
      <div class="syndic-copy" data-reveal data-split>
        <p class="kick">{L.management}</p>
        <h2 class="display">{p.syndic.h2}</h2>
        <p class="lead">{p.syndic.body}</p>
        <p class="syndic-end">{p.syndic.end}</p>
      </div>
      <ol class="missions" data-missions>
        {p.syndic.missions.map((m, i) => (
          <li data-mission>
            <span class="mission-icon" aria-hidden="true">
              <Icon name={missionIcons[i] ?? 'check'} size="1.15rem" />
            </span>
            {m}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="tranches">
    <div class="wrap text-photo">
      <div class="tranches-copy" data-reveal data-split>
        <p class="kick">{L.develop}</p>
        <h2 class="display">{p.tranches.h2}</h2>
        {p.tranches.body.map((t) => <p class="lead">{t}</p>)}
      </div>
      <figure data-media>
        <img src="/photos/facade-sunset.webp" alt={media.facade.alt} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <PageBand tone="canopy" />
  <MoreLinks h2={p.more.h2} links={moreLinks} variant="cards" />
</div>

<script>
  import '../../scripts/projet-motion';
</script>

<style>
  .promoteur {
    padding: var(--sec) 0;
    background: var(--paper);
  }
  .promoteur .display {
    margin: 1rem 0 0.35rem;
    max-width: none;
  }
  .promoteur .lead + .lead { margin-top: 0.85rem; }
  .promoteur .text-link { margin-top: 1.25rem; }

  /* Conception: four points, each with a round gold icon */
  .chapters {
    padding: var(--sec) 0;
  }
  .chapters-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 4vw, 3rem) clamp(1.75rem, 4vw, 3.5rem);
  }
  .chapter {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.15rem;
    align-items: start;
  }
  .chapter-icon {
    display: grid;
    place-items: center;
    width: 4.75rem;
    height: 4.75rem;
    border-radius: 50%;
    background: var(--cream);
    border: 1px solid rgb(200 181 104 / 0.35);
    color: var(--gold-text);
  }
  .chapter-copy {
    display: grid;
    gap: 0.4rem;
  }
  .chapter-num {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--gold-text);
  }
  .chapter h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.15rem, 1.6vw, 1.3rem);
    line-height: 1.2;
    color: var(--ink);
  }
  .chapter p {
    color: var(--muted);
    line-height: 1.7;
  }

  .cour-scene {
    padding: var(--sec) 0;
    background: var(--paper);
  }

  /* Prestations: photo cards on deep green */
  .amenity {
    padding: var(--sec) 0;
    background:
      radial-gradient(50% 60% at 100% 0%, rgb(200 181 104 / 0.12), transparent 60%),
      var(--canopy);
    color: var(--cream);
  }
  .amenity .kick { color: var(--gold-soft); }
  .amenity .display { color: var(--paper); }
  .amenity .lead { color: var(--muted-on-dark); }
  .amenity-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: 1.25rem 2rem;
    margin-bottom: var(--head-gap);
  }
  .amenity-head .head-split { margin: 0; }
  .amenity-cta { border-radius: 99px; }
  :global([dir='rtl']) .amenity-cta :global(.cta-arrow) { transform: scaleX(-1); }
  .amenity-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.85rem, 1.6vw, 1.15rem);
  }
  .amenity-card {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: clamp(15rem, 22vw, 17.5rem);
    border-radius: var(--radius);
    border: 1px solid var(--line-on-dark);
    background: var(--ink);
    display: flex;
    align-items: end;
  }
  .amenity-card img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.9s var(--ease);
  }
  .amenity-card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(0 32 30 / 0.94) 0%, rgb(0 32 30 / 0.7) 45%, rgb(0 32 30 / 0.15) 100%);
  }
  .amenity-card:hover img { transform: scale(1.05); }
  .amenity-copy {
    display: grid;
    gap: 0.5rem;
    padding: clamp(1.15rem, 2vw, 1.5rem);
    max-width: 22rem;
  }
  .amenity-icon {
    display: grid;
    place-items: center;
    width: 2.6rem;
    height: 2.6rem;
    margin-bottom: 0.35rem;
    border-radius: 10px;
    border: 1px solid rgb(217 201 135 / 0.55);
    color: var(--gold-soft);
    background: rgb(0 32 30 / 0.35);
  }
  .amenity-card h3 {
    font-weight: 500;
    font-size: 1.05rem;
    line-height: 1.3;
    color: var(--paper);
  }
  .amenity-card p {
    font-size: 0.875rem;
    color: var(--muted-on-dark);
    line-height: 1.55;
  }

  /* Gestion: copy beside a card listing the syndic's missions */
  .syndic {
    padding: var(--sec) 0;
    background: var(--paper);
  }
  .syndic-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap);
    align-items: center;
  }
  .syndic-copy .display {
    margin: 1rem 0 0.25rem;
    max-width: none;
  }
  .syndic-end {
    margin-top: 1.25rem;
    color: var(--muted);
    line-height: 1.65;
    max-width: 30rem;
  }
  .missions {
    display: grid;
    padding: clamp(0.5rem, 1.5vw, 0.85rem) clamp(1.1rem, 2.5vw, 1.75rem);
    border-radius: var(--radius);
    background: var(--paper);
    border: 1px solid var(--line);
    box-shadow: 0 18px 50px rgb(0 45 45 / 0.07);
  }
  .missions li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    align-items: center;
    padding: 0.95rem 0;
    font-size: 0.975rem;
    line-height: 1.45;
    color: var(--ink);
  }
  .missions li + li { border-top: 1px solid var(--line); }
  .mission-icon {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: var(--cream);
    color: var(--gold-text);
  }

  /* Développement: copy beside a photo */
  .tranches {
    padding: var(--sec) 0;
    background: var(--cream);
  }
  .tranches-copy .display { margin: 1rem 0 0.35rem; max-width: none; }
  .tranches-copy .lead + .lead { margin-top: 0.85rem; }

  @media (max-width: 600px) {
    .chapter { gap: 0.9rem; }
    .chapter-icon { width: 3.25rem; height: 3.25rem; }
    .chapter-icon :global(svg) { width: 1.55rem; height: 1.55rem; }
  }
  @media (max-width: 900px) {
    .chapters-grid { grid-template-columns: 1fr; }
    .amenity-grid { grid-template-columns: 1fr; }
    .syndic-grid { grid-template-columns: 1fr; }
  }
  @media (min-width: 901px) and (max-width: 1100px) {
    .amenity-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
