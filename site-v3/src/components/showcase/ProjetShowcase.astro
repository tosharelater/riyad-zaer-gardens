---
import PageHero from '../page/PageHero.astro';
import Icon from '../Icon.astro';
import PageBand from '../page/PageBand.astro';
import MoreLinks from '../page/MoreLinks.astro';
import { media } from '../../data/media';
import { localePath, type Locale } from '../../i18n/paths';
import { projetPage as projetFr } from '../../data/pages';
import { projetPage as projetAr } from '../../data/pages.ar';

interface Props {
  locale?: Locale;
}
const { locale = 'fr' } = Astro.props;
const p = locale === 'ar' ? projetAr : projetFr;
const L =
  locale === 'ar'
    ? {
        kick: 'المشروع',
        apt: 'شقق',
        shops: 'محلات تجارية',
        size: 'm² · F3 و F4',
        delivery: 'التسليم المتوقع',
        conception: 'التصميم',
        life: 'إطار العيش',
        amenities: 'الخدمات',
        management: 'الإدارة',
        fiche: 'المواصفات',
        develop: 'التطور',
      }
    : {
        kick: 'Le projet',
        apt: 'appartements',
        shops: 'fonds de commerce',
        size: 'm² · F3 et F4',
        delivery: 'livraison prévue',
        conception: 'Conception',
        life: 'Cadre de vie',
        amenities: 'Prestations',
        management: 'Gestion',
        fiche: 'Fiche technique',
        develop: 'Développement',
      };

const moreLinks = p.more.links.map((l) => ({ ...l, href: localePath(locale, l.href) }));
/** Same order as the conception choices */
const chapterIcons = ['signpost', 'trees', 'sun', 'square-parking'];
/** Same order as the amenities in the data */
const amenityIcons = ['arrow-up-down', 'trees', 'square-parking', 'shield-check', 'paint-roller', 'store'];
---
<div data-projet-page class="projet-page">
  <PageHero
    h1={p.h1}
    lead={p.lead}
    kicker={L.kick}
    image="/photos/facade-commerces.jpg"
    alt={media.hero.alt}
    facts={[
      { n: '120', l: L.apt, count: 120 },
      { n: '49', l: L.shops, count: 49 },
      { n: '65–86', l: L.size },
      { n: '2028', l: L.delivery },
    ]}
  />

  <section class="chapters">
    <div class="wrap">
      <header class="head-split chapters-head" data-reveal data-split>
        <p class="kick">{L.conception}</p>
        <h2 class="display">{p.conception.h2}</h2>
        <p class="lead">{p.conception.intro}</p>
      </header>
      <ol class="chapters-grid">
        {p.conception.items.map((item, i) => (
          <li class="chapter" data-chapter>
            <span class="chapter-num"><Icon name={chapterIcons[i] ?? 'check'} size="1.5rem" /></span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="cour-scene" data-cour-scene>
    <div class="wrap text-photo is-flip">
      <div>
        <p class="kick" data-cour-line>{L.life}</p>
        <h2 class="display" data-cour-line>{p.cadre.h2}</h2>
        {p.cadre.body.map((t) => (
          <p class="lead" data-cour-line>{t}</p>
        ))}
      </div>
      <figure data-media>
        <img src="/photos/allee-jardin.jpg" alt={media.courtyard.alt} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="amenity">
    <div class="wrap">
      <header class="head-split amenity-head" data-reveal data-split>
        <p class="kick">{L.amenities}</p>
        <h2 class="display">{p.equipements.h2}</h2>
        <p class="lead">{p.equipements.intro}</p>
      </header>
      <ol class="amenity-grid">
        {p.equipements.items.map((item, i) => (
          <li class="amenity-item" data-amenity>
            <span><Icon name={amenityIcons[i] ?? 'check'} size="1.6rem" /></span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            {'link' in item && item.link && (
              <a class="text-link" href={localePath(locale, item.link.href)}>{item.link.label}</a>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="syndic">
    <div class="wrap syndic-grid">
    <div class="syndic-copy" data-reveal data-split>
      <p class="kick">{L.management}</p>
      <h2 class="display">{p.syndic.h2}</h2>
      <p class="lead">{p.syndic.body}</p>
      <p class="syndic-end">{p.syndic.end}</p>
    </div>
      <ol class="missions" data-missions>
        {p.syndic.missions.map((m) => (
          <li data-mission><span class="tick"><Icon name="check" size="1rem" /></span>{m}</li>
        ))}
      </ol>
    </div>
  </section>

  <section class="fiche" data-fiche>
    <div class="wrap">
      <header class="fiche-head" data-reveal data-split>
        <p class="kick">{L.fiche}</p>
        <h2 class="display">{p.fiche.h2}</h2>
      </header>
      <dl class="fiche-table">
        {p.fiche.rows.map(([k, v]) => (
          <div data-fiche-row>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="tranches">
    <div class="wrap tranches-grid">
      <div class="tranches-copy" data-reveal data-split>
        <p class="kick">{L.develop}</p>
        <h2 class="display">{p.tranches.h2}</h2>
      </div>
      <div class="tranches-body" data-reveal>
        {p.tranches.body.map((t) => <p class="lead">{t}</p>)}
      </div>
    </div>
  </section>

  <PageBand />
  <MoreLinks h2={p.more.h2} links={moreLinks} />
</div>

<script>
  import '../../scripts/projet-motion';
</script>

<style>
  /* Conception — four choices, numbered */
  .chapters {
    padding: var(--sec) 0;
    background: var(--bg);
  }
  .chapters-head { margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .chapters-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(2rem, 6vw, 6rem);
    border-top: 1px solid var(--line);
  }
  .chapter {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: 1rem;
    row-gap: 0.6rem;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .chapter-num {
    grid-row: 1 / span 2;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--gold-deep);
    padding-top: 0.45rem;
  }
  .chapter h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.2;
  }
  .chapter p {
    color: var(--muted);
    line-height: 1.7;
  }

  /* Courtyard — a statement, no picture */
  .cour-scene {
    padding: var(--sec) 0;
    background: var(--cream);
  }

  /* Amenities */
  .amenity {
    padding: var(--sec) 0;
    background: var(--cream);
  }
  .amenity-head { margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .amenity-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .amenity-item {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1rem, 2.5vw, 2rem) clamp(1.75rem, 3vw, 2.5rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .amenity-item:not(:nth-child(3n + 1)) {
    padding-inline-start: clamp(1rem, 2.5vw, 2rem);
    border-inline-start: 1px solid var(--line);
  }
  .amenity-item span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--gold-deep);
  }
  .amenity-item h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    line-height: 1.15;
  }
  .amenity-item p {
    color: var(--muted);
    line-height: 1.65;
  }
  .amenity-item .text-link { justify-self: start; }

  /* Syndic */
  .syndic {
    padding: var(--sec) 0;
    background: var(--cream);
  }
  .syndic-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: start;
  }
  .syndic-copy .display {
    margin: 1rem 0 0.25rem;
    max-width: 14ch;
  }
  .missions {
    border-top: 1px solid var(--line);
  }
  .missions li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 1.05rem;
    line-height: 1.5;
  }
  .missions span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--gold-deep);
    padding-top: 0.25rem;
  }
  .syndic-end {
    margin-top: 1.5rem;
    color: var(--muted);
    line-height: 1.65;
    max-width: 30rem;
  }

  /* Fiche — spec sheet in two columns */
  .fiche {
    padding: var(--sec) 0;
    background: var(--bg);
  }
  .fiche-head { margin-bottom: clamp(2.5rem, 5vw, 3.5rem); }
  .fiche-head .display { margin-top: 1rem; max-width: 16ch; }
  .fiche-table {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(2rem, 5vw, 5rem);
    border-top: 1px solid var(--line);
  }
  .fiche-table > div {
    display: grid;
    grid-template-columns: minmax(8rem, 0.8fr) 1.2fr;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .fiche-table dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.25rem;
  }
  .fiche-table dd {
    font-size: 1.02rem;
    font-weight: 500;
  }

  /* Tranches */
  .tranches {
    padding: var(--sec) 0;
    background: var(--cream);
  }
  .tranches-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: end;
  }
  .tranches-copy .display { margin-top: 1rem; max-width: 14ch; }
  .tranches-body .lead:first-child { margin-top: 0; }
  .tranches-body .lead + .lead { margin-top: 0.85rem; }

  @media (max-width: 900px) {
    .chapters-grid { grid-template-columns: 1fr; }
    .amenity-grid { grid-template-columns: 1fr; }
    .amenity-item:not(:nth-child(3n + 1)) { padding-inline-start: 0; border-inline-start: 0; }
    .syndic-grid, .tranches-grid { grid-template-columns: 1fr; }
    .fiche-table { grid-template-columns: 1fr; }
    .fiche-table > div { grid-template-columns: 1fr; gap: 0.3rem; }
  }
  @media (min-width: 901px) and (max-width: 1100px) {
    .amenity-grid { grid-template-columns: 1fr 1fr; }
    .amenity-item:not(:nth-child(3n + 1)) { padding-inline-start: 0; border-inline-start: 0; }
    .amenity-item:nth-child(even) { padding-inline-start: 2rem; border-inline-start: 1px solid var(--line); }
  }
</style>
