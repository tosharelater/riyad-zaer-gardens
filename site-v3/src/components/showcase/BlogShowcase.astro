---
import PageHero from '../page/PageHero.astro';
import PageBand from '../page/PageBand.astro';
import MoreLinks from '../page/MoreLinks.astro';
import { blogListing, getArticles } from '../../data/blog';
import { media } from '../../data/media';
import { ui } from '../../i18n/ui';
import { localePath, type Locale } from '../../i18n/paths';

interface Props {
  locale?: Locale;
}
const { locale = 'fr' } = Astro.props;
const listing = blogListing[locale];
const articles = getArticles(locale);
const t = ui(locale);
const moreLinks = listing.more.links.map((l) => ({ ...l, href: localePath(locale, l.href) }));
const dateFmt = (d: string) =>
  new Date(d).toLocaleDateString(locale === 'ar' ? 'ar-MA' : 'fr-FR', {
    year: 'numeric',
    month: 'short',
    day: 'numeric',
  });
---
<div data-blog-page class="blog-page">
  <PageHero
    h1={listing.h1}
    lead={listing.lead}
    kicker={t.blog.kicker}
    image="/photos/facade-golden.jpg"
    alt={media.terrace.alt}
    position="center 40%"
  />

  <section class="blog wrap">
    {articles.map((a) => (
      <article class="entry" data-reveal>
        <a class="entry-link" href={localePath(locale, `/blog/${a.slug}`)}>
          <figure class="entry-media">
            <img src={a.image} alt="" loading="lazy" decoding="async" />
          </figure>
          <div class="entry-copy">
            <div class="meta">
              <time datetime={a.date}>{dateFmt(a.date)}</time>
              <span>{a.tags[0]}</span>
            </div>
            <h2>{a.title}</h2>
            <p>{a.excerpt}</p>
            <span class="text-link">{t.blog.read}</span>
          </div>
        </a>
      </article>
    ))}
  </section>

  <PageBand image="/photos/allee-jardin.jpg" />
  <MoreLinks h2={listing.more.h2} links={moreLinks} />
</div>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--muted);
  }
  .meta span { color: var(--gold-text); }

  .blog {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.75rem, 3.5vw, 2.75rem);
    padding: var(--sec) 0;
    background: var(--paper);
  }
  .entry {
    margin: 0;
    background: var(--paper);
    border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    border-radius: 16px;
    overflow: hidden;
    box-shadow:
      0 14px 32px rgb(45 35 15 / 0.06),
      0 2px 6px rgb(45 35 15 / 0.03);
    transition: transform 0.45s var(--ease), box-shadow 0.45s var(--ease);
  }
  .entry:hover {
    transform: translateY(-4px);
    box-shadow:
      0 22px 44px rgb(45 35 15 / 0.1),
      0 4px 12px rgb(200 181 104 / 0.12);
  }
  .entry-link {
    display: grid;
    grid-template-rows: auto 1fr;
    height: 100%;
    overflow: hidden;
  }
  .entry-media {
    margin: 0;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: color-mix(in srgb, var(--ink) 4%, transparent);
  }
  .entry-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .entry:hover .entry-media img { transform: scale(1.02); }
  .entry-copy {
    display: grid;
    gap: 0.75rem;
    align-content: start;
    padding: clamp(1.1rem, 2vw, 1.35rem) clamp(1.1rem, 2vw, 1.35rem) clamp(1.25rem, 2.2vw, 1.55rem);
  }
  .entry-copy h2 {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.35rem, 2vw, 1.75rem);
    line-height: 1.15;
    text-wrap: balance;
  }
  .entry-copy p {
    color: var(--muted);
    line-height: 1.7;
  }
  .entry-copy .text-link {
    justify-self: start;
    margin-top: 0.25rem;
  }

  @media (max-width: 900px) {
    .blog { grid-template-columns: 1fr; }
    .entry-media { aspect-ratio: 16 / 10; }
  }
  @media (min-width: 901px) and (max-width: 1100px) {
    .blog { grid-template-columns: 1fr 1fr; }
  }
  /* Desktop: two lead stories, then three — no orphan card in the last row. */
  @media (min-width: 1101px) {
    .blog { grid-template-columns: repeat(6, minmax(0, 1fr)); row-gap: clamp(3rem, 5vw, 4.5rem); }
    .entry { grid-column: span 2; }
    .entry:nth-child(-n + 2) { grid-column: span 3; }
    .entry:nth-child(-n + 2) .entry-media { aspect-ratio: 16 / 10; }
    .entry:nth-child(-n + 2) .entry-copy h2 { font-size: clamp(1.6rem, 2.3vw, 2.1rem); }
    .entry:nth-child(-n + 2) .entry-copy p { max-width: 36rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .entry-media img { transition: none; }
  }
</style>
