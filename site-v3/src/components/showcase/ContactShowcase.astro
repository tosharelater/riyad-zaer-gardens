---
import PageHero from '../page/PageHero.astro';
import MoreLinks from '../page/MoreLinks.astro';
import Icon from '../Icon.astro';
import { contactInfo } from '../../data/site';
import { media } from '../../data/media';
import { localePath, type Locale } from '../../i18n/paths';
import { contactPage as contactFr } from '../../data/pages';
import { contactPage as contactAr } from '../../data/pages.ar';

interface Props {
  locale?: Locale;
}
const { locale = 'fr' } = Astro.props;
const p = locale === 'ar' ? contactAr : contactFr;
const L =
  locale === 'ar'
    ? {
        kick: 'Riyad Zaer Gardens',
        form: 'النموذج',
        direct: 'مباشر',
        contact: 'اتصال',
        visit: 'زيارة',
        map: 'على الخريطة',
        mapTitle: 'Km 25، شارع محمد السادس',
        mapsCta: 'فتح في Google Maps',
        visitPoints: [
          { icon: 'calendar-days', title: 'زيارة بموعد', body: 'نتكيف مع أوقاتكم.' },
          { icon: 'users', title: 'في عين المكان مع مستشار', body: 'تقديم المشروع والمحلات المتاحة.' },
          { icon: 'map-pin', title: 'المباني والمساحات الخضراء والمحلات', body: 'رؤية ملموسة للمشروع.' },
        ],
        ph: { name: 'اسمكم', phone: '06 xx xx xx xx', email: 'votre@email.com', message: 'رسالتكم…' },
      }
    : {
        kick: 'Riyad Zaer Gardens',
        form: 'Formulaire',
        direct: 'Direct',
        contact: 'Contact',
        visit: 'Visite',
        map: 'Sur la carte',
        mapTitle: 'Km 25, Avenue Mohammed VI',
        mapsCta: 'Ouvrir dans Google Maps',
        visitPoints: [
          { icon: 'calendar-days', title: 'Visite sur rendez-vous', body: 'Nous nous adaptons à vos disponibilités.' },
          { icon: 'users', title: 'Sur place avec un conseiller', body: 'Présentation du projet et des lots disponibles.' },
          { icon: 'map-pin', title: 'Immeubles, espaces verts et commerces', body: 'Une vision concrète du projet.' },
        ],
        ph: { name: 'Votre nom', phone: '06 xx xx xx xx', email: 'votre@email.com', message: 'Votre message…' },
      };

// Icons follow the order of more.links in data/pages(.ar).ts
const moreIcons = ['building-2', 'house', 'file-text'];
const moreLinks = p.more.links.map((l, i) => ({ ...l, href: localePath(locale, l.href), icon: moreIcons[i] }));
---
<div data-contact-page class="contact-page">
  <PageHero
    h1={p.h1}
    lead={p.lead}
    kicker={L.kick}
    image="/photos/facade-nuit.webp"
    alt={media.hero.alt}
    position="center 35%"
    facts={[
      { n: '25', l: locale === 'ar' ? 'دقيقة من الرباط' : 'min de Rabat', count: 25 },
      { n: '25 Km', l: 'Mohammed VI' },
      { n: '2028', l: locale === 'ar' ? 'التسليم' : 'livraison' },
    ]}
  >
    <a class="btn btn-solid" href={`tel:${contactInfo.phoneTel}`} dir="ltr">{contactInfo.phone}</a>
    <a class="btn btn-light" href={contactInfo.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
  </PageHero>

  <section class="visit-scene">
    <div class="wrap text-photo">
      <div data-reveal data-split>
        <p class="kick">{L.visit}</p>
        <h2 class="display">{p.visit.h2}</h2>
        <p class="lead">{p.visit.body}</p>
        <ul class="visit-points">
          {L.visitPoints.map((pt) => (
            <li>
              <Icon name={pt.icon} size="1.75rem" strokeWidth={1.3} class="visit-icon" />
              <strong>{pt.title}</strong>
              <span>{pt.body}</span>
            </li>
          ))}
        </ul>
      </div>
      <figure data-media>
        <img src="/photos/facade-street.webp" alt={media.avenue.alt} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="contact">
    <div class="wrap contact-layout">
      <div class="form-panel" data-contact-form>
        <p class="kick">{L.form}</p>
        <h2 class="display">{p.form.h2}</h2>
        <form class="form" method="get" action={localePath(locale, '/merci')} data-lead-form>
          <label data-field>
            <span>{p.form.fields.name}</span>
            <input type="text" name="nom" required autocomplete="name" placeholder={L.ph.name} />
          </label>
          <div class="form-row">
            <label data-field>
              <span>{p.form.fields.phone}</span>
              <input
                type="tel"
                name="telephone"
                required
                autocomplete="tel"
                inputmode="tel"
                placeholder={L.ph.phone}
                dir="ltr"
                data-invalid-msg={p.form.fields.phoneInvalid}
              />
            </label>
            <label data-field>
              <span>{p.form.fields.email}</span>
              <input type="email" name="email" autocomplete="email" placeholder={L.ph.email} dir="ltr" />
            </label>
          </div>
          <label data-field>
            <span>{p.form.fields.interest}</span>
            <select name="interet" required>
              <option value="" disabled selected>{p.form.fields.interestPlaceholder}</option>
              {p.form.interests.map((opt) => <option value={opt}>{opt}</option>)}
            </select>
          </label>
          <label data-field>
            <span>{p.form.fields.message}</span>
            <textarea name="message" rows="4" placeholder={L.ph.message}></textarea>
          </label>
          <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn btn-solid" type="submit" data-field>
            {p.form.submit}
            <Icon name="arrow-right" size="1rem" class="c-arrow" />
          </button>
          <p class="form-note" data-field>{p.form.note}</p>
        </form>
      </div>

      <aside class="aside" data-contact-aside>
        <div class="aside-block">
          <p class="kick">{L.contact}</p>
          <h2 class="display aside-title">{p.direct.h2}</h2>
        </div>
        <ul class="direct-list">
          <li>
            <Icon name="phone" size="1.6rem" strokeWidth={1.3} class="direct-icon" />
            <div>
              <h3>{p.direct.phone.title}</h3>
              <a class="big" href={`tel:${contactInfo.phoneTel}`} dir="ltr">{p.direct.phone.label}</a>
            </div>
          </li>
          <li>
            <Icon name="message-circle" size="1.6rem" strokeWidth={1.3} class="direct-icon" />
            <div>
              <h3>{p.direct.whatsapp.title}</h3>
              <p>{p.direct.whatsapp.body}</p>
              <a class="direct-link" href={contactInfo.whatsapp} target="_blank" rel="noopener">
                {p.direct.whatsappCta}
                <Icon name="arrow-right" size="0.95rem" class="c-arrow" />
              </a>
            </div>
          </li>
          <li>
            <Icon name="map-pin" size="1.6rem" strokeWidth={1.3} class="direct-icon" />
            <div>
              <h3>{p.direct.place.title}</h3>
              <p>{p.direct.place.body}</p>
            </div>
          </li>
        </ul>
        <div class="aside-block soft">
          <h2>{p.faq.h2}</h2>
          <p>{p.faq.body}</p>
          <a class="btn btn-ghost faq-btn" href={localePath(locale, p.faq.link.href)}>
            {p.faq.link.label}
            <Icon name="arrow-right" size="1rem" class="c-arrow" />
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="map">
    <div class="map-frame">
      <iframe
        title={locale === 'ar' ? 'خريطة — رياض زعير غاردنز' : 'Carte — Riyad Zaer Gardens'}
        src={contactInfo.mapEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
    <div class="map-card" data-reveal>
      <p class="kick">{L.map}</p>
      <h2>{L.mapTitle}</h2>
      <p class="map-addr">
        <Icon name="map-pin" size="1.3rem" strokeWidth={1.5} class="map-pin" />
        {contactInfo.address}
      </p>
      <a class="btn btn-solid map-btn" href={contactInfo.mapsHref} target="_blank" rel="noopener">
        {L.mapsCta}
        <Icon name="arrow-right" size="1rem" class="c-arrow" />
      </a>
    </div>
  </section>

  <MoreLinks h2={p.more.h2} links={moreLinks} variant="icons" />
</div>

<script>
  import '../../scripts/contact-motion';
  import '../../scripts/form';
</script>

<style>
  :global([dir='rtl']) .contact-page :global(.c-arrow) { transform: scaleX(-1); }

  /* Visite: copy, three icon points, photo */
  .visit-scene {
    padding: var(--sec) 0;
    background: var(--paper);
  }
  .visit-scene .display {
    margin: 1rem 0 0.35rem;
    max-width: none;
  }
  .visit-points {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .visit-points li {
    display: grid;
    align-content: start;
    gap: 0.35rem;
  }
  .visit-points :global(.visit-icon) { color: var(--gold-text); margin-bottom: 0.5rem; }
  .visit-points strong {
    font-size: 0.875rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--ink);
  }
  .visit-points span {
    font-size: 0.8125rem;
    line-height: 1.5;
    color: var(--muted);
  }

  /* Form card beside the direct contacts */
  .contact {
    padding: var(--sec) 0;
    background: var(--cream);
  }
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap);
    align-items: start;
  }
  .form-panel {
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--paper);
    border-radius: var(--radius);
    border: 1px solid var(--line);
    box-shadow: 0 18px 50px rgb(0 45 45 / 0.06);
  }
  .form-panel .display {
    margin: 1rem 0 clamp(1.5rem, 3vw, 2.25rem);
    max-width: none;
  }
  .form {
    display: grid;
    gap: 1.25rem;
    position: relative;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  .form label {
    position: relative;
    display: grid;
    gap: 0.4rem;
  }
  .form span {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--ink);
  }
  .form input,
  .form select,
  .form textarea {
    width: 100%;
    min-width: 0;
    min-height: 3.1rem;
    padding: 0.7rem 1rem;
    border: 1px solid rgb(0 36 34 / 0.16);
    border-radius: var(--radius-sm);
    background: var(--paper);
    color: var(--ink);
    font-size: 1rem;
    outline: none;
    transition: border-color 0.2s ease, box-shadow 0.2s ease;
  }
  .form ::placeholder { color: rgb(74 94 89 / 0.6); }
  :global([dir='rtl']) .form input[dir='ltr']::placeholder { text-align: right; }
  .form input:focus, .form select:focus, .form textarea:focus {
    border-color: var(--gold-text);
    box-shadow: 0 0 0 4px color-mix(in srgb, var(--gold) 22%, transparent);
  }
  .form textarea { resize: vertical; min-height: 6rem; }
  .form input:user-invalid { border-bottom-color: var(--gold-text); }
  .form .btn { justify-self: start; margin-top: 0.5rem; }
  .form .btn[aria-busy='true'] { opacity: 0.7; }
  .form-note {
    font-size: 0.8125rem;
    color: var(--muted);
    max-width: 34rem;
    line-height: 1.55;
  }
  .hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    opacity: 0;
    pointer-events: none;
  }

  .aside {
    position: sticky;
    top: calc(var(--nav) + 2rem);
    display: grid;
    gap: 1.25rem;
  }
  .aside .kick { color: var(--gold-text); }
  .aside-title {
    margin: 0.75rem 0 0;
    font-size: clamp(1.9rem, 3vw, 2.4rem);
    max-width: none;
  }
  .direct-list {
    display: grid;
    gap: 1.25rem;
  }
  .direct-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    align-items: start;
  }
  .direct-list :global(.direct-icon) { color: var(--gold-text); margin-top: 0.15rem; }
  .aside h3 {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--ink);
    margin-bottom: 0.3rem;
  }
  .aside .big {
    font-weight: 600;
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    line-height: 1.1;
    color: var(--ink);
  }
  .aside .big:hover { color: var(--gold-text); }
  .aside p { color: var(--muted); line-height: 1.6; font-size: 0.95rem; }
  .direct-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.35rem;
    font-weight: 500;
    color: var(--ink);
    border-bottom: 1px solid var(--gold);
  }
  .direct-link:hover { color: var(--gold-text); }
  .aside-block.soft {
    margin-top: 0.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .aside-block.soft h2 {
    font-weight: 600;
    font-size: 1.2rem;
    line-height: 1.25;
    margin-bottom: 0.5rem;
  }
  .faq-btn { margin-top: 1.1rem; border-radius: var(--radius-sm); }

  /* Map, full width, with the address card floating over it */
  .map {
    position: relative;
    background: var(--ink);
  }
  .map-frame {
    height: min(60svh, 30rem);
    overflow: hidden;
  }
  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    filter: grayscale(0.25) sepia(0.08);
  }
  .map-card {
    position: absolute;
    top: 50%;
    inset-inline-start: max(var(--pad), calc((100% - var(--wrap)) / 2));
    transform: translateY(-50%);
    width: min(23rem, calc(100% - 2 * var(--pad)));
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: 0 20px 50px rgb(0 36 34 / 0.18);
  }
  .map-card h2 {
    margin: 0.6rem 0 1rem;
    font-weight: 300;
    font-size: clamp(1.5rem, 2.4vw, 1.9rem);
    line-height: 1.15;
    color: var(--ink);
  }
  .map-addr {
    display: flex;
    align-items: start;
    gap: 0.65rem;
    margin-bottom: 1.25rem;
    font-size: 0.9rem;
    color: var(--muted);
    line-height: 1.5;
  }
  .map-addr :global(.map-pin) { color: var(--gold-text); flex: none; }
  .map-btn { border-radius: var(--radius-sm); background: var(--gold); color: var(--ink); }
  .map-btn:hover { background: var(--gold-soft); }

  @media (max-width: 900px) {
    .contact-layout { grid-template-columns: 1fr; }
    .form-row { grid-template-columns: 1fr; }
    .aside { position: static; }
    .map-frame { height: min(50svh, 22rem); }
    .map-card { position: relative; top: auto; inset: auto; transform: none; width: auto; border-radius: 0; box-shadow: none; }
  }
  @media (max-width: 600px) {
    .visit-points { grid-template-columns: 1fr; }
  }
</style>
