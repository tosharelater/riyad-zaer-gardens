---
import PageHero from '../page/PageHero.astro';
import Icon from '../Icon.astro';
import { contactInfo } from '../../data/site';
import { media } from '../../data/media';
import { localePath, type Locale } from '../../i18n/paths';
import { contactPage as contactFr } from '../../data/pages';
import { contactPage as contactAr } from '../../data/pages.ar';

interface Props {
  locale?: Locale;
}
const { locale = 'fr' } = Astro.props;
const p = locale === 'ar' ? contactAr : contactFr;
const L =
  locale === 'ar'
    ? { kick: 'اتصل بنا', form: 'النموذج', direct: 'مباشر' }
    : { kick: 'Contact', form: 'Formulaire', direct: 'Direct' };
---
<div data-contact-page class="contact-page">
  <PageHero
    h1={p.h1}
    lead={p.lead}
    kicker={L.kick}
    image="/photos/facade-sunset.jpg"
    compact
  >
    <a class="btn btn-solid" href={`tel:${contactInfo.phoneTel}`} dir="ltr">{contactInfo.phone}</a>
    <a class="btn btn-light" href={contactInfo.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
  </PageHero>

  <section class="contact">
    <div class="wrap contact-layout">
      <div class="form-panel" data-contact-form>
        <p class="kick">{L.form}</p>
        <h2 class="display">{p.form.h2}</h2>
        <form class="form" method="get" action={localePath(locale, '/merci')} data-lead-form>
          <label data-field>
            <span>{p.form.fields.name}</span>
            <input type="text" name="nom" required autocomplete="name" />
          </label>
          <div class="form-row">
            <label data-field>
              <span>{p.form.fields.phone}</span>
              <input
                type="tel"
                name="telephone"
                required
                autocomplete="tel"
                inputmode="tel"
                data-invalid-msg={p.form.fields.phoneInvalid}
              />
            </label>
            <label data-field>
              <span>{p.form.fields.email}</span>
              <input type="email" name="email" autocomplete="email" />
            </label>
          </div>
          <label data-field>
            <span>{p.form.fields.interest}</span>
            <select name="interet" required>
              <option value="" disabled selected>{p.form.fields.interestPlaceholder}</option>
              {p.form.interests.map((opt) => <option value={opt}>{opt}</option>)}
            </select>
          </label>
          <label data-field>
            <span>{p.form.fields.message}</span>
            <textarea name="message" rows="4"></textarea>
          </label>
          <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn btn-solid" type="submit" data-field>{p.form.submit}</button>
          <p class="form-note" data-field>{p.form.note}</p>
        </form>
      </div>

      <aside class="aside" data-contact-aside>
        <div class="aside-block">
          <p class="kick">{L.direct}</p>
          <h2 class="display aside-title">{p.direct.h2}</h2>
        </div>
        <div class="aside-block">
          <h3><Icon name="phone" />{p.direct.phone.title}</h3>
          <a class="big" href={`tel:${contactInfo.phoneTel}`} dir="ltr">{p.direct.phone.label}</a>
        </div>
        <div class="aside-block">
          <h3><Icon name="message-circle" />{p.direct.whatsapp.title}</h3>
          <p>{p.direct.whatsapp.body}</p>
          <a href={contactInfo.whatsapp} target="_blank" rel="noopener">{p.direct.whatsappCta}</a>
        </div>
        <div class="aside-block">
          <h3><Icon name="map-pin" />{p.direct.place.title}</h3>
          <p>{p.direct.place.body}</p>
        </div>

        <div class="aside-block soft">
          <h2>{p.visit.h2}</h2>
          <p>{p.visit.body}</p>
        </div>

        <div class="aside-block soft">
          <h2>{p.faq.h2}</h2>
          <p>{p.faq.body}</p>
          <a class="text-link" href={localePath(locale, p.faq.link.href)}>{p.faq.link.label}</a>
        </div>
      </aside>
    </div>
  </section>
</div>

<script>
  import '../../scripts/contact-motion';
  import '../../scripts/form';
</script>

<style>
  .contact {
    padding: var(--sec) 0;
    background: var(--cream);
  }
  .contact-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 0.85fr);
    gap: clamp(3rem, 8vw, 8rem);
    align-items: start;
  }
  .form-panel .display {
    margin: 1rem 0 clamp(2rem, 4vw, 3rem);
    max-width: 12ch;
  }
  .form {
    display: grid;
    gap: 2rem;
    position: relative;
  }
  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
  }
  .form label {
    position: relative;
    display: grid;
    gap: 0.35rem;
  }
  .form span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    transition: color 0.3s ease;
  }
  .form label:focus-within span { color: var(--ink); }
  .form input,
  .form select,
  .form textarea {
    width: 100%;
    padding: 0.6rem 0;
    border: 0;
    border-bottom: 1px solid rgb(0 45 45 / 0.28);
    border-radius: 0;
    background: transparent;
    font-size: 1.1rem;
    outline: none;
  }
  .form textarea { resize: vertical; min-height: 6rem; }
  .form label::after {
    content: '';
    position: absolute;
    inset: auto 0 0 0;
    height: 1px;
    background: var(--ink);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.6s var(--ease);
  }
  .form label:focus-within::after { transform: scaleX(1); }
  .form input:user-invalid { border-bottom-color: #a33a2b; }
  .form .btn { justify-self: start; min-width: 14rem; margin-top: 0.5rem; }
  .form .btn[aria-busy='true'] { opacity: 0.7; }
  .form-note {
    font-size: 0.85rem;
    color: var(--muted);
    max-width: 34rem;
    line-height: 1.55;
  }
  .hp {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    opacity: 0;
    pointer-events: none;
  }

  .aside {
    position: sticky;
    top: calc(var(--nav) + 2rem);
    display: grid;
  }
  .aside-title {
    margin: 1rem 0 1.5rem;
    font-size: clamp(1.9rem, 3vw, 2.6rem);
    max-width: 12ch;
  }
  .aside-block {
    padding: 1.25rem 0;
    border-top: 1px solid var(--line);
  }
  .aside-block:first-child {
    padding-top: 0;
    border-top: 0;
  }
  .aside h3 :global(.icon) { margin-inline-end: 0.5rem; color: var(--gold-deep); }
  .aside h3 {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.45rem;
  }
  .aside .big {
    font-weight: 300;
    font-family: var(--display);
    font-size: clamp(2rem, 3.2vw, 2.8rem);
    line-height: 1.05;
    background: linear-gradient(var(--gold), var(--gold)) no-repeat 0 100% / 0 1px;
    transition: background-size 0.7s var(--ease);
  }
  .aside .big:hover { background-size: 100% 1px; }
  .aside a { font-weight: 500; display: inline-block; padding-block: 0.35rem; }
  .aside a:not(.big):not(.text-link):hover { color: var(--gold-deep); }
  .aside p { color: var(--muted); line-height: 1.6; }
  .aside-media {
    margin: 1.25rem 0;
    aspect-ratio: 16 / 11;
  }
  .aside-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .aside-block.soft h2 {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.5rem;
    line-height: 1.15;
    margin-bottom: 0.5rem;
  }

  @media (max-width: 900px) {
    .contact-layout { grid-template-columns: 1fr; }
    .form-row { grid-template-columns: 1fr; }
    .aside { position: static; }
  }
</style>
