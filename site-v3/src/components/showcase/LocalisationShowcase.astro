---
import PageHero from '../page/PageHero.astro';
import MoreLinks from '../page/MoreLinks.astro';
import PageBand from '../page/PageBand.astro';
import { media } from '../../data/media';
import { contactInfo } from '../../data/site';
import { localePath, type Locale } from '../../i18n/paths';
import { localisationPage as locFr } from '../../data/pages';
import { localisationPage as locAr } from '../../data/pages.ar';

interface Props {
  locale?: Locale;
}
const { locale = 'fr' } = Astro.props;
const p = locale === 'ar' ? locAr : locFr;
const L =
  locale === 'ar'
    ? {
        kick: 'الموقع',
        access: 'الوصول',
        area: 'الحي',
        map: 'على الخريطة',
        mapTitle: 'Km 25، شارع محمد السادس',
        iframeTitle: 'خريطة — رياض زعير غاردنز، عين عودة',
        mapsCta: 'فتح في Google Maps',
        visit: 'زيارة',
        min: 'دقيقة من الرباط',
        road: 'شارع محمد السادس',
        ways: 'طرق تحيط بالأرض',
      }
    : {
        kick: 'Localisation',
        access: 'Accès',
        area: 'Le quartier',
        map: 'Sur la carte',
        mapTitle: 'Km 25, Avenue Mohammed VI',
        iframeTitle: 'Carte — Riyad Zaer Gardens, Aïn Aouda',
        mapsCta: 'Ouvrir dans Google Maps',
        visit: 'Visite',
        min: 'minutes de Rabat',
        road: 'Avenue Mohammed VI',
        ways: 'voies bordent le terrain',
      };

const moreLinks = p.more.links.map((l) => ({ ...l, href: localePath(locale, l.href) }));
const mapTitle = 'map' in p && p.map && 'title' in p.map ? (p.map as { title: string }).title : L.mapTitle;
const iframeTitle =
  'map' in p && p.map && 'iframeTitle' in p.map ? (p.map as { iframeTitle: string }).iframeTitle : L.iframeTitle;
const mapsCta =
  'map' in p && p.map && 'mapsCta' in p.map ? (p.map as { mapsCta: string }).mapsCta : L.mapsCta;
const pad = (i: number) => String(i + 1).padStart(2, '0');
---
<div data-loc-page class="loc-page">
  <PageHero
    h1={p.h1}
    lead={p.lead}
    kicker={L.kick}
    index="04"
    image={media.avenue.src}
    alt={media.avenue.alt}
    facts={[
      { n: '20', l: L.min, count: 20 },
      { n: 'Km 25', l: L.road },
      { n: '3', l: L.ways },
    ]}
  />

  <section class="access" data-access>
    <div class="wrap">
      <header class="access-head" data-reveal data-split>
        <p class="kick">{L.access}</p>
        <h2 class="display">{p.acces.h2}</h2>
      </header>
      <ol class="access-grid">
        {p.acces.items.map((item, i) => (
          <li class="stop" data-stop>
            <span class="stop-n">{pad(i)}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="map">
    <div class="map-frame" data-map-frame>
      <iframe
        title={iframeTitle}
        src={contactInfo.mapEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
    <div class="map-card" data-reveal>
      <p class="kick">{L.map}</p>
      <h2>{mapTitle}</h2>
      <a class="btn btn-solid" href={contactInfo.mapsHref} target="_blank" rel="noopener">{mapsCta}</a>
    </div>
  </section>

  <section class="quartier">
    <div class="wrap quartier-grid">
    <div class="quartier-copy" data-reveal data-split>
      <p class="kick">{L.area}</p>
      <h2 class="display">{p.quartier.h2}</h2>
      {p.quartier.body.split('\n\n').map((t) => <p class="lead">{t}</p>)}
    </div>
    <div class="quartier-list">
      <ol class="near">
        {p.quartier.already.map((item, i) => <li><span>{pad(i)}</span>{item}</li>)}
      </ol>
      <p class="near-end">{p.quartier.end}</p>
    </div>
    </div>
  </section>

  <PageBand
    mode="custom"
    title={p.visit.h2}
    body={p.visit.body}
    primary={{ label: p.visit.cta.label, href: localePath(locale, p.visit.cta.href) }}
  />
  <MoreLinks h2={p.more.h2} links={moreLinks} />
</div>

<script>
  import '../../scripts/localisation-motion';
</script>

<style>
  /* Access — four answers, numbered */
  .access {
    padding: var(--sec) 0;
    background: var(--bg);
  }
  .access-head { margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .access-head .display { margin-top: 1rem; max-width: 14ch; }
  .access-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    column-gap: clamp(2rem, 6vw, 6rem);
    border-top: 1px solid var(--line);
  }
  .stop {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: 1rem;
    row-gap: 0.6rem;
    padding: clamp(1.5rem, 3vw, 2.25rem) 0;
    border-bottom: 1px solid var(--line);
  }
  .stop-n {
    grid-row: 1 / span 2;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--gold-deep);
    padding-top: 0.45rem;
  }
  .stop h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.2;
  }
  .stop p {
    color: var(--muted);
    line-height: 1.7;
  }

  /* Map — full bleed with a floating address card */
  .map {
    position: relative;
    background: var(--ink);
  }
  .map-frame {
    height: min(82svh, 46rem);
    overflow: hidden;
  }
  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    filter: grayscale(0.4) contrast(1.05) sepia(0.12);
  }
  .map-card {
    position: absolute;
    inset-inline-start: var(--pad);
    bottom: var(--pad);
    width: min(26rem, calc(100% - 2 * var(--pad)));
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--bg);
    display: grid;
    gap: 0.85rem;
  }
  .map-card h2 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    line-height: 1.1;
  }
  .map-card .btn { justify-self: start; margin-top: 0.5rem; }

  /* Quartier */
  .quartier {
    padding: var(--sec) 0;
    background: var(--cream);
  }
  .quartier-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: end;
  }
  .quartier-copy .display { margin: 1rem 0 0.25rem; max-width: 12ch; }
  .quartier-copy .lead + .lead { margin-top: 0.75rem; }
  .near {
    border-top: 1px solid var(--line);
  }
  .near li {
    display: grid;
    grid-template-columns: 3rem 1fr;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
    font-size: 1.05rem;
  }
  .near span {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--gold-deep);
    padding-top: 0.25rem;
  }
  .near-end {
    margin-top: 1.25rem;
    color: var(--muted);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .access-grid { grid-template-columns: 1fr; }
    .map-frame { height: 60svh; }
    .map-card { position: relative; inset: auto; width: auto; }
    .quartier-grid { grid-template-columns: 1fr; }
  }
</style>
