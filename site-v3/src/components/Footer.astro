---
import type { Locale } from '../i18n/paths';
import { getLocaleFromPath, localePath } from '../i18n/paths';
import { ui, contactInfo } from '../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale: localeProp } = Astro.props;
const locale: Locale =
  localeProp ?? (Astro.currentLocale === 'ar' ? 'ar' : getLocaleFromPath(Astro.url.pathname));
const t = ui(locale);
---
<footer class="foot">
  <div class="wrap foot-grid">
    <div>
      <img src="/brand/logo-light.png" alt={t.brand.name} width="140" height="90" />
      <p class="by">{t.brand.by}</p>
      <p>{t.brand.slogan}</p>
      <p>{t.brand.about}</p>
    </div>
    <div>
      <p class="col">{t.footerCols.project}</p>
      {t.footerProject.map((l) => <a href={localePath(locale, l.path)}>{l.label}</a>)}
    </div>
    <div>
      <p class="col">{t.footerCols.info}</p>
      {t.footerInfo.map((l) => <a href={localePath(locale, l.path)}>{l.label}</a>)}
    </div>
    <div>
      <p class="col">{t.footerCols.contact}</p>
      <a href={`tel:${contactInfo.phoneTel}`} dir="ltr">{contactInfo.phone}</a>
      <a href={contactInfo.whatsapp}>{t.writeWhatsapp}</a>
      <p>{contactInfo.address}</p>
      <p>{contactInfo.domain}</p>
    </div>
  </div>
  <div class="wrap foot-copy">
    <p>{t.legal.copy}</p>
    <p>{t.legal.aidNote}</p>
    <a href={localePath(locale, '/mentions-legales')}>{t.legal.mentions}</a>
    <a href={`${localePath(locale, '/mentions-legales')}#confidentialite`}>{t.legal.privacy}</a>
  </div>
</footer>

<nav class="mbar" aria-label="Actions">
  <a href={`tel:${contactInfo.phoneTel}`}>{t.call}</a>
  <a href={contactInfo.whatsapp}>{t.whatsapp}</a>
  <a href={localePath(locale, '/contact')}>{t.cta}</a>
</nav>
<style>
  .foot {
    background: var(--ink);
    color: var(--muted-on-dark);
    padding: clamp(3.5rem, 6vw, 5rem) 0 2rem;
    font-size: 0.875rem;
    line-height: 1.45;
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr 1fr 1.2fr;
    gap: var(--gap);
    align-items: start;
  }
  .foot img { height: 3.75rem; width: auto; margin-bottom: 1rem; }
  .foot .by {
    color: var(--gold-soft);
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .foot .col {
    font-weight: 600;
    color: var(--cream);
    margin-bottom: 0.5rem;
  }
  .foot a, .foot p { display: block; margin-top: 0.35rem; font-size: 0.875rem; }
  .foot-grid > div:first-child p:not(.by) { max-width: 22rem; }
  .foot-grid a { width: fit-content; margin-top: 0; padding-block: 0.4rem; transition: color 0.2s ease; }
  .foot-grid a:hover { color: var(--gold-soft); text-decoration: underline; text-underline-offset: 0.2em; }
  .foot-copy a { padding-block: 0.4rem; margin-top: 0; }
  .foot-copy a:hover { color: var(--gold-soft); text-decoration: underline; }
  .foot-copy {
    margin-top: 2.75rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line-on-dark);
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.5rem;
    font-size: 0.8125rem;
    color: var(--muted-on-dark);
  }
  .mbar {
    display: none;
    position: fixed;
    inset: auto 0.75rem max(0.75rem, env(safe-area-inset-bottom));
    z-index: 70;
    grid-template-columns: 1fr 1fr 1.25fr;
    gap: 0.35rem;
    padding: 0.35rem;
    border-radius: 999px;
    background: rgb(0 45 45 / 0.9);
    -webkit-backdrop-filter: saturate(160%) blur(20px);
    backdrop-filter: saturate(160%) blur(20px);
    box-shadow: 0 10px 30px rgb(0 36 34 / 0.28), 0 0 0 1px rgb(217 201 135 / 0.18);
  }
  @media (prefers-reduced-transparency: reduce) {
    .mbar { background: var(--ink); -webkit-backdrop-filter: none; backdrop-filter: none; }
  }
  .mbar a {
    display: grid;
    place-items: center;
    min-height: 2.75rem;
    padding: 0.5rem 0.5rem;
    border-radius: 999px;
    text-align: center;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--cream);
  }
  .mbar a:last-child { background: var(--gold); color: var(--ink); font-weight: 600; }
  @media (max-width: 800px) {
    .foot-grid { grid-template-columns: 1fr 1fr; }
    .foot-grid > div:first-child { grid-column: 1 / -1; }
    .foot { padding-bottom: 6.5rem; }
    .mbar { display: grid; }
  }
</style>
