---
import type { Locale } from '../i18n/paths';
import { getLocaleFromPath, localePath } from '../i18n/paths';
import { ui, contactInfo } from '../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale: localeProp } = Astro.props;
const locale: Locale =
  localeProp ?? (Astro.currentLocale === 'ar' ? 'ar' : getLocaleFromPath(Astro.url.pathname));
const t = ui(locale);
---
<footer class="foot">
  <div class="wrap foot-grid">
    <div>
      <img src="/brand/logo-light.png" alt={t.brand.name} width="140" height="90" />
      <p class="by">{t.brand.by}</p>
      <p>{t.brand.slogan}</p>
      <p>{t.brand.about}</p>
    </div>
    <div>
      <p class="col">{t.footerCols.project}</p>
      {t.footerProject.map((l) => <a href={localePath(locale, l.path)}>{l.label}</a>)}
    </div>
    <div>
      <p class="col">{t.footerCols.info}</p>
      {t.footerInfo.map((l) => <a href={localePath(locale, l.path)}>{l.label}</a>)}
    </div>
    <div>
      <p class="col">{t.footerCols.contact}</p>
      <a href={`tel:${contactInfo.phoneTel}`} dir="ltr">{contactInfo.phone}</a>
      <a href={contactInfo.whatsapp}>{t.writeWhatsapp}</a>
      <p>{contactInfo.address}</p>
      <p>{contactInfo.domain}</p>
    </div>
  </div>
  <div class="wrap foot-copy">
    <p>{t.legal.copy}</p>
    <p>{t.legal.aidNote}</p>
    <a href={localePath(locale, '/mentions-legales')}>{t.legal.mentions}</a>
    <a href={`${localePath(locale, '/mentions-legales')}#confidentialite`}>{t.legal.privacy}</a>
  </div>
</footer>

<nav class="mbar" aria-label="Actions">
  <a href={`tel:${contactInfo.phoneTel}`}>{t.call}</a>
  <a href={contactInfo.whatsapp}>{t.whatsapp}</a>
  <a href={localePath(locale, '/contact')}>{t.cta}</a>
</nav>
<style>
  .foot {
    background:
      radial-gradient(ellipse 50% 40% at 0% 0%, color-mix(in srgb, var(--gold) 10%, transparent), transparent 55%),
      radial-gradient(ellipse 40% 35% at 100% 100%, color-mix(in srgb, var(--canopy) 45%, transparent), transparent 60%),
      var(--ink);
    color: var(--muted-on-dark);
    padding: var(--sec) 0 2rem;
    overflow: hidden;
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.35fr 1fr 1fr 1.15fr;
    gap: var(--gap);
    align-items: start;
  }
  .foot img { height: 3rem; width: auto; margin-bottom: 0.65rem; }
  .foot .by {
    color: var(--gold-soft);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }
  .foot .col {
    font-size: 0.75rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: color-mix(in srgb, var(--cream) 48%, transparent);
    margin-bottom: 0.85rem;
  }
  .foot a, .foot p { display: block; margin-top: 0.4rem; font-size: 0.92rem; }
  .foot-grid a { width: fit-content; margin-top: 0; padding-block: 0.6rem; transition: color 0.3s ease, transform 0.5s var(--ease); }
  .foot-grid a:hover { color: var(--gold-soft); transform: translateX(4px); }
  .foot-copy a { padding-block: 0.5rem; margin-top: 0; }
  .foot-copy a:hover { color: var(--gold-soft); }
  .foot-copy {
    margin-top: 3rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line-on-dark);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    font-size: 0.78rem;
    color: color-mix(in srgb, var(--cream) 55%, transparent);
  }
  .mbar {
    display: none;
    position: fixed;
    inset: auto 0 0;
    z-index: 70;
    grid-template-columns: 1fr 1fr 1fr;
    background: var(--ink);
    border-top: 1px solid color-mix(in srgb, var(--gold) 40%, transparent);
  }
  .mbar a {
    padding: 0.9rem 0.5rem;
    text-align: center;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--cream);
    border-inline-end: 1px solid var(--line-on-dark);
  }
  .mbar a:last-child { border: 0; color: var(--gold-soft); }
  @media (max-width: 800px) {
    .foot-grid { grid-template-columns: 1fr; text-align: center; }
    .foot img { margin-inline: auto; }
    .foot-grid a { margin-inline: auto; }
    .foot { padding-bottom: 5.5rem; }
    .mbar { display: grid; }
  }
</style>
