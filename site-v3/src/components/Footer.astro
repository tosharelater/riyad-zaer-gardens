---
import type { Locale } from '../i18n/paths';
import { getLocaleFromPath, localePath } from '../i18n/paths';
import { ui, contactInfo } from '../i18n/ui';

interface Props {
  locale?: Locale;
}
const { locale: localeProp } = Astro.props;
const locale: Locale =
  localeProp ?? (Astro.currentLocale === 'ar' ? 'ar' : getLocaleFromPath(Astro.url.pathname));
const t = ui(locale);
---
<footer class="foot">
  <div class="wrap foot-grid">
    <div>
      <img src="/brand/logo-light.png" alt={t.brand.name} width="140" height="90" />
      <p class="by">{t.brand.by}</p>
      <p>{t.brand.slogan}</p>
      <p>{t.brand.about}</p>
    </div>
    <div>
      <p class="col">{t.footerCols.project}</p>
      {t.footerProject.map((l) => <a href={localePath(locale, l.path)}>{l.label}</a>)}
    </div>
    <div>
      <p class="col">{t.footerCols.info}</p>
      {t.footerInfo.map((l) => <a href={localePath(locale, l.path)}>{l.label}</a>)}
    </div>
    <div>
      <p class="col">{t.footerCols.contact}</p>
      <a href={`tel:${contactInfo.phoneTel}`} dir="ltr">{contactInfo.phone}</a>
      <a href={contactInfo.whatsapp}>{t.writeWhatsapp}</a>
      <p>{contactInfo.address}</p>
      <p>{contactInfo.domain}</p>
    </div>
  </div>
  <div class="wrap foot-copy">
    <p>{t.legal.copy}</p>
    <p>{t.legal.aidNote}</p>
    <a href={localePath(locale, '/mentions-legales')}>{t.legal.mentions}</a>
    <a href={`${localePath(locale, '/mentions-legales')}#confidentialite`}>{t.legal.privacy}</a>
  </div>
</footer>

<nav class="mbar" aria-label="Actions">
  <a href={`tel:${contactInfo.phoneTel}`}>{t.call}</a>
  <a href={contactInfo.whatsapp}>{t.whatsapp}</a>
  <a href={localePath(locale, '/contact')}>{t.cta}</a>
</nav>
<style>
  .foot {
    background: #000;
    color: rgb(247 242 232 / 0.72);
    padding: 3.5rem 0 5.5rem;
  }
  .foot-grid {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr 1.2fr;
    gap: 2rem;
  }
  .foot img { height: 3rem; width: auto; margin-bottom: 0.65rem; }
  .foot .by {
    color: var(--gold);
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    margin-bottom: 0.85rem;
  }
  .foot .col {
    font-size: 0.7rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: rgb(247 242 232 / 0.45);
    margin-bottom: 0.85rem;
  }
  .foot a, .foot p { display: block; margin-top: 0.4rem; font-size: 0.92rem; }
  .foot a:hover { color: var(--gold); }
  .foot-copy {
    margin-top: 2.5rem;
    padding-top: 1.25rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    font-size: 0.78rem;
    opacity: 0.55;
  }
  .mbar {
    display: none;
    position: fixed;
    inset: auto 0 0;
    z-index: 70;
    grid-template-columns: 1fr 1fr 1fr;
    background: var(--ink);
    border-top: 1px solid rgb(200 181 104 / 0.35);
  }
  .mbar a {
    padding: 0.9rem 0.5rem;
    text-align: center;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #f7f2e8;
    border-inline-end: 1px solid rgb(255 255 255 / 0.1);
  }
  .mbar a:last-child { border: 0; color: var(--gold); }
  @media (max-width: 800px) {
    .foot-grid { grid-template-columns: 1fr; text-align: center; }
    .foot img { margin-inline: auto; }
    .mbar { display: grid; }
  }
</style>
