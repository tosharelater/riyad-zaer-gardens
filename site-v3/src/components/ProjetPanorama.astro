---
import { getHome } from '../data/content';
import { localePath, type Locale } from '../i18n/paths';
import Icon from './Icon.astro';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { projet } = getHome(locale);

/** One icon per amenity, same order as the data */
const amenityIcons = ['arrow-up-down', 'trees', 'square-parking', 'shield-check', 'paint-roller', 'store'];
const href = projet.link.href.startsWith('/') ? localePath(locale, projet.link.href) : projet.link.href;
---
<section class="pano" id="projet">
  <div class="wrap">
    <header class="pano-head" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'المشروع' : 'Le projet'}</p>
      <h2 class="display">{projet.h2}</h2>
    </header>

    <figure class="pano-photo" data-reveal>
      <img src="/photos/aerial-ilot.jpg" alt={projet.alt} loading="lazy" decoding="async" />
    </figure>

    <ul class="pano-bar" data-reveal>
      {projet.amenities.map((a, i) => (
        <li>
          <span class="pano-ico" aria-hidden="true"><Icon name={amenityIcons[i]} size="1.4rem" /></span>
          <span class="pano-label">{a}</span>
        </li>
      ))}
    </ul>

    <div class="pano-text" data-reveal>
      <p class="lead">{projet.p1}</p>
      <p class="lead">{projet.p2}</p>
    </div>
    <a class="pano-link" href={href}>{projet.link.label}</a>
  </div>
</section>

<style>
  .pano {
    padding: var(--sec) 0;
    background: var(--cream);
  }
  .pano .wrap { display: grid; justify-items: center; }
  .pano-head {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    max-width: 44rem;
    margin-bottom: clamp(2rem, 4vw, 3rem);
    text-align: center;
  }
  .pano-head .kick { margin: 0; }
  .pano-head .display { margin: 0; max-width: none; }

  .pano-photo {
    width: 100%;
    margin: 0;
    aspect-ratio: 21 / 9;
    overflow: hidden;
    border-radius: 22px;
  }
  .pano-photo img { width: 100%; height: 100%; object-fit: cover; object-position: center 60%; }

  /* amenities bar overlaps the photo's lower edge */
  .pano-bar {
    position: relative;
    z-index: 1;
    width: min(100% - 2rem, 62rem);
    margin: -3.25rem 0 0;
    padding: clamp(1.25rem, 2.5vw, 1.75rem) clamp(1rem, 2.5vw, 2rem);
    list-style: none;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 1rem;
    border-radius: var(--radius);
    background: var(--paper);
  }
  .pano-bar li {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.65rem;
    text-align: center;
  }
  .pano-ico {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--canopy) 8%, var(--cream));
    color: var(--ink);
  }
  .pano-label { font-size: 0.85rem; font-weight: 500; line-height: 1.35; color: var(--ink); text-wrap: balance; }

  .pano-text {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1.5rem, 4vw, 3.5rem);
    width: min(100%, 60rem);
    margin-top: clamp(2rem, 4vw, 3rem);
  }
  .pano-text .lead { margin: 0; max-width: none; font-size: 1rem; }
  .pano-link {
    margin-top: 1.5rem;
    font-weight: 500;
    color: var(--canopy);
  }
  .pano-link::after { content: ' →'; }
  .pano-link:hover { text-decoration: underline; text-underline-offset: 0.25em; }

  @media (max-width: 900px) {
    .pano-photo { aspect-ratio: 16 / 9; }
    .pano-bar { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: -2.5rem; row-gap: 1.5rem; }
    .pano-text { grid-template-columns: 1fr; }
  }
  @media (max-width: 520px) {
    .pano-bar { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
