---
import { getHome } from '../data/content';
import { localePath, type Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { apartments, aid } = getHome(locale);
const keep = (t: string) => t.replace(/(\d) (?=\d|DH|m)/g, '$1 ');
const facts: [string, string][] = [
  [locale === 'ar' ? 'النوع' : 'Typologies', apartments.types.join(' · ')],
  [locale === 'ar' ? 'المساحة' : 'Surfaces', keep(apartments.range)],
  [locale === 'ar' ? 'السعر' : 'Prix', keep(apartments.price.charAt(0).toLowerCase() + apartments.price.slice(1))],
  [locale === 'ar' ? 'مع الدعم' : 'Avec l’aide au logement', keep(aid.withAid)],
];
const ctaHref = apartments.cta.href.startsWith('/')
  ? localePath(locale, apartments.cta.href)
  : apartments.cta.href;
---
<section class="homes" id="appartements">
  <div class="wrap homes-grid">
    <div class="homes-block" data-reveal data-split>
      <p class="kick">
        <span>{locale === 'ar' ? 'الشقق' : 'Appartements'}</span>
        <span class="kick-rule" aria-hidden="true"></span>
      </p>
      <h2 class="display">{apartments.h2}</h2>
      <p class="lead">{apartments.p1}</p>
      <p class="homes-note">{apartments.p2}</p>
      <dl class="facts">
        {facts.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
      <a class="btn btn-solid" href={ctaHref}>
        {apartments.cta.label}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <div class="homes-collage" data-reveal>
      <figure class="homes-main">
        <img src="/photos/salon.jpg" alt="" loading="lazy" decoding="async" />
      </figure>
      <figure class="homes-side">
        <img src="/photos/chambre.jpg" alt="" loading="lazy" decoding="async" />
      </figure>
      <figure class="homes-side">
        <img src="/photos/salon-balcon.jpg" alt="" loading="lazy" decoding="async" />
      </figure>
    </div>
  </div>
</section>

<style>
  .homes {
    padding: var(--sec) 0;
    background: var(--paper);
  }
  .homes-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .homes-block {
    display: grid;
    gap: 0.95rem;
    max-width: 32rem;
  }
  .homes .kick {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.76rem;
    font-weight: 600;
  }
  .homes .kick-rule {
    display: block;
    width: 2.5rem;
    height: 1.5px;
    background: var(--gold-text);
  }
  .homes .display {
    margin: 0;
    max-width: none;
    font-size: clamp(2rem, 3.5vw, 2.75rem);
  }
  .homes .lead { margin: 0; }
  .homes-types {
    margin: 0;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  .homes-note {
    margin: 0;
    color: var(--muted);
    font-size: 1rem;
    line-height: 1.65;
  }
  .homes-price {
    display: grid;
    gap: 0.25rem;
    margin-top: 0.25rem;
  }
  .homes-price strong {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.35rem, 2.2vw, 1.75rem);
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  .homes-price span {
    font-size: 0.95rem;
    color: var(--muted);
  }
  .homes .btn {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-top: 0.5rem;
  }

  .homes-collage {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.85fr);
    grid-template-rows: 1fr 1fr;
    gap: 0.85rem;
    min-height: clamp(22rem, 42vw, 30rem);
  }
  .homes-main {
    grid-row: 1 / -1;
    margin: 0;
    overflow: hidden;
    height: 100%;
  }
  .homes-side {
    margin: 0;
    overflow: hidden;
    height: 100%;
  }
  .homes-collage img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 900px) {
    .homes-grid {
      grid-template-columns: 1fr;
    }
    .homes-block {
      max-width: none;
    }
    .homes-block .display { font-size: clamp(1.7rem, 7vw, 2.4rem); }
    .homes-collage {
      min-height: 20rem;
      order: -1;
    }
  }

  @media (max-width: 560px) {
    .homes-collage {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto auto;
      min-height: 0;
    }
    .homes-main {
      grid-column: 1 / -1;
      grid-row: auto;
      aspect-ratio: 16 / 10;
    }
    .homes-side {
      aspect-ratio: 4 / 3;
    }
  }
</style>
