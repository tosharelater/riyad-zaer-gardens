---
import { apartments } from '../data/home';
---
<section class="homes" id="appartements">
  <div class="homes-stage">
    <figure class="homes-media" data-media data-reveal>
      <img src={apartments.img} alt="" loading="lazy" />
    </figure>
    <div class="homes-panel wrap">
      <header data-reveal data-split>
        <p class="kick">Appartements</p>
        <h2 class="display">{apartments.h2}</h2>
        <p class="lead">{apartments.p1}</p>
        <p class="lead">{apartments.p2}</p>
        <a class="btn btn-ghost" href={apartments.cta.href}>{apartments.cta.label}</a>
      </header>
      <dl class="homes-facts" data-reveal>
        {apartments.facts.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>
<style>
  .homes {
    background: var(--cream);
    padding: 0;
  }
  .homes-stage {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: 0;
    align-items: stretch;
    min-height: min(78svh, 44rem);
  }
  .homes-media {
    margin: 0;
    height: 100%;
    min-height: 28rem;
  }
  .homes-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .homes-panel {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2.5rem;
    padding-block: clamp(1.5rem, 4vw, 3rem);
    padding-inline: clamp(1.5rem, 4vw, 3rem);
    width: 100%;
    max-width: none;
  }
  .homes-panel .display { max-width: 16ch; }
  .homes-panel .lead + .lead { margin-top: 0.85rem; }
  .homes-panel .btn { margin-top: 1.5rem; }
  .homes-facts {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
    border-top: 1px solid var(--line);
  }
  .homes-facts > div {
    padding: 1rem 1rem 1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .homes-facts > div:nth-child(2n) { padding-inline-start: 1rem; }
  .homes-facts dt {
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .homes-facts dd {
    margin-top: 0.35rem;
    font-size: 1.05rem;
    font-weight: 500;
  }
  @media (max-width: 960px) {
    .homes-stage {
      grid-template-columns: 1fr;
      min-height: 0;
    }
    .homes-media {
      min-height: 0;
      aspect-ratio: 16 / 10;
    }
    .homes-panel {
      padding-inline: var(--pad);
      width: min(var(--wrap), calc(100% - 2 * var(--pad)));
      margin-inline: auto;
    }
  }
</style>
