---
import { getHome } from '../data/content';
import { localePath, type Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { commerce } = getHome(locale);
const href = (h: string) => (h.startsWith('/') ? localePath(locale, h) : h);
---
<section class="commerce" id="commerces">
  <div class="wrap commerce-grid">
    <div class="commerce-copy" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'المحلات التجارية' : 'Fonds de commerce'}</p>
      <h2 class="display">{commerce.h2}</h2>
      <p class="lead">{commerce.p1}</p>
      <p class="lead">{commerce.p2}</p>

      <dl class="commerce-facts">
        {commerce.facts.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
      <a class="btn btn-ghost" href={href(commerce.cta.href)}>{commerce.cta.label}</a>
    </div>

    <figure class="commerce-media" data-media data-reveal>
      <img src={commerce.img} alt="" loading="lazy" decoding="async" />
    </figure>
  </div>
</section>

<style>
  .commerce {
    padding: var(--sec) 0;
    background: var(--bg);
  }
  .commerce-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap);
    align-items: center;
  }
  .commerce-copy .kick { margin: 0; }
  .commerce-copy .display { margin: 0.65rem 0 0; max-width: none; }
  .commerce-copy .lead { margin-top: 0.85rem; }
  .commerce-copy .lead + .lead { margin-top: 0.75rem; }
  .commerce-facts {
    display: grid;
    gap: 0;
    margin: 1.75rem 0 1.5rem;
    border-top: 1px solid var(--line);
  }
  .commerce-facts > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  .commerce-facts dt {
    font-size: 0.875rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--muted);
  }
  .commerce-facts dd {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.05rem;
    text-align: end;
    color: var(--ink);
  }
  .commerce-media {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    position: relative;
    isolation: isolate;
  }
  .commerce-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  .commerce:hover .commerce-media img {
    transform: scale(1.02);
  }
  @media (max-width: 900px) {
    .commerce-grid { grid-template-columns: 1fr; }
    .commerce-media {
      order: -1;
      aspect-ratio: 16 / 10;
    }
  }
</style>
