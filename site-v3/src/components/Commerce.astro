---
import { getHome } from '../data/content';
import { localePath, type Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { commerce } = getHome(locale);
const href = (h: string) => (h.startsWith('/') ? localePath(locale, h) : h);
---
<section class="commerce" id="commerces">
  <div class="wrap commerce-grid">
    <div class="commerce-copy" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'المحلات التجارية' : 'Fonds de commerce'}</p>
      <h2 class="display">{commerce.h2}</h2>
      <p class="lead">{commerce.p1}</p>
      <p class="lead">{commerce.p2}</p>
    </div>

    <div class="commerce-side" data-reveal>
      <dl class="commerce-facts">
        {commerce.facts.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
      <a class="btn btn-ghost" href={href(commerce.cta.href)}>{commerce.cta.label}</a>
    </div>
  </div>
</section>

<style>
  .commerce {
    padding: var(--sec) 0;
    background: var(--bg);
  }
  .commerce-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap);
    align-items: start;
  }
  .commerce-copy .kick { margin: 0; }
  .commerce-copy .display { margin: 0.65rem 0 0; max-width: none; }
  .commerce-copy .lead { margin-top: 0.85rem; }
  .commerce-copy .lead + .lead { margin-top: 0.75rem; }
  .commerce-facts {
    display: grid;
    gap: 0.15rem;
    margin-bottom: 2rem;
  }
  .commerce-facts > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
  }
  .commerce-facts > div:last-child { border-bottom: 0; }
  .commerce-facts dt {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--muted);
  }
  .commerce-facts dd {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.05rem;
    text-align: end;
    color: var(--ink);
  }
  @media (max-width: 900px) {
    .commerce-grid { grid-template-columns: 1fr; }
  }
</style>
