---
import { getHome } from '../data/content';
import { localePath, type Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { commerce } = getHome(locale);
const keep = (t: string) => t.replace(/(\d) (?=\d|DH|m)/g, '$1 ');
const href = (h: string) => (h.startsWith('/') ? localePath(locale, h) : h);
---
<section class="commerce" id="commerces">
  <div class="wrap commerce-grid">
    <div class="commerce-copy" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'المحلات التجارية' : 'Fonds de commerce'}</p>
      <h2 class="display">{commerce.h2}</h2>
      <p class="lead">{commerce.p1}</p>
      <p class="lead">{commerce.p2}</p>

      <dl class="facts">
        {commerce.facts.map(([k, v], i) => (
          <div>
            <dt>{k}</dt>
            <dd>{keep(v)}</dd>
          </div>
        ))}
      </dl>
      <a class="btn btn-solid" href={href(commerce.cta.href)}>
        {commerce.cta.label}
        <span aria-hidden="true">→</span>
      </a>
    </div>

    <figure class="commerce-media" data-reveal>
      <img src={commerce.img} alt="" loading="lazy" decoding="async" />
    </figure>
  </div>
</section>

<style>
  .commerce {
    padding: var(--sec) 0;
    background: var(--paper);
  }
  .commerce-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }
  .commerce-copy {
    display: grid;
    gap: 0.9rem;
    max-width: 38rem;
  }
  .commerce-copy .kick { margin: 0; }
  .commerce-copy .display {
    margin: 0.35rem 0 0;
    max-width: none;
    font-size: clamp(2rem, 3.8vw, 3rem);
  }
  .commerce-copy .lead { margin: 0; font-size: 1rem; }

  .commerce .btn { justify-self: start; margin-top: 0.35rem; }
  .commerce-media {
    margin: 0;
    aspect-ratio: 4 / 5;
    max-height: 36rem;
    width: 100%;
    overflow: hidden;
    border-radius: 0 clamp(6rem, 16vw, 12rem) 0 0;
  }
  .commerce-media img { width: 100%; height: 100%; object-fit: cover; }

  @media (max-width: 900px) {
    .commerce-grid { grid-template-columns: 1fr; }
    .commerce-media {
      order: -1;
      aspect-ratio: 16 / 11;
      max-height: none;
      border-radius: var(--radius) var(--radius) 0 0;
    }
    .commerce-copy { max-width: none; }
    .commerce-copy .display { font-size: clamp(1.75rem, 7vw, 2.4rem); }
    .commerce .btn { justify-self: stretch; }
  }
</style>
