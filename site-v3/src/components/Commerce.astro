---
import { getHome } from '../data/content';
import { localePath, type Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { commerce } = getHome(locale);
const href = (h: string) => (h.startsWith('/') ? localePath(locale, h) : h);
---
<section class="commerce" id="commerces">
  <div class="wrap commerce-grid">
    <div class="commerce-copy" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'المحلات التجارية' : 'Fonds de commerce'}</p>
      <h2 class="display">{commerce.h2}</h2>
      <p class="lead">{commerce.p1}</p>
      <p class="lead">{commerce.p2}</p>
    </div>

    <div class="commerce-side" data-reveal>
      <dl class="commerce-facts">
        {commerce.facts.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
      <a class="btn btn-ghost" href={href(commerce.cta.href)}>{commerce.cta.label}</a>
    </div>
  </div>
</section>

<style>
  .commerce {
    padding: var(--sec) 0;
    background: var(--bg);
  }
  .commerce-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2.5rem, 7vw, 7rem);
    align-items: end;
  }
  .commerce-copy .display { margin: 1rem 0 0.25rem; max-width: 16ch; }
  .commerce-copy .lead + .lead { margin-top: 0.85rem; }
  .commerce-facts {
    margin-bottom: 2rem;
    border-top: 1px solid var(--line);
  }
  .commerce-facts > div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .commerce-facts dt {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .commerce-facts dd {
    font-weight: 500;
    text-align: end;
  }
  @media (max-width: 900px) {
    .commerce-grid { grid-template-columns: 1fr; }
  }
</style>
