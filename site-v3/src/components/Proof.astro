---
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { proof } = getHome(locale);
const items = locale === 'ar' ? proof.slice(0, 3) : proof;
---
<section class="proof" id="proof" aria-label="Points clés" data-proof>
  <ul class="wrap proof-bar">
    {items.map((item, i) => (
      <li data-proof-item>
        <span class="proof-ico" aria-hidden="true">
          {i % 3 === 0 && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 12h18v5H3z" />
              <path d="M5 12V9h5v3" />
              <path d="M14 12V9h5v3" />
              <path d="M3 17v2" />
              <path d="M21 17v2" />
            </svg>
          )}
          {i % 3 === 1 && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 11.5 12 5l8 6.5V19a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1z" />
              <path d="M9 20v-6h6v6" />
            </svg>
          )}
          {i % 3 === 2 && (
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
              <rect x="5" y="6" width="14" height="14" rx="1" />
              <path d="M8 4v3" />
              <path d="M16 4v3" />
              <path d="M5 10h14" />
            </svg>
          )}
        </span>
        <p>{item}</p>
      </li>
    ))}
  </ul>
</section>

<style is:global>
  #proof.proof {
    position: relative;
    z-index: 1;
    padding: 0;
    color: var(--ink);
    background: transparent;
  }

  #proof .proof-bar {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    list-style: none;
    margin: 0;
    padding: 0;
    width: 100%;
    max-width: none;
    margin: 0;
    padding-inline: var(--pad);
    background: var(--cream);
  }

  #proof .proof-bar li {
    display: grid !important;
    grid-template-columns: auto auto;
    align-items: center;
    align-content: center;
    gap: 1rem;
    justify-items: start;
    justify-content: center;
    min-height: 6.25rem;
    padding: 1.6rem clamp(1rem, 2.5vw, 2rem);
    text-align: start;
  }

  #proof .proof-ico {
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--gold) 14%, transparent);
    color: var(--ink);
  }
  #proof .proof-ico svg {
    width: 1.3rem;
    height: 1.3rem;
  }

  #proof .proof-bar p {
    margin: 0;
    max-width: 15rem;
    font-size: clamp(0.95rem, 1.1vw, 1.05rem);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.4;
    color: var(--ink);
    text-wrap: balance;
  }

  @media (max-width: 800px) {
    #proof .proof-bar {
      grid-template-columns: 1fr;
    }
    #proof .proof-bar li {
      grid-template-columns: auto 1fr;
      justify-items: start;
      text-align: start;
      gap: 0.9rem;
      min-height: 0;
      justify-content: start;
      padding: 0.95rem 0;
    }
    #proof .proof-bar li + li {
      border-top: 1px solid color-mix(in srgb, var(--gold) 35%, transparent);
    }
    #proof .proof-bar p {
      max-width: none;
    }
  }
</style>
