---
import { proof } from '../data/home';
---
<section class="proof" id="proof" aria-label="Points clés">
  <ul class="wrap proof-rail">
    {proof.map((item) => (
      <li><span>{item}</span></li>
    ))}
  </ul>
</section>
<style>
  .proof {
    padding: clamp(1.35rem, 3vw, 1.85rem) 0;
    background: var(--cream);
    border-bottom: 1px solid var(--line);
  }

  .proof-rail {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0;
    list-style: none;
    margin: 0 auto;
    padding: 0;
    align-items: center;
    justify-items: center;
    text-align: center;
  }

  .proof-rail li {
    position: relative;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 0.25rem clamp(0.4rem, 1vw, 0.85rem);
    min-width: 0;
    box-sizing: border-box;
  }

  .proof-rail li:not(:last-child)::after {
    content: '';
    position: absolute;
    right: 0;
    top: 50%;
    width: 0.28rem;
    height: 0.28rem;
    border-radius: 50%;
    background: var(--gold);
    transform: translate(50%, -50%);
  }

  .proof-rail span {
    display: block;
    width: 100%;
    max-width: 14ch;
    margin-inline: auto;
    text-align: center;
    font-size: clamp(0.78rem, 1.05vw, 0.92rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--ink);
  }

  @media (max-width: 900px) {
    .proof-rail {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 0.85rem;
    }
    .proof-rail li:nth-child(3)::after { display: none; }
    .proof-rail span { max-width: none; }
  }

  @media (max-width: 560px) {
    .proof-rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .proof-rail li:nth-child(2n)::after { display: none; }
  }
</style>
