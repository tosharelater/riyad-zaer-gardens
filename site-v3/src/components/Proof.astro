---
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { proof } = getHome(locale);
---
<section class="proof" id="proof" aria-label="Points clés" data-proof>
  <ul class="wrap proof-grid">
    {proof.map((item) => (
      <li data-proof-item>
        <span class="proof-mark" aria-hidden="true"></span>
        <p>{item}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .proof {
    position: relative;
    z-index: 1;
    color: var(--ink);
    padding: clamp(3.25rem, 7vw, 5.25rem) 0 clamp(2.25rem, 4.5vw, 3.25rem);
    background: transparent;
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.75rem, 4vw, 3.25rem);
    list-style: none;
  }

  .proof-grid li {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .proof-mark {
    display: block;
    width: 2rem;
    height: 2px;
    background: var(--gold-text);
    transform-origin: left center;
  }

  .proof-grid p {
    margin: 0;
    max-width: 14ch;
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.35rem, 2.4vw, 1.85rem);
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: var(--ink);
    text-wrap: balance;
  }

  @media (max-width: 800px) {
    .proof-grid {
      grid-template-columns: 1fr;
      gap: 1.75rem;
    }
    .proof-grid p {
      max-width: 22ch;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .proof-mark { transform: none; }
  }
</style>
