---
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { proof } = getHome(locale);
---
<section class="proof" id="proof" aria-label="Points clés">
  <figure class="proof-media" aria-hidden="true">
    <img src="/photos/facade-golden.jpg" alt="" loading="lazy" decoding="async" />
  </figure>
  <div class="proof-shade" aria-hidden="true"></div>

  <ul class="wrap proof-grid">
    {proof.map((item) => (
      <li>
        <p>{item}</p>
      </li>
    ))}
  </ul>
</section>

<style>
  .proof {
    position: relative;
    isolation: isolate;
    min-height: min(42svh, 22rem);
    display: grid;
    align-items: end;
    overflow: hidden;
    color: var(--cream);
  }

  .proof-media {
    position: absolute;
    inset: 0;
    margin: 0;
    z-index: -2;
  }
  .proof-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
  }

  .proof-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, color-mix(in srgb, var(--ink) 92%, transparent) 0%, color-mix(in srgb, var(--ink) 55%, transparent) 55%, color-mix(in srgb, var(--ink) 28%, transparent) 100%),
      linear-gradient(90deg, color-mix(in srgb, var(--ink) 35%, transparent), transparent 50%);
  }

  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    width: min(var(--wrap), calc(100% - 2 * var(--pad)));
    margin-inline: auto;
    padding: clamp(3rem, 7vw, 5rem) 0 clamp(2.25rem, 4.5vw, 3rem);
    list-style: none;
  }

  .proof-grid li {
    padding: 0 clamp(1.25rem, 2.5vw, 2rem);
  }
  .proof-grid li:first-child {
    padding-inline-start: 0;
  }
  .proof-grid li:last-child {
    padding-inline-end: 0;
  }
  .proof-grid li + li {
    border-inline-start: 1px solid color-mix(in srgb, var(--cream) 18%, transparent);
  }

  .proof-grid p {
    margin: 0;
    max-width: 14ch;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.25rem, 2.2vw, 1.7rem);
    letter-spacing: -0.03em;
    line-height: 1.25;
    text-wrap: balance;
  }

  @media (max-width: 800px) {
    .proof {
      min-height: 0;
    }
    .proof-grid {
      grid-template-columns: 1fr;
      gap: 0;
      padding-block: 2.5rem 2rem;
    }
    .proof-grid li {
      padding: 1.15rem 0;
    }
    .proof-grid li + li {
      border-inline-start: 0;
      border-top: 1px solid color-mix(in srgb, var(--cream) 18%, transparent);
    }
    .proof-grid p {
      max-width: none;
    }
  }
</style>
