---
import { getHome } from '../data/content';
import { localePath, type Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { hero } = getHome(locale);
const href = (h: string) => (h.startsWith('/') ? localePath(locale, h) : h);
const [priceLead, priceValue] = (() => {
  const m = hero.price.match(/^(.*?)(\d[\d\s  ]*\d.*)$/);
  return m ? [m[1].trim(), m[2].trim()] : ['', hero.price];
})();
---
<section class="hero" id="top" data-hero>
  <div class="hero-media" data-hero-media>
    <img src="/photos/facade-nuit.jpg" alt={hero.alt} fetchpriority="high" decoding="async" />
  </div>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="hero-copy wrap" data-split>
    <h1 class="hero-title">
      <span class="hero-brand" data-hero-brand>Riyad Zaer Gardens</span>
      <span class="hero-place" data-hero-in>{hero.kicker}</span>
    </h1>

    <div class="hero-foot">
      <p class="hero-sub" data-hero-in>{hero.sub}</p>
      <div class="hero-row" data-hero-in>
        <p class="hero-price">
          {priceLead && <span>{priceLead}</span>}
          <strong>{priceValue}</strong>
        </p>
        <div class="hero-actions">
          <a class="btn btn-solid" href={href(hero.primary.href)}>{hero.primary.label}</a>
          <a class="btn btn-light" href={href(hero.secondary.href)}>{hero.secondary.label}</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: min(100svh, 62rem);
    min-height: min(100dvh, 62rem);
    display: grid;
    align-items: end;
    color: var(--cream);
    overflow: hidden;
    isolation: isolate;
  }

  .hero-media {
    position: absolute;
    inset: -12% -3% -3%;
    z-index: -2;
    overflow: hidden;
  }
  .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 48%;
    transform: scale(1.06);
  }
  :global(html:not(.intro-lock)) .hero-media {
    animation: hero-curtain 1.6s var(--ease-io) both;
  }
  :global(html:not(.intro-lock)) .hero-media img {
    animation: hero-settle 2.8s var(--ease) both;
  }

  .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(to top, rgb(0 0 0 / 0.72) 0%, rgb(0 0 0 / 0.32) 40%, rgb(0 0 0 / 0) 68%),
      linear-gradient(to bottom, rgb(0 0 0 / 0.35), transparent 22%);
  }

  .hero-copy {
    padding-top: calc(var(--nav) + 3.5rem);
    padding-bottom: clamp(3rem, 7vw, 5rem);
  }

  .hero-title {
    display: grid;
    gap: clamp(0.85rem, 1.8vw, 1.5rem);
    font-weight: 400;
  }
  .hero-brand {
    font-family: var(--audrey);
    font-size: clamp(2.6rem, 7vw, 5.5rem);
    letter-spacing: -0.03em;
    word-spacing: 0.04em;
    line-height: 0.95;
    color: var(--cream);
    color: #fff;
  }
  .hero-brand :global(.w > span) { transform: translateY(110%); }
  :global([dir='rtl']) .hero-brand { direction: ltr; unicode-bidi: isolate; text-align: right; }
  .hero-place {
    font-family: var(--font);
    font-size: clamp(1.35rem, 2.6vw, 2.1rem);
    font-weight: 600;
    letter-spacing: -0.022em;
    line-height: 1.15;
    color: #fff;
    max-width: 32rem;
  }

  .hero-foot {
    margin-top: clamp(1rem, 2vw, 1.4rem);
    display: grid;
    gap: clamp(1.5rem, 3vw, 2rem);
    align-items: start;
  }

  .hero-sub {
    max-width: 34rem;
    font-size: clamp(1.0625rem, 1.4vw, 1.25rem);
    line-height: 1.45;
    color: rgb(255 255 255 / 0.86);
    text-wrap: pretty;
  }

  .hero-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.75rem;
  }

  .hero-price {
    display: grid;
    gap: 0.25rem;
  }
  .hero-price span {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: rgb(255 255 255 / 0.72);
  }
  .hero-price strong {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.45rem, 2.2vw, 1.85rem);
    line-height: 1;
    letter-spacing: -0.02em;
    color: #fff;
    white-space: nowrap;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  [data-hero-in] {
    opacity: 0;
    transform: translateY(1.2rem);
  }
  :global(html:not(.intro-lock)) [data-hero-in] {
    animation: rise 1.1s var(--ease) both;
  }
  :global(html:not(.intro-lock)) .hero-place { animation-delay: 0.55s; }
  :global(html:not(.intro-lock)) .hero-sub { animation-delay: 0.75s; }
  :global(html:not(.intro-lock)) .hero-row { animation-delay: 0.9s; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(1.2rem); }
    to { opacity: 1; transform: none; }
  }
  @keyframes hero-curtain {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes hero-settle {
    from { transform: scale(1.06); }
    to { transform: scale(1); }
  }

  @media (max-width: 700px) {
    .hero-row { flex-direction: column; align-items: flex-start; }
  }
  @media (max-width: 800px) {
    .hero-copy { padding-bottom: 6.5rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-media,
    .hero-media img,
    :global(html:not(.intro-lock)) .hero-media,
    :global(html:not(.intro-lock)) .hero-media img {
      animation: none;
      transform: none;
    }
    [data-hero-in] { opacity: 1; transform: none; }
  }
</style>
