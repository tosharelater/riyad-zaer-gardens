---
import { getHome } from '../data/content';
import { localePath, type Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { hero } = getHome(locale);
const href = (h: string) => (h.startsWith('/') ? localePath(locale, h) : h);
---
<section class="hero" id="top" data-hero>
  <div class="hero-media" data-hero-media>
    <img src="/photos/facade-golden.jpg" alt={hero.alt} fetchpriority="high" decoding="async" />
  </div>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="hero-copy wrap" data-split>
    <h1 class="hero-title">
      <span class="hero-brand" data-hero-brand>Riyad Zaer Gardens</span>
      <span class="hero-place" data-hero-in>{hero.kicker}</span>
    </h1>
    <p class="hero-sub" data-hero-in>{hero.sub}</p>
    <div class="hero-actions" data-hero-in>
      <a class="btn btn-solid" href={href(hero.primary.href)}>
        {hero.primary.label}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

<style is:global>
  #top.hero {
    position: relative;
    min-height: 100svh;
    min-height: 100dvh;
    display: grid;
    align-items: center;
    color: var(--ink);
    overflow: hidden;
    isolation: isolate;
    background: var(--cream);
  }

  #top .hero-media {
    position: absolute;
    inset: 0 0 0 auto;
    width: min(66%, 60rem);
    z-index: -2;
    overflow: hidden;
    border-radius: 0;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgb(0 0 0 / 0.35) 22%, #000 58%);
    mask-image: linear-gradient(to right, transparent 0%, rgb(0 0 0 / 0.35) 22%, #000 58%);
  }
  #top .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 85% center;
    transform: scale(1.04);
  }
  html:not(.intro-lock) #top .hero-media {
    animation: hero-curtain 1.4s var(--ease-io) both;
  }
  html:not(.intro-lock) #top .hero-media img {
    animation: hero-settle 2.6s var(--ease) both;
  }

  #top .hero-shade { display: none; }

  #top .hero-copy {
    width: min(var(--wrap), calc(100% - 2 * var(--pad)));
    max-width: none;
    justify-items: start;
    padding-top: calc(var(--nav) + 2.75rem);
    padding-bottom: clamp(3rem, 7vw, 4.5rem);
    display: grid;
    gap: 1.1rem;
  }

  #top .hero-kick {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin: 0;
    font-size: 0.76rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--gold-text);
  }
  #top .hero-kick-rule {
    display: block;
    width: 2.5rem;
    height: 1.5px;
    background: var(--gold-text);
  }

  #top .hero-title {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    font-weight: 400;
    max-width: 44rem;
  }
  #top .hero-brand {
    font-family: var(--audrey);
    font-size: clamp(2.5rem, 5.4vw, 4.4rem);
    letter-spacing: 0.06em;
    word-spacing: 0.04em;
    line-height: 1.05;
    text-transform: uppercase;
    color: var(--ink);
    font-weight: 400;
  }
  #top .hero-brand .w > span {
    transform: translateY(110%);
  }
  [dir='rtl'] #top .hero-brand {
    direction: ltr;
    unicode-bidi: isolate;
    text-align: right;
  }
  #top .hero-place {
    font-family: var(--font);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--canopy);
    max-width: 26rem;
    text-wrap: balance;
  }

  #top .hero-sub {
    margin: 0;
    max-width: 30rem;
    font-size: clamp(0.98rem, 1.2vw, 1.08rem);
    line-height: 1.55;
    color: var(--ink);
    text-wrap: pretty;
  }

  #top .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 0.45rem;
  }
  #top .hero-actions .btn {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
  }

  #top [data-hero-in] {
    opacity: 0;
    transform: translateY(1rem);
  }
  html:not(.intro-lock) #top [data-hero-in] {
    animation: rise 1s var(--ease) both;
  }
  html:not(.intro-lock) #top .hero-place { animation-delay: 0.35s; }
  html:not(.intro-lock) #top .hero-sub { animation-delay: 0.5s; }
  html:not(.intro-lock) #top .hero-actions { animation-delay: 0.65s; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(1rem); }
    to { opacity: 1; transform: none; }
  }
  @keyframes hero-curtain {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes hero-settle {
    from { transform: scale(1.04); }
    to { transform: scale(1); }
  }

  @media (max-width: 800px) {
    #top.hero {
      min-height: min(92svh, 44rem);
      align-items: end;
    }
    #top .hero-media {
      inset: 0;
      width: 100%;
      -webkit-mask-image: linear-gradient(to top, transparent 0%, transparent 22%, #000 68%);
      mask-image: linear-gradient(to top, transparent 0%, transparent 22%, #000 68%);
    }
    #top .hero-media img {
      object-position: center 40%;
    }
    #top .hero-copy {
      gap: 0.85rem;
      padding-top: calc(var(--nav) + 1.5rem);
      padding-bottom: 2.25rem;
    }
    #top .hero-title { gap: 0.55rem; }
    #top .hero-brand {
      font-size: clamp(2rem, 9.5vw, 2.65rem);
      letter-spacing: 0.04em;
      line-height: 1.08;
    }
    #top .hero-place {
      font-size: clamp(1.05rem, 4.4vw, 1.25rem);
      max-width: 22rem;
    }
    #top .hero-sub {
      font-size: 0.95rem;
      line-height: 1.5;
      max-width: 28rem;
    }
    #top .hero-actions { margin-top: 0.15rem; }
    #top .hero-actions .btn { min-height: 3.1rem; padding-inline: 1.35rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    #top .hero-media,
    #top .hero-media img,
    html:not(.intro-lock) #top .hero-media,
    html:not(.intro-lock) #top .hero-media img {
      animation: none;
      transform: none;
    }
    #top [data-hero-in] { opacity: 1; transform: none; }
    #top .hero-brand .w > span { transform: none; }
  }
</style>
