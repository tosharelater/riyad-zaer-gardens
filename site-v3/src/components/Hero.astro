---
import { getHome } from '../data/content';
import { localePath, type Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { hero } = getHome(locale);
// "Nouveau pôle urbain à 25 minutes de Rabat" -> two lines, second one accented
const cut = hero.kicker.search(/\s(à|من)\s/u);
const [titleA, titleB] = cut > 0 ? [hero.kicker.slice(0, cut), hero.kicker.slice(cut + 1)] : [hero.kicker, ''];
const href = (h: string) => (h.startsWith('/') ? localePath(locale, h) : h);
// "Appartements à partir de 420 000 DH" -> small lead + big figure
const [priceLead, priceValue] = (() => {
  const m = hero.price.match(/^(.*?)(\d[\d\s  ]*\d.*)$/);
  return m ? [m[1].trim(), m[2].trim().replace(/(\d) (?=\d|DH)/g, '$1 ')] : ['', hero.price];
})();
---
<section class="hero" id="top" data-hero>
  <div class="hero-media" data-hero-media>
    <img src="/photos/facade-nuit.webp" alt={hero.alt} fetchpriority="high" decoding="async" />
  </div>
  <div class="hero-shade" aria-hidden="true"></div>

  <div class="hero-copy wrap" data-split>
    <h1 class="hero-title">
      <span class="hero-brand" data-hero-brand>{titleA}</span>
      {titleB && <span class="hero-brand is-accent" data-hero-brand>{titleB}</span>}
    </h1>
    <p class="hero-sub" data-hero-in>{hero.sub}</p>
    <div class="hero-foot" data-hero-in>
      <p class="hero-price">
        {priceLead && <span>{priceLead}</span>}
        <strong>{priceValue}</strong>
      </p>
      <div class="hero-actions">
        <a class="btn btn-solid" href={href(hero.primary.href)}>
          {hero.primary.label}
        </a>
        <a class="btn btn-light" href={href(hero.secondary.href)}>{hero.secondary.label}</a>
      </div>
    </div>
  </div>
</section>

<style is:global>
  #top.hero {
    position: relative;
    min-height: 100svh;
    min-height: 100dvh;
    display: grid;
    align-items: end;
    color: var(--cream);
    overflow: hidden;
    isolation: isolate;
    background: var(--ink);
  }

  #top .hero-media {
    position: absolute;
    inset: 0;
    z-index: -2;
    overflow: hidden;
  }
  #top .hero-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 62% center;
    transform: scale(1.04);
  }
  html:not(.intro-lock) #top .hero-media {
    animation: hero-curtain 1.4s var(--ease-io) both;
  }
  html:not(.intro-lock) #top .hero-media img {
    animation: hero-settle 2.6s var(--ease) both;
  }

  #top .hero-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(to bottom, rgb(0 36 36 / 0.72) 0%, rgb(0 36 36 / 0.38) 7rem, transparent 14rem),
      linear-gradient(to top, rgb(0 36 36 / 0.88) 0%, rgb(0 36 36 / 0.45) 38%, transparent 62%),
      linear-gradient(100deg, rgb(0 36 36 / 0.7) 0%, rgb(0 36 36 / 0.3) 45%, transparent 75%);
  }

  #top .hero-copy {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    padding-top: calc(var(--nav) + 2.75rem);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  #top .hero-title {
    display: grid;
    gap: 0.05em;
    margin: 0;
    max-width: none;
    font-weight: 400;
  }
  #top .hero-brand {
    display: block;
    font-family: var(--font);
    font-size: clamp(2.2rem, 5.4vw, 4.9rem);
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-transform: none;
    color: var(--paper);
  }
  #top .hero-brand.is-accent { color: var(--gold-soft); }
  #top .hero-brand .w > span {
    transform: translateY(110%);
  }
  [dir='rtl'] #top .hero-brand {
    direction: rtl;
    text-align: right;
  }
  #top .hero-place {
    font-family: var(--font);
    font-size: clamp(1.15rem, 2vw, 1.5rem);
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.3;
    color: var(--gold-soft);
    max-width: 28rem;
    text-wrap: balance;
  }

  #top .hero-sub {
    margin: 0;
    max-width: 38rem;
    font-size: clamp(0.98rem, 1.35vw, 1.22rem);
    line-height: 1.6;
    color: rgb(246 240 228 / 0.88);
    text-wrap: pretty;
  }

  #top .hero-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.25rem 2.25rem;
    margin-top: 0.5rem;
  }
  #top .hero-price {
    display: grid;
    gap: 0.1rem;
    margin: 0;
  }
  #top .hero-price span {
    font-size: 0.82rem;
    color: rgb(246 240 228 / 0.75);
  }
  #top .hero-price strong {
    font-family: var(--font);
    font-weight: 300;
    font-size: clamp(1.9rem, 3.2vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--gold);
    white-space: nowrap;
  }
  #top .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
  }

  /* Gold primary, outlined secondary */
  #top .hero-actions { align-items: center; gap: 0.75rem; }
  #top .hero-actions .btn {
    min-height: 3.25rem;
    padding-inline: 1.6rem;
    border-radius: 10px;
    font-weight: 600;
  }
  #top .hero-actions .btn-light {
    background: rgb(0 36 36 / 0.25);
    border-color: rgb(255 252 244 / 0.75);
  }
  #top .hero-actions .btn-light:hover { background: var(--paper); color: var(--ink); }

  #top [data-hero-in] {
    opacity: 0;
    transform: translateY(1rem);
  }
  html:not(.intro-lock) #top [data-hero-in] {
    animation: rise 1s var(--ease) both;
  }
  html:not(.intro-lock) #top .hero-sub { animation-delay: 0.35s; }
  html:not(.intro-lock) #top .hero-foot { animation-delay: 0.65s; }

  @keyframes rise {
    from { opacity: 0; transform: translateY(1rem); }
    to { opacity: 1; transform: none; }
  }
  @keyframes hero-curtain {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes hero-settle {
    from { transform: scale(1.04); }
    to { transform: scale(1); }
  }

  @media (max-width: 800px) {
    #top .hero-copy { padding-bottom: 6.5rem; }
    #top .hero-media img { object-position: 60% center; }
    #top .hero-shade {
      background:
        linear-gradient(to bottom, rgb(0 36 36 / 0.6) 0%, transparent 8rem),
        linear-gradient(to top, rgb(0 36 36 / 0.92) 0%, rgb(0 36 36 / 0.62) 50%, rgb(0 36 36 / 0.25) 100%);
    }
    #top .hero-actions .btn { flex: 1 1 11rem; }
  }

  @media (prefers-reduced-motion: reduce) {
    #top .hero-media,
    #top .hero-media img,
    html:not(.intro-lock) #top .hero-media,
    html:not(.intro-lock) #top .hero-media img {
      animation: none;
      transform: none;
    }
    #top [data-hero-in] { opacity: 1; transform: none; }
    #top .hero-brand .w > span { transform: none; }
  }
</style>
