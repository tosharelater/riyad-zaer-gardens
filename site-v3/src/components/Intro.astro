---
---
<div class="intro" data-intro aria-hidden="true">
  <div class="intro-veil"></div>
  <div class="intro-mark">
    <img src="/brand/logo-light.png" alt="" width="280" height="182" />
    <p>Riyad Zaer Gardens</p>
    <span class="intro-line"></span>
  </div>
</div>

<script>
  const el = document.querySelector<HTMLElement>('[data-intro]');
  if (el) {
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    document.documentElement.classList.add('intro-lock');
    const done = () => {
      el.classList.add('is-out');
      document.documentElement.classList.remove('intro-lock');
      window.dispatchEvent(new Event('rz:ready'));
      window.setTimeout(() => el.remove(), 1100);
    };
    if (reduce) done();
    else window.setTimeout(done, 2100);
  }
</script>

<style is:global>
  html.intro-lock, html.intro-lock body { overflow: hidden; height: 100%; }
  .intro {
    position: fixed; inset: 0; z-index: 200;
    display: grid; place-items: center;
    background: var(--ink);
    transition: opacity 0.95s var(--ease), visibility 0.95s;
  }
  .intro.is-out { opacity: 0; visibility: hidden; pointer-events: none; }
  .intro-veil {
    position: absolute; inset: 0;
    background:
      radial-gradient(ellipse 50% 40% at 50% 45%, rgb(200 181 104 / 0.12), transparent 70%);
    animation: intro-veil 2s var(--ease) both;
  }
  .intro-mark {
    position: relative;
    display: grid;
    place-items: center;
    gap: 1rem;
  }
  .intro img {
    width: min(11rem, 40vw); height: auto;
    animation: intro-up 1.1s var(--ease) both;
  }
  .intro p {
    font-size: 0.72rem; letter-spacing: 0.32em; text-transform: uppercase;
    color: rgb(247 242 232 / 0.7);
    animation: intro-up 1.1s 0.18s var(--ease) both;
  }
  .intro-line {
    display: block;
    width: 0;
    height: 1px;
    background: var(--gold);
    animation: intro-line 1s 0.55s var(--ease) both;
  }
  @keyframes intro-up {
    from { opacity: 0; transform: translateY(18px); }
    to { opacity: 1; transform: none; }
  }
  @keyframes intro-line {
    from { width: 0; opacity: 0; }
    to { width: 4.5rem; opacity: 1; }
  }
  @keyframes intro-veil {
    from { opacity: 0; transform: scale(0.92); }
    to { opacity: 1; transform: none; }
  }
</style>
