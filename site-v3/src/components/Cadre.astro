---
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { projet } = getHome(locale);

const highlights = projet.amenities.slice(0, 4).map((label, i) => ({
  label,
  icon: i,
}));
---
<section class="cadre" id="projet">
  <div class="cadre-media" aria-hidden="true">
    <img src="/photos/facade-sunset.jpg" alt="" loading="lazy" decoding="async" />
  </div>

  <div class="wrap cadre-shell">
    <article class="cadre-card" data-reveal data-split>
      <p class="kick">
        <span>{locale === 'ar' ? 'المشروع' : 'Le projet'}</span>
        <span class="kick-rule" aria-hidden="true"></span>
      </p>
      <h2 class="display">{projet.h2}</h2>
      <p class="lead">{projet.p1}</p>

      <ul class="cadre-icons">
        {highlights.map((h) => (
          <li>
            <span class="cadre-ico" aria-hidden="true">
              {h.icon === 0 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 20V10l8-6 8 6v10" />
                  <path d="M9 20v-6h6v6" />
                </svg>
              )}
              {h.icon === 1 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3v3" />
                  <path d="M7 21c0-4 2.2-7 5-7s5 3 5 7" />
                  <path d="M5 14c1.5-1 3.2-1.5 5-1.5" />
                  <path d="M19 14c-1.5-1-3.2-1.5-5-1.5" />
                </svg>
              )}
              {h.icon === 2 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M4 10h16v10H4z" />
                  <path d="M8 10V7l4-3 4 3v3" />
                </svg>
              )}
              {h.icon === 3 && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 3 4 7v5c0 5 3.5 8.5 8 9 4.5-.5 8-4 8-9V7z" />
                </svg>
              )}
            </span>
            <span>{h.label}</span>
          </li>
        ))}
      </ul>
    </article>
  </div>
</section>

<style>
  .cadre {
    position: relative;
    isolation: isolate;
    min-height: clamp(28rem, 62vw, 38rem);
    display: grid;
    align-items: center;
    padding: clamp(3.5rem, 7vw, 6rem) 0;
    overflow: hidden;
    color: var(--ink);
  }

  .cadre-media {
    position: absolute;
    inset: 0;
    z-index: -2;
  }
  .cadre-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }
  .cadre::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(105deg, transparent 45%, rgb(246 240 228 / 0.5) 70%, rgb(246 240 228 / 0.9) 100%);
  }

  .cadre-shell {
    display: grid;
    justify-items: end;
  }

  .cadre-card {
    width: min(100%, 30rem);
    background: color-mix(in srgb, var(--cream) 94%, white);
    padding: clamp(1.75rem, 3.5vw, 2.5rem);
    display: grid;
    gap: 0.95rem;
    border-radius: var(--radius);
    box-shadow: 0 24px 60px rgb(0 45 45 / 0.16);
  }
  .cadre-card .kick {
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 0.16em;
    font-size: 0.76rem;
    font-weight: 600;
  }
  .cadre-card .kick-rule {
    display: block;
    width: 2.5rem;
    height: 1.5px;
    background: var(--gold-text);
  }
  .cadre-card .display {
    margin: 0;
    font-size: clamp(1.85rem, 3.3vw, 2.55rem);
    max-width: none;
  }
  .cadre-card .lead {
    margin: 0;
    font-size: 0.98rem;
  }

  .cadre-icons {
    list-style: none;
    margin: 0.65rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem 1.15rem;
  }
  .cadre-icons li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.65rem;
    align-items: start;
    font-size: 0.85rem;
    font-weight: 500;
    line-height: 1.35;
    color: var(--ink);
  }
  .cadre-ico {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border-radius: 50%;
    background: color-mix(in srgb, var(--gold) 16%, transparent);
    color: var(--gold-text);
  }
  .cadre-ico svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  @media (max-width: 800px) {
    .cadre {
      min-height: 0;
      padding: 0 0 clamp(2.5rem, 8vw, 3.5rem);
    }
    .cadre::before {
      background: linear-gradient(to top, rgb(246 240 228 / 0.97) 0%, rgb(246 240 228 / 0.55) 55%, transparent 100%);
    }
    .cadre-shell {
      justify-items: stretch;
      padding-top: clamp(10rem, 52vw, 14rem);
    }
    .cadre-card {
      width: 100%;
      box-shadow: none;
      padding: 1.5rem 1.25rem;
      gap: 0.8rem;
    }
    .cadre-card .display {
      font-size: clamp(1.65rem, 6.5vw, 2.15rem);
    }
    .cadre-media {
      inset: 0 0 auto;
      height: min(52vw, 18rem);
      min-height: 12rem;
    }
  }
  @media (max-width: 480px) {
    .cadre-icons {
      grid-template-columns: 1fr;
      gap: 0.85rem;
    }
  }
</style>
