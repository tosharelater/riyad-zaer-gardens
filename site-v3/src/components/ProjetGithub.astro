---
import { getHome } from '../data/content';
import { localePath, type Locale } from '../i18n/paths';
import Icon from './Icon.astro';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { projet } = getHome(locale);

/** One icon per amenity, same order as the data */
const amenityIcons = ['arrow-up-down', 'trees', 'square-parking', 'shield-check', 'paint-roller', 'store'];

---
<section class="projet-gh" id="projet-a" data-compare="github">
  <div class="wrap">
    <div class="projet-gh-grid">
      <div class="projet-gh-copy" data-reveal data-split>
        <p class="kick">{locale === 'ar' ? 'المشروع' : 'Le projet'}</p>
        <h2 class="display">{projet.h2}</h2>
        <p class="lead">{projet.p1}</p>
        <p class="lead">{projet.p2}</p>
        <a class="projet-gh-link" href={projet.link.href.startsWith('/') ? localePath(locale, projet.link.href) : projet.link.href}>{projet.link.label}</a>
      </div>
      <figure class="projet-gh-photo" data-media>
        <img src="/photos/aerial-ilot.jpg" alt={projet.alt} loading="lazy" decoding="async" />
      </figure>
    </div>

    <ul class="projet-gh-amenities" data-reveal>
      {projet.amenities.map((a, i) => (
        <li>
          <Icon name={amenityIcons[i]} size="1.15rem" />
          <span>{a}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .projet-gh {
    padding: var(--sec) 0;
    background: var(--bg);
  }
  .projet-gh-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap);
    align-items: center;
  }
  .projet-gh-copy .kick { margin: 0; }
  .projet-gh-copy .display {
    margin: 0.65rem 0 0;
    max-width: none;
  }
  .projet-gh-copy .lead { margin-top: 0.85rem; }
  .projet-gh-copy .lead + .lead { margin-top: 0.75rem; }
  .projet-gh-photo {
    margin: 0;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    position: relative;
    isolation: isolate;
  }
  .projet-gh-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 40%;
    transition: transform 0.8s var(--ease);
  }
  .projet-gh:hover .projet-gh-photo img {
    transform: scale(1.02);
  }

  .projet-gh-amenities {
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem var(--gap);
  }
  .projet-gh-amenities li {
    display: grid;
    grid-template-columns: 1.25rem 1fr;
    gap: 0.75rem;
    align-items: start;
    font-size: 0.98rem;
    line-height: 1.45;
  }
  .projet-gh-amenities :global(.icon) { color: var(--gold-text); }

  @media (max-width: 900px) {
    .projet-gh-grid { grid-template-columns: 1fr; }
    .projet-gh-photo { aspect-ratio: 4 / 3; }
    .projet-gh-amenities { grid-template-columns: 1fr; }
  }
  @media (min-width: 901px) and (max-width: 1100px) {
    .projet-gh-amenities { grid-template-columns: 1fr 1fr; }
  }
</style>
