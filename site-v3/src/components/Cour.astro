---
import { getHome } from '../data/content';
import Icon from './Icon.astro';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { reasons } = getHome(locale);
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="reasons" id="pourquoi" aria-labelledby="reasons-title" data-reasons>
  <div class="why-stage">
    <div class="wrap">
      <header class="why-head" data-reveal data-split>
        <p class="kick">{locale === 'ar' ? 'لماذا هنا' : 'Pourquoi ici'}</p>
        <h2 class="display" id="reasons-title">{reasons.h2}</h2>
        <p class="lead">{reasons.lead}</p>
        <div class="why-meter" data-why-meter aria-hidden="true">
          {reasons.items.map((_, i) => <span data-tick={num(i)} />)}
        </div>
      </header>

      <ol class="why-cards" data-strips>
        {reasons.items.map((r, i) => (
          <li class="why-card" data-strip tabindex="0" aria-expanded="false">
            <div class="why-flip">
              <!-- front: the picture and the title -->
              <div class="why-face why-front" aria-hidden="true">
                <img src={r.img} alt="" loading="lazy" decoding="async" />
                <span class="why-mark">{num(i)}</span>
                <span class="why-hint"><Icon name="rotate-3d" size="1.05rem" strokeWidth={1.5} /></span>
                <p class="why-title">{r.title}</p>
              </div>
              <!-- back: the explanation -->
              <div class="why-face why-back">
                <span class="why-ghost" aria-hidden="true">{num(i)}</span>
                <h3>{r.title}</h3>
                <p>{r.body}</p>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style is:global>
  #pourquoi.reasons {
    position: relative;
    isolation: isolate;
    padding: var(--sec) 0;
    background:
      radial-gradient(55% 50% at 100% 0%, rgb(200 181 104 / 0.16), transparent 58%),
      radial-gradient(40% 45% at 0% 100%, rgb(200 181 104 / 0.08), transparent 60%),
      var(--canopy);
    color: var(--paper);
  }
  #pourquoi .why-stage { position: relative; }
  #pourquoi .why-head {
    display: grid;
    gap: 0.75rem;
    max-width: 40rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }
  #pourquoi .kick { color: var(--gold-soft); }
  #pourquoi .display { margin: 0; color: var(--paper); font-size: clamp(1.9rem, 4.2vw, 3.15rem); }
  #pourquoi .lead { margin: 0; color: var(--muted-on-dark); max-width: 34rem; }

  #pourquoi .why-meter {
    display: flex;
    gap: 0.45rem;
    margin-top: 0.35rem;
  }
  #pourquoi .why-meter span {
    width: 1.7rem;
    height: 2px;
    border-radius: 99px;
    background: rgb(246 240 228 / 0.22);
    transition: width 0.45s ease, background 0.45s ease;
  }
  #pourquoi .why-meter span.is-on {
    width: 3.4rem;
    background: var(--gold);
  }

  #pourquoi .why-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
    align-items: stretch;
  }

  /* ---------- the flip ---------- */
  #pourquoi .why-card {
    position: relative;
    min-height: clamp(24rem, 46vh, 32rem);
    border-radius: 24px;
    outline-offset: 4px;
    cursor: pointer;
    perspective: 1500px;
    -webkit-tap-highlight-color: transparent;
  }
  #pourquoi .why-flip {
    position: absolute;
    inset: 0;
    border-radius: 24px;
    transform-style: preserve-3d;
    /* a soft overshoot makes it feel like a physical card, not a switch */
    transition: transform 0.95s cubic-bezier(0.3, 1.15, 0.4, 1), filter 0.6s var(--ease);
    will-change: transform;
  }
  #pourquoi .why-card:hover .why-flip,
  #pourquoi .why-card:focus-visible .why-flip,
  #pourquoi .why-card.is-open .why-flip { transform: rotateY(180deg); }

  #pourquoi .why-face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 24px;
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    box-shadow: 0 18px 44px rgb(0 16 12 / 0.3);
  }

  /* front */
  #pourquoi .why-front img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.9s var(--ease);
  }
  #pourquoi .why-front::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(3 26 22 / 0.88) 0%, rgb(3 26 22 / 0.35) 38%, transparent 62%);
    pointer-events: none;
  }
  #pourquoi .why-card:hover .why-front img { transform: scale(1.06); }
  #pourquoi .why-mark {
    position: absolute;
    z-index: 1;
    top: 1.05rem;
    inset-inline-start: 1.1rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    color: var(--gold-soft);
  }
  #pourquoi .why-hint {
    position: absolute;
    z-index: 1;
    top: 0.85rem;
    inset-inline-end: 0.9rem;
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border-radius: 50%;
    color: var(--paper);
    background: rgb(4 28 24 / 0.45);
    border: 1px solid rgb(255 255 255 / 0.2);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  /* a gentle nudge now and then tells you the card turns */
  #pourquoi .why-hint { animation: why-nudge 5s ease-in-out infinite; }
  @keyframes why-nudge { 0%, 82%, 100% { transform: rotate(0); } 90% { transform: rotate(180deg); } }
  #pourquoi .why-title {
    position: absolute;
    z-index: 1;
    inset-inline: 1.15rem;
    bottom: 1.25rem;
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.2rem, 1.6vw, 1.5rem);
    line-height: 1.2;
    color: #fff;
    text-wrap: balance;
    text-shadow: 0 2px 18px rgb(0 0 0 / 0.5);
  }
  #pourquoi .why-title::before {
    content: '';
    display: block;
    width: 2rem;
    height: 1.5px;
    margin-bottom: 0.7rem;
    background: var(--gold);
  }

  /* back */
  #pourquoi .why-back {
    transform: rotateY(180deg);
    display: grid;
    align-content: center;
    gap: 0.8rem;
    padding: clamp(1.4rem, 2.4vw, 2rem);
    color: var(--paper);
    border: 1px solid rgb(214 178 92 / 0.3);
    background:
      radial-gradient(70% 55% at 100% 0%, rgb(214 178 92 / 0.2), transparent 70%),
      linear-gradient(160deg, #0f5246 0%, #082f29 100%);
  }
  #pourquoi .why-ghost {
    position: absolute;
    top: 0.2rem;
    inset-inline-end: 1rem;
    font-family: var(--display);
    font-weight: 200;
    font-size: clamp(5rem, 8vw, 7rem);
    line-height: 1;
    letter-spacing: -0.04em;
    color: rgb(214 178 92 / 0.16);
    pointer-events: none;
  }
  #pourquoi .why-back h3 {
    position: relative;
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.2rem, 1.5vw, 1.45rem);
    line-height: 1.2;
    color: #fff;
    text-wrap: balance;
  }
  #pourquoi .why-back h3::after {
    content: '';
    display: block;
    width: 2.25rem;
    height: 1.5px;
    margin-top: 0.75rem;
    background: var(--gold);
  }
  #pourquoi .why-back p {
    position: relative;
    margin: 0;
    color: rgb(246 240 228 / 0.86);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  @media (max-width: 900px) {
    #pourquoi .why-cards { grid-template-columns: 1fr 1fr; }
    #pourquoi .why-card { min-height: 22rem; }
  }
  @media (max-width: 560px) {
    #pourquoi .why-cards { grid-template-columns: 1fr; gap: 0.8rem; }
    #pourquoi .why-card { min-height: 20rem; border-radius: 20px; }
    #pourquoi .why-flip, #pourquoi .why-face { border-radius: 20px; }
  }

  /* touch screens flip on tap only, never on a stray hover */
  @media (hover: none) {
    #pourquoi .why-card:hover:not(.is-open) .why-flip { transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    #pourquoi .why-flip, #pourquoi .why-front img, #pourquoi .why-meter span { transition: none; }
    #pourquoi .why-hint { animation: none; }
  }
</style>
