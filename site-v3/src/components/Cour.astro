---
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { reasons } = getHome(locale);
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="reasons" id="pourquoi" aria-labelledby="reasons-title" data-reasons>
  <div class="why-stage">
    <div class="wrap">
      <header class="why-head" data-reveal data-split>
        <p class="kick">{locale === 'ar' ? 'لماذا هنا' : 'Pourquoi ici'}</p>
        <h2 class="display" id="reasons-title">{reasons.h2}</h2>
        <p class="lead">{reasons.lead}</p>
        <div class="why-meter" data-why-meter aria-hidden="true">
          {reasons.items.map((_, i) => <span data-tick={num(i)} />)}
        </div>
      </header>

      <ol class="why-cards" data-strips>
        {reasons.items.map((r, i) => (
          <li class="why-card" data-strip tabindex="0" aria-expanded="false">
            <img src={r.img} alt="" loading="lazy" decoding="async" />
            <span class="why-mark" aria-hidden="true">{num(i)}</span>
            <div class="why-sheet">
              <span class="why-n" aria-hidden="true">{num(i)}</span>
              <h3>{r.title}</h3>
              <p>{r.body}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style is:global>
  #pourquoi.reasons {
    position: relative;
    isolation: isolate;
    padding: var(--sec) 0;
    background:
      radial-gradient(55% 50% at 100% 0%, rgb(200 181 104 / 0.16), transparent 58%),
      radial-gradient(40% 45% at 0% 100%, rgb(200 181 104 / 0.08), transparent 60%),
      var(--canopy);
    color: var(--paper);
  }
  #pourquoi .why-stage { position: relative; }
  #pourquoi .why-head {
    display: grid;
    gap: 0.75rem;
    max-width: 40rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }
  #pourquoi .kick { color: var(--gold-soft); }
  #pourquoi .display { margin: 0; color: var(--paper); font-size: clamp(1.9rem, 4.2vw, 3.15rem); }
  #pourquoi .lead { margin: 0; color: var(--muted-on-dark); max-width: 34rem; }

  #pourquoi .why-meter {
    display: flex;
    gap: 0.45rem;
    margin-top: 0.35rem;
  }
  #pourquoi .why-meter span {
    width: 1.7rem;
    height: 2px;
    border-radius: 99px;
    background: rgb(246 240 228 / 0.22);
    transition: width 0.45s ease, background 0.45s ease;
  }
  #pourquoi .why-meter span.is-on {
    width: 3.4rem;
    background: var(--gold);
  }

  #pourquoi .why-cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
    align-items: stretch;
  }
  #pourquoi .why-card {
    position: relative;
    overflow: hidden;
    min-height: clamp(24rem, 46vh, 32rem);
    border-radius: 24px;
    outline-offset: 4px;
    cursor: pointer;
    box-shadow: 0 16px 40px rgb(0 16 12 / 0.22);
  }
  #pourquoi .why-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.7s var(--ease);
  }
  #pourquoi .why-card:hover img,
  #pourquoi .why-card:focus-visible img,
  #pourquoi .why-card.is-open img { transform: scale(1.05); }
  #pourquoi .why-mark {
    position: absolute;
    z-index: 1;
    top: 1rem;
    inset-inline-start: 1rem;
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--gold-soft);
  }
  #pourquoi .why-sheet {
    position: absolute;
    z-index: 2;
    inset-inline: 0;
    bottom: 0;
    display: grid;
    gap: 0.45rem;
    padding: 1.15rem 1.15rem 1.3rem;
    background:
      linear-gradient(to top, rgb(255 252 244 / 0.98), rgb(255 252 244 / 0.94));
    color: var(--ink);
    transform: translateY(105%);
    transition: transform 0.55s cubic-bezier(0.22, 1, 0.36, 1);
  }
  #pourquoi .why-card:hover .why-sheet,
  #pourquoi .why-card:focus-visible .why-sheet,
  #pourquoi .why-card.is-open .why-sheet { transform: translateY(0); }
  #pourquoi .why-n {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--gold-text);
  }
  #pourquoi .why-sheet h3 {
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.15rem, 1.35vw, 1.4rem);
    line-height: 1.2;
    color: var(--ink);
    text-wrap: balance;
  }
  #pourquoi .why-sheet h3::after {
    content: '';
    display: block;
    width: 2rem;
    height: 1px;
    margin-top: 0.6rem;
    background: var(--gold);
  }
  #pourquoi .why-sheet p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.5;
  }

  @media (max-width: 900px) {
    #pourquoi .why-cards { grid-template-columns: 1fr 1fr; }
    #pourquoi .why-card { min-height: 22rem; }
    #pourquoi .why-sheet p {
      display: -webkit-box;
      -webkit-line-clamp: 6;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
  @media (max-width: 560px) {
    #pourquoi .why-cards { grid-template-columns: 1fr; gap: 0.75rem; }
    #pourquoi .why-card { min-height: 19.5rem; border-radius: 18px; }
    #pourquoi .why-sheet p { -webkit-line-clamp: 5; }
  }

  @media (prefers-reduced-motion: reduce) {
    #pourquoi .why-sheet,
    #pourquoi .why-card img,
    #pourquoi .why-meter span { transition: none; }
  }
</style>
