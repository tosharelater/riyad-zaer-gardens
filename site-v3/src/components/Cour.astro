---
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { reasons } = getHome(locale);
const num = (i: number) => String(i + 1).padStart(2, '0');
---
<section class="reasons" id="pourquoi" aria-labelledby="reasons-title" data-reasons>
  <div class="why-stage">
    <div class="wrap">
      <header class="why-head" data-reveal data-split>
        <p class="kick">{locale === 'ar' ? 'لماذا هنا' : 'Pourquoi ici'}</p>
        <h2 class="display" id="reasons-title">{reasons.h2}</h2>
        <p class="lead">{reasons.lead}</p>
        <div class="why-meter" data-why-meter aria-hidden="true">
          {reasons.items.map((_, i) => <span data-tick={num(i)} />)}
        </div>
      </header>

      <ol class="flips" data-strips>
        {reasons.items.map((r, i) => (
          <li class="flip" data-strip tabindex="0" aria-expanded="false">
            <div class="flip-inner">
              <div class="flip-face flip-front">
                <img src={r.img} alt="" loading="lazy" decoding="async" />
                <span class="flip-tag" aria-hidden="true">
                  <i>{num(i)}</i>
                  <b>{r.title}</b>
                </span>
              </div>
              <div class="flip-face flip-back">
                <span class="flip-ghost" aria-hidden="true">{num(i)}</span>
                <div class="flip-copy">
                  <span class="flip-n" aria-hidden="true">{num(i)}</span>
                  <h3>{r.title}</h3>
                  <p>{r.body}</p>
                </div>
              </div>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style is:global>
  #pourquoi.reasons {
    position: relative;
    isolation: isolate;
    padding: var(--sec) 0;
    background:
      radial-gradient(55% 50% at 100% 0%, rgb(200 181 104 / 0.16), transparent 58%),
      radial-gradient(40% 45% at 0% 100%, rgb(200 181 104 / 0.08), transparent 60%),
      var(--canopy);
    color: var(--paper);
  }
  #pourquoi .why-stage { position: relative; }
  #pourquoi .why-head {
    display: grid;
    gap: 0.75rem;
    max-width: 40rem;
    margin-bottom: clamp(1.75rem, 4vw, 2.75rem);
  }
  #pourquoi .kick { color: var(--gold-soft); }
  #pourquoi .display { margin: 0; color: var(--paper); font-size: clamp(1.9rem, 4.2vw, 3.15rem); }
  #pourquoi .lead { margin: 0; color: var(--muted-on-dark); max-width: 34rem; }

  #pourquoi .why-meter {
    display: flex;
    gap: 0.45rem;
    margin-top: 0.35rem;
  }
  #pourquoi .why-meter span {
    width: 1.7rem;
    height: 2px;
    border-radius: 99px;
    background: rgb(246 240 228 / 0.22);
    transition: width 0.45s ease, background 0.45s ease;
  }
  #pourquoi .why-meter span.is-on {
    width: 3.4rem;
    background: var(--gold);
  }

  #pourquoi .flips {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.9rem;
    align-items: stretch;
  }
  #pourquoi .flip {
    position: relative;
    perspective: 1200px;
    display: grid;
    min-height: clamp(24rem, 46vh, 32rem);
    outline-offset: 4px;
    cursor: pointer;
  }
  #pourquoi .flips.is-playing .flip:not(.is-open)::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 24px;
    background: rgb(2 18 16 / 0.42);
    pointer-events: none;
    z-index: 2;
  }
  #pourquoi .flip-inner {
    position: relative;
    min-height: 100%;
    transform-style: preserve-3d;
    transform: rotateX(0deg);
  }
  #pourquoi .flip-face {
    position: absolute;
    inset: 0;
    overflow: hidden;
    border-radius: 24px;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }
  #pourquoi .flip-front {
    transform: rotateX(0deg) translateZ(1px);
    box-shadow: 0 16px 40px rgb(0 16 12 / 0.22);
  }
  #pourquoi .flip-front img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  #pourquoi .flip-front::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(0 22 18 / 0.82) 0%, rgb(0 22 18 / 0.12) 46%, transparent 68%);
    z-index: 1;
  }
  #pourquoi .flip-front::after {
    content: '';
    position: absolute;
    inset: 0.6rem;
    border: 1px solid rgb(217 201 135 / 0.55);
    border-radius: 16px;
    z-index: 2;
    pointer-events: none;
  }
  #pourquoi .flip-tag {
    position: absolute;
    z-index: 3;
    inset-inline: 1.15rem;
    bottom: 1.05rem;
    display: grid;
    gap: 0.28rem;
    color: var(--paper);
  }
  #pourquoi .flip-tag i {
    font-style: normal;
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--gold);
  }
  #pourquoi .flip-tag b {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1rem, 1.15vw, 1.2rem);
    line-height: 1.22;
    text-wrap: balance;
  }

  #pourquoi .flip-back {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 1.15rem 1.15rem 1.35rem;
    background:
      radial-gradient(90% 55% at 50% 0%, rgb(200 181 104 / 0.34), transparent 62%),
      var(--paper);
    color: var(--ink);
    border: 1px solid rgb(200 181 104 / 0.45);
    box-shadow: inset 0 0 0 6px var(--paper), inset 0 0 0 7px rgb(200 181 104 / 0.45);
    transform: rotateX(180deg) translateZ(1px);
  }
  #pourquoi .flip-ghost {
    position: absolute;
    top: 0.15rem;
    inset-inline-start: 0.45rem;
    font-family: var(--display);
    font-weight: 300;
    font-size: clamp(4.6rem, 6vw, 6.4rem);
    line-height: 0.8;
    letter-spacing: -0.05em;
    color: rgb(122 102 40 / 0.16);
    pointer-events: none;
  }
  #pourquoi .flip-copy {
    position: relative;
    z-index: 1;
    display: grid;
    gap: 0.55rem;
  }
  #pourquoi .flip-n {
    font-size: 0.68rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--gold-text);
  }
  #pourquoi .flip-back h3 {
    margin: 0;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.2rem, 1.45vw, 1.5rem);
    line-height: 1.18;
    color: var(--ink);
    text-wrap: balance;
  }
  #pourquoi .flip-back h3::after {
    content: '';
    display: block;
    width: 2.25rem;
    height: 1px;
    margin-top: 0.7rem;
    background: var(--gold);
  }
  #pourquoi .flip-back p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    #pourquoi .flips { grid-template-columns: 1fr 1fr; }
    #pourquoi .flip { min-height: 22rem; }
    #pourquoi .flip-back p {
      display: -webkit-box;
      -webkit-line-clamp: 7;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
  }
  @media (max-width: 560px) {
    #pourquoi .flips { grid-template-columns: 1fr; gap: 0.75rem; }
    #pourquoi .flip { min-height: 19.5rem; }
    #pourquoi .flip-face,
    #pourquoi .flips.is-playing .flip:not(.is-open)::after { border-radius: 18px; }
    #pourquoi .flip-tag b { font-size: 1.2rem; }
    #pourquoi .flip-back p { -webkit-line-clamp: 5; }
  }

  @media (prefers-reduced-motion: reduce) {
    #pourquoi .flip-inner,
    #pourquoi .why-meter span { transition: none; }
  }
</style>
