---
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { reasons } = getHome(locale);
---
<section class="reasons" aria-labelledby="reasons-title">
  <div class="wrap">
    <header class="head-split" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'لماذا هنا' : 'Pourquoi ici'}</p>
      <h2 class="display" id="reasons-title">{reasons.h2}</h2>
      <p class="lead">{reasons.lead}</p>
    </header>

    <ol class="reasons-grid">
      {reasons.items.map((r, i) => (
        <li data-reason-item>
          <figure class="reasons-media">
            <img src={r.img} alt="" loading="lazy" decoding="async" />
          </figure>
          <span class="reasons-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{r.title}</h3>
          <p>{r.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .reasons {
    padding: var(--sec) 0;
    background:
      radial-gradient(ellipse 70% 50% at 80% 0%, color-mix(in srgb, var(--gold) 12%, transparent), transparent 55%),
      radial-gradient(ellipse 40% 35% at 0% 100%, color-mix(in srgb, var(--canopy) 55%, transparent), transparent 60%),
      var(--ink);
    color: var(--cream);
  }
  .reasons .kick { color: var(--gold-soft); }
  .reasons .lead { color: var(--muted-on-dark); }
  .reasons-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--gap);
  }
  .reasons-grid li {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }
  .reasons-media {
    margin: 0;
    aspect-ratio: 3 / 4;
    overflow: hidden;
    position: relative;
    isolation: isolate;
    background: color-mix(in srgb, var(--cream) 6%, transparent);
  }
  .reasons-media::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, color-mix(in srgb, var(--ink) 35%, transparent), transparent 42%);
    z-index: 1;
  }
  .reasons-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.5s var(--ease);
  }
  .reasons-grid li:hover .reasons-media img {
    transform: scale(1.07);
  }
  .reasons-n {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--gold-soft);
    margin-top: 0.15rem;
  }
  .reasons-grid h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.12rem, 1.45vw, 1.32rem);
    line-height: 1.2;
    text-wrap: balance;
  }
  .reasons-grid p {
    color: var(--muted-on-dark);
    line-height: 1.72;
    font-size: 0.92rem;
  }
  @media (max-width: 1000px) {
    .reasons-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 600px) {
    .reasons-grid { grid-template-columns: 1fr; }
    .reasons-media { aspect-ratio: 16 / 10; }
  }
</style>
