---
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { reasons } = getHome(locale);
---
<section class="reasons" id="pourquoi" aria-labelledby="reasons-title" data-reasons>
  <div class="reasons-glow" aria-hidden="true"></div>
  <div class="wrap">
    <header class="reasons-head" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'لماذا هنا' : 'Pourquoi ici'}</p>
      <h2 class="display" id="reasons-title">{reasons.h2}</h2>
      <span class="reasons-title-rule" aria-hidden="true"></span>
      <p class="lead">{reasons.lead}</p>
    </header>

    <div class="reasons-stage" data-reasons-stage>
      <ol class="reasons-orb">
        {reasons.items.map((r, i) => (
          <li class={`reasons-q reasons-q--${i + 1}`} data-reason-item style={`--i: ${i}`}>
            <figure class="reasons-media">
              <img src={r.img} alt="" loading="lazy" decoding="async" data-reason-img />
            </figure>
          </li>
        ))}
      </ol>

      {reasons.items.map((r, i) => (
        <div class={`reasons-copy reasons-copy--${i + 1}`} data-reason-copy style={`--i: ${i}`}>
          <span class="reasons-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{r.title}</h3>
          <span class="reasons-rule" aria-hidden="true"></span>
          <p>{r.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style is:global>
  #pourquoi.reasons {
    position: relative;
    isolation: isolate;
    padding: var(--sec) 0;
    background:
      radial-gradient(58% 70% at 92% 8%, rgb(200 181 104 / 0.2), transparent 55%),
      radial-gradient(48% 55% at 6% 92%, rgb(200 181 104 / 0.1), transparent 52%),
      linear-gradient(160deg, #faf6ec 0%, var(--cream) 48%, #f3ead8 100%);
    color: var(--ink);
    overflow: clip;
  }
  #pourquoi .reasons-glow {
    position: absolute;
    inset: -8% -4%;
    z-index: 0;
    pointer-events: none;
    background: radial-gradient(42% 48% at 50% 55%, rgb(255 253 248 / 0.65), transparent 60%);
  }
  #pourquoi > .wrap {
    position: relative;
    z-index: 1;
  }

  #pourquoi .reasons-head {
    display: grid;
    gap: 0.75rem;
    max-width: 40rem;
    margin-bottom: clamp(2.25rem, 4.5vw, 3.25rem);
  }
  #pourquoi .kick { color: var(--gold-text); }
  #pourquoi .display {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.05rem, 4.2vw, 3.15rem);
  }
  #pourquoi .reasons-title-rule {
    display: block;
    width: 2.75rem;
    height: 1.5px;
    background: var(--gold-text);
  }
  #pourquoi .lead {
    margin: 0.1rem 0 0;
    color: var(--muted);
    max-width: 34rem;
  }

  /* Circle centered; texts push out to use left/right space */
  #pourquoi .reasons-stage {
    --orb-gap: clamp(0.85rem, 2vw, 1.25rem);
    --orb-size: min(32rem, 40vw);
    display: grid;
    grid-template-columns: minmax(14rem, 1fr) var(--orb-size) minmax(14rem, 1fr);
    grid-template-rows: 1fr 1fr;
    grid-template-areas:
      'c1 orb c2'
      'c3 orb c4';
    column-gap: clamp(1.25rem, 3vw, 2.5rem);
    row-gap: var(--orb-gap);
    width: 100%;
    margin-inline: auto;
    align-items: center;
  }

  #pourquoi .reasons-orb {
    grid-area: orb;
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    display: grid !important;
    grid-template-columns: 1fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: var(--orb-gap);
    margin: 0;
    padding: 0;
    list-style: none;
    background: transparent;
    overflow: visible;
  }

  #pourquoi .reasons-q {
    position: relative;
    overflow: hidden;
    min-width: 0;
    min-height: 0;
    box-shadow:
      0 16px 36px rgb(45 35 15 / 0.1),
      0 0 0 1px color-mix(in srgb, var(--gold-text) 18%, transparent);
    transition: transform 0.55s var(--ease), box-shadow 0.55s var(--ease);
  }
  #pourquoi .reasons-q--1 { border-radius: 100% 0 0 0; }
  #pourquoi .reasons-q--2 { border-radius: 0 100% 0 0; }
  #pourquoi .reasons-q--3 { border-radius: 0 0 0 100%; }
  #pourquoi .reasons-q--4 { border-radius: 0 0 100% 0; }

  #pourquoi .reasons-media {
    position: absolute;
    inset: 0;
    margin: 0;
    aspect-ratio: auto;
    border-radius: inherit;
    box-shadow: none;
    background: var(--paper);
  }
  #pourquoi .reasons-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transform: scale(1.04);
    transition: transform 0.9s var(--ease);
    will-change: transform;
  }
  #pourquoi .reasons-q:hover {
    transform: scale(1.02);
    box-shadow:
      0 22px 44px rgb(45 35 15 / 0.14),
      0 0 0 1px color-mix(in srgb, var(--gold-text) 35%, transparent);
  }
  #pourquoi .reasons-q:hover .reasons-media img {
    transform: scale(1.1);
  }

  #pourquoi .reasons-copy {
    display: grid;
    gap: 0.4rem;
    width: 100%;
    max-width: min(26rem, 100%);
  }
  #pourquoi .reasons-copy--1 {
    grid-area: c1;
    justify-self: start;
    align-self: end;
    text-align: start;
    padding-bottom: 0.35rem;
  }
  #pourquoi .reasons-copy--2 {
    grid-area: c2;
    justify-self: end;
    align-self: end;
    text-align: end;
    padding-bottom: 0.35rem;
  }
  #pourquoi .reasons-copy--3 {
    grid-area: c3;
    justify-self: start;
    align-self: start;
    text-align: start;
    padding-top: 0.35rem;
  }
  #pourquoi .reasons-copy--4 {
    grid-area: c4;
    justify-self: end;
    align-self: start;
    text-align: end;
    padding-top: 0.35rem;
  }

  #pourquoi .reasons-idx {
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    color: var(--gold-text);
  }
  #pourquoi .reasons-copy h3 {
    margin: 0;
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.02rem, 1.55vw, 1.28rem);
    line-height: 1.15;
    text-wrap: balance;
    color: var(--ink);
  }
  #pourquoi .reasons-rule {
    display: block;
    width: 2rem;
    height: 1.5px;
    background: var(--gold-text);
  }
  #pourquoi .reasons-copy--2 .reasons-rule,
  #pourquoi .reasons-copy--4 .reasons-rule {
    margin-inline-start: auto;
  }
  #pourquoi .reasons-copy p {
    margin: 0;
    color: var(--muted);
    line-height: 1.5;
    font-size: clamp(0.82rem, 1.05vw, 0.94rem);
  }
  #pourquoi .reasons-copy--2 p,
  #pourquoi .reasons-copy--4 p {
    margin-inline-start: auto;
  }

  @media (max-width: 900px) {
    #pourquoi .reasons-stage {
      grid-template-columns: 1fr;
      grid-template-areas:
        'orb'
        'c1'
        'c2'
        'c3'
        'c4';
      width: min(100%, 28rem);
      row-gap: 1.1rem;
      --orb-size: min(100%, 22rem);
    }
    #pourquoi .reasons-orb {
      width: var(--orb-size);
      margin-inline: auto;
    }
    #pourquoi .reasons-copy,
    #pourquoi .reasons-copy--1,
    #pourquoi .reasons-copy--2,
    #pourquoi .reasons-copy--3,
    #pourquoi .reasons-copy--4 {
      max-width: none;
      justify-self: stretch;
      text-align: start;
      padding: 0;
    }
    #pourquoi .reasons-copy--2 .reasons-rule,
    #pourquoi .reasons-copy--4 .reasons-rule,
    #pourquoi .reasons-copy--2 p,
    #pourquoi .reasons-copy--4 p {
      margin-inline-start: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #pourquoi .reasons-media img,
    #pourquoi .reasons-q {
      transition: none;
    }
    #pourquoi .reasons-q:hover,
    #pourquoi .reasons-q:hover .reasons-media img {
      transform: none;
    }
  }
</style>
