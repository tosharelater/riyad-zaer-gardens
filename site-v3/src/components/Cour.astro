---
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
import Icon from './Icon.astro';
const reasonIcons = ['trees', 'clock-3', 'key-round', 'badge-percent'];
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { reasons } = getHome(locale);
---
<section class="reasons" aria-labelledby="reasons-title">
  <div class="wrap">
    <header class="reasons-head head-split" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'لماذا هنا' : 'Pourquoi ici'}</p>
      <h2 class="display" id="reasons-title">{reasons.h2}</h2>
      <p class="lead">{reasons.lead}</p>
    </header>

    <ol class="reasons-grid">
      {reasons.items.map((r, i) => (
        <li data-reason-item>
          <span class="reasons-top"><Icon name={reasonIcons[i]} size="1.75rem" /></span>
          <h3>{r.title}</h3>
          <p>{r.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .reasons {
    padding: var(--sec) 0;
    background: var(--cream);
  }
  .reasons-head { margin-bottom: clamp(3rem, 6vw, 5rem); }
  .reasons-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .reasons-grid li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.9rem;
    padding: clamp(1.5rem, 3vw, 2.25rem) clamp(1rem, 2vw, 1.75rem) 0;
  }
  .reasons-grid li:first-child { padding-inline-start: 0; }
  .reasons-grid li + li { border-inline-start: 1px solid var(--line); }
  /* A gold rule grows over the top edge on hover */
  .reasons-grid li::before {
    content: '';
    position: absolute;
    inset: -1px 0 auto 0;
    height: 1px;
    background: var(--gold-deep);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s var(--ease);
  }
  .reasons-grid li:hover::before { transform: scaleX(1); }
  .reasons-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    color: var(--gold-deep);
  }
  .reasons-n {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    color: var(--gold-deep);
  }
  .reasons-grid h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.2rem, 1.6vw, 1.45rem);
    line-height: 1.1;
    text-wrap: balance;
  }
  .reasons-grid p {
    color: var(--muted);
    line-height: 1.65;
  }
  @media (max-width: 1000px) {
    .reasons-grid { grid-template-columns: 1fr 1fr; }
    .reasons-grid li:nth-child(3) { padding-inline-start: 0; border-inline-start: 0; }
    .reasons-grid li:nth-child(n + 3) { margin-top: 2rem; border-top: 1px solid var(--line); }
  }
  @media (max-width: 600px) {
    .reasons-grid { grid-template-columns: 1fr; }
    .reasons-grid li { padding-inline: 0; border-inline-start: 0 !important; padding-bottom: 1.5rem; }
    .reasons-grid li + li { border-top: 1px solid var(--line); margin-top: 0; }
  }
</style>
