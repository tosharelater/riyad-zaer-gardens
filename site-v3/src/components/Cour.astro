---
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { reasons } = getHome(locale);
const ar = locale === 'ar';
const num = (i: number) => String(i + 1).padStart(2, '0');
// two cards per row
const pairs: { r: (typeof reasons.items)[number]; i: number }[][] = [];
reasons.items.forEach((r, i) => {
  if (i % 2 === 0) pairs.push([]);
  pairs[pairs.length - 1].push({ r, i });
});
---
<section class="reasons" id="pourquoi" aria-labelledby="reasons-title" data-reasons>
  <div class="why-stage">
    <div class="wrap">
      <header class="why-head" data-reveal data-split>
        <p class="kick">{ar ? 'لماذا هنا' : 'Pourquoi ici'}</p>
        <h2 class="display" id="reasons-title">{reasons.h2}</h2>
        <p class="lead">{reasons.lead}</p>
        <div class="why-meter" data-why-meter aria-hidden="true">
          {reasons.items.map((_, i) => <span data-tick={num(i)} />)}
        </div>
      </header>

      <div class="why-rows" data-strips>
        {pairs.map((pair) => (
          <div class="why-pair">
            {pair.map(({ r, i }) => (
              <article class="why-card" data-strip tabindex="0" aria-expanded="false">
                <img class="why-img" src={r.img} alt="" loading="lazy" decoding="async" />
                <p class="why-title" aria-hidden="true">{r.title}</p>
                <div class="why-panel">
                  <h3>{r.title}</h3>
                  <p>{r.body}</p>
                </div>
              </article>
            ))}
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style is:global>
  #pourquoi.reasons {
    position: relative;
    isolation: isolate;
    padding: var(--sec) 0;
    background: var(--canopy);
    color: var(--paper);
  }
  #pourquoi .why-stage { position: relative; }
  #pourquoi .why-head { display: grid; gap: 0.75rem; max-width: 40rem; margin-bottom: clamp(1.9rem, 4vw, 3rem); }
  #pourquoi .kick { color: var(--gold-soft); }
  #pourquoi .display { margin: 0; color: var(--paper); font-size: clamp(1.9rem, 4.2vw, 3.15rem); }
  #pourquoi .lead { margin: 0; color: var(--muted-on-dark); max-width: 34rem; }

  #pourquoi .why-meter { display: flex; gap: 0.45rem; margin-top: 0.35rem; }
  #pourquoi .why-meter span { width: 1.7rem; height: 2px; border-radius: 99px; background: rgb(246 240 228 / 0.22); transition: width 0.45s ease, background 0.45s ease; }
  #pourquoi .why-meter span.is-on { width: 3.4rem; background: var(--gold); }

  /* ---------- two cards per row; the one you point at takes half of its neighbour's width ---------- */
  #pourquoi .why-rows { display: grid; gap: clamp(0.8rem, 1.4vw, 1.1rem); }
  #pourquoi .why-pair { display: flex; gap: clamp(0.8rem, 1.4vw, 1.1rem); height: clamp(18rem, 36vh, 24rem); }

  #pourquoi .why-card {
    position: relative;
    flex: 1 1 0;               /* 50 / 50 at rest */
    min-width: 0;
    overflow: hidden;
    border-radius: 20px;
    perspective: 1500px;
    cursor: pointer;
    outline-offset: 4px;
    background: #06302a;
    -webkit-tap-highlight-color: transparent;
    transition: flex-grow 0.85s cubic-bezier(0.3, 0.8, 0.2, 1);
  }
  /* 3 : 1 = the hovered card grows to 75%, the neighbour keeps 25% */
  #pourquoi .why-card:hover,
  #pourquoi .why-card:focus-visible,
  #pourquoi .why-card.is-open { flex-grow: 3; }

  #pourquoi .why-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 1.1s var(--ease), filter 0.7s var(--ease);
  }
  #pourquoi .why-card:hover .why-img,
  #pourquoi .why-card:focus-visible .why-img,
  #pourquoi .why-card.is-open .why-img { transform: scale(1.05); }
  /* the card you are not on steps back */
  #pourquoi .why-pair:has(.why-card:hover) .why-card:not(:hover) .why-img,
  #pourquoi .why-pair:has(.why-card.is-open) .why-card:not(.is-open) .why-img { filter: brightness(0.55) saturate(0.8); }

  #pourquoi .why-card::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgb(2 22 18 / 0.7) 0%, transparent 52%);
    pointer-events: none;
  }
  #pourquoi .why-title {
    position: absolute;
    z-index: 2;
    inset-inline: 1.25rem;
    bottom: 1.2rem;
    margin: 0;
    max-width: 21rem;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.15rem, 1.6vw, 1.5rem);
    line-height: 1.2;
    color: #fff;
    text-wrap: balance;
    text-shadow: 0 2px 14px rgb(0 0 0 / 0.45);
    transition: opacity 0.4s var(--ease);
  }

  /* the text comes in from the left, over a green gradient that has faded out by the middle of the card */
  #pourquoi .why-panel {
    position: absolute;
    z-index: 3;
    top: 0;
    bottom: 0;
    inset-inline-start: 0;
    width: min(31rem, 68%);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.85rem;
    padding: clamp(1.4rem, 2.6vw, 2.3rem);
    padding-inline-end: 24%;
    background: linear-gradient(to right, rgb(5 40 35 / 0.95) 0%, rgb(5 40 35 / 0.88) 42%, rgb(5 40 35 / 0.45) 74%, rgb(5 40 35 / 0) 100%);
    color: var(--paper);
    clip-path: inset(0 100% 0 0);
    visibility: hidden;
    transition: clip-path 0.95s cubic-bezier(0.3, 0.8, 0.2, 1), visibility 0s linear 0.95s;
  }
  [dir='rtl'] #pourquoi .why-panel {
    background: linear-gradient(to left, rgb(5 40 35 / 0.95) 0%, rgb(5 40 35 / 0.88) 42%, rgb(5 40 35 / 0.45) 74%, rgb(5 40 35 / 0) 100%);
    clip-path: inset(0 0 0 100%);
  }
  #pourquoi .why-card:hover .why-panel,
  #pourquoi .why-card:focus-visible .why-panel,
  #pourquoi .why-card.is-open .why-panel {
    clip-path: inset(0 0 0 0);
    visibility: visible;
    transition-delay: 0.1s, 0s;
  }
  /* the words slide in from the left, one after the other */
  #pourquoi .why-panel > * { opacity: 0; transform: translateX(-22px); transition: opacity 0.5s ease, transform 0.7s cubic-bezier(0.3, 0.8, 0.2, 1); }
  [dir='rtl'] #pourquoi .why-panel > * { transform: translateX(22px); }
  #pourquoi .why-card:hover .why-panel > *,
  #pourquoi .why-card:focus-visible .why-panel > *,
  #pourquoi .why-card.is-open .why-panel > * { opacity: 1; transform: none; }
  #pourquoi .why-card.is-open .why-panel > :nth-child(1), #pourquoi .why-card:hover .why-panel > :nth-child(1) { transition-delay: 0.3s; }
  #pourquoi .why-card.is-open .why-panel > :nth-child(2), #pourquoi .why-card:hover .why-panel > :nth-child(2) { transition-delay: 0.42s; }
  #pourquoi .why-panel h3 { margin: 0; font-family: var(--display); font-weight: 600; font-size: clamp(1.25rem, 1.7vw, 1.55rem); line-height: 1.2; color: #fff; text-wrap: balance; }
  #pourquoi .why-panel h3::after { content: ''; display: block; width: 2.4rem; height: 2px; margin-top: 0.75rem; background: var(--gold); }
  #pourquoi .why-panel p { margin: 0; color: rgb(246 240 228 / 0.92); font-size: 0.95rem; line-height: 1.65; }
  /* the caption on the photo steps aside while the text is open */
  #pourquoi .why-card:hover .why-title,
  #pourquoi .why-card:focus-visible .why-title,
  #pourquoi .why-card.is-open .why-title { opacity: 0; }

  @media (max-width: 900px) {
    #pourquoi .why-pair { height: clamp(17rem, 34vh, 21rem); }
    #pourquoi .why-panel { width: min(25rem, 72%); }
  }
  /* phones: no hover, so every card shows photo and text, one under the other */
  @media (max-width: 700px) {
    #pourquoi .why-rows { gap: 1rem; }
    #pourquoi .why-pair { flex-direction: column; height: auto; gap: 1rem; }
    #pourquoi .why-card { flex: none; display: grid; background: var(--cream); cursor: default; transition: none; }
    #pourquoi .why-card::after { display: none; }
    #pourquoi .why-img { position: relative; inset: auto; height: auto; aspect-ratio: 16 / 10; grid-row: 1; }
    #pourquoi .why-title { display: none; }
        #pourquoi .why-panel {
      position: static;
      grid-row: 2;
      width: auto;
      clip-path: none;
      visibility: visible;
      background: var(--cream);
      color: var(--ink);
      padding: 1.25rem 1.3rem 1.5rem;
      transition: none;
    }
    #pourquoi .why-panel > * { opacity: 1; transform: none; transition: none; }
    #pourquoi .why-panel h3 { color: var(--canopy); }
    #pourquoi .why-panel p { color: #35453f; }
    #pourquoi .why-card:hover, #pourquoi .why-card:focus-visible, #pourquoi .why-card.is-open { flex-grow: 0; }
    #pourquoi .why-card:hover .why-img, #pourquoi .why-card.is-open .why-img { transform: none; }
  }
  @media (prefers-reduced-motion: reduce) {
    #pourquoi .why-card, #pourquoi .why-img, #pourquoi .why-panel, #pourquoi .why-panel > *, #pourquoi .why-title, #pourquoi .why-meter span { transition: none; }
  }
</style>
