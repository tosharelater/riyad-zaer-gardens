---
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
import Icon from './Icon.astro';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { ways } = getHome(locale);
const wayIcons = ['house', 'trending-up', 'plane'];
---
<section class="ways" aria-labelledby="ways-title">
  <div class="wrap">
    <header class="ways-head" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'الحضور' : 'Présence'}</p>
      <h2 class="display" id="ways-title">{ways.h2}</h2>
    </header>

    <ul class="ways-list">
      {ways.items.map((w, i) => (
        <li>
          <Icon name={wayIcons[i] ?? 'house'} size="2rem" />
          <h3>{w.title}</h3>
          <p>{w.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .ways {
    padding: var(--sec) 0;
    background: var(--bg);
  }
  .ways-head {
    margin-bottom: clamp(2.5rem, 5vw, 3.5rem);
  }
  .ways-head .display {
    margin-top: 1rem;
    max-width: 20ch;
  }

  .ways-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: 1px solid var(--line);
  }
  .ways-list li {
    position: relative;
    display: grid;
    align-content: start;
    gap: 1rem;
    padding: clamp(1.75rem, 3vw, 2.5rem) clamp(1.25rem, 3vw, 2.5rem);
  }
  .ways-list li:first-child { padding-inline-start: 0; }
  .ways-list li:last-child { padding-inline-end: 0; }
  .ways-list li + li { border-inline-start: 1px solid var(--line); }
  /* A rule grows along the top edge on hover */
  .ways-list li::before {
    content: '';
    position: absolute;
    inset: -1px 0 auto 0;
    height: 1px;
    background: var(--gold-deep);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.8s var(--ease);
  }
  .ways-list li:hover::before { transform: scaleX(1); }
  :global([dir='rtl']) .ways-list li::before { transform-origin: right; }

  .ways-list :global(.icon) { color: var(--gold-deep); }
  .ways h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.5rem, 2.2vw, 1.9rem);
    line-height: 1.15;
  }
  .ways p {
    color: var(--muted);
    line-height: 1.7;
    max-width: 24rem;
  }

  @media (max-width: 800px) {
    .ways-list { grid-template-columns: 1fr; }
    .ways-list li,
    .ways-list li:first-child,
    .ways-list li:last-child { padding-inline: 0; }
    .ways-list li + li { border-inline-start: 0; border-top: 1px solid var(--line); }
  }
</style>
