---
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { ways } = getHome(locale);
---
<section class="ways" aria-labelledby="ways-title">
  <div class="wrap">
    <header class="ways-head head-split" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'الحضور' : 'Présence'}</p>
      <h2 class="display" id="ways-title">{ways.h2}</h2>
    </header>

    <ul class="ways-list">
      {ways.items.map((w, i) => (
        <li>
          <h3>{w.title}</h3>
          <p>{w.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>
<style>
  .ways {
    padding: var(--sec) 0;
    background:
      var(--ink);
    color: var(--cream);
  }
  .ways .kick { color: var(--gold-soft); }
  .ways-list {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
  }
  .ways-list li {
    display: grid;
    align-content: start;
    gap: 0.75rem;
  }

  .ways-n {
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--gold-soft);
  }
  .ways h3 {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.45rem, 2.1vw, 1.85rem);
    line-height: 1.15;
  }
  .ways p {
    color: var(--muted-on-dark);
    line-height: 1.7;
    font-size: 0.95rem;
  }

  @media (max-width: 800px) {
    .ways-list { grid-template-columns: 1fr; }
  }
</style>
