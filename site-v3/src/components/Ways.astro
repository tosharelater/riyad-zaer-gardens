---
import { getHome } from '../data/content';
import Icon from './Icon.astro';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { ways } = getHome(locale);
const icons = ['house', 'trending-up', 'key-round'];
---
<section class="ways" id="presence" aria-labelledby="ways-title" data-ways>
  <div class="wrap ways-shell">
    <header class="ways-head" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'الحضور' : 'Présence'}</p>
      <h2 class="display" id="ways-title">{ways.h2}</h2>
    </header>

    <ol class="ways-grid">
      {ways.items.map((w, i) => (
        <li class="ways-card" data-ways-item style={`--i: ${i}`}>
          <span class="ways-node" aria-hidden="true">
            <Icon name={icons[i % icons.length]} size="2.15rem" />
          </span>
          <h3>{w.title}</h3>
          <p>{w.body}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style is:global>
  #presence.ways {
    padding: var(--sec) 0;
    background: var(--paper);
    color: var(--ink);
  }

  #presence .ways-head {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    max-width: 38rem;
    margin: 0 auto clamp(2.75rem, 5vw, 4rem);
    text-align: center;
  }
  #presence .ways-head .kick { margin: 0; letter-spacing: 0.2em; }
  #presence .ways-head .display {
    margin: 0;
    font-size: clamp(2rem, 4vw, 3.1rem);
  }

  /* Three cards, linked by small arrows */
  #presence .ways-grid {
    --gap: clamp(1rem, 2.4vw, 1.75rem);
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    align-items: stretch;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #presence .ways-card {
    display: grid;
    align-content: start;
    justify-items: center;
    gap: 0.9rem;
    margin-top: 2.75rem;
    padding: calc(4.75rem / 2 + 1.5rem) clamp(1.75rem, 3vw, 2.5rem) clamp(1.75rem, 3vw, 2.5rem);
    border-radius: var(--radius);
    background: var(--cream);
    text-align: center;
  }
  #presence .ways-node {
    position: absolute;
    top: 0;
    inset-inline-start: 50%;
    transform: translate(-50%, -50%);
    display: grid;
    place-items: center;
    width: 4.75rem;
    height: 4.75rem;
    border: 1.25px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
  }
  [dir='rtl'] #presence .ways-node { transform: translate(50%, -50%); }
  #presence .ways-card h3 {
    margin: 0;
    font-family: var(--serif);
    font-weight: 300;
    font-size: clamp(2rem, 3.2vw, 2.6rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    color: var(--ink);
  }
  #presence .ways-card p {
    margin: 0;
    max-width: 22rem;
    color: var(--muted);
    line-height: 1.7;
    font-size: 1.02rem;
  }

  @media (max-width: 860px) {
    #presence .ways-grid { grid-template-columns: 1fr; max-width: 32rem; margin-inline: auto; gap: 1.75rem; }
    #presence .ways-card h3 { font-size: clamp(1.55rem, 6.5vw, 2rem); }
    #presence .ways-card p { font-size: 0.98rem; }
    #presence .ways-node { width: 4rem; height: 4rem; }
  }
</style>
