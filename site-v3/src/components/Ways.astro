---
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { ways } = getHome(locale);
---
<section class="ways" id="presence" aria-labelledby="ways-title" data-ways>
  <div class="ways-glow" aria-hidden="true"></div>
  <div class="wrap ways-shell">
    <header class="ways-head" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'الحضور' : 'Présence'}</p>
      <h2 class="display" id="ways-title">{ways.h2}</h2>
      <span class="ways-title-rule" aria-hidden="true"></span>
    </header>

    <ul class="ways-grid">
      {ways.items.map((w, i) => (
        <li class="ways-card" data-ways-item style={`--i: ${i}`}>
          <span class="ways-idx" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{w.title}</h3>
          <span class="ways-rule" aria-hidden="true"></span>
          <p>{w.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style is:global>
  #presence.ways {
    position: relative;
    isolation: isolate;
    padding: var(--sec) 0;
    overflow: clip;
    background:
      radial-gradient(58% 70% at 92% 8%, rgb(200 181 104 / 0.22), transparent 55%),
      radial-gradient(48% 55% at 6% 92%, rgb(200 181 104 / 0.1), transparent 52%),
      linear-gradient(160deg, #faf6ec 0%, var(--cream) 48%, #f3ead8 100%);
    color: var(--ink);
  }

  #presence .ways-glow {
    position: absolute;
    inset: -10% -8%;
    z-index: 0;
    pointer-events: none;
    background:
      radial-gradient(42% 48% at 78% 28%, rgb(255 253 248 / 0.7), transparent 60%),
      radial-gradient(36% 42% at 18% 70%, rgb(200 181 104 / 0.16), transparent 58%);
  }

  #presence .ways-shell {
    position: relative;
    z-index: 1;
  }

  #presence .ways-head {
    display: grid;
    gap: 0.75rem;
    max-width: 40rem;
    margin-bottom: clamp(2.75rem, 5.5vw, 4rem);
  }
  #presence .ways-head .kick {
    margin: 0;
    color: var(--gold-text);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: 0.8125rem;
    font-weight: 600;
  }
  #presence .ways-head .display {
    margin: 0;
    color: var(--ink);
    font-size: clamp(2.05rem, 4.2vw, 3.15rem);
  }
  #presence .ways-title-rule {
    display: block;
    width: 2.75rem;
    height: 1.5px;
    background: var(--gold-text);
  }

  #presence .ways-grid {
    display: grid !important;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.1rem, 2.6vw, 1.75rem);
    align-items: start;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #presence .ways-card {
    position: relative;
    display: grid;
    align-content: start;
    gap: 0.95rem;
    padding: 1.7rem 1.55rem 1.8rem;
    background: var(--paper);
    border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    border-radius: 18px;
    box-shadow:
      0 22px 48px rgb(45 35 15 / 0.08),
      0 2px 8px rgb(45 35 15 / 0.04);
    overflow: hidden;
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease),
      border-color 0.5s var(--ease);
  }
  #presence .ways-card::after {
    content: '';
    position: absolute;
    top: 0;
    left: 1.55rem;
    right: 1.55rem;
    height: 2px;
    border-radius: 999px;
    background: linear-gradient(90deg, var(--gold-text), var(--gold) 55%, transparent);
    opacity: 0.85;
  }
  #presence .ways-card:nth-child(2) {
    margin-top: 1.35rem;
  }
  #presence .ways-card:nth-child(3) {
    margin-top: 2.7rem;
  }
  #presence .ways-card::before {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(
      115deg,
      transparent 35%,
      rgb(255 255 255 / 0.7) 48%,
      transparent 62%
    );
    transform: translateX(-130%);
    opacity: 0;
  }
  #presence .ways-card.is-in::before {
    animation: ways-shine 1.1s var(--ease) both;
  }
  @keyframes ways-shine {
    from { transform: translateX(-130%); opacity: 0; }
    30% { opacity: 0.9; }
    to { transform: translateX(130%); opacity: 0; }
  }
  #presence .ways-card:hover {
    border-color: color-mix(in srgb, var(--gold-text) 42%, transparent);
    box-shadow:
      0 28px 52px rgb(45 35 15 / 0.12),
      0 6px 18px rgb(200 181 104 / 0.18);
    transform: translateY(-6px);
  }
  #presence .ways-card:nth-child(2):hover {
    transform: translateY(calc(1.35rem - 6px));
  }
  #presence .ways-card:nth-child(3):hover {
    transform: translateY(calc(2.7rem - 6px));
  }

  #presence .ways-idx {
    font-family: var(--display);
    font-weight: 600;
    font-size: 0.78rem;
    letter-spacing: 0.14em;
    color: var(--gold-text);
  }

  #presence .ways-card h3 {
    margin: 0;
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    line-height: 1.05;
    letter-spacing: -0.03em;
    color: var(--ink);
  }

  #presence .ways-rule {
    display: block;
    width: 2.25rem;
    height: 1.5px;
    background: var(--gold-text);
    transform-origin: left center;
  }

  #presence .ways-card p {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
    font-size: 1.01rem;
  }

  @media (max-width: 980px) {
    #presence .ways-grid {
      grid-template-columns: 1fr;
      gap: 1.05rem;
      max-width: 30rem;
    }
    #presence .ways-card:nth-child(2),
    #presence .ways-card:nth-child(3) {
      margin-top: 0;
    }
    #presence .ways-card:hover,
    #presence .ways-card:nth-child(2):hover,
    #presence .ways-card:nth-child(3):hover {
      transform: translateY(-4px);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #presence .ways-card::before { display: none; }
    #presence .ways-card,
    #presence .ways-card:hover {
      transition: none;
      transform: none;
    }
  }
</style>
