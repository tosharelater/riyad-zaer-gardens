---
/**
 * COMPARE MODE — two full homepage stacks, same écriture (home.ts).
 * A = GitHub / older visual + full GitHub section order
 * B = Current visual + current section order
 * Tell us which stack (or mix) to keep; then we remove the other.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroGithub from '../components/HeroGithub.astro';
import Hero from '../components/Hero.astro';
import ProofGithub from '../components/ProofGithub.astro';
import Proof from '../components/Proof.astro';
import FiguresGithub from '../components/FiguresGithub.astro';
import Figures from '../components/Figures.astro';
import Cour from '../components/Cour.astro';
import Projet from '../components/Projet.astro';
import Cadre from '../components/Cadre.astro';
import Logements from '../components/Logements.astro';
import Finishes from '../components/Finishes.astro';
import Commerce from '../components/Commerce.astro';
import Vision from '../components/Vision.astro';
import Aid from '../components/Aid.astro';
import Ways from '../components/Ways.astro';
import Lieu from '../components/Lieu.astro';
import Contact from '../components/Contact.astro';
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { seo } = getHome(locale);
---
<BaseLayout title={seo.title} description={seo.description} intro solidNav locale={locale}>

  <!-- ========== STACK A — GitHub full content ========== -->
  <div class="style-banner" data-style="a">
    <strong>A — Full GitHub page</strong>
    <span>Hero → Proof → Figures → Cour → Projet → Logements → Commerce → Vision → Ways → Lieu → Contact</span>
  </div>
  <div class="compare-stack" data-stack="a">
    <HeroGithub />
    <ProofGithub />
    <FiguresGithub />
    <Cour />
    <Projet />
    <Logements />
    <Commerce />
    <Vision />
    <Ways />
    <Lieu />
    <Contact />
  </div>

  <!-- ========== STACK B — Current full content ========== -->
  <div class="style-banner" data-style="b">
    <strong>B — Full current page</strong>
    <span>Hero → Proof+Figures → Cour → Cadre → Logements → Finishes → Commerce → Aid → Ways → Lieu → Contact</span>
  </div>
  <div class="compare-stack" data-stack="b">
    <Hero />
    <div class="home-soft">
      <Proof />
      <Figures />
    </div>
    <Cour />
    <Cadre />
    <Logements />
    <Finishes />
    <Commerce />
    <Aid />
    <Ways />
    <Lieu />
    <Contact />
  </div>

</BaseLayout>

<style is:global>
  .style-banner {
    position: sticky;
    top: var(--nav);
    z-index: 40;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.5rem 1.25rem;
    padding: 0.75rem var(--pad);
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    border-bottom: 1px solid rgb(0 45 45 / 0.12);
  }
  .style-banner[data-style='a'] {
    background: var(--ink);
    color: var(--cream);
  }
  .style-banner[data-style='a'] strong { color: var(--gold-soft); }
  .style-banner[data-style='b'] {
    background: var(--cream);
    color: var(--ink);
  }
  .style-banner[data-style='b'] strong { color: var(--gold-text); }
  .style-banner span { opacity: 0.85; font-weight: 400; max-width: 72rem; }

  /* Soft separator between the two full stacks */
  .compare-stack[data-stack='a'] {
    border-bottom: 4px solid var(--gold);
  }
</style>
