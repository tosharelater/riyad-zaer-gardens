---
import BaseLayout from '../layouts/BaseLayout.astro';
import { notFoundPage as p } from '../data/pages';
import { media } from '../data/media';
import PageHero from '../components/page/PageHero.astro';
---
<BaseLayout title="Page introuvable — Riyad Zaer Gardens">
  <PageHero
    h1={p.h1}
    lead={p.body}
    kicker={'404'}
    compact
  >
    <a class="btn btn-solid" href={p.primary.href}>{p.primary.label}</a>
    <a class="btn btn-light" href={p.secondary.href}>{p.secondary.label}</a>
  </PageHero>
</BaseLayout>
