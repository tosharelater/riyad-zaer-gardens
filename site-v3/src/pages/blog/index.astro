---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/page/PageHero.astro';
import { blogListing, getArticles } from '../../data/blog';
import { media } from '../../data/media';
import { ui } from '../../i18n/ui';
import { localePath, type Locale } from '../../i18n/paths';

const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const listing = blogListing[locale];
const articles = getArticles(locale);
const t = ui(locale);
---
<BaseLayout title={listing.seo.title} description={listing.seo.description} locale={locale}>
  <PageHero
    h1={listing.h1}
    lead={listing.lead}
    kicker={t.blog.kicker}
    compact
  />

  <section class="blog wrap">
    {articles.map((a) => (
      <article class="card">
        <div class="card-copy">
          <div class="meta">
            <time datetime={a.date}>{a.date}</time>
            <span>{a.tags[0]}</span>
          </div>
          <h2>
            <a href={localePath(locale, `/blog/${a.slug}`)}>{a.title}</a>
          </h2>
          <p>{a.excerpt}</p>
          <a class="text-link" href={localePath(locale, `/blog/${a.slug}`)}>{t.blog.read}</a>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .blog {
    padding: var(--sec) 0;
  }
  .card {
    border-top: 1px solid var(--line);
  }
  .card:last-child { border-bottom: 1px solid var(--line); }
  .card-copy {
    display: grid;
    grid-template-columns: 14rem minmax(0, 1fr) minmax(0, 0.8fr);
    column-gap: clamp(1.5rem, 4vw, 4rem);
    row-gap: 0.75rem;
    align-items: baseline;
    padding: clamp(1.75rem, 3.5vw, 2.75rem) 0;
  }
  .meta {
    grid-row: 1 / span 3;
    display: grid;
    gap: 0.4rem;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .meta span { color: var(--gold-deep); }
  .card-copy h2 {
    grid-column: 2;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.7rem, 3vw, 2.6rem);
    line-height: 1.08;
    text-wrap: balance;
  }
  .card-copy h2 a {
    background: linear-gradient(currentColor, currentColor) no-repeat 0 100% / 0 1px;
    transition: background-size 0.7s var(--ease);
  }
  .card:hover .card-copy h2 a { background-size: 100% 1px; }
  .card-copy p {
    grid-column: 3;
    grid-row: 1;
    color: var(--muted);
    line-height: 1.7;
  }
  .card-copy .text-link {
    grid-column: 3;
    grid-row: 2;
    justify-self: start;
    margin-top: 0;
  }
  @media (max-width: 900px) {
    .card-copy { grid-template-columns: 1fr; }
    .meta { grid-row: auto; display: flex; gap: 1rem; }
    .card-copy h2, .card-copy p, .card-copy .text-link { grid-column: 1; grid-row: auto; }
  }
</style>
