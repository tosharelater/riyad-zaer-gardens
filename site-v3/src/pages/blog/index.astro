---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/page/PageHero.astro';
import { blogListing, getArticles } from '../../data/blog';
import { media } from '../../data/media';
import { ui } from '../../i18n/ui';
import { localePath, type Locale } from '../../i18n/paths';

const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const listing = blogListing[locale];
const articles = getArticles(locale);
const t = ui(locale);
---
<BaseLayout title={listing.seo.title} description={listing.seo.description} locale={locale}>
  <PageHero
    h1={listing.h1}
    lead={listing.lead}
    kicker={t.blog.kicker}
    image={media.terrace.src}
    alt={media.terrace.alt}
    compact
  />

  <section class="blog wrap">
    {articles.map((a) => (
      <article class="card">
        <a class="card-media" href={localePath(locale, `/blog/${a.slug}`)}>
          <img src={a.image} alt={a.alt} loading="lazy" />
        </a>
        <div class="card-copy">
          <div class="meta">
            <time datetime={a.date}>{a.date}</time>
            <span>{a.tags[0]}</span>
          </div>
          <h2>
            <a href={localePath(locale, `/blog/${a.slug}`)}>{a.title}</a>
          </h2>
          <p>{a.excerpt}</p>
          <a class="text-link" href={localePath(locale, `/blog/${a.slug}`)}>{t.blog.read}</a>
        </div>
      </article>
    ))}
  </section>
</BaseLayout>

<style>
  .blog {
    display: grid;
    gap: 1.5rem;
    padding: clamp(2.5rem, 6vw, 4rem) 0 5rem;
  }
  .card {
    display: grid;
    grid-template-columns: minmax(12rem, 0.85fr) 1.15fr;
    background: var(--cream);
    overflow: hidden;
  }
  .card-media {
    display: block;
    min-height: 14rem;
    overflow: hidden;
  }
  .card-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--ease);
  }
  .card:hover img { transform: scale(1.04); }
  .card-copy {
    padding: clamp(1.35rem, 3vw, 2.25rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.65rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .meta span { color: var(--gold); }
  .card-copy h2 {
    font-size: clamp(1.35rem, 2.5vw, 1.85rem);
    font-weight: 500;
    letter-spacing: -0.02em;
    line-height: 1.2;
  }
  .card-copy h2 a:hover { color: var(--gold); }
  .card-copy p {
    color: var(--muted);
    line-height: 1.65;
    max-width: 38rem;
  }
  @media (max-width: 800px) {
    .card { grid-template-columns: 1fr; }
    .card-media { aspect-ratio: 16 / 10; min-height: 0; }
  }
</style>
