---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogShowcase from '../../components/showcase/BlogShowcase.astro';
import { blogListing } from '../../data/blog';
import type { Locale } from '../../i18n/paths';

const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const listing = blogListing[locale];
---
<BaseLayout title={listing.seo.title} description={listing.seo.description} locale={locale} solidNav={true}>
  <BlogShowcase locale={locale} />
</BaseLayout>
