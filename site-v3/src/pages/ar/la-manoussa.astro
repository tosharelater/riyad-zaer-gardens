---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/page/PageHero.astro';
import MoreLinks from '../../components/page/MoreLinks.astro';
import PageBand from '../../components/page/PageBand.astro';
import MediaSplit from '../../components/page/MediaSplit.astro';
import { promoteurPage as p } from '../../data/pages.ar';
import { media } from '../../data/media';
import { localePath } from '../../i18n/paths';
import { contactInfo } from '../../data/site';

const moreLinks = p.more.links.map((l) => ({ ...l, href: localePath('ar', l.href) }));
---
<BaseLayout locale="ar" title={p.seo.title} description={p.seo.description}>
  <PageHero
    h1={p.h1}
    lead={p.lead}
    kicker="المطوّر"
    image={media.aerial.src}
    alt={media.aerial.alt}
    compact
  />

  <MediaSplit
    image={media.hero.src}
    alt={media.hero.alt}
    kicker="Riyad Zaer Gardens"
    title={p.splitTitle}
    body={[p.body, p.note]}
    tone="cream"
  />

  <PageBand
    mode="custom"
    title={p.band.title}
    body={p.band.body}
    primary={{ label: p.band.primary, href: localePath('ar', '/contact') }}
    secondary={{ label: p.band.secondary, href: `tel:${contactInfo.phoneTel}` }}
    image={media.facade.src}
  />
  <MoreLinks h2={p.more.h2} links={moreLinks} />
</BaseLayout>
