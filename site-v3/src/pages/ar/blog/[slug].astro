---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getArticle, getArticles } from '../../../data/blog';
import { ui } from '../../../i18n/ui';
import { localePath } from '../../../i18n/paths';

export function getStaticPaths() {
  return getArticles('ar').map((a) => ({ params: { slug: a.slug } }));
}

const locale = 'ar' as const;
const { slug } = Astro.params;
const article = getArticle(slug!, 'ar');
if (!article) return Astro.redirect('/ar/blog');

const t = ui('ar');
const others = getArticles('ar').filter((a) => a.slug !== article.slug).slice(0, 3);
const dateFmt = (d: string) =>
  new Date(d).toLocaleDateString('ar-MA', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
---
<BaseLayout title={article.seoTitle} description={article.description} locale={locale}>
  <article class="post">
    <header class="post-hero">
      <div class="wrap post-intro">
        <a class="back" href={localePath(locale, '/blog')}>{t.blog.back}</a>
        <div class="tags">
          {article.tags.map((tag) => <span>{tag}</span>)}
        </div>
        <h1 class="display">{article.title}</h1>
        <p class="dates">
          <span>{t.blog.published} {dateFmt(article.date)}</span>
          <span>{t.blog.updated} {dateFmt(article.updated)}</span>
        </p>
      </div>
    </header>

    <div class="wrap post-body">
      <p class="deck">{article.excerpt}</p>
      {article.sections.map((s) => (
        <section>
          <h2>{s.h2}</h2>
          {s.paragraphs.map((p) => <p>{p}</p>)}
          {s.list && (
            <ul>
              {s.list.map((item) => <li>{item}</li>)}
            </ul>
          )}
        </section>
      ))}
      {article.cta && (
        <div class="post-cta">
          <a class="btn btn-solid" href={localePath(locale, article.cta.href)}>{article.cta.label}</a>
        </div>
      )}
      {!article.cta && (
        <div class="post-cta">
          <a class="btn btn-solid" href={localePath(locale, '/contact')}>{t.cta}</a>
        </div>
      )}
    </div>

    <section class="more wrap">
      <h2 class="display">{t.blog.more}</h2>
      <div class="more-grid">
        {others.map((a) => (
          <a href={localePath(locale, `/blog/${a.slug}`)}>
            <strong>{a.title}</strong>
          </a>
        ))}
      </div>
    </section>
  </article>
</BaseLayout>

<style>
  .post-hero {
    background: var(--cream);
    color: var(--ink);
  }
  .post-intro {
    padding: calc(var(--nav) + clamp(4rem, 10vw, 7rem)) 0 clamp(3rem, 6vw, 4.5rem);
    max-width: 56rem;
  }
  .back {
    display: inline-block;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    color: var(--gold);
    margin-bottom: 1.25rem;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1rem;
  }
  .tags span {
    font-size: 0.75rem;
    color: var(--muted);
    border: 1px solid var(--line);
    padding: 0.35rem 0.65rem;
  }
  .post-intro .display {
    font-family: var(--audrey);
    font-weight: 400;
    font-size: clamp(2.3rem, 5vw, 4.2rem);
    max-width: 18ch;
    letter-spacing: -0.03em;
  }
  .dates {
    margin-top: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .post-body {
    padding: var(--sec) 0 3rem;
    max-width: 42rem;
  }
  .deck {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.4rem, 2.2vw, 1.75rem);
    line-height: 1.35;
    color: var(--ink);
    margin-bottom: 3rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--line);
  }
  .post-body section { margin-bottom: 2.25rem; }
  .post-body h2 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.6rem, 2.6vw, 2.1rem);
    line-height: 1.15;
    margin: 3rem 0 1rem;
  }
  .post-body p {
    color: rgb(0 45 45 / 0.86);
    font-size: 1.125rem;
    line-height: 1.8;
    margin-bottom: 1.1rem;
  }
  .post-body ul {
    margin: 1rem 0 1.5rem;
    border-top: 1px solid var(--line);
  }
  .post-body li {
    position: relative;
    padding: 0.7rem 0 0.7rem 0;
    padding-inline-start: 1.75rem;
    border-bottom: 1px solid var(--line);
    color: rgb(0 45 45 / 0.86);
    font-size: 1.05rem;
    line-height: 1.6;
  }
  .post-body li::before {
    content: '—';
    position: absolute;
    inset-inline-start: 0;
    color: var(--gold-deep);
  }
  .post-body .btn { margin-top: 1rem; }
  .post-cta {
    margin-top: 2rem;
    padding-top: 2rem;
    border-top: 1px solid var(--line);
  }
  .more { padding: 2rem 0 5rem; }
  .more .display {
    font-size: clamp(1.5rem, 2.8vw, 2rem);
    margin-bottom: 1.5rem;
  }
  .more-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }
  .more-grid a { display: grid; gap: 0.75rem; }
  .more-grid img {
    width: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .more-grid strong {
    font-family: var(--display);
    font-weight: 500;
    font-size: 1.35rem;
    line-height: 1.2;
  }
</style>
