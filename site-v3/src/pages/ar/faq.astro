---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/page/PageHero.astro';
import PageBand from '../../components/page/PageBand.astro';
import { faqPage as p } from '../../data/pages.ar';
import { media } from '../../data/media';
---
<BaseLayout locale="ar" title={p.seo.title} description={p.seo.description}>
  <PageHero
    h1={p.h1}
    lead={p.lead}
    kicker="الأسئلة الشائعة"
    compact
  />

  <div class="faq" data-faq>
    {p.groups.map((group) => (
      <section class="faq-group wrap">
        <h2 class="display">{group.h2}</h2>
        <div class="faq-list">
          {group.items.map((item) => (
            <details>
              <summary>{item.q}</summary>
              <p>{item.a}</p>
            </details>
          ))}
        </div>
      </section>
    ))}
  </div>

  <PageBand />
</BaseLayout>

<script>
  import '../../scripts/faq';
</script>

<style>
  .faq {
    padding: var(--sec) 0 calc(var(--sec) * 0.6);
    background: var(--bg);
  }
  .faq-group {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(1.5rem, 6vw, 6rem);
    align-items: start;
    padding-bottom: clamp(3rem, 6vw, 5rem);
  }
  .faq-group .display {
    position: sticky;
    top: calc(var(--nav) + 2rem);
    font-size: clamp(1.9rem, 3.2vw, 2.8rem);
    max-width: 12ch;
  }
  .faq-list {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    cursor: pointer;
    list-style: none;
    position: relative;
    padding: 1.4rem 0;
    padding-inline-end: 3rem;
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.2rem, 1.8vw, 1.45rem);
    line-height: 1.3;
    transition: color 0.3s ease;
  }
  summary:hover { color: var(--gold-deep); }
  summary::-webkit-details-marker { display: none; }
  /* Plus that turns into a minus */
  summary::before,
  summary::after {
    content: '';
    position: absolute;
    inset-inline-end: 0.4rem;
    top: 50%;
    width: 0.9rem;
    height: 1px;
    background: currentColor;
    transition: transform 0.5s var(--ease);
  }
  summary::after { transform: rotate(90deg); }
  details[open] summary::after { transform: rotate(0deg); }
  details p {
    padding-block-end: 1.6rem;
    padding-inline-end: 3rem;
    color: rgb(0 45 45 / 0.8);
    max-width: 40rem;
    font-size: 1.05rem;
    line-height: 1.75;
    animation: faq-open 0.6s var(--ease) both;
  }
  @keyframes faq-open {
    from { opacity: 0; transform: translateY(-0.5rem); }
  }
  @media (max-width: 800px) {
    .faq-group { grid-template-columns: 1fr; }
    .faq-group .display { position: static; }
    details p { padding-inline-end: 0; }
  }
  @media (prefers-reduced-motion: reduce) {
    details p { animation: none; }
  }
</style>
