---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusShowcase from '../../components/showcase/StatusShowcase.astro';
import { merciPage as p } from '../../data/pages.ar';
---
<BaseLayout locale="ar" title={p.seo.title} description={p.seo.description} noindex>
  <StatusShowcase
    locale="ar"
    kicker={p.kick}
    h1={p.h1}
    lead={[p.lead, p.body, p.wait]}
    image="/photos/facade-sunset.jpg"
    primary={p.primary}
    secondary={p.secondary}
    more={p.more}
  />
</BaseLayout>
