---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { merciPage as p } from '../../data/pages.ar';
import { media } from '../../data/media';
import PageHero from '../../components/page/PageHero.astro';
import { localePath } from '../../i18n/paths';
---
<BaseLayout locale="ar" title={p.seo.title} description={p.seo.description} noindex>
  <PageHero
    h1={p.h1}
    lead={[p.body, p.wait]}
    kicker={p.kick}
    compact
  >
    <a class="btn btn-solid" href={p.primary.href}>{p.primary.label}</a>
    <a class="btn btn-light" href={localePath('ar', p.secondary.href)}>{p.secondary.label}</a>
  </PageHero>
</BaseLayout>
