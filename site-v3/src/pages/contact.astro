---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/page/PageHero.astro';
import { contactPage as p } from '../data/pages';
import { contactInfo } from '../data/site';
import { media } from '../data/media';
---
<BaseLayout title={p.seo.title} description={p.seo.description}>
  <PageHero
    h1={p.h1}
    lead={p.lead}
    kicker="Contact"
    image={media.hero.src}
    alt={media.hero.alt}
    compact
  />

  <section class="contact">
    <div class="wrap contact-layout">
      <div class="form-panel">
        <p class="kick">Formulaire</p>
        <h2 class="display">{p.form.h2}</h2>
        <form class="form" method="get" action="/merci">
          <label>
            <span>Nom complet</span>
            <input type="text" name="nom" required autocomplete="name" />
          </label>
          <label>
            <span>Téléphone</span>
            <input type="tel" name="telephone" required autocomplete="tel" />
          </label>
          <label>
            <span>E-mail</span>
            <input type="email" name="email" autocomplete="email" />
          </label>
          <label>
            <span>Votre projet</span>
            <select name="interet" required>
              <option value="" disabled selected>Choisir…</option>
              {p.form.interests.map((opt) => <option value={opt}>{opt}</option>)}
            </select>
          </label>
          <label>
            <span>Votre message (facultatif)</span>
            <textarea name="message" rows="4"></textarea>
          </label>
          <input class="hp" type="text" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <button class="btn btn-solid" type="submit">{p.form.submit}</button>
          <p class="form-note">{p.form.note}</p>
        </form>
      </div>

      <aside class="aside">
        <div class="aside-card">
          <p class="kick">Direct</p>
          <h2 class="display">{p.direct.h2}</h2>
          <div class="aside-block">
            <h3>{p.direct.phone.title}</h3>
            <a class="big" href={`tel:${contactInfo.phoneTel}`} dir="ltr">{p.direct.phone.label}</a>
          </div>
          <div class="aside-block">
            <h3>{p.direct.whatsapp.title}</h3>
            <p>{p.direct.whatsapp.body}</p>
            <a href={contactInfo.whatsapp}>Écrire sur WhatsApp</a>
          </div>
          <div class="aside-block">
            <h3>{p.direct.place.title}</h3>
            <p>{p.direct.place.body}</p>
          </div>
        </div>

        <figure class="aside-media">
          <img src={media.courtyard.src} alt={media.courtyard.alt} loading="lazy" />
        </figure>

        <div class="aside-card soft">
          <h2>{p.visit.h2}</h2>
          <p>{p.visit.body}</p>
        </div>

        <div class="aside-card soft">
          <h2>{p.faq.h2}</h2>
          <p>{p.faq.body}</p>
          <a class="text-link" href={p.faq.link.href}>{p.faq.link.label}</a>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .contact {
    padding: clamp(3rem, 7vw, 5rem) 0 5rem;
    background:
      radial-gradient(ellipse 60% 50% at 0% 0%, rgb(200 181 104 / 0.12), transparent 55%),
      var(--cream);
  }
  .contact-layout {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: clamp(1.5rem, 4vw, 2.5rem);
    align-items: start;
  }
  .form-panel,
  .aside-card {
    background: #fff;
    padding: clamp(1.75rem, 4vw, 2.75rem);
  }
  .form-panel .display {
    margin: 0.45rem 0 1.5rem;
    font-size: clamp(1.7rem, 3vw, 2.3rem);
  }
  .form {
    display: grid;
    gap: 1rem;
  }
  .form label { display: grid; gap: 0.4rem; }
  .form span {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .form input,
  .form select,
  .form textarea {
    width: 100%;
    padding: 0.95rem 1rem;
    border: 1px solid var(--line);
    background: #fff;
    transition: border-color 0.2s ease;
  }
  .form input:focus,
  .form select:focus,
  .form textarea:focus {
    outline: none;
    border-color: var(--gold);
  }
  .form .btn { justify-self: start; margin-top: 0.35rem; }
  .form-note {
    font-size: 0.85rem;
    color: var(--muted);
    max-width: 34rem;
    line-height: 1.55;
  }
  .hp {
    position: absolute;
    left: -9999px;
    opacity: 0;
    height: 0;
    width: 0;
  }

  .aside {
    display: grid;
    gap: 1rem;
  }
  .aside .display {
    margin: 0.4rem 0 1.25rem;
    font-size: clamp(1.45rem, 2.5vw, 1.85rem);
  }
  .aside-block + .aside-block {
    margin-top: 1.25rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
  }
  .aside h3 {
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.4rem;
  }
  .aside .big {
    font-size: 1.45rem;
    font-weight: 500;
    letter-spacing: -0.02em;
  }
  .aside a { font-weight: 500; }
  .aside a:hover { color: var(--gold); }
  .aside p { color: var(--muted); line-height: 1.6; }
  .aside-media {
    margin: 0;
    aspect-ratio: 16 / 11;
    overflow: hidden;
  }
  .aside-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .aside-card.soft h2 {
    font-size: 1.2rem;
    font-weight: 500;
    margin-bottom: 0.55rem;
  }

  @media (max-width: 900px) {
    .contact-layout { grid-template-columns: 1fr; }
  }
</style>
