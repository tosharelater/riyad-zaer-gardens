---
import BaseLayout from '../layouts/BaseLayout.astro';
import { merciPage as p } from '../data/pages';
import { media } from '../data/media';
---
<BaseLayout title={p.seo.title} description={p.seo.description} noindex>
  <section class="merci">
    <figure class="merci-bg" aria-hidden="true">
      <img src={media.courtyard.src} alt="" />
    </figure>
    <div class="merci-shade" aria-hidden="true"></div>
    <div class="merci-copy wrap">
      <p class="kick">Confirmation</p>
      <h1 class="display">{p.h1}</h1>
      <p class="lead">{p.body}</p>
      <p class="lead">{p.wait}</p>
      <div class="actions">
        <a class="btn btn-solid" href={p.primary.href}>{p.primary.label}</a>
        <a class="btn btn-light" href={p.secondary.href}>{p.secondary.label}</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .merci {
    position: relative;
    min-height: min(85svh, 46rem);
    display: grid;
    align-items: end;
    color: #f7f2e8;
    isolation: isolate;
    overflow: hidden;
  }
  .merci-bg {
    position: absolute;
    inset: 0;
    z-index: -2;
    margin: 0;
  }
  .merci-bg img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .merci-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(105deg, rgb(0 25 25 / 0.82), rgb(0 15 15 / 0.45)),
      linear-gradient(to top, rgb(0 0 0 / 0.55), transparent 50%);
  }
  .merci-copy {
    padding: calc(var(--nav) + 5rem) 0 5rem;
    max-width: 40rem;
  }
  .merci .kick { color: var(--gold); }
  .merci .kick::before { background: var(--gold); }
  .merci .display {
    margin: 1rem 0;
    font-size: clamp(2.1rem, 4.5vw, 3.4rem);
    max-width: 14ch;
  }
  .merci .lead { color: rgb(247 242 232 / 0.78); }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 2rem;
  }
</style>
