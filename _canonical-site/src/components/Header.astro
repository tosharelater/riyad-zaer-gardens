---
import { site } from '../data/site';
import { navLinks } from '../data/nav';
import { routes } from '../lib/routes';
import { withBase } from '../lib/base';

interface Props {
  current?: string;
}
const { current = '' } = Astro.props;
---

<header class="site-header z-50" data-site-header data-fusion-header>
  <div class="header-shell">
    <div class="header-bar">
      <a href={routes.home()} class="header-brand" aria-label={site.name}>
        <img src={withBase("/logo-bar.png")} alt={site.name} width="954" height="612" />
      </a>

      <nav class="header-nav" aria-label="Navigation">
        {navLinks.map((l) => (
          <a
            href={l.href}
            class:list={['fusion-nav-link', current === l.id && 'is-active']}
            data-i18n={l.key}
          >
            {l.label}
          </a>
        ))}
      </nav>

      <div class="header-tools">
        <div class="lang-toggle" role="group" aria-label="Langue">
          <button type="button" data-lang="fr" aria-pressed="true">FR</button>
          <button type="button" data-lang="ar" aria-pressed="false">العربية</button>
        </div>
        <a class="header-cta" href={routes.contact()} data-i18n="cta_callback">Être rappelé</a>
        <button
          type="button"
          class="header-menu"
          data-nav-toggle
          aria-expanded="false"
          aria-label="Menu"
        >
          <svg class="nav-icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg class="nav-icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
    </div>

    <nav class="mobile-nav" data-mobile-nav>
      <div class="mobile-nav__inner">
        {navLinks.map((l) => (
          <a
            href={l.href}
            class:list={['mobile-nav__link', current === l.id && 'is-active']}
            data-i18n={l.key}
          >
            {l.label}
          </a>
        ))}
        <a href={routes.contact()} class="mobile-nav__cta" data-i18n="cta_callback">Être rappelé</a>
      </div>
    </nav>
  </div>
</header>

<style>
  header .lang-toggle button[aria-pressed='true'] {
    background: var(--color-gold);
    color: var(--color-foret);
  }
</style>
