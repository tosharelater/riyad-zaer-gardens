---
import { site } from '../data/site';
import { navLinks } from '../data/nav';
import { routes } from '../lib/routes';
import { withBase } from '../lib/base';

interface Props {
  current?: string;
}
const { current = 'home' } = Astro.props;
---

<header class="site-header z-50" data-site-header data-fusion-header>
  <div class="header-shell">
    <div class="header-bar flex h-14 items-center gap-3 px-4 sm:px-8 lg:px-12">
      <a href={routes.home()} class="header-brand" aria-label={site.name}>
        <img src={withBase('/logo.png')} alt="" width="280" height="280" />
      </a>

      <nav class="hidden min-w-0 flex-1 items-center justify-center gap-3 lg:flex lg:gap-5" aria-label="Navigation">
        {navLinks.map((l) => (
          <a
            href={l.href}
            class:list={['fusion-nav-link text-[0.72rem] font-medium uppercase tracking-[0.12em] text-creme/70 transition hover:text-gold', current === l.id && 'is-active text-gold']}
            data-i18n={l.key}
          >
            {l.label}
          </a>
        ))}
      </nav>

      <div class="ml-auto flex shrink-0 items-center gap-2">
        <div class="lang-toggle flex rounded-full border border-creme/15 p-0.5 text-[0.72rem] font-semibold leading-none" role="group" aria-label="Langue">
          <button type="button" data-lang="fr" aria-pressed="true" class="inline-flex min-h-7 min-w-[4.6rem] items-center justify-center rounded-full px-2.5 py-1">FR</button>
          <button type="button" data-lang="ar" aria-pressed="false" class="inline-flex min-h-7 min-w-[4.6rem] items-center justify-center rounded-full px-2.5 py-1">العربية</button>
        </div>
        <a class="btn btn-solid btn-sm hidden !px-4 !py-2 lg:inline-flex" href={routes.contact()} data-i18n="cta_callback">Être rappelé</a>
        <button
          type="button"
          class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-creme/15 lg:hidden"
          data-nav-toggle
          aria-expanded="false"
          aria-label="Menu"
        >
          <svg class="h-5 w-5 nav-icon-open" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
          <svg class="hidden h-5 w-5 nav-icon-close" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>
    </div>
  </div>

  <nav class="mobile-nav hidden border-t border-creme/10 bg-foret lg:hidden" data-mobile-nav>
    <div class="mx-auto grid max-w-7xl gap-1 px-4 py-4">
      {navLinks.map((l) => (
        <a
          href={l.href}
          class:list={['rounded-lg px-3 py-2.5 text-sm text-creme/80 transition hover:bg-creme/5 hover:text-gold', current === l.id && 'text-gold']}
          data-i18n={l.key}
        >
          {l.label}
        </a>
      ))}
      <a href={routes.contact()} class="mt-2 rounded-lg bg-gold px-3 py-2.5 text-center text-sm font-medium text-foret" data-i18n="cta_callback">Être rappelé</a>
    </div>
  </nav>
</header>

<style>
  header .lang-toggle button[aria-pressed='true'] {
    background: var(--color-gold);
    color: var(--color-foret);
  }
</style>
