---
import { site } from '../data/site';
import { routes } from '../lib/routes';

interface Props {
  titleFr?: string;
  titleAr?: string;
  bodyFr?: string;
  bodyAr?: string;
  primaryFr?: string;
  primaryAr?: string;
  primaryHref?: string;
  secondaryFr?: string;
  secondaryAr?: string;
  secondaryHref?: string;
  secondaryExternal?: boolean;
}
const {
  titleFr = 'Parlons de votre projet',
  titleAr = 'لنتحدث عن مشروعكم',
  bodyFr = 'Laissez-nous vos coordonnées. Un conseiller vous rappelle pour répondre à vos questions et vous transmettre la brochure du projet.',
  bodyAr = 'اتركوا بياناتكم. يتصل بكم مستشار للإجابة على أسئلتكم وإرسال كتيب المشروع.',
  primaryFr = 'Être rappelé',
  primaryAr = 'اطلبوا اتصالاً',
  primaryHref = routes.contact(),
  secondaryFr = 'Écrire sur WhatsApp',
  secondaryAr = 'الكتابة على واتساب',
  secondaryHref = site.whatsapp,
  secondaryExternal = true,
} = Astro.props;
---

<section class="section--dark section fusion-convert">
  <div class="container-rzg" data-reveal-group>
    <h2 class="fusion-h2 reveal-fusion">
      <span data-bilingual-fr>{titleFr}</span>
      <span data-bilingual-ar hidden>{titleAr}</span>
    </h2>
    <p class="fusion-lead fusion-lead--wide text-creme/75 reveal-fusion">
      <span data-bilingual-fr>{bodyFr}</span>
      <span data-bilingual-ar hidden>{bodyAr}</span>
    </p>
    <div class="mt-8 flex flex-wrap items-center gap-3 reveal-fusion">
      <a href={primaryHref} class="btn btn-solid">
        <span data-bilingual-fr>{primaryFr}</span>
        <span data-bilingual-ar hidden>{primaryAr}</span>
      </a>
      <a href={secondaryHref} class="btn btn-ghost" target={secondaryExternal ? '_blank' : undefined} rel={secondaryExternal ? 'noopener' : undefined}>
        <span data-bilingual-fr>{secondaryFr}</span>
        <span data-bilingual-ar hidden>{secondaryAr}</span>
      </a>
    </div>
  </div>
</section>
