---
import PageLayout from '../layouts/PageLayout.astro';
import ContactForm from '../components/ContactForm.astro';
import Bi from '../components/Bi.astro';
import Eyebrow from '../components/Eyebrow.astro';
import { site, galleryImages, typologies, amenities, finishes, reasons, waysToBe } from '../data/site';
import { proofPoints, keyFigures, accessPoints, aidSteps } from '../data/home-content';
import { routes } from '../lib/routes';
import { withBase } from '../lib/base';

const heroSlides = [
  withBase('/gallery/render-11.jpg'),
  withBase('/gallery/render-5.jpg'),
  withBase('/gallery/render-12.jpg'),
];
const homes = typologies.filter((t) => t.id !== 'fonds');
const shop = typologies.find((t) => t.id === 'fonds')!;
const gallery = [11, 1, 8, 2, 5, 0].map((i) => galleryImages[i]);
const finishBlocks = finishes.map((f) => {
  const [frTitle, frText] = f.fr.split(' — ');
  const [arTitle, arText] = f.ar.split(' — ');
  return { frTitle, frText, arTitle, arText };
});
const contactWith = (interest: string) => `${routes.contact()}?interest=${interest}`;
---

<PageLayout
  title="Riyad Zaer Gardens — Appartements neufs à Aïn Aouda"
  description="Appartements F3 et F4 de 65 à 86 m² et fonds de commerce à Aïn Aouda, à 20 min de Rabat. À partir de 420 000 DH, éligibles à l'aide au logement."
  current="home"
>
  <div class="fusion-page hm" data-fusion-page>
    <!-- 1 · Hero -->
    <section class="hm-hero fusion-hero fusion-hero--ken">
      <div class="fusion-hero__media fusion-media fusion-media--crossfade" data-hero-crossfade>
        {heroSlides.map((src, i) => (
          <img src={src} alt="Vue du projet immobilier Riyad Zaer Gardens à Aïn Aouda" class:list={[i === 0 && 'is-active']} />
        ))}
      </div>
      <div class="hm-hero__veil" aria-hidden="true"></div>
      <div class="hm-hero__copy" data-reveal-group>
        <p class="hm-eyebrow reveal-fusion">
          <Bi fr="Riyad Zaer Gardens · Aïn Aouda, à 20 min de Rabat" ar="رياض زعير غاردنز · عين عودة، على بعد 20 دقيقة من الرباط" />
        </p>
        <h1 class="hm-hero__title reveal-fusion">
          <Bi fr="Nouveau pôle urbain à Rabat" ar="قطب حضري جديد بالرباط" />
        </h1>
        <p class="hm-hero__lead reveal-fusion">
          <Bi
            fr="Des appartements F3 et F4 et des fonds de commerce, livrés finis, dans un quartier neuf et verdoyant sur l’Avenue Mohammed VI."
            ar="شقق F3 و F4 ومحلات تجارية تُسلَّم منتهية، في حي جديد وأخضر على شارع محمد السادس."
          />
        </p>
        <p class="hm-hero__price reveal-fusion">
          <span class="hm-hero__price-label"><Bi fr="Appartements à partir de" ar="شقق ابتداءً من" /></span>
          <strong class="num-ltr">{site.priceFrom}</strong>
        </p>
        <div class="hm-actions reveal-fusion">
          <a href={routes.projet()} class="hm-btn hm-btn--gold">
            <Bi fr="Découvrir le projet" ar="اكتشفوا المشروع" />
            <span class="hm-btn__arrow" aria-hidden="true"></span>
          </a>
          <a href="#contact" class="hm-btn hm-btn--ghost">
            <Bi fr="Être rappelé" ar="اطلبوا اتصالاً" />
          </a>
        </div>
      </div>
      <a href="#chiffres" class="hm-hero__cue" aria-label="Défiler vers le contenu"><span></span></a>
    </section>

    <!-- 2 · Bandeau de réassurance -->
    <section class="hm-proof" aria-label="Le projet en un coup d’œil">
      <ul class="hm-proof__list" data-reveal-group>
        {proofPoints.map((p) => (
          <li class="reveal-fusion"><Bi fr={p.fr} ar={p.ar} /></li>
        ))}
      </ul>
    </section>

    <!-- 3 · Chiffres clés -->
    <section class="hm-figures hm-section" id="chiffres">
      <div class="hm-wrap hm-figures__grid">
        <div class="hm-figures__intro" data-reveal-group>
          <Eyebrow n={1} fr="Tranche 1" ar="المرحلة الأولى" ink />
          <h2 class="hm-h2 reveal-fusion"><Bi fr="La première tranche en chiffres" ar="المرحلة الأولى بالأرقام" /></h2>
          <p class="hm-lead reveal-fusion">
            <Bi
              fr="Un îlot complet, pensé comme un petit quartier avec ses logements, ses espaces verts et ses commerces."
              ar="مجمّع متكامل، صُمّم كحيّ صغير بمساكنه ومساحاته الخضراء ومحلاته."
            />
          </p>
        </div>
        <dl class="hm-figures__nums" data-reveal-group>
          {keyFigures.map((f) => (
            <div class="hm-figure reveal-fusion">
              <dt class="hm-figure__n num-ltr" data-count-to={f.value}>{f.value}</dt>
              <dd class="hm-figure__label"><Bi fr={f.fr} ar={f.ar} /></dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <!-- 4 · Le projet en bref -->
    <section class="hm-brief" id="projet">
      <div class="hm-media hm-brief__media" data-media-reveal>
        <img data-parallax="0.05" src={withBase('/gallery/render-4.jpg')} alt="Vue aérienne de l’îlot Riyad Zaer Gardens et de son cœur planté" loading="lazy" />
      </div>
      <div class="hm-media hm-brief__accent" data-media-reveal>
        <img src={withBase('/gallery/render-2.jpg')} alt="Chambre d’un appartement Riyad Zaer Gardens" loading="lazy" />
      </div>
      <div class="hm-brief__card" data-reveal-group>
        <Eyebrow n={2} fr="Le projet" ar="المشروع" />
        <h2 class="hm-h2 reveal-fusion">
          <Bi fr="Un quartier complet, pas seulement des immeubles" ar="حيّ متكامل، وليس مجرد عمارات" />
        </h2>
        <p class="hm-body reveal-fusion">
          <Bi
            fr="Les immeubles s’organisent autour d’une cour centrale plantée, avec des commerces en rez-de-chaussée. Le stationnement est enterré : l’espace extérieur reste dégagé et rendu aux résidents."
            ar="تنتظم العمارات حول فناء مركزي مغروس، مع محلات في الطابق الأرضي. الموقف تحت الأرض، فتبقى المساحة الخارجية مفتوحة ومخصصة للسكان."
          />
        </p>
        <ul class="hm-checks reveal-fusion">
          {amenities.map((a) => (
            <li><Bi fr={a.fr} ar={a.ar} /></li>
          ))}
        </ul>
        <a href={routes.projet()} class="hm-link reveal-fusion">
          <Bi fr="Découvrir le projet en détail" ar="اكتشفوا المشروع بالتفصيل" />
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </section>

    <!-- 5 · Pourquoi ici -->
    <section class="hm-why hm-section hm-section--dark">
      <div class="hm-wrap">
        <div class="hm-head hm-head--center" data-reveal-group>
          <Eyebrow n={3} fr="Pourquoi ici" ar="لماذا هنا" center />
          <h2 class="hm-h2 hm-h2--light reveal-fusion">
            <Bi fr="Quatre raisons de choisir Riyad Zaer Gardens" ar="أربعة أسباب لاختيار رياض زعير غاردنز" />
          </h2>
        </div>
        <ol class="hm-why__grid" data-reveal-group>
          {reasons.map((r, i) => (
            <li class="hm-why__item reveal-fusion">
              <span class="hm-why__n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3><Bi fr={r.titleFr} ar={r.titleAr} /></h3>
              <p><Bi fr={r.bodyFr} ar={r.bodyAr} /></p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <!-- 6 · Appartements -->
    <section class="hm-homes hm-section" id="appartements">
      <div class="hm-wrap">
        <div class="hm-head" data-reveal-group>
          <Eyebrow n={4} fr="Appartements" ar="الشقق" ink />
          <h2 class="hm-h2 reveal-fusion">
            <Bi fr="Des appartements F3 et F4 de 65 à 86 m<sup>2</sup>" ar="شقق F3 و F4 من 65 إلى 86 م<sup>2</sup>" />
          </h2>
          <p class="hm-lead reveal-fusion">
            <Bi
              fr="Des surfaces faciles à vivre, pour un premier achat comme pour louer. Livrés finis, avec balcon ou terrasse selon le lot."
              ar="مساحات مريحة للعيش، لأول شراء أو للكراء. تُسلَّم منتهية، مع شرفة أو تراس حسب الوحدة."
            />
          </p>
        </div>
        <div class="hm-homes__grid" data-reveal-group>
          {homes.map((t) => (
            <article class="hm-home reveal-fusion">
              <div class="hm-home__img">
                <img src={t.image} alt={t.titleFr} loading="lazy" />
                <span class="hm-home__tag"><Bi fr={t.labelFr} ar={t.labelAr} /></span>
              </div>
              <div class="hm-home__body">
                <h3><Bi fr={t.titleFr} ar={t.titleAr} /></h3>
                <dl class="hm-home__specs">
                  <div>
                    <dt><Bi fr="Surface" ar="المساحة" /></dt>
                    <dd><Bi fr={t.surfaceFr} ar={t.surfaceAr} /></dd>
                  </div>
                  <div>
                    <dt><Bi fr="Chambres" ar="الغرف" /></dt>
                    <dd><Bi fr={t.roomsFr} ar={t.roomsAr} /></dd>
                  </div>
                  <div>
                    <dt><Bi fr="Salle de bain" ar="الحمام" /></dt>
                    <dd><Bi fr={t.bathsFr} ar={t.bathsAr} /></dd>
                  </div>
                </dl>
                <p class="hm-home__text"><Bi fr={t.bodyFr} ar={t.bodyAr} /></p>
                <div class="hm-home__foot">
                  <p class="hm-home__price">
                    <span class="hm-home__price-label"><Bi fr="à partir de" ar="ابتداءً من" /></span>
                    <strong class="num-ltr">{site.priceFrom}</strong>
                  </p>
                  <a href={contactWith(t.id)} class="hm-link hm-link--tight">
                    <Bi fr="Être rappelé" ar="اطلبوا اتصالاً" />
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
        <div class="hm-homes__more reveal-fusion">
          <a href={routes.appartements()} class="hm-btn hm-btn--ink">
            <Bi fr="Voir les appartements" ar="عرض الشقق" />
            <span class="hm-btn__arrow" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </section>

    <!-- 7 · Finitions -->
    <section class="hm-finish hm-section hm-section--paper">
      <div class="hm-wrap hm-finish__grid">
        <div class="hm-head" data-reveal-group>
          <Eyebrow n={5} fr="Les finitions" ar="التشطيبات" ink />
          <h2 class="hm-h2 reveal-fusion">
            <Bi fr="Des finitions soignées, livrées prêtes à vivre" ar="تشطيبات متقنة، جاهزة للسكن" />
          </h2>
          <p class="hm-lead reveal-fusion">
            <Bi
              fr="Des matériaux choisis pour durer et rester faciles à entretenir. Faux plafonds et éclairage sont intégrés dès la livraison."
              ar="مواد مختارة لتدوم وتسهل صيانتها. الأسقف المعلقة والإضاءة مدمجة منذ التسليم."
            />
          </p>
          <a href={`${routes.appartements()}#finitions`} class="hm-link reveal-fusion">
            <Bi fr="Voir le détail des finitions" ar="تفاصيل التشطيبات" />
            <span aria-hidden="true">→</span>
          </a>
        </div>
        <ul class="hm-finish__list" data-reveal-group>
          {finishBlocks.map((f) => (
            <li class="hm-finish__item reveal-fusion">
              <h3><Bi fr={f.frTitle} ar={f.arTitle} /></h3>
              <p><Bi fr={f.frText} ar={f.arText} /></p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 8 · Fonds de commerce -->
    <section class="hm-shop">
      <div class="hm-media hm-shop__media" data-media-reveal>
        <img data-parallax="0.05" src={shop.image} alt="Fonds de commerce en rez-de-chaussée, Avenue Mohammed VI" loading="lazy" />
      </div>
      <div class="hm-shop__text" data-reveal-group>
        <Eyebrow n={6} fr="Fonds de commerce" ar="المحلات التجارية" />
        <h2 class="hm-h2 hm-h2--light reveal-fusion">
          <Bi fr="49 fonds de commerce en rez-de-chaussée" ar="49 محلاً تجارياً في الطابق الأرضي" />
        </h2>
        <p class="hm-body hm-body--light reveal-fusion">
          <Bi
            fr="Le terrain donne sur trois voies, dont un axe principal au sud : les locaux bénéficient d’une vraie visibilité."
            ar="يطل العقار على ثلاث طرق، منها محور رئيسي جنوباً: تتمتع المحلات برؤية حقيقية."
          />
        </p>
        <dl class="hm-facts reveal-fusion">
          <div>
            <dt><Bi fr="Lots" ar="الوحدات" /></dt>
            <dd class="num-ltr">49</dd>
          </div>
          <div>
            <dt><Bi fr="Surfaces" ar="المساحات" /></dt>
            <dd><Bi fr={shop.surfaceFr} ar={shop.surfaceAr} /></dd>
          </div>
          <div>
            <dt><Bi fr="Prix" ar="السعر" /></dt>
            <dd><Bi fr={shop.priceFr} ar={shop.priceAr} /></dd>
          </div>
        </dl>
        <a href={routes.commerce()} class="hm-btn hm-btn--gold reveal-fusion">
          <Bi fr="Voir les fonds de commerce" ar="عرض المحلات التجارية" />
          <span class="hm-btn__arrow" aria-hidden="true"></span>
        </a>
      </div>
    </section>

    <!-- 9 · Aide au logement -->
    <section class="hm-aid hm-section hm-section--dark" id="aide">
      <div class="hm-wrap hm-aid__grid">
        <div class="hm-aid__text" data-reveal-group>
          <Eyebrow n={7} fr="Aide au logement" ar="دعم السكن" />
          <h2 class="hm-h2 hm-h2--light reveal-fusion">
            <Bi fr="Un projet éligible à l’aide au logement" ar="مشروع مؤهل لدعم السكن" />
          </h2>
          <p class="hm-body hm-body--light reveal-fusion">
            <Bi
              fr="Les surfaces et les prix ont été conçus dès le départ pour répondre aux conditions du programme. L’éligibilité dépend de votre situation : nos conseillers la vérifient avec vous, gratuitement et sans engagement."
              ar="صُمّمت المساحات والأثمان منذ البداية لتلبية شروط البرنامج. الأهلية تتوقف على وضعيتكم: يتحقق مستشارونا منها معكم مجاناً ودون أي التزام."
            />
          </p>
          <ol class="hm-steps reveal-fusion">
            {aidSteps.map((s) => (
              <li><Bi fr={s.fr} ar={s.ar} /></li>
            ))}
          </ol>
        </div>
        <div class="hm-aid__card reveal-fusion">
          <div class="hm-aid__row">
            <span><Bi fr="Sans aide" ar="بدون دعم" /></span>
            <strong class="num-ltr">{site.priceFrom}</strong>
          </div>
          <div class="hm-aid__row hm-aid__row--gold">
            <span><Bi fr="Avec l’aide au logement" ar="مع دعم السكن" /></span>
            <strong class="num-ltr">{site.priceWithAid}</strong>
          </div>
          <p class="hm-aid__note">
            <Bi fr="Prix d’appel d’un appartement, à partir de." ar="سعر ابتدائي لشقة، ابتداءً من." />
          </p>
          <a href={contactWith('f3')} class="hm-btn hm-btn--gold">
            <Bi fr="Vérifier mon éligibilité" ar="تحققوا من أهليتي" />
            <span class="hm-btn__arrow" aria-hidden="true"></span>
          </a>
        </div>
      </div>
    </section>

    <!-- 10 · Trois façons d'y être -->
    <section class="hm-ways hm-section">
      <div class="hm-wrap">
        <div class="hm-head hm-head--center" data-reveal-group>
          <h2 class="hm-h2 reveal-fusion">
            <Bi fr="Trois façons d’être à Riyad Zaer Gardens" ar="ثلاث طرق لتكونوا في رياض زعير غاردنز" />
          </h2>
        </div>
        <ul class="hm-ways__grid" data-reveal-group>
          {waysToBe.map((w) => (
            <li class="hm-way reveal-fusion">
              <h3><Bi fr={w.titleFr} ar={w.titleAr} /></h3>
              <p><Bi fr={w.bodyFr} ar={w.bodyAr} /></p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <!-- 11 · Galerie -->
    <section class="hm-gallery" data-lightbox data-reveal-group aria-label="Galerie">
      {gallery.map((img, i) => (
        <button type="button" class={`hm-gallery__item hm-gallery__item--${i + 1} reveal-fusion`} data-lightbox-item data-src={img.src} data-alt={img.altFr}>
          <img src={img.src} alt={img.altFr} loading="lazy" />
        </button>
      ))}
    </section>

    <!-- 12 · Localisation -->
    <section class="hm-place">
      <div class="hm-place__text" data-reveal-group>
        <Eyebrow n={8} fr="Localisation" ar="الموقع" ink />
        <h2 class="hm-h2 reveal-fusion"><Bi fr="Km 25, Avenue Mohammed VI" ar="الكلم 25، شارع محمد السادس" /></h2>
        <p class="hm-body reveal-fusion">
          <Bi
            fr="À Aïn Aouda, à 20 minutes de Rabat par l’autoroute. Une pharmacie, un cabinet vétérinaire et des commerces de proximité sont déjà installés dans le quartier."
            ar="في عين عودة، على بعد 20 دقيقة من الرباط عبر الطريق السيار. صيدلية وعيادة بيطرية ومحلات قريبة موجودة بالفعل في الحي."
          />
        </p>
        <ul class="hm-checks hm-checks--ink reveal-fusion">
          {accessPoints.map((a) => (
            <li><Bi fr={a.fr} ar={a.ar} /></li>
          ))}
        </ul>
        <a href={routes.localisation()} class="hm-link reveal-fusion">
          <Bi fr="Voir la localisation" ar="عرض الموقع" />
          <span aria-hidden="true">→</span>
        </a>
      </div>
      <div class="hm-place__map hm-media" data-media-reveal>
        <iframe title="Carte — Riyad Zaer Gardens" src={routes.mapsEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </section>

    <!-- 13 · Conversion -->
    <section class="hm-cta hm-section hm-section--dark" id="contact">
      <div class="hm-wrap hm-cta__grid">
        <div class="hm-cta__text" data-reveal-group>
          <Eyebrow n={9} fr="Contact" ar="تواصل" />
          <h2 class="hm-h2 hm-h2--light reveal-fusion"><Bi fr="Parlons de votre projet" ar="لنتحدث عن مشروعكم" /></h2>
          <p class="hm-body hm-body--light reveal-fusion">
            <Bi
              fr="Laissez-nous vos coordonnées. Un conseiller vous rappelle pour répondre à vos questions et vous transmettre la brochure du projet."
              ar="اتركوا لنا بياناتكم. يتصل بكم مستشار للإجابة عن أسئلتكم وإرسال كتيّب المشروع."
            />
          </p>
          <div class="hm-actions reveal-fusion">
            <a href={site.whatsapp} target="_blank" rel="noopener" class="hm-btn hm-btn--ghost">
              <Bi fr="Écrire sur WhatsApp" ar="راسلونا على واتساب" />
            </a>
            <a href={`tel:${site.phoneTel}`} class="hm-btn hm-btn--ghost">
              <span class="num-ltr">{site.phone}</span>
            </a>
          </div>
        </div>
        <div class="hm-cta__form reveal-fusion">
          <ContactForm />
        </div>
      </div>
    </section>
  </div>
</PageLayout>
