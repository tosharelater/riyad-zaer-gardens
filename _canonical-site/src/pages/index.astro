---
import PageLayout from '../layouts/PageLayout.astro';
import ConversionBlock from '../components/ConversionBlock.astro';
import { site, amenities, reasons, waysToBe, galleryImages, finishes, typologies } from '../data/site';
import { routes } from '../lib/routes';
import { withBase } from '../lib/base';

const heroSlides = [withBase('/gallery/render-11.jpg'), withBase('/gallery/render-6.jpg'), withBase('/gallery/render-5.jpg')];
const proof = [
  { fr: 'Appartements F3 et F4', ar: 'شقق F3 و F4' },
  { fr: 'De 65 à 86 m²', ar: 'من 65 إلى 86 م²' },
  { fr: 'À partir de 420 000 DH', ar: 'ابتداءً من 420 000 درهم' },
  { fr: 'Éligible à l’aide au logement', ar: 'مؤهل لدعم السكن' },
  { fr: 'Parking en sous-sol', ar: 'موقف تحت الأرض' },
  { fr: 'Livraison prévue en septembre 2028', ar: 'التسليم المتوقع في سبتمبر 2028' },
];
---

<PageLayout
  title="Riyad Zaer Gardens — Appartements neufs à Aïn Aouda"
  description="Appartements F3 et F4 de 65 à 86 m² et fonds de commerce à Aïn Aouda, à 20 min de Rabat. À partir de 420 000 DH, éligibles à l'aide au logement."
  current="home"
>
  <div class="fusion-page" data-fusion-page>
    <div class="fusion-progress" data-scroll-progress aria-hidden="true"></div>

    <section class="fusion-hero fusion-hero--ken text-creme">
      <div class="fusion-hero__media fusion-media fusion-media--crossfade" data-hero-crossfade>
        {heroSlides.map((src, i) => (
          <img src={src} alt="Vue du projet immobilier Riyad Zaer Gardens à Aïn Aouda" class:list={[i === 0 && 'is-active']} />
        ))}
      </div>
      <div class="fusion-hero__veil" aria-hidden="true"></div>
      <div class="fusion-hero__copy" data-reveal-group>
        <p class="fusion-kicker reveal-fusion">
          <span data-bilingual-fr>Aïn Aouda · à 20 minutes de Rabat</span>
          <span data-bilingual-ar hidden>عين عودة · على بعد 20 دقيقة من الرباط</span>
        </p>
        <h1 class="fusion-h1 fusion-h1--caps reveal-fusion reveal-fusion--left">
          <span data-bilingual-fr>Nouveau pôle urbain à Rabat</span>
          <span data-bilingual-ar hidden>قطب حضري جديد بالرباط</span>
        </h1>
        <p class="fusion-lead text-creme/82 reveal-fusion">
          <span data-bilingual-fr>
            Riyad Zaer Gardens réunit des appartements F3 et F4 et des fonds de commerce dans un quartier neuf et verdoyant, sur l’Avenue Mohammed VI.
          </span>
          <span data-bilingual-ar hidden>
            يجمع رياض زائر غاردنز شقق F3 و F4 ومحلات تجارية في حي جديد وأخضر، على شارع محمد السادس.
          </span>
        </p>
        <p class="mt-6 inline-flex rounded-full border border-gold/40 bg-foret/35 px-4 py-2 text-sm text-gold-soft reveal-fusion">
          <span data-bilingual-fr>Appartements à partir de <span class="num-ltr">{site.priceFrom}</span></span>
          <span data-bilingual-ar hidden>شقق ابتداءً من <span class="num-ltr">{site.priceFrom}</span></span>
        </p>
        <div class="mt-8 flex flex-wrap gap-3 reveal-fusion">
          <a href={routes.projet()} class="btn btn-solid" data-i18n="cta_discover">Découvrir le projet</a>
          <a href={routes.contact()} class="btn btn-ghost" data-i18n="cta_callback">Être rappelé</a>
        </div>
      </div>

      <div class="fusion-proof" aria-label="Points clés">
        <div class="fusion-proof__row">
          {proof.map((item) => (
            <div class="fusion-proof-cell">
              <p class="fusion-proof-val">
                <span data-bilingual-fr>{item.fr}</span>
                <span data-bilingual-ar hidden>{item.ar}</span>
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="fusion-split fusion-split--short bg-creme">
      <div class="fusion-pane" data-reveal-group>
        <h2 class="fusion-h2 reveal-fusion">
          <span data-bilingual-fr>La première tranche en chiffres</span>
          <span data-bilingual-ar hidden>المرحلة الأولى بالأرقام</span>
        </h2>
        <p class="fusion-lead text-foret/72 reveal-fusion">
          <span data-bilingual-fr>
            La première tranche de Riyad Zaer Gardens est composée d’un îlot complet, pensé comme un petit quartier avec ses logements, ses espaces verts et ses commerces.
          </span>
          <span data-bilingual-ar hidden>
            تتكون المرحلة الأولى من جزيرة كاملة، كحي صغير بمساكنه ومساحاته الخضراء ومحلاته.
          </span>
        </p>
        <dl class="fusion-plan reveal-fusion">
          <div class="fusion-plan__cell">
            <dt><span data-count-to={site.buildings}>0</span></dt>
            <dd>
              <span data-bilingual-fr>immeubles</span>
              <span data-bilingual-ar hidden>عمارات</span>
            </dd>
          </div>
          <div class="fusion-plan__cell">
            <dt><span data-count-to={site.apartments}>0</span></dt>
            <dd>
              <span data-bilingual-fr>appartements</span>
              <span data-bilingual-ar hidden>شقق</span>
            </dd>
          </div>
          <div class="fusion-plan__cell">
            <dt><span data-count-to={site.commercial}>0</span></dt>
            <dd>
              <span data-bilingual-fr>fonds de commerce</span>
              <span data-bilingual-ar hidden>محلات تجارية</span>
            </dd>
          </div>
        </dl>
      </div>
      <div class="fusion-media" data-media-reveal>
        <img src={withBase('/gallery/render-4.jpg')} alt="Cœur d’îlot végétalisé de la résidence Riyad Zaer Gardens" />
      </div>
    </section>

    <section class="fusion-reasons bg-white">
      <div class="container-rzg" data-reveal-group>
        <h2 class="fusion-h2 reveal-fusion">
          <span data-bilingual-fr>Quatre raisons de choisir Riyad Zaer Gardens</span>
          <span data-bilingual-ar hidden>أربع أسباب لاختيار رياض زائر غاردنز</span>
        </h2>
        <p class="fusion-lead fusion-lead--wide text-foret/70 reveal-fusion">
          <span data-bilingual-fr>Le projet s’installe dans une zone qui se développe vite, à la jonction entre la ville et la nature.</span>
          <span data-bilingual-ar hidden>يقع المشروع في منطقة تتوسع بسرعة، عند التقاء المدينة والطبيعة.</span>
        </p>
        <div class="fusion-plan fusion-plan--reasons">
          {reasons.map((item, i) => (
            <article class:list={['fusion-plan__row', 'reveal-fusion', i % 2 === 0 ? 'is-odd' : 'is-even']} style={`--reason-i: ${i}`}>
              <div class:list={['fusion-plan__cell', 'fusion-plan__cell--num', i % 2 === 0 ? 'is-slide-rtl' : 'is-slide-ltr']}>
                <span class="num-ltr">{String(i + 1).padStart(2, '0')}</span>
              </div>
              <div class="fusion-plan__cell fusion-plan__cell--copy">
                <h3>
                  <span data-bilingual-fr>{item.titleFr}</span>
                  <span data-bilingual-ar hidden>{item.titleAr}</span>
                </h3>
                <p>
                  <span data-bilingual-fr>{item.bodyFr}</span>
                  <span data-bilingual-ar hidden>{item.bodyAr}</span>
                </p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="fusion-sticky-scene">
      <div class="fusion-sticky-scene__pin" aria-hidden="true">
        <img src={withBase('/gallery/render-2.jpg')} alt="" />
        <div class="fusion-sticky-scene__veil"></div>
      </div>
      <div class="fusion-sticky-scene__body text-creme" data-reveal-group>
        <p class="fusion-eyebrow reveal-fusion">
          <span data-bilingual-fr>Le quartier</span>
          <span data-bilingual-ar hidden>الحي</span>
        </p>
        <h2 class="fusion-h2 text-creme reveal-fusion">
          <span data-bilingual-fr>Un quartier complet, pas seulement des immeubles</span>
          <span data-bilingual-ar hidden>حي كامل، وليس عمارات فقط</span>
        </h2>
        <p class="fusion-lead fusion-lead--wide text-creme/85 reveal-fusion">
          <span data-bilingual-fr>
            Riyad Zaer Gardens est un projet immobilier de moyen standing développé par La Manoussa à Aïn Aouda. Les immeubles s’organisent autour d’une cour centrale plantée, avec des commerces en rez-de-chaussée.
          </span>
          <span data-bilingual-ar hidden>
            رياض زائر غاردنز مشروع عقاري متوسط الوقوف تطوره La Manoussa في عين عودة. تنتظم العمارات حول فناء مركزي مغروس، مع محلات في الطابق الأرضي.
          </span>
        </p>
        <p class="fusion-lead fusion-lead--wide text-creme/85 reveal-fusion">
          <span data-bilingual-fr>
            Le stationnement est enterré : deux niveaux de sous-sol accueillent les voitures et les locaux techniques. L’espace extérieur reste ainsi dégagé et rendu aux résidents.
          </span>
          <span data-bilingual-ar hidden>
            المواقف تحت الأرض: مستويان يستقبلان السيارات والمحلات التقنية. فيبقى الفضاء الخارجي مفتوحاً للسكان.
          </span>
        </p>

        <ul class="fusion-amenity-list">
          {amenities.map((a, i) => (
            <li class="reveal-fusion">
              <span class="fusion-amenity-list__n num-ltr">{String(i + 1).padStart(2, '0')}</span>
              <span data-bilingual-fr>{a.fr}</span>
              <span data-bilingual-ar hidden>{a.ar}</span>
            </li>
          ))}
        </ul>

        <div class="fusion-sticky-scene__cta reveal-fusion">
          <a href={routes.projet()} class="btn btn-solid">
            <span data-bilingual-fr>Découvrir le projet en détail</span>
            <span data-bilingual-ar hidden>اكتشفوا المشروع بالتفصيل</span>
          </a>
        </div>
      </div>
    </section>

    <section class="bg-creme section">
      <div class="container-rzg" data-reveal-group>
        <h2 class="fusion-h2 reveal-fusion">
          <span data-bilingual-fr>Des appartements F3 et F4 de 65 à 86 m²</span>
          <span data-bilingual-ar hidden>شقق F3 و F4 من 65 إلى 86 م²</span>
        </h2>
        <p class="fusion-lead fusion-lead--wide text-foret/70 reveal-fusion">
          <span data-bilingual-fr>
            Deux typologies sont proposées : des F3 et des F4, de 65 à 86 m². Des surfaces pensées pour être faciles à vivre, que ce soit pour un premier achat ou pour louer.
          </span>
          <span data-bilingual-ar hidden>
            نمطان معروضان: F3 و F4، من 65 إلى 86 م². مساحات سهلة العيش، للشراء الأول أو للكراء.
          </span>
        </p>
        <p class="fusion-lead fusion-lead--wide text-foret/70 reveal-fusion">
          <span data-bilingual-fr>Les appartements sont livrés finis, avec balcon ou terrasse selon le lot.</span>
          <span data-bilingual-ar hidden>تُسلَّم الشقق منتهية، مع شرفة أو تراس حسب الوحدة.</span>
        </p>
        <div class="fusion-type-grid mt-12">
          {typologies.filter((t) => t.id !== 'fonds').map((t, i) => (
            <article class:list={['fusion-type', 'reveal-fusion', i === 1 && 'fusion-type--flip']}>
              <div class="fusion-type__img">
                <img src={t.image} alt={t.titleFr} />
              </div>
              <div class="fusion-type__copy">
                <p class="fusion-type__surface">
                  <span data-bilingual-fr>{t.surfaceFr}</span>
                  <span data-bilingual-ar hidden>{t.surfaceAr}</span>
                </p>
                <h3 class="fusion-sub text-canopee">
                  <span data-bilingual-fr>{t.titleFr}</span>
                  <span data-bilingual-ar hidden>{t.titleAr}</span>
                </h3>
                <p class="fusion-type__body">
                  <span data-bilingual-fr>{t.bodyFr}</span>
                  <span data-bilingual-ar hidden>{t.bodyAr}</span>
                </p>
                <p class="fusion-type__price">
                  <span data-bilingual-fr>{t.priceFr}</span>
                  <span data-bilingual-ar hidden>{t.priceAr}</span>
                </p>
              </div>
            </article>
          ))}
        </div>
        <div class="mt-10 flex justify-center">
          <a href={routes.appartements()} class="btn btn-solid reveal-fusion">
            <span data-bilingual-fr>Voir les appartements</span>
            <span data-bilingual-ar hidden>عرض الشقق</span>
          </a>
        </div>
      </div>
    </section>

    <section class="bg-white section">
      <div class="container-rzg" data-reveal-group>
        <h2 class="fusion-h2 reveal-fusion">
          <span data-bilingual-fr>Des finitions soignées, livrées prêtes à vivre</span>
          <span data-bilingual-ar hidden>تشطيبات متقنة، جاهزة للسكن</span>
        </h2>
        <p class="fusion-lead fusion-lead--wide text-foret/70 reveal-fusion">
          <span data-bilingual-fr>
            Les appartements sont livrés avec des matériaux choisis pour durer et rester faciles à entretenir : sols en céramique ou parquet stratifié, menuiseries aluminium, volets roulants motorisés et sanitaires de marque.
          </span>
          <span data-bilingual-ar hidden>
            تُسلَّم الشقق بمواد مختارة لتدوم ويسهل صيانتها: سيراميك أو باركيه، نجارة ألومنيوم، ستائر كهربائية وتجهيزات صحية ذات علامة.
          </span>
        </p>
        <p class="fusion-lead fusion-lead--wide text-foret/70 reveal-fusion">
          <span data-bilingual-fr>
            Chaque salle de bain est équipée d’une douche à l’italienne. Les faux plafonds et l’éclairage sont intégrés dès la livraison.
          </span>
          <span data-bilingual-ar hidden>
            كل حمام مجهّز بدش إيطالي. الأسقف المعلقة والإضاءة مدمجة منذ التسليم.
          </span>
        </p>
        <ul class="fusion-spec">
          {finishes.map((item) => (
            <li class="reveal-fusion">
              <span data-bilingual-fr>{item.fr}</span>
              <span data-bilingual-ar hidden>{item.ar}</span>
            </li>
          ))}
        </ul>
        <a href={`${routes.appartements()}#finitions`} class="link-line mt-8 inline-flex text-sm font-medium text-gold reveal-fusion">
          <span data-bilingual-fr>Voir le détail des finitions</span>
          <span data-bilingual-ar hidden>تفاصيل التشطيبات</span>
        </a>
      </div>
    </section>

    <section class="fusion-sticky-scene">
      <div class="fusion-sticky-scene__pin" aria-hidden="true">
        <img src={withBase('/gallery/render-8.jpg')} alt="" />
        <div class="fusion-sticky-scene__veil"></div>
      </div>
      <div class="fusion-sticky-scene__body text-creme" data-reveal-group>
        <p class="fusion-eyebrow reveal-fusion">
          <span data-bilingual-fr>Commerces</span>
          <span data-bilingual-ar hidden>المحلات</span>
        </p>
        <h2 class="fusion-h2 text-creme reveal-fusion">
          <span data-bilingual-fr>49 fonds de commerce en rez-de-chaussée</span>
          <span data-bilingual-ar hidden>49 محلاً تجارياً في الطابق الأرضي</span>
        </h2>
        <p class="fusion-lead fusion-lead--wide text-creme/85 reveal-fusion">
          <span data-bilingual-fr>
            La première tranche compte 49 locaux commerciaux, de 13 à 30 m², en rez-de-chaussée sur l’Avenue Mohammed VI.
          </span>
          <span data-bilingual-ar hidden>
            المرحلة الأولى تضم 49 محلاً تجارياً، من 13 إلى 30 م²، في الطابق الأرضي على شارع محمد السادس.
          </span>
        </p>
        <p class="fusion-lead fusion-lead--wide text-creme/85 reveal-fusion">
          <span data-bilingual-fr>
            Le terrain donne sur trois voies, dont un axe principal au sud : les locaux bénéficient d’une vraie visibilité.
          </span>
          <span data-bilingual-ar hidden>
            تطل القطعة على ثلاثة طرق، منها محور رئيسي جنوباً: للمحلات رؤية حقيقية.
          </span>
        </p>

        <div class="fusion-commerce-cards">
          <article class="fusion-commerce-card reveal-fusion">
            <p class="fusion-commerce-card__n num-ltr">49</p>
            <p class="fusion-commerce-card__label">
              <span data-bilingual-fr>lots</span>
              <span data-bilingual-ar hidden>محلاً</span>
            </p>
            <p class="fusion-commerce-card__hint">
              <span data-bilingual-fr>en rez-de-chaussée</span>
              <span data-bilingual-ar hidden>في الطابق الأرضي</span>
            </p>
          </article>
          <article class="fusion-commerce-card reveal-fusion">
            <p class="fusion-commerce-card__n">13–30</p>
            <p class="fusion-commerce-card__label">
              <span data-bilingual-fr>m²</span>
              <span data-bilingual-ar hidden>م²</span>
            </p>
            <p class="fusion-commerce-card__hint">
              <span data-bilingual-fr>surfaces disponibles</span>
              <span data-bilingual-ar hidden>مساحات متاحة</span>
            </p>
          </article>
          <article class="fusion-commerce-card reveal-fusion">
            <p class="fusion-commerce-card__n num-ltr">15 000</p>
            <p class="fusion-commerce-card__label">
              <span data-bilingual-fr>DH / m²</span>
              <span data-bilingual-ar hidden>درهم / م²</span>
            </p>
            <p class="fusion-commerce-card__hint">
              <span data-bilingual-fr>à partir de</span>
              <span data-bilingual-ar hidden>ابتداءً من</span>
            </p>
          </article>
        </div>

        <div class="fusion-sticky-scene__cta reveal-fusion">
          <a href={routes.commerce()} class="btn btn-solid">
            <span data-bilingual-fr>Voir les fonds de commerce</span>
            <span data-bilingual-ar hidden>عرض المحلات</span>
          </a>
        </div>
      </div>
    </section>

    <section class="bg-foret text-creme">
      <div class="container-rzg section fusion-aid" data-reveal-group>
        <h2 class="fusion-h2 text-creme reveal-fusion">
          <span data-bilingual-fr>Un projet éligible à l’aide au logement</span>
          <span data-bilingual-ar hidden>مشروع مؤهل لدعم السكن</span>
        </h2>
        <p class="fusion-lead fusion-lead--wide text-creme/78 reveal-fusion">
          <span data-bilingual-fr>
            Riyad Zaer Gardens est éligible au programme d’aide au logement de l’État. Les surfaces et les prix des appartements ont été conçus dès le départ pour répondre aux conditions du programme.
          </span>
          <span data-bilingual-ar hidden>
            رياض زائر غاردنز مؤهل لبرنامج دعم السكن. صُممت مساحات وأثمان الشقق منذ البداية لتلبية شروط البرنامج.
          </span>
        </p>
        <p class="mt-4 text-sm leading-relaxed text-creme/70 reveal-fusion">
          <span data-bilingual-fr>
            Concrètement, cela change le prix d’entrée : selon votre situation, un appartement peut démarrer à <span class="num-ltr">{site.priceWithAid}</span> au lieu de <span class="num-ltr">{site.priceFrom}</span>. L’éligibilité dépend de votre situation personnelle. Nos conseillers la vérifient avec vous, gratuitement et sans engagement.
          </span>
          <span data-bilingual-ar hidden>
            عملياً، يتغير ثمن الدخول: حسب وضعيتكم، يمكن أن تبدأ الشقة من <span class="num-ltr">{site.priceWithAid}</span> بدل <span class="num-ltr">{site.priceFrom}</span>. الأهلية شخصية. يتحقق منها مستشارونا مجاناً ودون التزام.
          </span>
        </p>
        <div class="fusion-aid__prices">
          <div class="card-dark text-pair reveal-fusion">
            <p class="pair-label">
              <span data-bilingual-fr>Sans aide</span>
              <span data-bilingual-ar hidden>بدون دعم</span>
            </p>
            <p class="pair-value">
              <span data-bilingual-fr>à partir de <span class="num-ltr">{site.priceFrom}</span></span>
              <span data-bilingual-ar hidden>ابتداءً من <span class="num-ltr">{site.priceFrom}</span></span>
            </p>
          </div>
          <div class="card-dark text-pair reveal-fusion">
            <p class="pair-label">
              <span data-bilingual-fr>Avec l’aide au logement</span>
              <span data-bilingual-ar hidden>مع دعم السكن</span>
            </p>
            <p class="pair-value">
              <span data-bilingual-fr>à partir de <span class="num-ltr">{site.priceWithAid}</span></span>
              <span data-bilingual-ar hidden>ابتداءً من <span class="num-ltr">{site.priceWithAid}</span></span>
            </p>
          </div>
        </div>
        <div class="fusion-center-cta reveal-fusion">
          <a href={routes.contact()} class="btn btn-solid">
            <span data-bilingual-fr>Vérifier mon éligibilité</span>
            <span data-bilingual-ar hidden>تحققوا من أهليتي</span>
          </a>
        </div>
      </div>
    </section>

    <section class="fusion-sticky-scene fusion-ways-scene">
      <div class="fusion-sticky-scene__pin" aria-hidden="true">
        <img src={withBase('/gallery/render-1.jpg')} alt="" data-ways-parallax-img />
        <div class="fusion-sticky-scene__veil fusion-ways-scene__veil"></div>
      </div>
      <div class="fusion-sticky-scene__body text-creme" data-reveal-group>
        <p class="fusion-eyebrow reveal-fusion">
          <span data-bilingual-fr>Votre intention</span>
          <span data-bilingual-ar hidden>نيتكم</span>
        </p>
        <h2 class="fusion-h2 text-creme reveal-fusion">
          <span data-bilingual-fr>Trois façons d’être à Riyad Zaer Gardens</span>
          <span data-bilingual-ar hidden>ثلاث طرق للوجود في رياض زائر غاردنز</span>
        </h2>
        <p class="fusion-lead fusion-lead--wide text-creme/85 reveal-fusion">
          <span data-bilingual-fr>Habiter, investir ou garder un pied-à-terre — trois intentions, un même niveau de finition.</span>
          <span data-bilingual-ar hidden>للسكن أو الاستثمار أو الاحتفاظ بموطئ قدم — ثلاث نوايا، ونفس مستوى التشطيب.</span>
        </p>
        <div class="fusion-ways">
          {waysToBe.map((item, i) => (
            <article class="fusion-way reveal-fusion" style={`--way-i: ${i}`} data-parallax-depth={0.08 + i * 0.05}>
              <span class="fusion-way__n num-ltr">{String(i + 1).padStart(2, '0')}</span>
              <span class="fusion-way__mark" aria-hidden="true"></span>
              <h3 class="fusion-way__title">
                <span data-bilingual-fr>{item.titleFr}</span>
                <span data-bilingual-ar hidden>{item.titleAr}</span>
              </h3>
              <p class="fusion-way__body">
                <span data-bilingual-fr>{item.bodyFr}</span>
                <span data-bilingual-ar hidden>{item.bodyAr}</span>
              </p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="fusion-split fusion-split--map bg-creme">
      <div class="fusion-pane" data-reveal-group>
        <h2 class="fusion-h2 reveal-fusion">
          <span data-bilingual-fr>Km 25, Avenue Mohammed VI</span>
          <span data-bilingual-ar hidden>الكلم 25، شارع محمد السادس</span>
        </h2>
        <p class="fusion-lead fusion-lead--wide text-foret/70 reveal-fusion">
          <span data-bilingual-fr>
            Le projet se situe à Aïn Aouda, sur l’Avenue Mohammed VI, à 20 minutes de Rabat par l’autoroute. Une pharmacie, un cabinet vétérinaire et des commerces de proximité sont déjà installés dans le quartier.
          </span>
          <span data-bilingual-ar hidden>
            يقع المشروع في عين عودة، على شارع محمد السادس، على بعد 20 دقيقة من الرباط عبر الطريق السيار. صيدلية وعيادة بيطرية ومحلات قرب موجودة سلفاً في الحي.
          </span>
        </p>
        <a href={routes.localisation()} class="btn btn-solid mt-8 reveal-fusion">
          <span data-bilingual-fr>Voir la localisation</span>
          <span data-bilingual-ar hidden>عرض الموقع</span>
        </a>
      </div>
      <div class="fusion-media fusion-media--map" data-media-reveal>
        <iframe title="Riyad Zaer Gardens — Aïn Aouda" src={routes.mapsEmbed} loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </section>

    <section class="gallery-arc-block" data-film-gallery data-gallery-parallax>
      <div class="film-popup" data-film-preview aria-hidden="true">
        <img data-film-a alt="" />
        <img data-film-b alt="" />
      </div>
      <div class="gallery-arc-block__intro" data-reveal-group>
        <p class="fusion-eyebrow reveal-fusion">
          <span data-bilingual-fr>Galerie</span>
          <span data-bilingual-ar hidden>المعرض</span>
        </p>
        <h2 class="fusion-h2 text-creme reveal-fusion">
          <span data-bilingual-fr>Le projet en images</span>
          <span data-bilingual-ar hidden>المشروع بالصور</span>
        </h2>
      </div>
      <div class="gallery-arc gallery-arc--top" aria-hidden="true">
        <div class="gallery-arc__fade gallery-arc__fade--start"></div>
        <div class="gallery-arc__fade gallery-arc__fade--end"></div>
        <div class="gallery-arc__wheel gallery-arc__wheel--left" style="--count: 28">
          {Array.from({ length: 28 }, (_, i) => {
            const img = galleryImages[i % galleryImages.length];
            return (
              <div class="gallery-arc__slot" style={`--i: ${i}`}>
                <img src={img.src} alt="" data-film-i={i % galleryImages.length} />
              </div>
            );
          })}
        </div>
      </div>

      <ConversionBlock />
    </section>
  </div>
</PageLayout>
