---
import PageLayout from '../layouts/PageLayout.astro';
import ConversionBlock from '../components/ConversionBlock.astro';
import { site } from '../data/site';
import { routes } from '../lib/routes';
---

<PageLayout
  title="La Manoussa, promoteur de Riyad Zaer Gardens"
  description="La Manoussa est le promoteur de Riyad Zaer Gardens à Aïn Aouda : 9 immeubles, 120 appartements et 49 commerces, livraison prévue en 2028."
>
  <div class="fusion-page" data-fusion-page>
    <section class="bg-foret px-4 pb-14 pt-28 text-creme sm:px-6 md:pt-32">
      <div class="mx-auto max-w-3xl" data-reveal-group>
        <p class="fusion-kicker reveal-fusion">
          <span data-bilingual-fr>Le promoteur</span>
          <span data-bilingual-ar hidden>المطور</span>
        </p>
        <h1 class="fusion-h1 mt-6 reveal-fusion">
          <span data-bilingual-fr>La Manoussa, promoteur de Riyad Zaer Gardens</span>
          <span data-bilingual-ar hidden>La Manoussa، مطور رياض زعير غاردنز</span>
        </h1>
        <p class="fusion-lead fusion-lead--wide text-creme/75 reveal-fusion">
          <span data-bilingual-fr>
            Riyad Zaer Gardens est développé par La Manoussa, promoteur immobilier actif dans la région de Rabat. La conception architecturale du projet est signée Mabani Architects.
          </span>
          <span data-bilingual-ar hidden>
            يطور رياض زعير غاردنز La Manoussa، مطور عقاري نشيط في جهة الرباط. التصور المعماري من توقيع Mabani Architects.
          </span>
        </p>
      </div>
    </section>

    <section class="bg-white section">
      <div class="container-rzg" data-reveal-group>
        <h2 class="fusion-h2 reveal-fusion">
          <span data-bilingual-fr>Nos projets</span>
          <span data-bilingual-ar hidden>مشاريعنا</span>
        </h2>
        <article class="mt-8 border-t border-gold/40 pt-6 reveal-fusion">
          <h3 class="fusion-sub text-canopee">
            <span data-bilingual-fr>Riyad Zaer Gardens</span>
            <span data-bilingual-ar hidden>رياض زعير غاردنز</span>
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-foret/70">
            <span data-bilingual-fr>
              9 immeubles, 120 appartements et 49 fonds de commerce à Aïn Aouda, sur l’Avenue Mohammed VI. Livraison prévue en septembre 2028.
            </span>
            <span data-bilingual-ar hidden>
              9 عمارات و120 شقة و49 محلاً تجارياً في عين عودة، على شارع محمد السادس. التسليم المتوقع سبتمبر 2028.
            </span>
          </p>
          <a href={routes.projet()} class="link-line mt-4 inline-flex text-sm font-medium text-gold">
            <span data-bilingual-fr>Le projet →</span>
            <span data-bilingual-ar hidden>المشروع ←</span>
          </a>
        </article>
      </div>
    </section>

    <ConversionBlock
      titleFr="Une question sur le projet ?"
      titleAr="سؤال عن المشروع؟"
      bodyFr="Notre équipe commerciale répond à vos questions et vous accompagne dans votre projet d’achat."
      bodyAr="يجيب فريقنا التجاري عن أسئلتكم ويرافقكم في مشروع الشراء."
      secondaryFr={`Appeler le ${site.phone}`}
      secondaryAr={`اتصلوا على ${site.phone}`}
      secondaryHref={`tel:${site.phoneTel}`}
      secondaryExternal={false}
    />
  </div>
</PageLayout>
