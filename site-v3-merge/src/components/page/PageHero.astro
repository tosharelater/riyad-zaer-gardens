---
/**
 * Inner-page hero — same language as the homepage:
 * full-bleed photograph, title low on the image, gold second line,
 * quiet actions. Optional facts strip underneath (like the proof bar).
 */
interface Fact {
  n: string;
  l: string;
  count?: number;
}
interface Props {
  h1: string;
  lead?: string | readonly string[];
  kicker?: string;
  index?: string;
  image?: string;
  alt?: string;
  compact?: boolean;
  facts?: readonly Fact[];
  position?: string;
  accent?: boolean;
}
const {
  h1,
  lead,
  kicker = 'Riyad Zaer Gardens',
  index,
  image,
  alt = '',
  compact = false,
  facts = [],
  position = 'center 40%',
  accent = true,
} = Astro.props;
const leads = lead == null ? [] : Array.isArray(lead) ? [...lead] : [lead];
const hasExtras = Astro.slots.has('default');
const plain = !image;
const words = h1.trim().split(/\s+/);
let accentFrom = -1;
if (accent && words.length >= 3) {
  let best = Infinity;
  for (let i = 1; i < words.length; i++) {
    const d = Math.abs(words.slice(0, i).join(' ').length - words.slice(i).join(' ').length);
    if (d < best) { best = d; accentFrom = i; }
  }
}
---
<header class:list={['ph', { 'is-compact': compact, 'is-plain': plain }]} data-page-hero>
  {!plain && (
    <figure class="ph-media" data-ph-media>
      <img src={image} alt={alt} fetchpriority="high" decoding="async" style={`object-position: ${position}`} />
    </figure>
  )}
  {!plain && <div class="ph-shade" aria-hidden="true"></div>}

  <div class="ph-copy wrap">
    <p class="ph-kick" data-ph-in>
      {index && <span class="ph-index">{index}</span>}
      {index && <i aria-hidden="true"></i>}
      <span>{kicker}</span>
    </p>
    <h1 class="ph-title" data-ph-title data-accent-from={accentFrom > 0 ? accentFrom : undefined}>{h1}</h1>

    {(leads.length > 0 || hasExtras) && (
      <div class="ph-foot">
        {leads.length > 0 && (
          <div class="ph-leads" data-ph-in>
            {leads.slice(0, 3).map((p) => <p class="ph-lead">{p}</p>)}
          </div>
        )}
        {hasExtras && (
          <div class="ph-extra" data-ph-in>
            <slot />
          </div>
        )}
      </div>
    )}
  </div>

  {facts.length > 0 && (
    <dl class="ph-facts">
      {facts.map((f) => (
        <div data-ph-fact>
          <dt data-count={f.count != null ? String(f.count) : undefined}>{f.n}</dt>
          <dd>{f.l}</dd>
        </div>
      ))}
    </dl>
  )}
</header>

<style>
  .ph {
    position: relative;
    min-height: 100svh;
    min-height: 100dvh;
    display: grid;
    grid-template-rows: 1fr auto;
    align-items: end;
    color: var(--cream);
    overflow: hidden;
    isolation: isolate;
    background: var(--ink);
  }
  .ph.is-compact {
    min-height: min(78svh, 44rem);
  }

  .ph-media {
    position: absolute;
    inset: 0;
    z-index: -2;
    margin: 0;
    overflow: hidden;
    animation: ph-curtain 1.4s var(--ease-io) both;
  }
  .ph-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.04);
    animation: ph-settle 2.6s var(--ease) both;
  }
  .ph-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(to top, rgb(0 36 36 / 0.88) 0%, rgb(0 36 36 / 0.45) 38%, transparent 62%),
      linear-gradient(100deg, rgb(0 36 36 / 0.7) 0%, rgb(0 36 36 / 0.3) 45%, transparent 75%);
  }

  .ph-copy {
    display: grid;
    gap: 1.1rem;
    justify-items: start;
    align-self: end;
    padding-top: calc(var(--nav) + 2.75rem);
    padding-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .ph-kick {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.9rem;
    margin: 0;
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold-soft);
  }
  .ph-index {
    color: var(--gold);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.08em;
  }
  .ph-kick i {
    width: 0.25rem;
    height: 0.25rem;
    border-radius: 50%;
    background: var(--gold);
    opacity: 0.75;
  }

  .ph-title {
    margin: 0;
    max-width: min(22ch, 100%);
    font-family: var(--font);
    font-size: clamp(2.4rem, 5.8vw, 5.4rem);
    font-weight: 300;
    letter-spacing: -0.035em;
    line-height: 1.02;
    text-wrap: balance;
    color: var(--paper);
  }
  .is-compact .ph-title {
    font-size: clamp(2rem, 4.4vw, 3.4rem);
  }
  .ph-title :global(.w.is-accent) { color: var(--gold-soft); }
  .ph-title :global(.w > span) { transform: translateY(110%); }

  .ph-foot {
    display: grid;
    gap: 1.25rem;
    justify-items: start;
    margin-top: 0.25rem;
  }
  .ph-leads { max-width: 34rem; }
  .ph-lead {
    margin: 0;
    font-size: clamp(0.98rem, 1.2vw, 1.08rem);
    line-height: 1.6;
    color: rgb(246 240 228 / 0.88);
    text-wrap: pretty;
  }
  .ph-lead + .ph-lead { margin-top: 0.55rem; }

  .ph-extra {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.65rem 1.5rem;
  }
  .ph-extra :global(.btn),
  .ph-extra :global(.btn:hover),
  .ph-extra :global(.btn:active) {
    min-height: 0;
    padding: 0.4rem 0.1rem;
    border: 0;
    border-radius: 0;
    border-bottom: 1.5px solid rgb(255 255 255 / 0.55);
    background: none;
    box-shadow: none;
    color: #fff;
    transform: none;
  }
  .ph-extra :global(.btn:hover) { border-bottom-color: #fff; }
  .ph-extra :global(.btn-light),
  .ph-extra :global(.btn-light:hover) {
    color: rgb(255 255 255 / 0.88);
    border-bottom-color: rgb(255 255 255 / 0.35);
  }
  .ph-extra :global(.btn-light:hover) {
    color: #fff;
    border-bottom-color: #fff;
  }

  .ph-facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(9rem, 1fr));
    margin: 0;
    border-top: 1px solid color-mix(in srgb, var(--canopy) 28%, transparent);
    background: var(--cream);
    color: var(--ink);
    padding-inline: max(var(--pad), calc((100% - var(--wrap)) / 2));
  }
  .ph-facts > div {
    display: grid;
    gap: 0.35rem;
    align-content: center;
    min-height: 6.5rem;
    padding: 1.15rem clamp(0.5rem, 2vw, 1.5rem) 1.25rem 0;
  }
  .ph-facts > div + div {
    padding-inline-start: clamp(0.75rem, 2vw, 1.5rem);
    border-inline-start: 1px solid color-mix(in srgb, var(--canopy) 18%, transparent);
  }
  .ph-facts dt {
    font-family: var(--font);
    font-weight: 300;
    font-size: clamp(1.7rem, 3vw, 2.4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }
  .ph-facts dd {
    margin: 0;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--gold-text);
  }

  /* Plain: no photo — cream reading page */
  .ph.is-plain {
    min-height: 0;
    background: var(--cream);
    color: var(--ink);
  }
  .ph.is-plain .ph-copy {
    padding-top: calc(var(--nav) + clamp(4rem, 10vw, 8rem));
  }
  .ph.is-plain .ph-kick { color: var(--gold-text); }
  .ph.is-plain .ph-kick i { background: var(--gold-text); }
  .ph.is-plain .ph-index { color: var(--gold-deep); }
  .ph.is-plain .ph-title { color: var(--ink); }
  .ph.is-plain .ph-title :global(.w.is-accent) { color: var(--gold-text); }
  .ph.is-plain .ph-lead { color: var(--muted); }
  .ph.is-plain .ph-extra :global(.btn),
  .ph.is-plain .ph-extra :global(.btn:hover) {
    color: var(--canopy);
    border-bottom-color: color-mix(in srgb, var(--canopy) 45%, transparent);
  }
  .ph.is-plain .ph-extra :global(.btn-light),
  .ph.is-plain .ph-extra :global(.btn-light:hover) {
    color: var(--ink);
    border-bottom-color: color-mix(in srgb, var(--ink) 28%, transparent);
  }

  [data-ph-in],
  [data-ph-fact] { animation: ph-rise 1.1s var(--ease) both; }
  .ph-kick { animation-delay: 0.3s; }
  .ph-leads { animation-delay: 0.7s; }
  .ph-extra { animation-delay: 0.85s; }
  [data-ph-fact]:nth-child(1) { animation-delay: 0.95s; }
  [data-ph-fact]:nth-child(2) { animation-delay: 1.02s; }
  [data-ph-fact]:nth-child(3) { animation-delay: 1.09s; }
  [data-ph-fact]:nth-child(4) { animation-delay: 1.16s; }

  @keyframes ph-curtain {
    from { opacity: 0; }
    to { opacity: 1; }
  }
  @keyframes ph-settle {
    from { transform: scale(1.06); }
    to { transform: scale(1); }
  }
  @keyframes ph-rise {
    from { opacity: 0; transform: translateY(1.1rem); }
    to { opacity: 1; transform: none; }
  }

  @media (max-width: 800px) {
    .ph-lead + .ph-lead + .ph-lead { display: none; }
    .ph-facts > div + div {
      border-inline-start: 0;
      padding-inline-start: 0;
    }
    .ph-facts > div { padding-inline-end: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .ph-media,
    .ph-media img,
    [data-ph-in],
    [data-ph-fact] { animation: none; }
    .ph-media img { transform: none; }
    .ph-title :global(.w > span) { transform: none; }
  }
</style>
