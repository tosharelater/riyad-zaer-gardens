---
/**
 * COMPARE A — GitHub / older figures (open type on paper).
 * Same écriture. Keep for side-by-side choice vs Figures.astro.
 */
import { getHome } from '../data/content';
import type { Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { figures } = getHome(locale);
---
<section class="fig-gh" id="chiffres-a" data-compare="github">
  <div class="wrap">
    <header class="head-split">
      <p class="kick">{locale === 'ar' ? 'المرحلة الأولى' : 'Tranche 1'}</p>
      <h2 class="display">{figures.h2}</h2>
      <p class="lead">{figures.lead}</p>
    </header>

    <dl class="fig-gh-board">
      {figures.items.map((f) => (
        <div class="fig-gh-item">
          <dt>{f.n}</dt>
          <dd>{f.label}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .fig-gh {
    padding: var(--sec) 0;
    background: var(--paper);
  }
  .fig-gh-board {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--gap);
    margin: 0;
  }
  .fig-gh-item {
    display: grid;
    gap: 0.55rem;
    align-content: start;
  }
  .fig-gh-item dt {
    font-family: var(--display);
    font-weight: 600;
    font-size: clamp(3rem, 6.5vw, 5rem);
    line-height: 1;
    letter-spacing: -0.045em;
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .fig-gh-item dd {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 500;
    letter-spacing: -0.01em;
    color: var(--muted);
  }
  @media (max-width: 600px) {
    .fig-gh-board { gap: 1rem; }
    .fig-gh-item dt { font-size: clamp(2.25rem, 11vw, 3rem); }
    .fig-gh-item dd { font-size: 0.9375rem; }
  }
</style>
