---
import PageHero from '../page/PageHero.astro';
import PageBand from '../page/PageBand.astro';
import MoreLinks from '../page/MoreLinks.astro';
import { media } from '../../data/media';
import { localePath, type Locale } from '../../i18n/paths';
import { projetPage as projetFr } from '../../data/pages';
import { projetPage as projetAr } from '../../data/pages.ar';

interface Props {
  locale?: Locale;
}
const { locale = 'fr' } = Astro.props;
const p = locale === 'ar' ? projetAr : projetFr;
const L =
  locale === 'ar'
    ? {
        kick: 'المشروع',
        ctaApt: 'عرض الشقق',
        ctaCall: 'اطلب اتصالاً',
        promoteur: 'المطوّر',
        conception: 'التصميم',
        life: 'إطار العيش',
        amenities: 'الخدمات',
        management: 'الإدارة',
        develop: 'التطور',
      }
    : {
        kick: 'Le projet',
        ctaApt: 'Voir les appartements',
        ctaCall: 'Être rappelé',
        promoteur: 'Le promoteur',
        conception: 'Conception',
        life: 'Cadre de vie',
        amenities: 'Prestations',
        management: 'Gestion',
        develop: 'Développement',
      };

const moreLinks = p.more.links.map((l) => ({ ...l, href: localePath(locale, l.href) }));
const promoteur = 'promoteur' in p ? p.promoteur : null;
---
<div data-projet-page class="projet-page">
  <PageHero
    h1={p.h1}
    lead={p.lead}
    kicker={L.kick}
    image="/photos/aerial-ilot.webp"
    alt="Vue de la résidence Riyad Zaer Gardens"
  >
    <a class="btn btn-solid" href={localePath(locale, '/appartements')}>{L.ctaApt}</a>
    <a class="btn btn-light" href={localePath(locale, '/contact')}>{L.ctaCall}</a>
  </PageHero>

  {promoteur && (
    <section class="promoteur">
      <div class="wrap text-photo">
        <div data-reveal data-split>
          <p class="kick">{L.promoteur}</p>
          <h2 class="display">{promoteur.h2}</h2>
          {promoteur.body.map((t) => <p class="lead">{t}</p>)}
          <a class="text-link" href={localePath(locale, promoteur.link.href)}>{promoteur.link.label}</a>
        </div>
        <figure data-media>
          <img src="/photos/facade-golden.webp" alt={media.facade.alt} loading="lazy" decoding="async" />
        </figure>
      </div>
    </section>
  )}

  <section class="chapters soft-band">
    <div class="wrap">
      <header class="head-split chapters-head" data-reveal data-split>
        <p class="kick">{L.conception}</p>
        <h2 class="display">{p.conception.h2}</h2>
        <p class="lead">{p.conception.intro}</p>
      </header>
      <ol class="chapters-grid">
        {p.conception.items.map((item, i) => (
          <li class="chapter" data-chapter>
            <span class="chapter-num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="cour-scene" id="cadre" data-cour-scene>
    <figure class="cour-media" data-cour-media>
      <img src="/photos/allee-jardin.webp" alt={media.courtyard.alt} loading="lazy" decoding="async" />
    </figure>
    <div class="cour-shade" aria-hidden="true"></div>
    <div class="wrap cour-copy">
      <p class="kick" data-cour-line>{L.life}</p>
      <h2 class="display" data-cour-line>{p.cadre.h2}</h2>
      <p class="lead" data-cour-line>{p.cadre.body[1] ?? p.cadre.body[0]}</p>
      <ul class="cour-points" data-cour-line>
        {(locale === 'ar'
          ? ['فناء مركزي مزروع', 'مساحات لعب للأطفال', 'مخصصة للساكنين']
          : ['Cour centrale plantée', 'Aires de jeux', 'Réservée aux résidents']
        ).map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
  </section>

  <section class="amenity">
    <div class="wrap">
      <header class="head-split amenity-head" data-reveal data-split>
        <p class="kick">{L.amenities}</p>
        <h2 class="display">{p.equipements.h2}</h2>
        <p class="lead">{p.equipements.intro}</p>
      </header>
      <ol class="amenity-grid">
        {p.equipements.items.map((item, i) => (
          <li class="amenity-item" data-amenity>
            <span class="amenity-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
            {'link' in item && item.link && (
              <a class="text-link" href={localePath(locale, item.link.href)}>{item.link.label}</a>
            )}
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="syndic">
    <div class="wrap syndic-grid">
    <div class="syndic-copy" data-reveal data-split>
      <p class="kick">{L.management}</p>
      <h2 class="display">{p.syndic.h2}</h2>
      <p class="lead">{p.syndic.body}</p>
      <p class="syndic-end">{p.syndic.end}</p>
    </div>
      <ol class="missions" data-missions>
        {p.syndic.missions.map((m) => (
          <li data-mission><span class="tick" aria-hidden="true"></span>{m}</li>
        ))}
      </ol>
    </div>
  </section>

  <section class="tranches">
    <div class="wrap tranches-grid">
      <div class="tranches-copy" data-reveal data-split>
        <p class="kick">{L.develop}</p>
        <h2 class="display">{p.tranches.h2}</h2>
      </div>
      <div class="tranches-body" data-reveal>
        {p.tranches.body.map((t) => <p class="lead">{t}</p>)}
      </div>
    </div>
  </section>

  <PageBand image="/photos/allee-jardin.webp" />
  <MoreLinks h2={p.more.h2} links={moreLinks} />
</div>

<script>
  import '../../scripts/projet-motion';
</script>

<style>
  .promoteur {
    padding: var(--sec) 0;
    background: var(--paper);
  }
  .promoteur .display {
    margin: 1rem 0 0.35rem;
    max-width: none;
  }
  .promoteur .lead + .lead { margin-top: 0.85rem; }
  .promoteur .text-link { margin-top: 1.25rem; }

  .chapters {
    padding: var(--sec) 0;
  }
  .chapters-head { margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .chapters-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.75rem, 4vw, 2.75rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .chapter {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: 1rem;
    row-gap: 0.55rem;
    padding: 0;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .chapter-num {
    grid-row: 1 / span 2;
    font-family: var(--display);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    color: var(--gold-text);
    padding-top: 0.35rem;
  }
  .chapter h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.2;
    color: var(--ink);
  }
  .chapter p {
    color: var(--muted);
    line-height: 1.7;
  }

  .cour-scene {
    position: relative;
    isolation: isolate;
    min-height: min(88svh, 52rem);
    display: grid;
    align-items: end;
    color: var(--cream);
    overflow: hidden;
    background: var(--ink);
  }
  .cour-media {
    position: absolute;
    inset: 0;
    z-index: -2;
    margin: 0;
  }
  .cour-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Whole îlot: the hollow courtyard has to stay readable */
    object-position: 45% 35%;
    transform: scale(1.08);
  }
  .cour-shade {
    position: absolute;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    background:
      linear-gradient(to top, rgb(0 36 34 / 0.88) 0%, rgb(0 36 34 / 0.35) 38%, rgb(0 36 34 / 0.08) 68%),
      linear-gradient(105deg, rgb(0 36 34 / 0.55) 0%, rgb(0 36 34 / 0.12) 42%, transparent 68%);
  }
  .cour-copy {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
    padding-block: clamp(3rem, 8vw, 5.5rem);
    max-width: 40rem;
  }
  .cour-scene .kick { margin: 0; color: var(--gold-soft); }
  .cour-scene .display {
    margin: 0;
    max-width: 16ch;
    color: var(--paper);
    font-size: clamp(2rem, 4.2vw, 3.35rem);
  }
  .cour-scene .lead {
    margin: 0;
    max-width: 34rem;
    color: rgb(246 240 228 / 0.88);
  }
  .cour-points {
    list-style: none;
    margin: 0.65rem 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 1.35rem;
  }
  .cour-points li {
    position: relative;
    padding-inline-start: 0.95rem;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--gold-soft);
  }
  .cour-points li::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    top: 0.45em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 1px;
    background: var(--gold);
  }

  .amenity {
    padding: var(--sec) 0;
    background: var(--canopy);
    color: var(--cream);
  }
  .amenity .kick { color: var(--gold-soft); }
  .amenity .lead { color: var(--muted-on-dark); }
  .amenity-head { margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .amenity-head .lead { color: var(--muted-on-dark); }
  .amenity-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1.75rem, 4vw, 2.75rem) clamp(1.5rem, 3vw, 2.5rem);
  }
  .amenity-item {
    display: grid;
    align-content: start;
    gap: 0.7rem;
  }
  .amenity-n {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--gold-soft);
  }
  .amenity-item h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    line-height: 1.15;
  }
  .amenity-item p {
    color: var(--muted-on-dark);
    line-height: 1.65;
  }
  .amenity-item .text-link {
    justify-self: start;
    color: var(--gold-soft);
  }

  .syndic {
    padding: var(--sec) 0;
    background: var(--paper);
  }
  .syndic-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap);
    align-items: start;
  }
  .syndic-copy .display {
    margin: 1rem 0 0.25rem;
    max-width: none;
  }
  .missions {
    display: grid;
    gap: 0.9rem;
  }
  .missions li {
    display: grid;
    grid-template-columns: 0.65rem 1fr;
    gap: 0.85rem;
    font-size: 1.05rem;
    line-height: 1.5;
    align-items: start;
  }
  .missions .tick {
    width: 0.4rem;
    height: 0.4rem;
    margin-top: 0.55rem;
    border-radius: 1px;
    background: var(--gold-text);
  }
  .syndic-end {
    margin-top: 1.5rem;
    color: var(--muted);
    line-height: 1.65;
    max-width: 30rem;
  }

  .tranches {
    padding: var(--sec) 0;
    background: var(--cream);
  }
  .tranches-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--gap);
    align-items: start;
  }
  .tranches-copy .display { margin-top: 1rem; max-width: none; }
  .tranches-body .lead:first-child { margin-top: 0; }
  .tranches-body .lead + .lead { margin-top: 0.85rem; }

  @media (max-width: 900px) {
    .chapters-grid { grid-template-columns: 1fr; }
    .amenity-grid { grid-template-columns: 1fr; }
    .syndic-grid, .tranches-grid { grid-template-columns: 1fr; }
  }
  @media (min-width: 901px) and (max-width: 1100px) {
    .amenity-grid { grid-template-columns: 1fr 1fr; }
  }
</style>
