---
import PageHero from '../page/PageHero.astro';
import PageBand from '../page/PageBand.astro';
import { media } from '../../data/media';
import { contactInfo } from '../../data/site';
import { localePath, type Locale } from '../../i18n/paths';
import { localisationPage as locFr } from '../../data/pages';
import { localisationPage as locAr } from '../../data/pages.ar';

interface Props {
  locale?: Locale;
}
const { locale = 'fr' } = Astro.props;
const p = locale === 'ar' ? locAr : locFr;
const L =
  locale === 'ar'
    ? {
        kick: 'الموقع',
        access: 'الوصول',
        area: 'الحي',
        map: 'على الخريطة',
        mapTitle: 'Km 25، شارع محمد السادس',
        iframeTitle: 'خريطة — رياض زعير غاردنز',
        mapsCta: 'فتح في Google Maps',
        visit: 'زيارة',
      }
    : {
        kick: 'Localisation',
        access: 'Accès',
        area: 'Le quartier',
        map: 'Sur la carte',
        mapTitle: 'Km 25, Avenue Mohammed VI',
        iframeTitle: 'Carte — Riyad Zaer Gardens',
        mapsCta: 'Ouvrir dans Google Maps',
        visit: 'Visite',
      };

const mapTitle = 'map' in p && p.map && 'title' in p.map ? (p.map as { title: string }).title : L.mapTitle;
const iframeTitle =
  'map' in p && p.map && 'iframeTitle' in p.map ? (p.map as { iframeTitle: string }).iframeTitle : L.iframeTitle;
const mapsCta =
  'map' in p && p.map && 'mapsCta' in p.map ? (p.map as { mapsCta: string }).mapsCta : L.mapsCta;
const quartierBody = typeof p.quartier.body === 'string' ? p.quartier.body.split('\n\n') : p.quartier.body;
---
<div data-loc-page class="loc-page">
  <PageHero
    h1={p.h1}
    lead={p.lead}
    kicker={L.kick}
    image="/photos/facade-street.webp"
    alt={media.avenue.alt}
  />

  <section class="access soft-band" data-access>
    <div class="wrap">
      <header class="access-head" data-reveal data-split>
        <p class="kick">{L.access}</p>
        <h2 class="display">{p.acces.h2}</h2>
      </header>
      <ol class="access-grid">
        {p.acces.items.map((item, i) => (
          <li class="stop" data-stop>
            <span class="stop-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.body}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <section class="quartier">
    <div class="wrap text-photo is-flip">
      <div data-reveal data-split>
        <p class="kick">{L.area}</p>
        <h2 class="display">{p.quartier.h2}</h2>
        {quartierBody.map((t) => <p class="lead">{t}</p>)}
        <ul class="near">
          {p.quartier.already.map((item) => <li><span class="tick" aria-hidden="true"></span>{item}</li>)}
        </ul>
        <p class="near-end">{p.quartier.end}</p>
      </div>
      <figure data-media>
        <img src="/photos/facade-golden.webp" alt={media.facade.alt} loading="lazy" decoding="async" />
      </figure>
    </div>
  </section>

  <section class="map">
    <div class="map-frame" data-map-frame>
      <iframe
        title={iframeTitle}
        src={contactInfo.mapEmbed}
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"
      ></iframe>
    </div>
    <div class="map-card map-panel" data-reveal>
      <p class="kick">{L.map}</p>
      <h2>{mapTitle}</h2>
      <a class="btn btn-solid" href={contactInfo.mapsHref} target="_blank" rel="noopener">{mapsCta}</a>
    </div>
  </section>

  <PageBand
    mode="custom"
    title={p.visit.h2}
    body={p.visit.body}
    primary={{ label: p.visit.cta.label, href: localePath(locale, p.visit.cta.href) }}
    image="/photos/facade-street.webp"
  />
</div>

<script>
  import '../../scripts/localisation-motion';
</script>

<style>
  .access {
    padding: var(--sec) 0;
  }
  .access-head { margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .access-head .display { margin-top: 1rem; max-width: none; }
  .access-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(1.75rem, 4vw, 3rem) clamp(2rem, 6vw, 6rem);
  }
  .stop {
    display: grid;
    grid-template-columns: 3rem 1fr;
    column-gap: 1rem;
    row-gap: 0.6rem;
  }
  .stop-n {
    grid-row: 1 / span 2;
    font-size: 0.875rem;
    font-weight: 600;
    letter-spacing: -0.005em;
    color: var(--gold-text);
    padding-top: 0.4rem;
  }
  .stop h3 {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(1.25rem, 1.8vw, 1.5rem);
    line-height: 1.2;
  }
  .stop p {
    color: var(--muted);
    line-height: 1.7;
  }

  .map {
    position: relative;
    background: var(--canopy);
  }
  .map-frame {
    height: min(70svh, 38rem);
    overflow: hidden;
  }
  .map-frame iframe {
    width: 100%;
    height: 100%;
    border: 0;
    display: block;
    filter: grayscale(0.4) contrast(1.05) sepia(0.12);
  }
  .map-card {
    position: absolute;
    inset-inline-start: max(var(--pad), calc((100% - var(--wrap)) / 2));
    bottom: clamp(2rem, 4vw, 3rem);
    width: min(26rem, calc(100% - 2 * var(--pad)));
  }

  .quartier {
    padding: var(--sec) 0;
    background: var(--paper);
  }
  .near {
    margin-top: 1.75rem;
    display: grid;
    gap: 0.85rem;
  }
  .near li {
    display: grid;
    grid-template-columns: 0.65rem 1fr;
    gap: 0.85rem;
    font-size: 1.05rem;
    align-items: start;
  }
  .near .tick {
    width: 0.4rem;
    height: 0.4rem;
    margin-top: 0.55rem;
    border-radius: 1px;
    background: var(--gold-text);
  }
  .near-end {
    margin-top: 1.25rem;
    color: var(--muted);
    line-height: 1.65;
  }

  @media (max-width: 900px) {
    .access-grid { grid-template-columns: 1fr; }
    .map-frame { height: min(60svh, 32rem); }
    .map-card { position: relative; inset: auto; width: auto; }
  }
</style>
