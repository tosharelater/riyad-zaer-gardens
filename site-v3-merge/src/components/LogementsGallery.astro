---
import { getHome } from '../data/content';
import { localePath, type Locale } from '../i18n/paths';
const locale = (Astro.currentLocale === 'ar' ? 'ar' : 'fr') as Locale;
const { apartments, aid } = getHome(locale);
const keep = (t: string) => t.replace(/(\d) (?=\d|DH|m)/g, '$1 ');
const facts: [string, string][] = [
  [locale === 'ar' ? 'النوع' : 'Typologies', apartments.types.join(' · ')],
  [locale === 'ar' ? 'المساحة' : 'Surfaces', keep(apartments.range)],
  [locale === 'ar' ? 'السعر' : 'Prix', keep(apartments.price.charAt(0).toLowerCase() + apartments.price.slice(1))],
  [locale === 'ar' ? 'مع الدعم' : 'Avec l’aide au logement', keep(aid.withAid)],
];
const ctaHref = apartments.cta.href.startsWith('/') ? localePath(locale, apartments.cta.href) : apartments.cta.href;
---
<section class="gal" id="appartements">
  <div class="wrap">
    <header class="gal-head" data-reveal data-split>
      <p class="kick">{locale === 'ar' ? 'الشقق' : 'Appartements'}</p>
      <h2 class="display">{apartments.h2}</h2>
      <p class="lead">{apartments.p1}</p>
    </header>

    <div class="gal-grid" data-reveal>
      <figure class="gal-main">
        <img src="/photos/salon.jpg" alt="" loading="lazy" decoding="async" />
        <div class="gal-panel">
          <dl class="facts">
            {facts.map(([k, v]) => (
              <div>
                <dt>{k}</dt>
                <dd>{v}</dd>
              </div>
            ))}
          </dl>
          <a class="btn btn-solid" href={ctaHref}>
            {apartments.cta.label}
          </a>
        </div>
      </figure>
      <figure class="gal-side">
        <img src="/photos/chambre.jpg" alt="" loading="lazy" decoding="async" />
      </figure>
      <figure class="gal-side">
        <img src="/photos/salon-balcon.jpg" alt="" loading="lazy" decoding="async" />
      </figure>
    </div>

    <p class="gal-note" data-reveal>{apartments.p2}</p>
  </div>
</section>

<style>
  .gal {
    padding: var(--sec) 0;
    background: var(--paper);
  }
  .gal-head {
    display: grid;
    justify-items: center;
    gap: 0.75rem;
    max-width: 44rem;
    margin: 0 auto clamp(2rem, 4vw, 3rem);
    text-align: center;
  }
  .gal-head .kick { margin: 0; }
  .gal-head .display { margin: 0; max-width: none; }
  .gal-head .lead { margin: 0.25rem 0 0; max-width: none; }

  .gal-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr);
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    height: clamp(26rem, 44vw, 36rem);
    margin-bottom: 3.5rem;
  }
  .gal-grid figure { margin: 0; position: relative; overflow: visible; min-height: 0; }
  .gal-grid img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 22px; }
  .gal-main { grid-row: 1 / -1; }
  .gal-side img { border-radius: 22px; }

  /* facts panel overlaps the bottom-left of the main photo */
  .gal-panel {
    position: absolute;
    inset-inline-start: clamp(1rem, 2.5vw, 1.75rem);
    bottom: -3rem;
    display: grid;
    gap: 1rem;
    justify-items: start;
    width: min(26rem, calc(100% - 2rem));
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border-radius: var(--radius);
    background: var(--paper);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--canopy) 8%, transparent);
  }
  .gal-panel .facts { margin: 0; width: 100%; gap: 0.55rem; }
  .gal-panel .facts > div { grid-template-columns: minmax(6.5rem, 8.5rem) 1fr; }
  .gal-panel .facts dd { font-size: 1rem; }

  .gal-note {
    margin: 0 auto;
    max-width: 38rem;
    text-align: center;
    color: var(--muted);
  }

  @media (max-width: 900px) {
    .gal-grid { grid-template-columns: 1fr 1fr; grid-template-rows: auto auto; height: auto; margin-bottom: 1.5rem; }
    .gal-main { grid-column: 1 / -1; grid-row: auto; display: grid; gap: 1rem; }
    .gal-main img { position: static; aspect-ratio: 16 / 10; height: auto; }
    .gal-panel { position: static; width: 100%; box-shadow: none; background: var(--cream); }
    .gal-side { aspect-ratio: 4 / 3; }
  }
</style>
