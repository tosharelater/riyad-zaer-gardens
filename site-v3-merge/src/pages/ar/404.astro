---
import BaseLayout from '../../layouts/BaseLayout.astro';
import StatusShowcase from '../../components/showcase/StatusShowcase.astro';
import { notFoundPage as p } from '../../data/pages.ar';
---
<BaseLayout locale="ar" title={p.seoTitle}>
  <StatusShowcase
    locale="ar"
    kicker={p.kick}
    h1={p.h1}
    lead={p.body}
    image="/photos/facade-nuit.jpg"
    primary={p.primary}
    secondary={p.secondary}
    more={p.more}
  />
</BaseLayout>
