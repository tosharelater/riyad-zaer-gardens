---
import '../styles/global.css';
import Splash from '../components/Splash.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Riyad Zaer Gardens — nouveau pôle urbain à Aïn Aouda / Rabat. F3 & F4, 120 appartements.',
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<!doctype html>
<html lang="fr" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#002D2D" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- TODO: replace Bodoni Moda with Audrey once .woff2/.otf land in public/fonts -->
    <link
      href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400;0,6..96,500;0,6..96,600;1,6..96,400&family=Poppins:wght@300;400;500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      try {
        if (sessionStorage.getItem('rzg-splash-seen') === '1') {
          document.documentElement.classList.add('rzg-splash-done');
        } else {
          document.documentElement.classList.add('rzg-splash-pending');
        }
      } catch (e) {
        document.documentElement.classList.add('rzg-splash-pending');
      }
    </script>
    <title>{title}</title>
  </head>
  <body>
    <Splash />
    <slot />
    <script>
      import { initSplash } from '../scripts/splash.ts';
      import { initLangToggle } from '../scripts/i18n.ts';
      import { initReveal, initParallax, initHeaderScroll, initChapterVideos } from '../scripts/polish.ts';
      import { initChoose } from '../scripts/choose.ts';
      initSplash();
      initLangToggle();
      initReveal();
      initParallax();
      initHeaderScroll();
      initChapterVideos();
      initChoose();
    </script>
  </body>
</html>
