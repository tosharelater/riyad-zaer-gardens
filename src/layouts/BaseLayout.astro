---
import '../styles/global.css';
import Splash from '../components/Splash.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Riyad Zaer Gardens — nouveau pôle urbain à Aïn Aouda / Rabat. F3 & F4, 120 appartements.',
} = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<!doctype html>
<html lang="fr" dir="ltr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!-- Pre-paint splash gate: localStorage + critical CSS so refresh never flashes -->
    <script is:inline>
      try {
        if (localStorage.getItem('rzg-splash-seen') === '1') {
          document.documentElement.classList.add('rzg-splash-done');
        } else {
          document.documentElement.classList.add('rzg-splash-pending');
        }
      } catch (e) {
        document.documentElement.classList.add('rzg-splash-pending');
      }
    </script>
    <style is:inline>
      /* Critical: apply before external CSS — hide splash unless pending */
      .rzg-splash {
        display: none;
        visibility: hidden;
      }
      html.rzg-splash-pending .rzg-splash {
        display: grid;
        visibility: visible;
        place-items: center;
        position: fixed;
        inset: 0;
        z-index: 200;
        background: #002d2d;
      }
      html.rzg-splash-done .rzg-splash {
        display: none !important;
        visibility: hidden !important;
      }
      html.rzg-splash-pending,
      html.rzg-splash-pending body {
        overflow: hidden;
      }
    </style>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#002D2D" />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <!-- Display: Audrey via @font-face in global.css (public/fonts). UI: Poppins only. No Bodoni. -->
    <link
      href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,300;0,400;0,500;0,700;1,400&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <Splash />
    <slot />
    <script>
      import { initSplash } from '../scripts/splash.ts';
      import { initLangToggle } from '../scripts/i18n.ts';
      import { initReveal, initParallax, initHeaderScroll, initChapterVideos } from '../scripts/polish.ts';
      import { initChoose } from '../scripts/choose.ts';
      import { initQuartier } from '../scripts/quartier3d.ts';
      initSplash();
      initLangToggle();
      initReveal();
      initParallax();
      initHeaderScroll();
      initChapterVideos();
      initChoose();
      initQuartier();
    </script>
  </body>
</html>
