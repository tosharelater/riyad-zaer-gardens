---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { posts, getPost } from '../../data/blog';

export function getStaticPaths() {
  return posts.map((post) => ({ params: { slug: post.slug } }));
}

const { slug } = Astro.params;
const post = getPost(slug!);
if (!post) {
  return Astro.redirect('../');
}

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const paragraphs = [
  'Riyad Zaer Gardens fait partie des projets résidentiels les plus ambitieux lancés à la périphérie de Rabat : 120 appartements F3 et F4, des fonds de commerce en rez-de-chaussée, des jardins partagés et des équipements du quotidien réunis en un seul site — pensé pour des familles marocaines, pas pour un marché de niche.',
  'Cette échelle change la donne. Regrouper logement, commerce et espaces verts au même endroit permet de mutualiser les coûts d’aménagement et de maintenir des prix cohérents avec les dispositifs d’aide au logement, sans sacrifier la qualité des matériaux ni le suivi de chantier.',
  'Sur le terrain, cela se traduit par des choix concrets : cours végétalisées entre les immeubles, cheminements piétons séparés des accès véhicules, façades claires et volumes qui laissent entrer la lumière toute la journée. Rien n’est laissé au hasard, du plan de masse jusqu’au choix des faïences.',
  'Le calendrier de livraison est communiqué dès la réservation, avec des jalons de chantier visibles pour chaque acquéreur. L’objectif reste simple : que l’ampleur du projet profite à chaque famille qui s’y installe, sans complexité supplémentaire au moment de réserver.',
];
---

<BaseLayout title={`${post.title} — Riyad Zaer Gardens`} description={post.excerpt}>
  <Header current="blog" />

  <article class="bg-cream text-foret">
    <header class="pt-32 pb-10 md:pb-14">
      <div class="container-rzg max-w-3xl" data-reveal>
        <p class="mb-5">
          <a href={`${base}blog/`} class="text-sm font-medium tracking-wide text-canopee hover:text-gold transition-colors" data-i18n="blog_back">← Blog</a>
        </p>
        <div class="flex flex-wrap items-center gap-3 mb-5 text-[0.7rem] tracking-[0.1em] uppercase text-canopee/70">
          <time datetime={post.date}>{post.dateLabel}</time>
          <span class="w-1 h-1 rounded-full bg-gold" aria-hidden="true"></span>
          <span>{post.readMin} min</span>
        </div>
        <h1 class="serif text-[clamp(2.25rem,5vw,3.75rem)] m-0 mb-6">{post.title}</h1>
        <p class="text-foret/70 text-lg md:text-xl leading-relaxed m-0">{post.excerpt}</p>
      </div>
    </header>

    <div class="container-rzg max-w-4xl mb-14 md:mb-20" data-reveal="clip">
      <div class="overflow-hidden rounded-sm aspect-[16/9] bg-canopee">
        <img src={`${base}${post.img}`} alt="" width="1400" height="788" class="w-full h-full object-cover" loading="eager" />
      </div>
    </div>

    <div class="container-rzg max-w-2xl pb-20 md:pb-28 article-prose" data-reveal>
      <p>{paragraphs[0]}</p>
      <h2>Repères utiles</h2>
      <p>{paragraphs[1]}</p>
      <p>{paragraphs[2]}</p>
      <h2>Ce qu’il faut retenir</h2>
      <p>{paragraphs[3]}</p>
      <div class="flex flex-wrap gap-2 mt-10 mb-12">
        {post.tags.map((tag) => <span class="chip">{tag}</span>)}
      </div>
      <div class="border-t border-foret/10 pt-10 flex flex-wrap gap-4 items-center justify-between">
        <a href={`${base}blog/`} class="text-sm font-medium tracking-wide text-canopee hover:underline underline-offset-4" data-i18n="blog_back">← Blog</a>
        <a class="btn btn-solid" href={`${base}contact/`} data-i18n="nav_contact">Contact</a>
      </div>
    </div>
  </article>

  <Footer />
</BaseLayout>
