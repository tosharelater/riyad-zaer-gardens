---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<BaseLayout title="À propos — Riyad Zaer Gardens" description="L’histoire et la vision de Riyad Zaer Gardens, nouveau pôle urbain à Aïn Aouda / Rabat.">
  <Header current="about" />

  <section class="bg-foret text-cream pt-36 pb-24 md:pb-32 relative overflow-hidden">
    <div class="absolute inset-0 opacity-30" aria-hidden="true">
      <img src={`${base}parcours/viz-07.jpg`} alt="" class="w-full h-full object-cover" width="1920" height="1080" />
      <div class="absolute inset-0 bg-gradient-to-t from-foret via-foret/70 to-foret/40"></div>
    </div>
    <div class="container-rzg relative z-10 max-w-3xl" data-reveal>
      <p class="kicker" data-i18n="about_kicker">À propos</p>
      <h1 class="serif text-[clamp(2.75rem,6vw,4.5rem)] m-0 mb-6" data-i18n="about_title">Une adresse qui tient sa parole</h1>
      <p class="text-cream/75 text-lg md:text-xl leading-relaxed m-0 max-w-2xl" data-i18n="about_lead">
        Riyad Zaer Gardens naît d’une intuition simple : offrir un cadre familial, moderne et sécurisé — entre Rabat et Aïn Aouda — sans le bruit du luxe générique.
      </p>
    </div>
  </section>

  <section class="bg-cream text-foret py-24 md:py-32">
    <div class="container-rzg grid lg:grid-cols-12 gap-12 lg:gap-20 items-start">
      <div class="lg:col-span-5" data-reveal>
        <p class="kicker kicker--ink" data-i18n="about_vision_kicker">Vision</p>
        <h2 class="serif text-[clamp(2rem,4vw,3rem)] m-0 mb-6" data-i18n="about_vision_title">Vivre autrement. C’est possible.</h2>
        <p class="text-foret/75 text-lg leading-relaxed m-0" data-i18n="about_vision_body">
          Nous croyons qu’un grand projet ne doit pas être réservé à quelques-uns. Riyad Zaer Gardens réunit logements, commerces et espaces verts au même endroit, à une échelle rarement atteinte au Maroc pour ce segment — pour que la qualité de vie reste accessible au plus grand nombre.
        </p>
      </div>
      <div class="lg:col-span-7 space-y-8" data-stagger>
        <article class="border border-foret/10 rounded-sm p-7 md:p-9 bg-white/40">
          <h3 class="serif text-2xl m-0 mb-3" data-i18n="about_p1_t">Cadre & nature</h3>
          <p class="m-0 text-foret/70 leading-relaxed" data-i18n="about_p1_b">
            Près de 40 % de l’emprise du projet est réservée aux espaces verts et aux circulations piétonnes. Cours végétalisées, promenades ombragées, volumes qui respirent — la nature comme infrastructure, pas comme décor.
          </p>
        </article>
        <article class="border border-foret/10 rounded-sm p-7 md:p-9 bg-white/40">
          <h3 class="serif text-2xl m-0 mb-3" data-i18n="about_p2_t">Accession maîtrisée</h3>
          <p class="m-0 text-foret/70 leading-relaxed" data-i18n="about_p2_b">
            Un projet dimensionné pour maximiser l’éligibilité aux aides au logement, avec un accompagnement dossier par dossier — de la réservation jusqu’à la remise des clés.
          </p>
        </article>
        <article class="border border-foret/10 rounded-sm p-7 md:p-9 bg-white/40">
          <h3 class="serif text-2xl m-0 mb-3" data-i18n="about_p3_t">Long terme</h3>
          <p class="m-0 text-foret/70 leading-relaxed" data-i18n="about_p3_b">
            Un chantier suivi et documenté, des jalons visibles dès la réservation, une livraison anticipée — pour que la promesse tienne aussi longtemps que l’adresse.
          </p>
        </article>
      </div>
    </div>
  </section>

  <section class="bg-cream border-t border-foret/8 py-24 md:py-32 section-seam">
    <div class="container-rzg grid md:grid-cols-2 gap-10 lg:gap-16 items-center">
      <div class="relative aspect-[4/5] overflow-hidden rounded-sm bg-canopee" data-reveal="clip">
        <img src={`${base}parcours/viz-02.jpg`} alt="" width="1000" height="1250" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
      </div>
      <div data-reveal>
        <p class="kicker kicker--ink" data-i18n="about_numbers_kicker">En chiffres</p>
        <h2 class="serif text-[clamp(2rem,4vw,3rem)] m-0 mb-10" data-i18n="about_numbers_title">L’échelle du projet</h2>
        <dl class="grid grid-cols-2 gap-8 m-0">
          <div>
            <dt class="text-xs uppercase tracking-[0.14em] text-canopee/70 mb-2" data-i18n="about_n1_l">Appartements</dt>
            <dd class="serif text-4xl md:text-5xl m-0 text-foret">120</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-[0.14em] text-canopee/70 mb-2" data-i18n="about_n2_l">Surfaces</dt>
            <dd class="serif text-4xl md:text-5xl m-0 text-foret">65–86</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-[0.14em] text-canopee/70 mb-2" data-i18n="about_n3_l">Typologies</dt>
            <dd class="serif text-4xl md:text-5xl m-0 text-foret">F3 · F4</dd>
          </div>
          <div>
            <dt class="text-xs uppercase tracking-[0.14em] text-canopee/70 mb-2" data-i18n="about_n4_l">Commerces</dt>
            <dd class="serif text-4xl md:text-5xl m-0 text-gold">+</dd>
          </div>
        </dl>
        <div class="mt-12">
          <a class="btn btn-solid" href={`${base}contact/`} data-i18n="nav_contact">Contact</a>
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
