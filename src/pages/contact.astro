---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const target = `${base}#talk`;
---

<BaseLayout title="Contact — Riyad Zaer Gardens">
  <Header current="contact" />
  <section class="companion theme-cream">
    <div class="container companion-inner">
      <p class="kicker kicker--ink" data-i18n="talk_kicker">Échange</p>
      <h1 class="serif" data-i18n="companion_contact">Le contact est dans le parcours</h1>
      <p class="muted">WhatsApp prioritaire — chapitre Parler.</p>
      <div class="companion-links">
        <a class="btn btn-solid" href={target} data-i18n="companion_back">Revenir au parcours</a>
        <a class="btn-ghost-link" href={`${base}#choose`} data-i18n="nav_choose">Choisir</a>
      </div>
    </div>
  </section>
  <Footer />
  <script define:vars={{ target }}>
    location.replace(target);
  </script>
</BaseLayout>
