---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';

const faqItems = [
  {
    id: 'aides',
    qKey: 'faq_aides_q',
    q: 'Le projet est-il éligible aux aides au logement ?',
    aKey: 'faq_aides_a',
    a: 'Oui. Riyad Zaer Gardens est conçu pour maximiser l’éligibilité aux dispositifs d’accession. Notre équipe vous oriente dossier par dossier.',
  },
  {
    id: 'livraison',
    qKey: 'faq_livraison_q',
    q: 'Quand est prévue la livraison ?',
    aKey: 'faq_livraison_a',
    a: 'Le calendrier de livraison est partagé dès la réservation, avec des jalons de chantier visibles. Vous savez où en est votre futur chez-vous.',
  },
  {
    id: 'parking',
    qKey: 'faq_parking_q',
    q: 'Y a-t-il du stationnement ?',
    aKey: 'faq_parking_a',
    a: 'Des places dédiées sont prévues pour les résidents. Les détails (nombre, attribution) sont précisés à la réservation.',
  },
  {
    id: 'visite',
    qKey: 'faq_visite_q',
    q: 'Puis-je visiter le site ou le showroom ?',
    aKey: 'faq_visite_a',
    a: 'Oui, sur rendez-vous. Contactez-nous via WhatsApp pour planifier une visite et découvrir les typologies en détail.',
  },
  {
    id: 'reservation',
    qKey: 'faq_resa_q',
    q: 'Comment réserver un appartement ?',
    aKey: 'faq_resa_a',
    a: 'Choisissez votre typologie sur la page d’accueil, puis écrivez-nous sur WhatsApp. Nous vous guidons pour la réservation et les prochaines étapes.',
  },
  {
    id: 'typologies',
    qKey: 'faq_typo_q',
    q: 'Quelles typologies sont disponibles ?',
    aKey: 'faq_typo_a',
    a: 'F3 (65–75 m²), F4 (jusqu’à 86 m²) et fonds de commerce en rez-de-chaussée — 120 appartements au total.',
  },
] as const;
---

<BaseLayout title="Contact — Riyad Zaer Gardens">
  <Header current="contact" />

  <section class="bg-cream text-foret pt-32 pb-12 md:pb-16">
    <div class="container-rzg max-w-2xl" data-reveal>
      <p class="kicker kicker--ink" data-i18n="contact_kicker">Contact</p>
      <h1 class="serif text-[clamp(2.5rem,5vw,4rem)] m-0 mb-5" data-i18n="contact_title">Écrivons la suite</h1>
      <p class="text-foret/75 text-lg leading-relaxed m-0" data-i18n="contact_lead">
        WhatsApp en priorité — ou laissez vos coordonnées ci-dessous.
      </p>
      <p
        class="talk-choice is-empty text-canopee text-sm tracking-wide mt-6 mb-0"
        data-selected-label
        data-empty=""
        data-prefix="Votre choix :"
        hidden
      ></p>
    </div>
  </section>

  <section class="bg-cream pb-20 md:pb-28">
    <div class="container-rzg grid lg:grid-cols-2 gap-8 lg:gap-12 items-start">
      <aside class="bg-foret text-cream rounded-sm p-8 md:p-10 flex flex-col gap-6" data-reveal>
        <svg class="w-10 h-10 text-gold" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
          ></path>
          <path
            d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.968-1.402A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a8 8 0 01-4.29-1.24l-.307-.182-2.946.832.81-2.87-.2-.312A7.96 7.96 0 014 12a8 8 0 1116 0 8 8 0 01-8 8z"
          ></path>
        </svg>
        <div>
          <h2 class="serif text-3xl m-0 mb-3" data-i18n="contact_wa">Discuter sur WhatsApp</h2>
          <p class="m-0 text-cream/70 leading-relaxed" data-i18n="contact_lead">
            WhatsApp en priorité. Un formulaire discret si vous préférez écrire.
          </p>
        </div>
        <div class="h-px w-full bg-gold/30" aria-hidden="true"></div>
        <a
          class="btn btn-solid btn-wa-lg w-full sm:w-auto"
          href="https://wa.me/212600000000"
          target="_blank"
          rel="noopener noreferrer"
          data-wa
          data-i18n="contact_wa">Discuter sur WhatsApp</a
        >
      </aside>

      <div class="border border-foret/10 rounded-sm p-8 md:p-10 bg-cream" data-reveal data-quiet-form>
        <ContactForm />
      </div>
    </div>
  </section>

  <section id="faq" class="bg-cream pb-28 md:pb-36">
    <div class="container-rzg max-w-3xl">
      <header class="mb-10 md:mb-12" data-reveal>
        <p class="kicker kicker--ink" data-i18n="faq_kicker">Questions</p>
        <h2 class="serif text-3xl md:text-4xl m-0 mb-4" data-i18n="faq_title">Tout ce qu’il faut savoir</h2>
        <p class="text-foret/70 leading-relaxed m-0" data-i18n="faq_body">
          Aides, livraison, parking, visite, réservation et typologies — réponses claires.
        </p>
      </header>

      <div class="faq-list" data-faq data-stagger>
        {
          faqItems.map((item) => (
            <div class="faq-item" data-faq-item>
              <button
                type="button"
                class="faq-trigger"
                data-faq-trigger
                aria-expanded="false"
                aria-controls={`faq-panel-${item.id}`}
                id={`faq-btn-${item.id}`}
              >
                <span class="faq-q" data-i18n={item.qKey}>{item.q}</span>
                <span class="faq-icon" aria-hidden="true" />
              </button>
              <div
                class="faq-panel"
                data-faq-panel
                id={`faq-panel-${item.id}`}
                role="region"
                aria-labelledby={`faq-btn-${item.id}`}
                aria-hidden="true"
              >
                <p data-i18n={item.aKey}>{item.a}</p>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
