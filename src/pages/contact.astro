---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<BaseLayout title="Contact — Riyad Zaer Gardens">
  <Header current="contact" />

  <section class="page-hero theme-cream">
    <div class="container" data-reveal>
      <p class="kicker kicker--ink" data-i18n="contact_kicker">Contact</p>
      <h1 class="serif" data-i18n="contact_title">Écrivons la suite</h1>
      <p class="lead muted" data-i18n="contact_lead">
        WhatsApp en priorité. Un formulaire discret si vous préférez écrire.
      </p>
      <p
        class="talk-choice talk-choice--ink is-empty"
        data-selected-label
        data-empty="Aucune typologie sélectionnée"
        data-prefix="Votre choix :"
      >
        Aucune typologie sélectionnée
      </p>
    </div>
  </section>

  <section class="contact-section section theme-cream">
    <div class="container contact-layout contact-layout--offset">
      <aside class="wa-first theme-dark" data-reveal>
        <svg class="wa-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path
            d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"
          ></path>
          <path
            d="M12 2C6.477 2 2 6.477 2 12c0 1.89.525 3.66 1.438 5.168L2 22l4.968-1.402A9.955 9.955 0 0012 22c5.523 0 10-4.477 10-10S17.523 2 12 2zm0 18a8 8 0 01-4.29-1.24l-.307-.182-2.946.832.81-2.87-.2-.312A7.96 7.96 0 014 12a8 8 0 1116 0 8 8 0 01-8 8z"
          ></path>
        </svg>
        <div>
          <h2 class="serif" data-i18n="contact_wa">Discuter sur WhatsApp</h2>
          <p class="hint" data-i18n="contact_lead">
            WhatsApp en priorité. Un formulaire discret si vous préférez écrire.
          </p>
        </div>
        <div class="rule" aria-hidden="true"></div>
        <a
          class="btn btn-solid btn-wa-lg"
          href="https://wa.me/212600000000"
          target="_blank"
          rel="noopener noreferrer"
          data-wa
          data-i18n="contact_wa">Discuter sur WhatsApp</a
        >
      </aside>

      <div class="contact-form-wrap" data-reveal>
        <button
          type="button"
          class="btn-ghost-link"
          data-form-toggle
          aria-expanded="false"
          data-i18n="contact_form_toggle">Préférer un message écrit ?</button
        >
        <div class="talk-form" data-quiet-form hidden>
          <ContactForm />
        </div>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
