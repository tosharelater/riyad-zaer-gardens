---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout title="Contact — Riyad Zaer Gardens">
  <Header current="contact" />

  <section class="page-hero">
    <div class="container">
      <span class="label" data-i18n="nav_contact">Contact</span>
      <h1 data-i18n="contact_title">Parlons de votre futur chez-vous</h1>
      <p style="color:var(--muted); max-width:36rem;" data-i18n="contact_sub">
        Une question, une visite, une réservation — nous vous répondons rapidement.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:1.5rem;">
    <div class="container contact-grid">
      <aside class="gold-card" data-reveal style="display:flex; flex-direction:column; gap:1.25rem; justify-content:space-between;">
        <div>
          <span class="label">WhatsApp</span>
          <h2 class="serif" style="margin:0.5rem 0 0.75rem; font-size:1.9rem;" data-i18n="wa_cta">Discuter sur WhatsApp</h2>
          <p style="margin:0; color:var(--muted)" data-i18n="contact_sub">
            Une question, une visite, une réservation — nous vous répondons rapidement.
          </p>
        </div>
        <a
          class="btn btn-solid"
          href="https://wa.me/212600000000"
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="wa_cta"
        >
          Discuter sur WhatsApp
        </a>
        <div style="border-top:1px solid rgba(197,163,103,0.25); padding-top:1rem;">
          <p class="label" style="margin:0 0 0.35rem;" data-i18n="aides_title">Éligible aux aides au logement</p>
          <p style="margin:0; color:var(--muted); font-size:0.95rem;" data-i18n="aides_body">
            Projet conçu pour maximiser votre éligibilité aux dispositifs d’aide à l’accession — renseignez-vous dès maintenant.
          </p>
        </div>
      </aside>

      <div data-reveal>
        <ContactForm />
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
