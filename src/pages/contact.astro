---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactForm from '../components/ContactForm.astro';
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<BaseLayout title="Contact — Riyad Zaer Gardens">
  <Header current="contact" />

  <section class="page-hero">
    <div class="container">
      <span class="label" data-i18n="nav_contact">Contact</span>
      <h1 data-i18n="contact_title">Parlons de votre futur chez-vous</h1>
      <p class="lead" data-i18n="contact_sub">
        Une question, une visite, une réservation — nous vous répondons rapidement.
      </p>
    </div>
  </section>

  <section class="section" style="padding-top:1.75rem;">
    <div class="container contact-grid">
      <aside class="gold-card wa-panel" data-reveal>
        <div>
          <svg class="wa-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path
              d="M12 3a9 9 0 0 0-7.8 13.4L3 21l4.8-1.3A9 9 0 1 0 12 3z"
              stroke="currentColor"
              stroke-width="1.3"
              stroke-linejoin="round"></path>
            <path
              d="M9.2 9.4c.2-.4.4-.4.6-.4h.5c.2 0 .4.1.5.4l.6 1.4c.1.2 0 .4-.1.6l-.4.5c-.1.1-.1.3 0 .4.4.7 1.1 1.4 1.9 1.8.1.1.3.1.4 0l.6-.4c.2-.1.4-.1.5 0l1.3.7c.3.1.4.3.4.5v.5c0 .2 0 .4-.2.5-.4.4-1 .6-1.6.6-2.7 0-5.5-2.5-6.2-5.7-.1-.6 0-1.2.4-1.6z"
              fill="currentColor"
              opacity="0.85"></path>
          </svg>
          <span class="label" data-i18n="wa_lead">Réponse prioritaire sur WhatsApp</span>
          <h2 data-i18n="wa_cta">Discuter sur WhatsApp</h2>
          <p class="hint" data-i18n="contact_sub">
            Une question, une visite, une réservation — nous vous répondons rapidement.
          </p>
        </div>
        <a
          class="btn btn-solid"
          href="https://wa.me/212600000000"
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="wa_cta"
        >
          Discuter sur WhatsApp
        </a>
        <div class="divider"></div>
        <div>
          <p class="label" style="margin:0 0 0.4rem;" data-i18n="aides_title"
            >Éligible aux aides au logement</p
          >
          <p class="hint" style="font-size:0.92rem;" data-i18n="aides_body">
            Projet conçu pour maximiser votre éligibilité aux dispositifs d’aide à l’accession —
            renseignez-vous dès maintenant.
          </p>
        </div>
        <div style="margin-top:auto;">
          <img
            src={`${base}logo.png`}
            alt=""
            width="140"
            height="56"
            loading="lazy"
            style="opacity:0.85; height:2.4rem; width:auto;"
          />
        </div>
      </aside>

      <div data-reveal data-reveal-delay="2">
        <ContactForm />
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
