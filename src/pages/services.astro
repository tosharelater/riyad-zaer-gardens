---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArchFrame from '../components/ArchFrame.astro';
import ArchDivider from '../components/ArchDivider.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const equipments = [
  {
    title: 'Ascenseur',
    desc: 'Accès fluide à tous les étages, confort familial et accessibilité.',
    titleKey: 'svc_ascenseur',
    descKey: 'svc_ascenseur_d',
    num: '01',
  },
  {
    title: 'Espaces verts & jeux',
    desc: 'Cour végétalisée, aires de jeux et moments en famille en toute sérénité.',
    titleKey: 'svc_espaces',
    descKey: 'svc_espaces_d',
    num: '02',
  },
  {
    title: 'Sécurité',
    desc: 'Résidence fermée, contrôle d’accès et tranquillité d’esprit.',
    titleKey: 'svc_securite',
    descKey: 'svc_securite_d',
    num: '03',
  },
  {
    title: 'Parking titré',
    desc: 'Places de stationnement titrées pour un usage serein et durable.',
    titleKey: 'svc_parking',
    descKey: 'svc_parking_d',
    num: '04',
  },
  {
    title: 'Finitions modernes',
    desc: 'Matériaux soignés, lumière naturelle et espaces pensés pour la vie réelle.',
    titleKey: 'svc_finitions',
    descKey: 'svc_finitions_d',
    num: '05',
  },
  {
    title: 'Éligibilité aides logement',
    desc: 'Accompagnement pour les dispositifs d’aide à l’accession au logement.',
    titleKey: 'svc_aides',
    descKey: 'svc_aides_d',
    num: '06',
  },
] as const;
---

<BaseLayout title="Prestations — Riyad Zaer Gardens">
  <Header current="services" />

  <section class="page-hero theme-cream">
    <div class="container">
      <span class="marker" data-num="01" data-i18n="nav_services">Prestations</span>
      <h1 data-i18n="services_title">Prestations & confort</h1>
      <p class="lead muted" data-i18n="services_sub"
        >Typologies, commerces et cadre de vie — clairement distincts</p
      >
    </div>
  </section>

  <!-- F3 story -->
  <section class="typo-story theme-cream">
    <div class="container">
      <article class="story" data-reveal>
        <div class="story-media">
          <img
            src={`${base}kids-bedroom.jpg`}
            alt="Intérieur — typologie F3"
            width="1200"
            height="800"
            loading="lazy"
          />
          <ArchFrame />
        </div>
        <div class="story-body">
          <span class="marker" data-num="02" data-i18n="block_typo_tag">Habitation</span>
          <p class="label" style="margin:0;" data-i18n="f3_surface">65–75 m²</p>
          <h3 class="serif" data-i18n="f3_title">F3</h3>
          <p class="muted" data-i18n="f3_body">
            65 à 75 m² environ — séjour lumineux, deux chambres, cuisine équipable, rangements
            pensés.
          </p>
          <div class="story-meta">
            <span class="chip" data-i18n="chip_family">Familial</span>
            <span class="chip" data-i18n="chip_light">Lumière naturelle</span>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- F4 story (flipped, dark) -->
  <section class="typo-story theme-dark">
    <div class="container">
      <article class="story story--flip" data-reveal>
        <div class="story-media">
          <img
            src={`${base}courtyard.jpg`}
            alt="Cour — typologie F4"
            width="1600"
            height="1000"
            loading="lazy"
          />
          <ArchFrame />
        </div>
        <div class="story-body">
          <span class="marker" data-num="03" data-i18n="block_typo_tag">Habitation</span>
          <p class="label" style="margin:0;" data-i18n="f4_surface">jusqu’à 86 m²</p>
          <h3 class="serif" data-i18n="f4_title">F4</h3>
          <p class="muted" data-i18n="f4_body">
            Jusqu’à 86 m² — troisième chambre, plus d’espace familial, idéale pour s’ancrer
            durablement.
          </p>
          <div class="story-meta">
            <span class="chip" data-i18n="chip_surface">65–86 m²</span>
            <span class="chip" data-i18n="chip_family">Familial</span>
          </div>
        </div>
      </article>
    </div>
  </section>

  <!-- Commerce editorial block -->
  <section class="section theme-cream" style="padding-block: clamp(3.5rem, 8vw, 5.5rem);">
    <div class="container">
      <div class="commerce-story" data-reveal>
        <div class="num" aria-hidden="true">04</div>
        <div>
          <span class="marker" data-num="" data-i18n="block_commerce_tag">Investissement</span>
          <h2 class="serif" data-i18n="block_commerce_title">Fonds de commerce</h2>
          <p class="muted" data-i18n="block_commerce_body">
            Locaux en rez-de-chaussée pour commerces de proximité — une adresse vivante au pied de la
            résidence.
          </p>
        </div>
      </div>
      <ArchDivider />
    </div>
  </section>

  <!-- Amenities quiet list -->
  <section class="section theme-dark">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="marker" data-num="05" data-i18n="block_cadre_tag">Cadre & équipements</span>
        <h2 class="serif" data-i18n="block_cadre_title">Le confort au quotidien</h2>
        <p class="muted" data-i18n="block_cadre_lead">
          Tout ce qui sécurise, facilite et embellit la vie en résidence.
        </p>
      </div>

      <div class="amenity-list" data-reveal>
        {
          equipments.map((s) => (
            <div class="amenity">
              <span class="idx" aria-hidden="true">
                {s.num}
              </span>
              <div>
                <h3 data-i18n={s.titleKey}>{s.title}</h3>
                <p data-i18n={s.descKey}>{s.desc}</p>
              </div>
            </div>
          ))
        }
      </div>

      <div class="aides-note" style="margin-top:2.75rem; max-width:36rem;" data-reveal>
        <span class="label" data-i18n="aides_title">Éligible aux aides au logement</span>
        <p data-i18n="aides_body">
          Projet conçu pour maximiser votre éligibilité aux dispositifs d’aide à l’accession —
          renseignez-vous dès maintenant.
        </p>
      </div>

      <div class="cta-row" data-reveal>
        <a
          class="btn btn-solid"
          href="https://wa.me/212600000000"
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="cta_whatsapp">WhatsApp</a
        >
        <a class="btn-ghost-link" href={`${base}contact`} data-i18n="cta_contact">Nous contacter</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
