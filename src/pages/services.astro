---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const amenities = [
  { t: 'amenity_garden_t', d: 'amenity_garden_d', tf: 'Cours & jardins', df: 'Espaces verts partagés, promenades plantées.' },
  { t: 'amenity_sec_t', d: 'amenity_sec_d', tf: 'Sécurité', df: 'Accès contrôlé, résidence fermée.' },
  { t: 'amenity_park_t', d: 'amenity_park_d', tf: 'Stationnement', df: 'Places dédiées pour résidents.' },
  { t: 'amenity_shop_t', d: 'amenity_shop_d', tf: 'Commerces', df: 'Fonds en rez-de-chaussée, proximité immédiate.' },
  { t: 'amenity_light_t', d: 'amenity_light_d', tf: 'Lumière', df: 'Orientations étudiées, volumes ouverts.' },
  { t: 'amenity_family_t', d: 'amenity_family_d', tf: 'Familial', df: 'Espaces pensés pour la vie à plusieurs.' },
] as const;
---

<BaseLayout title="Prestations — Riyad Zaer Gardens">
  <Header current="services" />

  <section class="page-hero theme-cream">
    <div class="container" data-reveal>
      <p class="kicker kicker--ink" data-i18n="services_kicker">Prestations</p>
      <h1 class="serif" data-i18n="services_title">Typologies & cadre</h1>
      <p class="lead muted" data-i18n="services_lead">
        F3, F4 et fonds de commerce — volumes, surfaces, équipements. Tout le détail, sans précipitation.
      </p>
    </div>
  </section>

  <section class="typo-story theme-cream">
    <div class="container">
      <div class="collage collage--cream" data-reveal>
        <div class="collage-media">
          <img src={`${base}parcours/viz-09.jpg`} alt="Intérieur F3" width="1200" height="800" loading="lazy" />
        </div>
        <div class="collage-plate">
          <p class="surface-tag" data-i18n="choose_f3_surface">65–75 m²</p>
          <h2 class="collage-title serif" data-i18n="choose_f3_title">F3</h2>
          <p class="muted" data-i18n="choose_f3_body">
            Séjour lumineux, deux chambres, cuisine ouverte, rangements pensés. Idéal pour démarrer ou se
            réancrer.
          </p>
          <p class="typo-price" data-i18n="choose_f3_price">À partir de ~420 000 DHS</p>
          <div class="story-meta">
            <span class="chip" data-i18n="chip_family">Familial</span>
            <span class="chip" data-i18n="chip_aides">Aides</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="cream-void" aria-hidden="true"></div>

  <section class="typo-story theme-cream">
    <div class="container">
      <div class="collage collage--veil" data-reveal>
        <div class="collage-media">
          <img src={`${base}parcours/viz-06.jpg`} alt="Façade F4" width="1400" height="900" loading="lazy" />
          <div class="collage-veil" aria-hidden="true"></div>
          <div class="collage-on-photo">
            <p class="surface-tag surface-tag--ivory" data-i18n="choose_f4_surface">jusqu’à 86 m²</p>
            <h2 class="collage-title collage-title--ivory serif" data-i18n="choose_f4_title">F4</h2>
            <p class="collage-copy" data-i18n="choose_f4_body">
              Troisième chambre, plus d’espace familial, volumes clairs — pour s’ancrer durablement.
            </p>
            <p class="typo-price" style="color:var(--gold-soft)" data-i18n="choose_f4_price">
              À partir de ~480 000 DHS
            </p>
          </div>
        </div>
        <div class="collage-plate collage-plate--mobile-only">
          <p class="surface-tag" data-i18n="choose_f4_surface">jusqu’à 86 m²</p>
          <h2 class="collage-title serif" data-i18n="choose_f4_title">F4</h2>
          <p class="muted" data-i18n="choose_f4_body">
            Troisième chambre, plus d’espace familial, volumes clairs — pour s’ancrer durablement.
          </p>
          <p class="typo-price" data-i18n="choose_f4_price">À partir de ~480 000 DHS</p>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--commerce theme-cream">
    <div class="container">
      <div class="commerce-story" data-reveal>
        <span class="num" aria-hidden="true">+</span>
        <div>
          <p class="surface-tag" data-i18n="choose_fonds_surface">Rez-de-chaussée</p>
          <h2 data-i18n="choose_fonds_title">Fonds de commerce</h2>
          <p class="muted" data-i18n="choose_fonds_body">
            Locaux en pied d’immeuble pour commerces de proximité — une adresse vivante au seuil de la
            résidence.
          </p>
          <p class="typo-price" data-i18n="choose_fonds_price">Sur consultation</p>
        </div>
      </div>
    </div>
  </section>

  <div class="cream-void" aria-hidden="true"></div>

  <section class="section theme-cream">
    <div class="container">
      <header class="section-head" data-reveal>
        <p class="kicker kicker--ink" data-i18n="services_amenities_t">Équipements</p>
        <h2 class="serif">Le cadre, au quotidien</h2>
      </header>
      <div class="amenity-list amenity-list--cream" data-reveal>
        {
          amenities.map((a) => (
            <article class="amenity">
              <h3 data-i18n={a.t}>{a.tf}</h3>
              <p data-i18n={a.d}>{a.df}</p>
            </article>
          ))
        }
      </div>
      <div class="cta-row" data-reveal>
        <a class="btn btn-solid" href={`${base}contact/`} data-i18n="nav_contact">Contact</a>
        <a class="btn-ghost-link" href={`${base}#explore`} data-i18n="explore_kicker">Explorer</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
