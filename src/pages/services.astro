---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const target = `${base}#choose`;
---

<BaseLayout title="Prestations — Riyad Zaer Gardens">
  <Header current="services" />
  <section class="companion theme-cream">
    <div class="container companion-inner">
      <p class="kicker kicker--ink" data-i18n="choose_kicker">Typologies</p>
      <h1 class="serif" data-i18n="companion_services">Les prestations sont dans le parcours</h1>
      <p class="muted">F3 · F4 · Fonds de commerce — chapitre Choisir.</p>
      <div class="companion-links">
        <a class="btn btn-solid" href={target} data-i18n="companion_back">Revenir au parcours</a>
        <a class="btn-ghost-link" href={`${base}#live`} data-i18n="nav_live">Vivre</a>
        <a class="btn-ghost-link" href={`${base}#talk`} data-i18n="nav_talk">Parler</a>
      </div>
    </div>
  </section>
  <Footer />
  <script define:vars={{ target }}>
    location.replace(target);
  </script>
</BaseLayout>
