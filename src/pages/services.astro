---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const amenities = [
  { t: 'amenity_garden_t', d: 'amenity_garden_d', tf: 'Cours & jardins', df: 'Espaces verts partagés, promenades plantées.' },
  { t: 'amenity_sec_t', d: 'amenity_sec_d', tf: 'Sécurité', df: 'Accès contrôlé, résidence fermée.' },
  { t: 'amenity_park_t', d: 'amenity_park_d', tf: 'Stationnement', df: 'Places dédiées pour résidents.' },
  { t: 'amenity_shop_t', d: 'amenity_shop_d', tf: 'Commerces', df: 'Fonds en rez-de-chaussée, proximité immédiate.' },
  { t: 'amenity_light_t', d: 'amenity_light_d', tf: 'Lumière', df: 'Orientations étudiées, volumes ouverts.' },
  { t: 'amenity_family_t', d: 'amenity_family_d', tf: 'Familial', df: 'Espaces pensés pour la vie à plusieurs.' },
] as const;
---

<BaseLayout title="Prestations — Riyad Zaer Gardens">
  <Header current="services" />

  <section class="bg-cream text-foret pt-32 pb-16 md:pb-24">
    <div class="container-rzg max-w-2xl" data-reveal>
      <p class="kicker kicker--ink" data-i18n="services_kicker">Prestations</p>
      <h1 class="serif text-[clamp(2.5rem,5vw,4rem)] m-0 mb-6" data-i18n="services_title">Typologies & cadre</h1>
      <p class="text-foret/75 text-lg leading-relaxed m-0" data-i18n="services_lead">
        F3, F4 et fonds de commerce — volumes, surfaces, équipements. Tout le détail, sans précipitation.
      </p>
    </div>
  </section>

  <section class="bg-cream pb-16 md:pb-24">
    <div class="container-rzg">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-14 items-center" data-reveal>
        <div class="overflow-hidden rounded-sm aspect-[5/4]">
          <img src={`${base}parcours/viz-09.jpg`} alt="Intérieur F3" width="1200" height="800" class="w-full h-full object-cover" loading="lazy" />
        </div>
        <div class="py-4">
          <p class="surface-tag mb-3" data-i18n="choose_f3_surface">65–75 m²</p>
          <h2 class="serif text-4xl md:text-5xl m-0 mb-4" data-i18n="choose_f3_title">F3</h2>
          <p class="text-foret/75 leading-relaxed m-0 mb-5" data-i18n="choose_f3_body">
            Séjour lumineux, deux chambres, cuisine ouverte, rangements pensés. Idéal pour démarrer ou se
            réancrer.
          </p>
          <p class="typo-price mb-5" data-i18n="choose_f3_price">À partir de ~420 000 DHS</p>
          <div class="flex flex-wrap gap-2">
            <span class="chip" data-i18n="chip_family">Familial</span>
            <span class="chip" data-i18n="chip_aides">Aides</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream pb-16 md:pb-24">
    <div class="container-rzg">
      <div class="relative overflow-hidden rounded-sm min-h-[28rem] md:min-h-[34rem]" data-reveal>
        <img src={`${base}parcours/viz-06.jpg`} alt="Façade F4" width="1400" height="900" class="absolute inset-0 w-full h-full object-cover" loading="lazy" />
        <div class="absolute inset-0 bg-gradient-to-t from-foret/85 via-foret/40 to-transparent"></div>
        <div class="relative z-10 flex flex-col justify-end h-full min-h-[28rem] md:min-h-[34rem] p-8 md:p-12 max-w-xl text-cream">
          <p class="text-[0.75rem] font-medium tracking-[0.12em] uppercase text-gold-soft mb-3" data-i18n="choose_f4_surface">jusqu’à 86 m²</p>
          <h2 class="serif text-4xl md:text-5xl m-0 mb-4 text-cream" data-i18n="choose_f4_title">F4</h2>
          <p class="text-cream/80 leading-relaxed m-0 mb-5" data-i18n="choose_f4_body">
            Troisième chambre, plus d’espace familial, volumes clairs — pour s’ancrer durablement.
          </p>
          <p class="m-0 text-gold-soft font-medium" data-i18n="choose_f4_price">À partir de ~480 000 DHS</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream pb-16 md:pb-24">
    <div class="container-rzg">
      <div class="grid md:grid-cols-[auto_1fr] gap-8 md:gap-14 items-start border border-foret/10 rounded-sm p-8 md:p-12" data-reveal>
        <span class="serif text-6xl text-gold leading-none" aria-hidden="true">+</span>
        <div>
          <p class="surface-tag mb-3" data-i18n="choose_fonds_surface">Rez-de-chaussée</p>
          <h2 class="serif text-3xl md:text-4xl m-0 mb-4" data-i18n="choose_fonds_title">Fonds de commerce</h2>
          <p class="text-foret/75 leading-relaxed m-0 mb-4" data-i18n="choose_fonds_body">
            Locaux en pied d’immeuble pour commerces de proximité — une adresse vivante au seuil de la
            résidence.
          </p>
          <p class="typo-price" data-i18n="choose_fonds_price">Sur consultation</p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-cream pb-28 md:pb-36">
    <div class="container-rzg">
      <header class="max-w-xl mb-12 md:mb-16" data-reveal>
        <p class="kicker kicker--ink" data-i18n="services_amenities_t">Équipements</p>
        <h2 class="serif text-3xl md:text-4xl m-0">Le cadre, au quotidien</h2>
      </header>
      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-x-10 gap-y-12 mb-14" data-reveal>
        {
          amenities.map((a) => (
            <article>
              <h3 class="text-base font-medium tracking-wide m-0 mb-2 text-foret" data-i18n={a.t}>{a.tf}</h3>
              <p class="m-0 text-foret/70 leading-relaxed" data-i18n={a.d}>{a.df}</p>
            </article>
          ))
        }
      </div>
      <div class="flex flex-wrap gap-4 items-center" data-reveal>
        <a class="btn btn-solid" href={`${base}contact/`} data-i18n="nav_contact">Contact</a>
        <a class="text-sm font-medium tracking-wide text-canopee underline-offset-4 hover:underline" href={`${base}#explore`} data-i18n="explore_kicker">Explorer</a>
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
