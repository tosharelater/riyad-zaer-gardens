---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Quartier3D from '../components/Quartier3D.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const typologies = [
  {
    id: 'F3',
    titleKey: 'choose_f3_title',
    title: 'F3',
    surfaceKey: 'choose_f3_surface',
    surface: '65–75 m²',
    bodyKey: 'choose_f3_body',
    body:
      'Séjour lumineux, deux chambres, cuisine ouverte, rangements pensés. Idéal pour démarrer ou se réancrer.',
    priceKey: 'choose_f3_price',
    price: 'À partir de ~420 000 DHS',
    roomsKey: 'choose_rooms_f3',
    rooms: '2 chambres · séjour · cuisine ouverte',
    img: 'parcours/viz-09.jpg',
    imgAlt: 'Cuisine — typologie F3',
    hotspot: { top: '42%', left: '28%' },
  },
  {
    id: 'F4',
    titleKey: 'choose_f4_title',
    title: 'F4',
    surfaceKey: 'choose_f4_surface',
    surface: 'jusqu’à 86 m²',
    bodyKey: 'choose_f4_body',
    body:
      'Troisième chambre, plus d’espace familial, volumes clairs — pour s’ancrer durablement.',
    priceKey: 'choose_f4_price',
    price: 'À partir de ~480 000 DHS',
    roomsKey: 'choose_rooms_f4',
    rooms: '3 chambres · séjour · cuisine ouverte',
    img: 'parcours/viz-06.jpg',
    imgAlt: 'Façade — typologie F4',
    hotspot: { top: '38%', left: '58%' },
  },
  {
    id: 'Fonds',
    titleKey: 'choose_fonds_title',
    title: 'Fonds de commerce',
    surfaceKey: 'choose_fonds_surface',
    surface: 'Rez-de-chaussée',
    bodyKey: 'choose_fonds_body',
    body:
      'Locaux en pied d’immeuble pour commerces de proximité — une adresse vivante au seuil de la résidence.',
    priceKey: 'choose_fonds_price',
    price: 'Sur consultation',
    roomsKey: 'choose_rooms_fonds',
    rooms: 'Local commercial · rez-de-chaussée',
    img: 'parcours/viz-05.jpg',
    imgAlt: 'Commerces en rez-de-chaussée',
    hotspot: { top: '68%', left: '48%' },
  },
] as const;
---

<BaseLayout title="Riyad Zaer Gardens — Nouveau pôle urbain">
  <Header current="home" />

  <!-- ARRIVE — full-bleed cinematic -->
  <section id="arrive" class="beat beat-arrive">
    <div class="arrive-media" aria-hidden="true">
      <img
        class="arrive-poster media-poster"
        src={`${base}parcours/viz-08.jpg`}
        alt=""
        width="1920"
        height="1080"
        fetchpriority="high"
        decoding="async"
      />
      <video
        class="beat-video"
        data-chapter-video
        poster={`${base}parcours/viz-08.jpg`}
        muted
        loop
        playsinline
        preload="none"
        aria-hidden="true"
      >
        <source src={`${base}parcours/video/arrive.webm`} type="video/webm" />
        <source src={`${base}parcours/video/arrive.mp4`} type="video/mp4" />
      </video>
      <div class="arrive-veil"></div>
    </div>
    <div class="arrive-copy">
      <p class="kicker" data-i18n="arrive_kicker">Riyad Zaer Gardens</p>
      <p class="hero-locale" data-i18n="teasing">Aïn Aouda · Rabat</p>
      <h1 class="arrive-title" data-i18n="arrive_title">Un nouveau pôle urbain</h1>
      <p class="arrive-lead" data-i18n="arrive_lead">
        Une adresse familiale, moderne et sécurisée — lumière, jardins, horizon ouvert entre Rabat et
        Aïn Aouda.
      </p>
      <div class="arrive-actions">
        <a class="btn btn-solid" href="#live" data-i18n="cta_scroll">Découvrir</a>
      </div>
    </div>
  </section>

  <!-- cream void -->
  <div class="cream-void" aria-hidden="true"></div>

  <!-- LIFESTYLE — monumental -->
  <section id="live" class="beat beat-live theme-cream">
    <div class="container">
      <header class="beat-head" data-reveal>
        <p class="kicker kicker--ink" data-i18n="live_kicker">Cadre de vie</p>
        <h2 class="serif beat-title beat-title--billboard" data-i18n="live_title">
          Vivre autrement. C’est possible.
        </h2>
        <p class="muted beat-lead" data-i18n="live_body">
          Cour végétalisée, volumes clairs, commerces de proximité — un quotidien élégant, sans le
          bruit du luxe générique.
        </p>
      </header>

      <div class="live-monument" data-reveal="clip">
        <figure class="live-hero">
          <img
            class="media-poster"
            src={`${base}parcours/viz-01.jpg`}
            alt="Cour végétalisée"
            width="1600"
            height="1000"
            loading="lazy"
          />
          <video
            class="beat-video"
            data-chapter-video
            poster={`${base}parcours/viz-01.jpg`}
            muted
            loop
            playsinline
            preload="none"
            aria-hidden="true"
          >
            <source src={`${base}parcours/video/live.webm`} type="video/webm" />
            <source src={`${base}parcours/video/live.mp4`} type="video/mp4" />
          </video>
          <figcaption data-i18n="live_cap_courtyard">Cour &amp; jardins</figcaption>
        </figure>
      </div>

      <div class="live-strip" data-stagger>
        <figure class="live-shot">
          <img src={`${base}parcours/viz-11.jpg`} alt="Façade et palmiers" width="1200" height="800" loading="lazy" />
          <figcaption data-i18n="live_cap_street">Adresse vivante</figcaption>
        </figure>
        <figure class="live-shot">
          <img src={`${base}parcours/viz-06.jpg`} alt="Façade — volumes" width="1200" height="800" loading="lazy" />
          <figcaption data-i18n="live_cap_facade">Façade & volumes</figcaption>
        </figure>
        <figure class="live-shot">
          <img src={`${base}parcours/viz-02.jpg`} alt="Intérieur lumineux" width="1200" height="800" loading="lazy" />
          <figcaption data-i18n="live_cap_interior">Intérieurs lumineux</figcaption>
        </figure>
      </div>

      <div class="live-stats" data-stagger>
        <div class="stat-loose stat-loose--lg">
          <strong>120</strong>
          <span>appartements</span>
        </div>
        <div class="stat-loose">
          <strong>65–86</strong>
          <span>m² F3–F4</span>
        </div>
        <div class="stat-loose stat-loose--quiet">
          <strong>+</strong>
          <span>fonds de commerce</span>
        </div>
      </div>
    </div>
  </section>

  <!-- cream void + pull quote -->
  <div class="section-rule" data-reveal="line" aria-hidden="true"></div>

  <section class="cream-silence theme-cream" aria-hidden="false">
    <div class="container" data-reveal>
      <p class="silence-quote serif" data-i18n="silence_quote">
        Long horizon. Adresse claire. Quotidien maîtrisé.
      </p>
    </div>
  </section>

  <!-- QUARTIER — scroll-scrubbed 3D volumes -->
  <Quartier3D />

  <!-- EXPLORE — woven choose, no chapter label -->
  <section id="explore" class="beat beat-explore theme-cream">
    <div class="container">
      <header class="beat-head" data-reveal>
        <p class="kicker kicker--ink" data-i18n="explore_kicker">Explorer</p>
        <h2 class="serif beat-title beat-title--billboard" data-i18n="explore_title">
          Trouvez votre adresse
        </h2>
        <p class="muted beat-lead" data-i18n="explore_body">
          Survolez le plan, ouvrez une typologie. Votre choix vous suit jusqu’à la conversation.
        </p>
      </header>

      <figure class="explore-cinema" data-reveal="clip">
        <img
          class="media-poster"
          src={`${base}parcours/viz-04.jpg`}
          alt=""
          width="1600"
          height="1000"
          loading="lazy"
        />
        <video
          class="beat-video"
          data-chapter-video
          poster={`${base}parcours/viz-04.jpg`}
          muted
          loop
          playsinline
          preload="none"
          aria-hidden="true"
        >
          <source src={`${base}parcours/video/explore.webm`} type="video/webm" />
          <source src={`${base}parcours/video/explore.mp4`} type="video/mp4" />
        </video>
      </figure>

      <div class="choose-island" data-reveal>
        <ul class="choose-legend" role="list" aria-label="Typologies" data-i18n-aria="choose_legend_label">
          {
            typologies.map((t) => (
              <li>
                <button
                  type="button"
                  class="choose-legend__btn"
                  data-legend={t.id}
                  data-hotspot-trigger={t.id}
                  aria-pressed="false"
                >
                  <span class="choose-legend__swatch" aria-hidden="true" />
                  <span class="choose-legend__copy">
                    <span
                      data-i18n={
                        t.id === 'Fonds' ? 'choose_legend_fonds' : `choose_legend_${t.id.toLowerCase()}`
                      }
                    >
                      {t.title === 'Fonds de commerce' ? 'Fonds' : t.title}
                    </span>
                    <span class="choose-legend__meta" data-i18n={t.surfaceKey}>
                      {t.surface}
                    </span>
                  </span>
                </button>
              </li>
            ))
          }
        </ul>

        <div class="choose-plan" role="group" aria-label="Plan interactif">
          <img
            src={`${base}parcours/viz-04.jpg`}
            alt="Plan aérien — Riyad Zaer Gardens"
            width="1600"
            height="1000"
            loading="lazy"
          />
          <p id="explore-hint" class="choose-hint" data-i18n="explore_hint">Touchez un point sur le plan</p>
          {
            typologies.map((t) => (
              <button
                type="button"
                class="hotspot"
                style={`top:${t.hotspot.top};left:${t.hotspot.left}`}
                data-hotspot={t.id}
                aria-label={t.title}
                aria-pressed="false"
                aria-describedby="explore-hint"
              >
                <span class="hotspot__ring" aria-hidden="true" />
                <span class="hotspot__label">{t.title === 'Fonds de commerce' ? 'Fonds' : t.title}</span>
              </button>
            ))
          }
        </div>

        <div class="choose-panels">
          <div class="choose-panel-stage" data-panel-stage>
            <p class="choose-empty" data-choose-empty data-i18n="choose_empty">
              Choisissez F3, F4 ou un fonds — le détail s’ouvre ici.
            </p>
            {
              typologies.map((t) => (
                <article class="typo-panel" data-panel={t.id} aria-hidden="true" inert>
                  <button type="button" class="typo-panel__close" data-panel-close aria-label="Fermer">
                    <span data-i18n="choose_close">Fermer</span>
                  </button>
                  <div class="typo-panel__media">
                    <img src={`${base}${t.img}`} alt={t.imgAlt} width="900" height="600" loading="lazy" />
                  </div>
                  <div class="typo-panel__body">
                    <p class="kicker kicker--ink" data-i18n="choose_kicker">
                      Typologie
                    </p>
                    <h3 class="serif" data-i18n={t.titleKey}>
                      {t.title}
                    </h3>
                    <p class="typo-panel__rooms" data-i18n={t.roomsKey}>
                      {t.rooms}
                    </p>
                    <p class="muted" data-i18n={t.bodyKey}>
                      {t.body}
                    </p>
                    <div class="typo-panel__facts">
                      <p class="surface-tag" data-i18n={t.surfaceKey}>
                        {t.surface}
                      </p>
                      <p class="typo-price" data-i18n={t.priceKey}>
                        {t.price}
                      </p>
                    </div>
                    <p class="typo-aides label" data-i18n="choose_aides">
                      Éligible aux aides au logement
                    </p>
                    <div class="story-meta">
                      {t.id !== 'Fonds' ? (
                        <>
                          <span class="chip" data-i18n="chip_family">
                            Familial
                          </span>
                          <span class="chip" data-i18n="chip_light">
                            Lumière naturelle
                          </span>
                          <span class="chip" data-i18n="chip_aides">
                            Aides
                          </span>
                        </>
                      ) : (
                        <span class="chip" data-i18n="chip_rdc">
                          RDC
                        </span>
                      )}
                    </div>
                    <button type="button" class="btn btn-solid" data-select-typo={t.id} data-i18n="choose_select">
                      Garder ce choix
                    </button>
                  </div>
                </article>
              ))
            }
          </div>

          <aside class="choose-rail" aria-live="polite">
            <p
              class="choose-rail__sel is-empty"
              data-selected-label
              data-empty="Aucune typologie sélectionnée"
              data-prefix="Votre choix :"
              data-i18n-empty="talk_selected_none"
            >
              Aucune typologie sélectionnée
            </p>
            <a class="btn-ghost-link" href={`${base}services/`} data-i18n="nav_services">Prestations</a>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <div class="cream-void cream-void--tall" aria-hidden="true"></div>

  <!-- TRUST — quiet -->
  <section id="trust" class="beat beat-trust theme-cream">
    <div class="container">
      <header class="beat-head" data-reveal>
        <p class="kicker kicker--ink" data-i18n="trust_kicker">Repères</p>
        <h2 class="serif beat-title" data-i18n="trust_title">Avancer sereinement</h2>
        <p class="muted beat-lead" data-i18n="trust_body">
          Aides, chantier, livraison — des balises claires, sans formalités inutiles.
        </p>
      </header>

      <ol class="trust-markers" data-stagger>
        <li class="trust-marker">
          <span class="trust-marker__num" aria-hidden="true">01</span>
          <div>
            <h3 data-i18n="trust_aides_t">Aides au logement</h3>
            <p class="muted" data-i18n="trust_aides_d">
              Projet conçu pour maximiser l’éligibilité aux dispositifs d’accession. On vous oriente.
            </p>
          </div>
        </li>
        <li class="trust-marker">
          <span class="trust-marker__num" aria-hidden="true">02</span>
          <div>
            <h3 data-i18n="trust_chantier_t">Chantier suivi</h3>
            <p class="muted" data-i18n="trust_chantier_d">
              Jalons visibles, communication régulière, visite sur rendez-vous.
            </p>
          </div>
        </li>
        <li class="trust-marker">
          <span class="trust-marker__num" aria-hidden="true">03</span>
          <div>
            <h3 data-i18n="trust_livraison_t">Livraison anticipée</h3>
            <p class="muted" data-i18n="trust_livraison_d">
              Calendrier partagé dès la réservation. Vous savez où en est votre futur chez-vous.
            </p>
          </div>
        </li>
      </ol>

      <div class="trust-visual" data-reveal="clip">
        <img
          src={`${base}parcours/viz-07.jpg`}
          alt="Perspectives du projet"
          width="1600"
          height="900"
          loading="lazy"
        />
      </div>
    </div>
  </section>

  <!-- HANDOFF — one WhatsApp -->
  <section id="handoff" class="beat beat-handoff theme-dark">
    <div class="container handoff-inner">
      <header class="beat-head beat-head--dark" data-reveal>
        <p class="kicker" data-i18n="handoff_kicker">Suite</p>
        <h2 class="serif beat-title" data-i18n="handoff_title">Parlons de votre futur chez-vous</h2>
        <p class="beat-lead handoff-lead" data-i18n="handoff_body">
          Une question, une visite, une réservation — réponse prioritaire sur WhatsApp.
        </p>
        <p
          class="talk-choice is-empty"
          data-selected-label
          data-empty="Aucune typologie sélectionnée"
          data-prefix="Votre choix :"
        >
          Aucune typologie sélectionnée
        </p>
      </header>

      <div class="handoff-cta" data-reveal>
        <a
          class="btn btn-solid btn-wa-lg"
          href="https://wa.me/212600000000"
          target="_blank"
          rel="noopener noreferrer"
          data-wa
          data-i18n="handoff_wa">Discuter sur WhatsApp</a
        >
        <a class="btn-ghost-link" href={`${base}contact/`} data-i18n="handoff_contact"
          >Voir la page Contact</a
        >
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
