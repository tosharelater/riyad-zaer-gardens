---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const vizAll = Array.from({ length: 12 }, (_, i) => `parcours/viz-${String(i + 1).padStart(2, '0')}.jpg`);

const typologies = [
  {
    id: 'F3',
    titleKey: 'choose_f3_title',
    title: 'F3',
    surfaceKey: 'choose_f3_surface',
    surface: '65–75 m²',
    bodyKey: 'choose_f3_body',
    body:
      'Séjour lumineux, deux chambres, cuisine ouverte, rangements pensés. Idéal pour démarrer ou se réancrer.',
    priceKey: 'choose_f3_price',
    price: 'À partir de ~420 000 DHS',
    roomsKey: 'choose_rooms_f3',
    rooms: '2 chambres · séjour · cuisine ouverte',
    img: 'parcours/viz-09.jpg',
    imgAlt: 'Cuisine — typologie F3',
    hotspot: { top: '42%', left: '28%' },
  },
  {
    id: 'F4',
    titleKey: 'choose_f4_title',
    title: 'F4',
    surfaceKey: 'choose_f4_surface',
    surface: 'jusqu’à 86 m²',
    bodyKey: 'choose_f4_body',
    body:
      'Troisième chambre, plus d’espace familial, volumes clairs — pour s’ancrer durablement.',
    priceKey: 'choose_f4_price',
    price: 'À partir de ~480 000 DHS',
    roomsKey: 'choose_rooms_f4',
    rooms: '3 chambres · séjour · cuisine ouverte',
    img: 'parcours/viz-06.jpg',
    imgAlt: 'Façade — typologie F4',
    hotspot: { top: '38%', left: '58%' },
  },
  {
    id: 'Fonds',
    titleKey: 'choose_fonds_title',
    title: 'Fonds de commerce',
    surfaceKey: 'choose_fonds_surface',
    surface: 'Rez-de-chaussée',
    bodyKey: 'choose_fonds_body',
    body:
      'Locaux en pied d’immeuble pour commerces de proximité — une adresse vivante au seuil de la résidence.',
    priceKey: 'choose_fonds_price',
    price: 'Sur consultation',
    roomsKey: 'choose_rooms_fonds',
    rooms: 'Local commercial · rez-de-chaussée',
    img: 'parcours/viz-05.jpg',
    imgAlt: 'Commerces en rez-de-chaussée',
    hotspot: { top: '68%', left: '48%' },
  },
] as const;
---

<BaseLayout title="Riyad Zaer Gardens — Nouveau pôle urbain">
  <Header current="home" />

  <!-- 1 · HERO -->
  <section id="arrive" class="beat beat-arrive relative min-h-[100svh] flex items-end md:items-center overflow-hidden bg-foret text-cream">
    <div class="arrive-media arrive-collage absolute inset-0" aria-hidden="true">
      <div class="absolute inset-0 scale-105" data-arrive-depth="0.1">
        <img
          class="arrive-poster media-poster w-full h-full object-cover"
          src={`${base}${vizAll[7]}`}
          alt=""
          width="1920"
          height="1080"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="absolute inset-0 pointer-events-none hidden lg:block" data-arrive-depth="0.22">
        <figure class="absolute top-[14%] left-[8%] w-[28%] aspect-[4/3] overflow-hidden rounded-sm shadow-2xl opacity-90">
          <img src={`${base}${vizAll[0]}`} alt="" width="1400" height="900" class="w-full h-full object-cover" loading="eager" decoding="async" />
        </figure>
        <figure class="absolute top-[18%] right-[10%] w-[22%] aspect-[3/4] overflow-hidden rounded-sm shadow-2xl opacity-85">
          <img src={`${base}${vizAll[10]}`} alt="" width="1200" height="800" class="w-full h-full object-cover" loading="eager" decoding="async" />
        </figure>
        <figure class="absolute bottom-[18%] right-[22%] w-[24%] aspect-[5/3] overflow-hidden rounded-sm shadow-2xl opacity-80">
          <img src={`${base}${vizAll[5]}`} alt="" width="1200" height="800" class="w-full h-full object-cover" loading="eager" decoding="async" />
        </figure>
      </div>

      <div class="absolute inset-0 bg-gradient-to-t from-foret via-foret/55 to-foret/25"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-foret/80 via-foret/35 to-transparent"></div>
    </div>

    <div class="arrive-copy relative z-10 container-rzg w-full pb-20 pt-32 md:py-36 md:max-w-2xl">
      <p class="text-[0.75rem] font-medium tracking-[0.22em] uppercase text-gold/90 mb-5" data-i18n="teasing">Aïn Aouda · Rabat</p>
      <h1 class="serif text-[clamp(2.75rem,7vw,5rem)] text-cream m-0 mb-6" data-i18n="arrive_title">Un nouveau pôle urbain</h1>
      <p class="text-cream/75 text-lg leading-relaxed max-w-xl m-0 mb-10" data-i18n="arrive_lead">
        Une adresse familiale, moderne et sécurisée — lumière, jardins, horizon ouvert entre Rabat et
        Aïn Aouda.
      </p>
      <div class="arrive-scale flex flex-wrap gap-x-10 gap-y-6 mb-12" data-stagger aria-label="Échelle du projet">
        <div class="min-w-[5.5rem]">
          <strong class="block serif text-3xl text-gold font-medium">120</strong>
          <span class="text-sm text-cream/60">appartements</span>
        </div>
        <div class="min-w-[5.5rem]">
          <strong class="block serif text-3xl text-gold font-medium">65–86</strong>
          <span class="text-sm text-cream/60">m² F3–F4</span>
        </div>
        <div class="min-w-[5.5rem] opacity-80">
          <strong class="block serif text-3xl text-gold-soft font-medium">+</strong>
          <span class="text-sm text-cream/60">fonds de commerce</span>
        </div>
      </div>
      <div class="arrive-actions">
        <a class="btn btn-solid" href="#live" data-i18n="cta_scroll">Découvrir</a>
      </div>
    </div>
  </section>

  <!-- 2 · LIVING -->
  <section id="live" class="beat beat-live bg-cream text-foret py-24 md:py-36">
    <div class="container-rzg">
      <header class="max-w-2xl mb-16 md:mb-24" data-reveal>
        <p class="kicker kicker--ink" data-i18n="live_kicker">Cadre de vie</p>
        <h2 class="serif text-[clamp(2.25rem,5vw,4rem)] m-0 mb-6 whitespace-pre-line" data-i18n="live_title">
          Vivre autrement.
C’est possible.
        </h2>
        <p class="text-foret/75 text-lg leading-relaxed m-0 max-w-xl" data-i18n="live_body">
          Cour végétalisée, volumes clairs, commerces de proximité — un quotidien élégant, sans le
          bruit du luxe générique.
        </p>
      </header>

      <div class="mb-10 md:mb-16" data-reveal="clip">
        <div class="live-depth live-hero relative aspect-[16/10] md:aspect-[21/10] overflow-hidden rounded-sm bg-canopee">
          <div class="absolute inset-[-8%] opacity-40" data-live-parallax="0.28" aria-hidden="true">
            <img src={`${base}parcours/viz-12.jpg`} alt="" width="1600" height="1000" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="absolute inset-[8%] md:inset-[10%_42%_18%_8%] opacity-70 shadow-xl overflow-hidden rounded-sm" data-live-parallax="0.18" aria-hidden="true">
            <img src={`${base}parcours/viz-11.jpg`} alt="" width="1200" height="800" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="absolute inset-0 md:inset-[12%_8%_8%_28%] overflow-hidden rounded-sm shadow-2xl" data-live-parallax="0.1">
            <img
              class="media-poster absolute inset-0 w-full h-full object-cover"
              src={`${base}parcours/viz-01.jpg`}
              alt="Cour végétalisée"
              width="1600"
              height="1000"
              loading="lazy"
            />
            <video
              class="beat-video"
              data-chapter-video
              poster={`${base}parcours/viz-01.jpg`}
              muted
              loop
              playsinline
              preload="none"
              aria-hidden="true"
            >
              <source src={`${base}parcours/video/live.webm`} type="video/webm" />
              <source src={`${base}parcours/video/live.mp4`} type="video/mp4" />
            </video>
          </div>
          <p class="absolute bottom-4 left-4 md:bottom-6 md:left-6 z-10 text-[0.7rem] tracking-[0.16em] uppercase text-cream/90 bg-foret/50 backdrop-blur-sm px-3 py-1.5 rounded-sm" data-i18n="live_cap_courtyard">Cour &amp; jardins</p>
        </div>
      </div>

      <div class="grid md:grid-cols-2 gap-6 md:gap-10 mb-16 md:mb-24" data-stagger>
        <figure class="m-0 group" data-live-parallax="0.2">
          <div class="overflow-hidden rounded-sm aspect-[5/3]">
            <img src={`${base}parcours/viz-06.jpg`} alt="Façade — volumes" width="1200" height="800" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" loading="lazy" />
          </div>
          <figcaption class="mt-4 text-sm text-canopee/80 tracking-wide" data-i18n="live_cap_facade">Façade & volumes</figcaption>
        </figure>
        <figure class="m-0 group md:mt-12" data-live-parallax="0.16">
          <div class="overflow-hidden rounded-sm aspect-[5/3]">
            <img src={`${base}parcours/viz-02.jpg`} alt="Intérieur lumineux" width="1200" height="800" class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]" loading="lazy" />
          </div>
          <figcaption class="mt-4 text-sm text-canopee/80 tracking-wide" data-i18n="live_cap_interior">Intérieurs lumineux</figcaption>
        </figure>
      </div>

      <aside class="flex flex-wrap items-center justify-center gap-x-6 gap-y-3 py-8 border-y border-foret/10" data-reveal aria-label="Confiance">
        <p class="m-0 text-sm font-medium tracking-wide text-canopee" data-i18n="trust_aides_t">Aides au logement</p>
        <span class="hidden sm:block w-1.5 h-1.5 rounded-full bg-gold" aria-hidden="true"></span>
        <p class="m-0 text-sm font-medium tracking-wide text-canopee" data-i18n="trust_chantier_t">Chantier suivi</p>
        <span class="hidden sm:block w-1.5 h-1.5 rounded-full bg-gold" aria-hidden="true"></span>
        <p class="m-0 text-sm font-medium tracking-wide text-canopee" data-i18n="trust_livraison_t">Livraison anticipée</p>
      </aside>
    </div>
  </section>

  <!-- 3 · EXPLORE -->
  <section id="explore" class="beat beat-explore bg-cream text-foret pb-24 md:pb-36">
    <header class="container-rzg max-w-2xl mb-12 md:mb-16" data-reveal>
      <p class="kicker kicker--ink" data-i18n="explore_kicker">Explorer</p>
      <h2 class="serif text-[clamp(2.25rem,5vw,4rem)] m-0 mb-5" data-i18n="explore_title">
        Trouvez votre adresse
      </h2>
      <p class="text-foret/75 text-lg leading-relaxed m-0" data-i18n="explore_body">
        Survolez le plan, ouvrez une typologie. Votre choix vous suit jusqu’à la conversation.
      </p>
    </header>

    <div class="container-rzg" data-reveal>
      <ul class="flex flex-wrap gap-2 mb-8 list-none p-0 m-0" role="list" aria-label="Typologies" data-i18n-aria="choose_legend_label">
        {
          typologies.map((t) => (
            <li>
              <button
                type="button"
                data-legend={t.id}
                data-hotspot-trigger={t.id}
                aria-pressed={t.id === 'F3' ? 'true' : 'false'}
                class:list={[
                  'choose-legend__btn inline-flex items-center gap-3 min-h-12 px-4 py-2.5 rounded-sm border transition-colors cursor-pointer',
                  t.id === 'F3'
                    ? 'is-active border-gold bg-foret text-cream'
                    : 'border-foret/15 bg-cream text-foret hover:border-gold/60',
                ]}
              >
                <span class="w-2 h-2 rounded-full bg-gold shrink-0" aria-hidden="true" />
                <span class="flex flex-col items-start text-left leading-tight">
                  <span
                    class="text-[0.8rem] font-medium tracking-wide"
                    data-i18n={
                      t.id === 'Fonds' ? 'choose_legend_fonds' : `choose_legend_${t.id.toLowerCase()}`
                    }
                  >
                    {t.title === 'Fonds de commerce' ? 'Fonds' : t.title}
                  </span>
                  <span class="text-[0.7rem] opacity-70" data-i18n={t.surfaceKey}>
                    {t.surface}
                  </span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>

      <div class="choose-split grid lg:grid-cols-2 gap-6 lg:gap-10 items-stretch">
        <div class="choose-plan relative overflow-hidden rounded-sm bg-canopee aspect-[4/3] lg:aspect-auto lg:min-h-[36rem]" role="group" aria-label="Plan interactif">
          <img
            src={`${base}parcours/viz-04.jpg`}
            alt="Plan aérien — Riyad Zaer Gardens"
            width="1600"
            height="1000"
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-foret/25"></div>
          <p id="explore-hint" class="absolute top-4 left-4 z-20 m-0 text-[0.7rem] tracking-[0.12em] uppercase text-cream/85 bg-foret/55 backdrop-blur-sm px-3 py-1.5 rounded-sm" data-i18n="explore_hint">Touchez un point sur le plan</p>
          {
            typologies.map((t) => (
              <button
                type="button"
                style={`top:${t.hotspot.top};left:${t.hotspot.left}`}
                data-hotspot={t.id}
                aria-label={t.title}
                aria-pressed={t.id === 'F3' ? 'true' : 'false'}
                class:list={['hotspot', { 'is-active': t.id === 'F3', 'is-selected': t.id === 'F3' }]}
                aria-describedby="explore-hint"
              >
                <span class="hotspot__pulse" aria-hidden="true" />
                <span class="hotspot__ring" aria-hidden="true">
                  <span class="hotspot__dot" aria-hidden="true" />
                </span>
                <span class="hotspot__label">{t.title === 'Fonds de commerce' ? 'Fonds' : t.title}</span>
              </button>
            ))
          }
        </div>

        <div class="choose-side relative bg-cream border border-foret/10 rounded-sm min-h-[28rem] lg:min-h-[36rem]">
          <div class="choose-panel-stage relative h-full p-6 md:p-8 overflow-y-auto" data-panel-stage>
            <p class="choose-empty is-hidden absolute inset-0 flex items-center justify-center p-8 text-center text-foret/50" data-choose-empty hidden aria-hidden="true" data-i18n="choose_empty">
              Choisissez F3, F4 ou un fonds — le détail s’ouvre ici.
            </p>
            {
              typologies.map((t) => (
                <article
                  class:list={['typo-panel flex flex-col h-full', { 'is-open': t.id === 'F3' }]}
                  data-panel={t.id}
                  aria-hidden={t.id === 'F3' ? 'false' : 'true'}
                  inert={t.id === 'F3' ? undefined : true}
                >
                  <div class="overflow-hidden rounded-sm aspect-[16/10] mb-6 shrink-0">
                    <img src={`${base}${t.img}`} alt={t.imgAlt} width="900" height="600" class="w-full h-full object-cover" loading="lazy" />
                  </div>
                  <div class="flex flex-col flex-1 gap-3">
                    <h3 class="serif text-3xl md:text-4xl m-0" data-i18n={t.titleKey}>
                      {t.title}
                    </h3>
                    <p class="m-0 text-sm text-canopee/80 tracking-wide" data-i18n={t.roomsKey}>
                      {t.rooms}
                    </p>
                    <p class="m-0 text-foret/75 leading-relaxed" data-i18n={t.bodyKey}>
                      {t.body}
                    </p>
                    <div class="flex flex-wrap items-baseline gap-x-6 gap-y-2 mt-2">
                      <p class="surface-tag" data-i18n={t.surfaceKey}>
                        {t.surface}
                      </p>
                      <p class="typo-price" data-i18n={t.priceKey}>
                        {t.price}
                      </p>
                    </div>
                    <p class="m-0 text-[0.75rem] tracking-[0.1em] uppercase text-canopee/70" data-i18n="choose_aides">
                      Éligible aux aides au logement
                    </p>
                    <div class="flex flex-wrap gap-2 mt-1">
                      {t.id !== 'Fonds' ? (
                        <>
                          <span class="chip" data-i18n="chip_family">Familial</span>
                          <span class="chip" data-i18n="chip_light">Lumière naturelle</span>
                          <span class="chip" data-i18n="chip_aides">Aides</span>
                        </>
                      ) : (
                        <span class="chip" data-i18n="chip_rdc">RDC</span>
                      )}
                    </div>
                    <div class="mt-auto pt-6">
                      <button type="button" class="btn btn-solid" data-select-typo={t.id} data-i18n="choose_select">
                        Garder ce choix
                      </button>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 4 · HANDOFF -->
  <section id="handoff" class="beat beat-handoff bg-foret text-cream py-28 md:py-36">
    <div class="container-rzg max-w-2xl text-center">
      <header data-reveal>
        <h2 class="serif text-[clamp(2rem,4.5vw,3.5rem)] m-0 mb-5" data-i18n="handoff_title">Parlons de votre futur chez-vous</h2>
        <p class="text-cream/70 text-lg leading-relaxed m-0 mb-4" data-i18n="handoff_body">
          Une question, une visite, une réservation — réponse prioritaire sur WhatsApp.
        </p>
        <p
          class="talk-choice is-empty text-gold text-sm tracking-wide m-0 mb-10"
          data-selected-label
          data-empty=""
          data-prefix="Votre choix :"
          hidden
        ></p>
      </header>

      <div class="handoff-cta" data-reveal>
        <a
          class="btn btn-solid btn-wa-lg"
          href="https://wa.me/212600000000"
          target="_blank"
          rel="noopener noreferrer"
          data-wa
          data-i18n="handoff_wa">Discuter sur WhatsApp</a
        >
      </div>
    </div>
  </section>

  <Footer />
</BaseLayout>
