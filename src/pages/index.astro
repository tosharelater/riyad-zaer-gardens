          Cum sociis natoque penatibus et magnis dis parturient montes — texture, lumière, silence.
        </p>
        <ul class="list-none p-0 m-0 space-y-5 text-foret/80" data-stagger>
          <li class="flex gap-3 items-start">
            <span class="mt-2 w-1.5 h-1.5 rounded-full bg-gold shrink-0" aria-hidden="true"></span>
            <span data-i18n="finitions_li1">Vestibulum id ligula porta felis euismod semper — finishes thoughtfully paced.</span>
          </li>
          <li class="flex gap-3 items-start">
            <span class="mt-2 w-1.5 h-1.5 rounded-full bg-gold shrink-0" aria-hidden="true"></span>
            <span data-i18n="finitions_li2">Morbi leo risus, porta ac consectetur ac, vestibulum at eros.</span>
          </li>
          <li class="flex gap-3 items-start">
            <span class="mt-2 w-1.5 h-1.5 rounded-full bg-gold shrink-0" aria-hidden="true"></span>
            <span data-i18n="finitions_li3">Etiam porta sem malesuada magna mollis euismod — detail without noise.</span>
          </li>
        </ul>
      </div>
      <div class="relative aspect-[4/5] md:aspect-[5/6] overflow-hidden rounded-sm bg-canopee" data-reveal="clip">
        <img
          src={`${base}parcours/viz-10.jpg`}
          alt=""
          width="1200"
          height="1500"
          class="absolute inset-0 w-full h-full object-cover"
          loading="lazy"
        />
        <div class="absolute inset-x-0 bottom-0 p-6 md:p-8 bg-gradient-to-t from-foret/80 to-transparent" data-reveal="fade">
          <p class="m-0 text-cream/90 text-sm tracking-wide" data-i18n="finitions_caption">
            Texture, lumière, silence — le détail sans bruit.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ — prominent -->
  <section id="faq" class="faq-section section-seam" aria-labelledby="faq-title">
    <div class="container-rzg">
      <header class="max-w-2xl mx-auto text-center mb-14 md:mb-20" data-reveal>
        <p class="kicker kicker--ink" data-i18n="faq_kicker">Questions</p>
        <h2 id="faq-title" class="serif text-[clamp(2.25rem,5vw,3.75rem)] m-0 mb-5" data-i18n="faq_title">
          Tout ce qu’il faut savoir
        </h2>
        <p class="text-foret/70 text-lg leading-relaxed m-0" data-i18n="faq_body">
          Aides, livraison, parking, visite, réservation et typologies — réponses claires.
        </p>
      </header>

      <div class="faq-list" data-faq data-stagger>
        {
          faqItems.map((item) => (
            <div class="faq-item" data-faq-item>
              <button
                type="button"
                class="faq-trigger"
                data-faq-trigger
                aria-expanded="false"
                aria-controls={`faq-panel-home-${item.id}`}
                id={`faq-btn-home-${item.id}`}
              >
                <span class="faq-q" data-i18n={item.qKey}>{item.q}</span>
                <span class="faq-icon" aria-hidden="true" />
              </button>
              <div
                class="faq-panel"
                data-faq-panel
                id={`faq-panel-home-${item.id}`}
                role="region"
                aria-labelledby={`faq-btn-home-${item.id}`}
                aria-hidden="true"
              >
                <div class="faq-panel-inner">
                  <p data-i18n={item.aKey}>{item.a}</p>
                </div>
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- 4 · HANDOFF -->
