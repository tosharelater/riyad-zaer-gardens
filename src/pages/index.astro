---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';

const vizAll = Array.from({ length: 12 }, (_, i) => `parcours/viz-${String(i + 1).padStart(2, '0')}.jpg`);

const storyBeats = [
  {
    id: '01',
    img: 'parcours/viz-01.jpg',
    imgAlt: 'Cour végétalisée',
    titleKey: 'story_1_title',
    title: 'Cour & jardins',
    bodyKey: 'story_1_body',
    body: 'Un cœur planté, des promenades ombragées — le quotidien commence à l’air libre.',
  },
  {
    id: '02',
    img: 'parcours/viz-06.jpg',
    imgAlt: 'Façade et volumes',
    titleKey: 'story_2_title',
    title: 'Volumes & lumière',
    bodyKey: 'story_2_body',
    body: 'Façades claires, proportions maîtrisées — une architecture qui respire sans forcer le geste.',
  },
  {
    id: '03',
    img: 'parcours/viz-02.jpg',
    imgAlt: 'Intérieur lumineux',
    titleKey: 'story_3_title',
    title: 'Intérieurs calmes',
    bodyKey: 'story_3_body',
    body: 'Séjours ouverts, cuisine fluide, rangements pensés — des mètres carrés qui travaillent pour vous.',
  },
  {
    id: '04',
    img: 'parcours/viz-11.jpg',
    imgAlt: 'Horizon et adresse',
    titleKey: 'story_4_title',
    title: 'Horizon ouvert',
    bodyKey: 'story_4_body',
    body: 'Entre Rabat et Aïn Aouda, une adresse familiale, sécurisée, tournée vers le long terme.',
  },
] as const;

const typologies = [
  {
    id: 'F3',
    titleKey: 'choose_f3_title',
    title: 'F3',
    surfaceKey: 'choose_f3_surface',
    surface: '65–75 m²',
    bodyKey: 'choose_f3_body',
    body:
      'Séjour lumineux, deux chambres, cuisine ouverte, rangements pensés. Idéal pour démarrer ou se réancrer.',
    priceKey: 'choose_f3_price',
    price: 'À partir de ~420 000 DHS',
    roomsKey: 'choose_rooms_f3',
    rooms: '2 chambres · séjour · cuisine ouverte',
    img: 'parcours/viz-09.jpg',
    imgAlt: 'Cuisine — typologie F3',
    hotspot: { top: '42%', left: '28%' },
  },
  {
    id: 'F4',
    titleKey: 'choose_f4_title',
    title: 'F4',
    surfaceKey: 'choose_f4_surface',
    surface: 'jusqu’à 86 m²',
    bodyKey: 'choose_f4_body',
    body:
      'Troisième chambre, plus d’espace familial, volumes clairs — pour s’ancrer durablement.',
    priceKey: 'choose_f4_price',
    price: 'À partir de ~480 000 DHS',
    roomsKey: 'choose_rooms_f4',
    rooms: '3 chambres · séjour · cuisine ouverte',
    img: 'parcours/viz-06.jpg',
    imgAlt: 'Façade — typologie F4',
    hotspot: { top: '38%', left: '58%' },
  },
  {
    id: 'Fonds',
    titleKey: 'choose_fonds_title',
    title: 'Fonds de commerce',
    surfaceKey: 'choose_fonds_surface',
    surface: 'Rez-de-chaussée',
    bodyKey: 'choose_fonds_body',
    body:
      'Locaux en pied d’immeuble pour commerces de proximité — une adresse vivante au seuil de la résidence.',
    priceKey: 'choose_fonds_price',
    price: 'Sur consultation',
    roomsKey: 'choose_rooms_fonds',
    rooms: 'Local commercial · rez-de-chaussée',
    img: 'parcours/viz-05.jpg',
    imgAlt: 'Commerces en rez-de-chaussée',
    hotspot: { top: '68%', left: '48%' },
  },
] as const;

const faqItems = [
  {
    id: 'aides',
    qKey: 'faq_aides_q',
    q: 'Le projet est-il éligible aux aides au logement ?',
    aKey: 'faq_aides_a',
    a: 'Oui. Riyad Zaer Gardens est conçu pour maximiser l’éligibilité aux dispositifs d’accession. Notre équipe vous oriente dossier par dossier.',
  },
  {
    id: 'livraison',
    qKey: 'faq_livraison_q',
    q: 'Quand est prévue la livraison ?',
    aKey: 'faq_livraison_a',
    a: 'Le calendrier de livraison est partagé dès la réservation, avec des jalons de chantier visibles. Vous savez où en est votre futur chez-vous.',
  },
  {
    id: 'parking',
    qKey: 'faq_parking_q',
    q: 'Y a-t-il du stationnement ?',
    aKey: 'faq_parking_a',
    a: 'Des places dédiées sont prévues pour les résidents. Les détails (nombre, attribution) sont précisés à la réservation.',
  },
  {
    id: 'visite',
    qKey: 'faq_visite_q',
    q: 'Puis-je visiter le site ou le showroom ?',
    aKey: 'faq_visite_a',
    a: 'Oui, sur rendez-vous. Contactez-nous via WhatsApp pour planifier une visite et découvrir les typologies en détail.',
  },
  {
    id: 'typologies',
    qKey: 'faq_typo_q',
    q: 'Quelles typologies sont disponibles ?',
    aKey: 'faq_typo_a',
    a: 'F3 (65–75 m²), F4 (jusqu’à 86 m²) et fonds de commerce en rez-de-chaussée — 120 appartements au total.',
  },
  {
    id: 'reservation',
    qKey: 'faq_resa_q',
    q: 'Comment réserver un appartement ?',
    aKey: 'faq_resa_a',
    a: 'Choisissez votre typologie sur cette page, puis écrivez-nous sur WhatsApp. Nous vous guidons pour la réservation et les prochaines étapes.',
  },
] as const;
---

<BaseLayout title="Riyad Zaer Gardens — Nouveau pôle urbain">
  <Header current="home" />

  <!-- 1 · HERO -->
  <section id="arrive" class="beat beat-arrive relative min-h-[100svh] flex items-end md:items-center overflow-hidden bg-foret text-cream">
    <div class="arrive-media arrive-collage absolute inset-0" aria-hidden="true">
      <div class="absolute inset-0 scale-105" data-arrive-depth="0.1">
        <img
          class="arrive-poster media-poster w-full h-full object-cover"
          src={`${base}${vizAll[7]}`}
          alt=""
          width="1920"
          height="1080"
          fetchpriority="high"
          decoding="async"
        />
      </div>

      <div class="absolute inset-0 pointer-events-none hidden lg:block" data-arrive-depth="0.22">
        <figure class="absolute top-[14%] left-[8%] w-[28%] aspect-[4/3] overflow-hidden rounded-sm shadow-2xl opacity-90">
          <img src={`${base}${vizAll[0]}`} alt="" width="1400" height="900" class="w-full h-full object-cover" loading="eager" decoding="async" />
        </figure>
        <figure class="absolute top-[18%] right-[10%] w-[22%] aspect-[3/4] overflow-hidden rounded-sm shadow-2xl opacity-85">
          <img src={`${base}${vizAll[10]}`} alt="" width="1200" height="800" class="w-full h-full object-cover" loading="eager" decoding="async" />
        </figure>
        <figure class="absolute bottom-[18%] right-[22%] w-[24%] aspect-[5/3] overflow-hidden rounded-sm shadow-2xl opacity-80">
          <img src={`${base}${vizAll[5]}`} alt="" width="1200" height="800" class="w-full h-full object-cover" loading="eager" decoding="async" />
        </figure>
      </div>

      <div class="absolute inset-0 bg-gradient-to-t from-foret via-foret/55 to-foret/25"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-foret/80 via-foret/35 to-transparent"></div>
    </div>

    <div class="arrive-copy relative z-10 container-rzg w-full pb-20 pt-32 md:py-36 md:max-w-2xl">
      <p class="text-[0.75rem] font-medium tracking-[0.22em] uppercase text-gold/90 mb-5" data-i18n="teasing">Aïn Aouda · Rabat</p>
      <h1 class="serif text-[clamp(2.75rem,7vw,5rem)] text-cream m-0 mb-6" data-i18n="arrive_title">Un nouveau pôle urbain</h1>
      <p class="text-cream/75 text-lg leading-relaxed max-w-xl m-0 mb-10" data-i18n="arrive_lead">
        Une adresse familiale, moderne et sécurisée — lumière, jardins, horizon ouvert entre Rabat et
        Aïn Aouda.
      </p>
      <div class="arrive-scale flex flex-wrap gap-x-10 gap-y-6 mb-12" data-stagger aria-label="Échelle du projet">
        <div class="min-w-[5.5rem]">
          <strong class="block serif text-3xl text-gold font-medium">120</strong>
          <span class="text-sm text-cream/60">appartements</span>
        </div>
        <div class="min-w-[5.5rem]">
          <strong class="block serif text-3xl text-gold font-medium">65–86</strong>
          <span class="text-sm text-cream/60">m² F3–F4</span>
        </div>
        <div class="min-w-[5.5rem] opacity-80">
          <strong class="block serif text-3xl text-gold-soft font-medium">+</strong>
          <span class="text-sm text-cream/60">fonds de commerce</span>
        </div>
      </div>
      <div class="arrive-actions">
        <a class="btn btn-solid" href="#live" data-i18n="cta_scroll">Découvrir</a>
      </div>
    </div>
  </section>

  <!-- 2 · CADRE DE VIE — fullscreen scroll story -->
  <section id="live" class="beat beat-live story bg-cream text-foret" data-story>
    <header class="story-intro" data-reveal>
      <p class="kicker kicker--ink" data-i18n="live_kicker">Cadre de vie</p>
      <h2 class="serif text-[clamp(2.25rem,5vw,4rem)] m-0 mb-6 whitespace-pre-line" data-i18n="live_title">
        Vivre autrement.
C’est possible.
      </h2>
      <p class="text-foret/75 text-lg leading-relaxed m-0 max-w-xl" data-i18n="live_body">
        Cour végétalisée, volumes clairs, commerces de proximité — un quotidien élégant, sans le
        bruit du luxe générique.
      </p>
    </header>

    {
      storyBeats.map((beat, i) => (
        <div class="story-beat" data-story-beat={beat.id}>
          <div class="story-sticky">
            <div class="story-media" data-story-media>
              <img
                src={`${base}${beat.img}`}
                alt={beat.imgAlt}
                width="1920"
                height="1080"
                loading={i === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
              <div class="story-media__veil" aria-hidden="true" />
            </div>
            <div class="story-copy" data-story-copy>
              <div class="story-copy__silence" aria-hidden="true" />
              <span class="story-index">{String(i + 1).padStart(2, '0')} / {String(storyBeats.length).padStart(2, '0')}</span>
              <h3 data-i18n={beat.titleKey}>{beat.title}</h3>
              <p data-i18n={beat.bodyKey}>{beat.body}</p>
            </div>
          </div>
        </div>
      ))
    }

    <aside class="container-rzg flex flex-wrap items-center justify-center gap-x-6 gap-y-3 py-14 md:py-20 border-t border-foret/10" data-reveal aria-label="Confiance">
      <p class="m-0 text-sm font-medium tracking-wide text-canopee" data-i18n="trust_aides_t">Aides au logement</p>
      <span class="hidden sm:block w-1.5 h-1.5 rounded-full bg-gold" aria-hidden="true"></span>
      <p class="m-0 text-sm font-medium tracking-wide text-canopee" data-i18n="trust_chantier_t">Chantier suivi</p>
      <span class="hidden sm:block w-1.5 h-1.5 rounded-full bg-gold" aria-hidden="true"></span>
      <p class="m-0 text-sm font-medium tracking-wide text-canopee" data-i18n="trust_livraison_t">Livraison anticipée</p>
    </aside>
  </section>

  <!-- Showcase · Promesse -->
  <section id="promesse" class="showcase-section showcase-section--foret section-seam" aria-labelledby="promesse-title">
    <div class="container-rzg max-w-3xl text-center" data-reveal>
      <p class="kicker" data-i18n="promesse_kicker">Promesse</p>
      <h2 id="promesse-title" class="serif text-[clamp(2rem,4.5vw,3.5rem)] m-0 mb-6" data-i18n="promesse_title">
        Une adresse qui tient sa parole
      </h2>
      <p class="text-cream/70 text-lg leading-relaxed m-0 max-w-2xl mx-auto" data-i18n="promesse_body">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit. Sed do eiusmod tempor incididunt ut
        labore et dolore magna aliqua — lumen, silentium, spatium. Ut enim ad minim veniam, quis
        nostrud exercitation ullamco laboris nisi ut aliquip ex ea commodo consequat.
      </p>
    </div>
  </section>

  <!-- 3 · EXPLORE — compact -->
  <section id="explore" class="beat beat-explore explore--compact bg-cream text-foret section-seam">
    <header class="container-rzg max-w-xl mb-8 md:mb-10" data-reveal>
      <p class="kicker kicker--ink" data-i18n="explore_kicker">Explorer</p>
      <h2 class="serif text-[clamp(1.85rem,4vw,2.75rem)] m-0 mb-3" data-i18n="explore_title">
        Trouvez votre adresse
      </h2>
      <p class="text-foret/70 text-base leading-relaxed m-0" data-i18n="explore_body">
        Survolez le plan, ouvrez une typologie. Votre choix vous suit jusqu’à la conversation.
      </p>
    </header>

    <div class="container-rzg" data-reveal>
      <ul class="flex flex-wrap gap-1.5 mb-5 list-none p-0 m-0" role="list" aria-label="Typologies" data-i18n-aria="choose_legend_label">
        {
          typologies.map((t) => (
            <li>
              <button
                type="button"
                data-legend={t.id}
                data-hotspot-trigger={t.id}
                aria-pressed={t.id === 'F3' ? 'true' : 'false'}
                class:list={[
                  'choose-legend__btn inline-flex items-center gap-2 min-h-10 px-3 py-2 rounded-sm border transition-colors cursor-pointer',
                  t.id === 'F3'
                    ? 'is-active border-gold bg-foret text-cream'
                    : 'border-foret/15 bg-cream text-foret hover:border-gold/60',
                ]}
              >
                <span class="w-1.5 h-1.5 rounded-full bg-gold shrink-0" aria-hidden="true" />
                <span class="flex flex-col items-start text-left leading-tight">
                  <span
                    class="text-[0.75rem] font-medium tracking-wide"
                    data-i18n={
                      t.id === 'Fonds' ? 'choose_legend_fonds' : `choose_legend_${t.id.toLowerCase()}`
                    }
                  >
                    {t.title === 'Fonds de commerce' ? 'Fonds' : t.title}
                  </span>
                  <span class="text-[0.65rem] opacity-70" data-i18n={t.surfaceKey}>
                    {t.surface}
                  </span>
                </span>
              </button>
            </li>
          ))
        }
      </ul>

      <div class="choose-split grid lg:grid-cols-2 gap-4 lg:gap-6 items-stretch">
        <div class="choose-plan relative overflow-hidden rounded-sm bg-canopee aspect-[16/11] lg:aspect-auto lg:min-h-[22rem] lg:max-h-[26rem]" role="group" aria-label="Plan interactif">
          <img
            src={`${base}parcours/viz-04.jpg`}
            alt="Plan aérien — Riyad Zaer Gardens"
            width="1600"
            height="1000"
            class="absolute inset-0 w-full h-full object-cover"
            loading="lazy"
          />
          <div class="absolute inset-0 bg-foret/25"></div>
          <p id="explore-hint" class="absolute top-3 left-3 z-20 m-0 text-[0.65rem] tracking-[0.12em] uppercase text-cream/85 bg-foret/55 backdrop-blur-sm px-2.5 py-1 rounded-sm" data-i18n="explore_hint">Touchez un point sur le plan</p>
          {
            typologies.map((t) => (
              <button
                type="button"
                style={`top:${t.hotspot.top};left:${t.hotspot.left}`}
                data-hotspot={t.id}
                aria-label={t.title}
                aria-pressed={t.id === 'F3' ? 'true' : 'false'}
                class:list={['hotspot', { 'is-active': t.id === 'F3', 'is-selected': t.id === 'F3' }]}
                aria-describedby="explore-hint"
              >
                <span class="hotspot__pulse" aria-hidden="true" />
                <span class="hotspot__ring" aria-hidden="true">
                  <span class="hotspot__dot" aria-hidden="true" />
                </span>
                <span class="hotspot__label">{t.title === 'Fonds de commerce' ? 'Fonds' : t.title}</span>
              </button>
            ))
          }
        </div>

        <div class="choose-side relative bg-cream border border-foret/10 rounded-sm min-h-[18rem] lg:min-h-[22rem] lg:max-h-[26rem] overflow-hidden">
          <div class="choose-panel-stage relative h-full p-4 md:p-5 overflow-y-auto" data-panel-stage>
            <p class="choose-empty is-hidden absolute inset-0 flex items-center justify-center p-6 text-center text-foret/50 text-sm" data-choose-empty hidden aria-hidden="true" data-i18n="choose_empty">
              Choisissez F3, F4 ou un fonds — le détail s’ouvre ici.
            </p>
            {
              typologies.map((t) => (
                <article
                  class:list={['typo-panel flex flex-col h-full', { 'is-open': t.id === 'F3' }]}
                  data-panel={t.id}
                  aria-hidden={t.id === 'F3' ? 'false' : 'true'}
                  inert={t.id === 'F3' ? undefined : true}
                >
                  <div class="overflow-hidden rounded-sm aspect-[16/9] max-h-36 mb-3 shrink-0">
                    <img src={`${base}${t.img}`} alt={t.imgAlt} width="900" height="600" class="w-full h-full object-cover" loading="lazy" />
                  </div>
                  <div class="flex flex-col flex-1 gap-2">
                    <h3 class="serif text-2xl md:text-3xl m-0" data-i18n={t.titleKey}>
                      {t.title}
                    </h3>
                    <p class="m-0 text-xs text-canopee/80 tracking-wide" data-i18n={t.roomsKey}>
                      {t.rooms}
                    </p>
                    <p class="m-0 text-sm text-foret/75 leading-relaxed" data-i18n={t.bodyKey}>
                      {t.body}
                    </p>
                    <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1 mt-1">
                      <p class="surface-tag" data-i18n={t.surfaceKey}>
                        {t.surface}
                      </p>
                      <p class="typo-price text-sm" data-i18n={t.priceKey}>
                        {t.price}
                      </p>
                    </div>
                    <p class="m-0 text-[0.7rem] tracking-[0.1em] uppercase text-canopee/70" data-i18n="choose_aides">
                      Éligible aux aides au logement
                    </p>
                    <div class="flex flex-wrap gap-1.5 mt-0.5">
                      {t.id !== 'Fonds' ? (
                        <>
                          <span class="chip" data-i18n="chip_family">Familial</span>
                          <span class="chip" data-i18n="chip_light">Lumière naturelle</span>
                          <span class="chip" data-i18n="chip_aides">Aides</span>
                        </>
                      ) : (
                        <span class="chip" data-i18n="chip_rdc">RDC</span>
                      )}
                    </div>
                    <div class="mt-auto pt-4">
                      <button type="button" class="btn btn-solid min-h-11 px-5 text-[0.75rem]" data-select-typo={t.id} data-i18n="choose_select">
                        Garder ce choix
                      </button>
                    </div>
                  </div>
                </article>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Showcase · Emplacement -->
  <section id="emplacement" class="showcase-section showcase-section--cream section-seam" aria-labelledby="emplacement-title">
    <div class="container-rzg">
      <div class="grid lg:grid-cols-2 gap-10 lg:gap-16 items-center mb-14 md:mb-20">
        <header class="max-w-xl" data-reveal>
          <p class="kicker kicker--ink" data-i18n="emplacement_kicker">Emplacement</p>
          <h2 id="emplacement-title" class="serif text-[clamp(2rem,4.5vw,3.25rem)] m-0 mb-5" data-i18n="emplacement_title">
            Entre Rabat et l’horizon
          </h2>
          <p class="text-foret/70 text-lg leading-relaxed m-0 mb-8" data-i18n="emplacement_body">
            Duis aute irure dolor in reprehenderit in voluptate velit esse cillum dolore eu fugiat nulla
            pariatur. Excepteur sint occaecat cupidatat non proident — axes fluides, silence relatif,
            proximité des communs.
          </p>
          <div class="emplacement-stats" data-stagger>
            <div class="emplacement-stat">
              <strong>12</strong>
              <span data-i18n="emplacement_stat1">min vers Rabat</span>
            </div>
            <div class="emplacement-stat">
              <strong>Aïn</strong>
              <span data-i18n="emplacement_stat2">Aouda · Sud</span>
            </div>
            <div class="emplacement-stat">
              <strong>120</strong>
              <span data-i18n="emplacement_stat3">appartements</span>
            </div>
            <div class="emplacement-stat">
              <strong>+</strong>
              <span data-i18n="emplacement_stat4">commerces RDC</span>
            </div>
          </div>
        </header>

        <div class="emplacement-map aspect-[5/4] md:aspect-[4/3] is-in" data-reveal="clip" aria-label="Carte symbolique">
          <img
            class="emplacement-map__img"
            src={`${base}parcours/viz-11.jpg`}
            alt=""
            width="1400"
            height="1000"
            loading="lazy"
          />
          <div class="emplacement-map__veil" aria-hidden="true"></div>
          <div class="emplacement-map__grid" aria-hidden="true"></div>
          <div class="emplacement-pin" style="top:42%;left:38%;--pin-delay:0.15s">
            <span class="emplacement-pin__dot" aria-hidden="true"></span>
            <span class="emplacement-pin__label" data-i18n="emplacement_pin_rzg">Riyad Zaer</span>
          </div>
          <div class="emplacement-pin" style="top:28%;left:62%;--pin-delay:0.35s">
            <span class="emplacement-pin__dot" aria-hidden="true"></span>
            <span class="emplacement-pin__label" data-i18n="emplacement_pin_rabat">Rabat</span>
          </div>
          <div class="emplacement-pin" style="top:68%;left:55%;--pin-delay:0.5s">
            <span class="emplacement-pin__dot" aria-hidden="true"></span>
            <span class="emplacement-pin__label" data-i18n="emplacement_pin_axis">Axes sud</span>
          </div>
        </div>
      </div>

      <div class="showcase-grid" data-stagger>
        <article class="showcase-card">
          <h3 data-i18n="emplacement_c1_t">Axes & accès</h3>
          <p data-i18n="emplacement_c1_b">
            Lorem ipsum dolor sit amet, consectetur adipiscing elit. Integer posuere erat a ante
            venenatis dapibus posuere velit aliquet.
          </p>
        </article>
        <article class="showcase-card">
          <h3 data-i18n="emplacement_c2_t">Quartier vivant</h3>
          <p data-i18n="emplacement_c2_b">
            Cras mattis consectetur purus sit amet fermentum. Aenean lacinia bibendum nulla sed
            consectetur. Maecenas faucibus mollis interdum.
          </p>
        </article>
        <article class="showcase-card">
          <h3 data-i18n="emplacement_c3_t">Horizon long</h3>
