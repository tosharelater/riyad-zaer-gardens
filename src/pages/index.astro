---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ArchFrame from '../components/ArchFrame.astro';
import ArchDivider from '../components/ArchDivider.astro';
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<BaseLayout title="Riyad Zaer Gardens — Accueil">
  <Header current="home" />

  <section class="hero">
    <div class="hero-copy">
      <div class="masthead">
        <span class="marker" data-num="01" data-i18n="coming_soon">Bientôt disponible</span>
      </div>
      <p class="label" style="margin:0 0 1.25rem; opacity:0.85;" data-i18n="teasing"
        >Résidence exclusive · Aïn Aouda · Rabat</p
      >
      <h1 data-i18n="hero_title">Vivre l’élégance au cœur de Riyad Zaer</h1>
      <p class="hero-pitch" data-i18n="hero_pitch">
        F3 & F4 de 65 à 86 m² · 120 appartements + fonds de commerce. Une adresse familiale, moderne et
        sécurisée entre Rabat et Aïn Aouda.
      </p>
      <div class="aides-note">
        <span class="label" data-i18n="aides_title">Éligible aux aides au logement</span>
        <p data-i18n="aides_body">
          Projet conçu pour maximiser votre éligibilité aux dispositifs d’aide à l’accession —
          renseignez-vous dès maintenant.
        </p>
      </div>
      <div class="hero-actions">
        <a
          class="btn btn-solid"
          href="https://wa.me/212600000000"
          target="_blank"
          rel="noopener noreferrer"
          data-i18n="cta_whatsapp">WhatsApp</a
        >
        <a class="btn-ghost-link" href={`${base}contact`} data-i18n="cta_contact">Nous contacter</a>
      </div>
    </div>

    <div class="hero-media" aria-hidden="false">
      <div class="hero-fade" aria-hidden="true"></div>
      <div class="hero-kb">
        <img
          class="hero-poster"
          src={`${base}courtyard.jpg`}
          alt="Cour végétalisée de Riyad Zaer Gardens"
          width="1600"
          height="1000"
          fetchpriority="high"
          decoding="async"
        />
      </div>
      <div class="hero-caption" data-i18n="hero_caption">Cour végétalisée · Aïn Aouda</div>
    </div>
  </section>

  <section class="section theme-cream">
    <div class="container">
      <div class="section-head" data-reveal>
        <span class="marker" data-num="02" data-i18n="pitch_label">Le projet</span>
        <h2 class="serif" data-i18n="pitch_title">120 appartements · F3 / F4 · 65–86 m²</h2>
        <p class="muted" data-i18n="hero_pitch">
          F3 & F4 de 65 à 86 m² · 120 appartements + fonds de commerce. Une adresse familiale, moderne et
          sécurisée entre Rabat et Aïn Aouda.
        </p>
      </div>

      <ArchDivider />

      <div class="stats-editorial" data-reveal>
        <div class="stat-ed">
          <strong>120</strong>
          <span class="muted" data-i18n="stats_apts">appartements</span>
        </div>
        <div class="stat-ed">
          <strong>65–86</strong>
          <span class="muted" data-i18n="stats_surface">m² F3–F4</span>
        </div>
        <div class="stat-ed">
          <strong>+</strong>
          <span class="muted" data-i18n="stats_commerce">fonds de commerce</span>
        </div>
      </div>
    </div>
  </section>

  <section class="section theme-dark">
    <div class="container">
      <div class="quote-band" data-reveal>
        <blockquote class="pull-quote">
          <span data-i18n="pull_quote"
            >« Une adresse familiale, moderne et sécurisée — sans le bruit du luxe générique. »</span
          >
          <cite data-i18n="pull_cite">Riyad Zaer Gardens · Éditorial</cite>
        </blockquote>
        <div class="aside muted">
          <span class="marker" data-num="03" data-i18n="feature_label">Cadre de vie</span>
          <p style="margin:1rem 0 0;" data-i18n="feature_body">
            Lumière naturelle, finitions soignées et cour végétalisée — un quotidien élégant, sans
            compromis.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section theme-cream">
    <div class="container">
      <article class="story" data-reveal>
        <div class="story-media">
          <img
            src={`${base}kids-bedroom.jpg`}
            alt="Chambre enfant — finitions modernes"
            width="1200"
            height="800"
            loading="lazy"
          />
          <ArchFrame />
        </div>
        <div class="story-body">
          <span class="marker" data-num="04" data-i18n="feature_label">Cadre de vie</span>
          <h3 class="serif" data-i18n="feature_title">Espaces pensés pour la famille</h3>
          <p class="muted" data-i18n="feature_body">
            Lumière naturelle, finitions soignées et cour végétalisée — un quotidien élégant, sans
            compromis.
          </p>
          <a
            class="btn"
            href={`${base}services`}
            style="align-self:flex-start; margin-top:0.5rem;"
            data-i18n="cta_discover">Découvrir les prestations</a
          >
        </div>
      </article>
    </div>
  </section>

  <Footer />
</BaseLayout>
