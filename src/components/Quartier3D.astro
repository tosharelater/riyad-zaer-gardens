---
/**
 * Pin / tall mid-home section: scroll-scrubbed abstract 3D quartier.
 * Three.js loads only when this section nears the viewport.
 */
---

<section id="quartier" class="beat beat-quartier" data-quartier aria-label="Quartier">
  <div class="quartier-track">
    <div class="quartier-sticky" data-quartier-sticky>
      <canvas class="quartier-canvas" data-quartier-canvas hidden aria-hidden="true"></canvas>

      <div class="quartier-fallback" data-quartier-fallback aria-hidden="true">
        <div class="quartier-fallback__sky"></div>
        <div class="quartier-fallback__ground"></div>
        <div class="quartier-fallback__block quartier-fallback__block--a"></div>
        <div class="quartier-fallback__block quartier-fallback__block--b"></div>
        <div class="quartier-fallback__block quartier-fallback__block--c"></div>
        <div class="quartier-fallback__arch"></div>
        <div class="quartier-fallback__gold"></div>
      </div>

      <div class="quartier-overlay">
        <p class="kicker" data-i18n="quartier_kicker">Le quartier</p>
        <h2 class="serif quartier-title" data-i18n="quartier_title">Volumes &amp; horizon</h2>
        <p class="quartier-lead" data-i18n="quartier_body">
          Faites défiler — la caméra traverse un fragment abstrait de Riyad Zaer Gardens.
        </p>
        <p class="quartier-hint" data-i18n="quartier_hint">Défilez pour explorer</p>
      </div>
    </div>
  </div>
</section>
