---
interface Props {
  current?: 'home' | 'services' | 'about' | 'blog' | 'contact';
}
const { current = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const solid = current !== 'home';
---

<header class:list={['site-header', { 'is-scrolled': solid, 'site-header--solid': solid }]}>
  <div class="inner">
    <a class="brand" href={base} aria-label="Riyad Zaer Gardens">
      <img src={`${base}logo.png`} alt="Riyad Zaer Gardens" width="160" height="64" />
    </a>
    <nav class="nav-links" aria-label="Navigation">
      <a href={base} aria-current={current === 'home' ? 'page' : undefined} data-i18n="nav_home"
        >Accueil</a
      >
      <a
        href={`${base}services/`}
        aria-current={current === 'services' ? 'page' : undefined}
        data-i18n="nav_services">Prestations</a
      >
      <a
        href={`${base}about/`}
        aria-current={current === 'about' ? 'page' : undefined}
        data-i18n="nav_about">À propos</a
      >
      <a
        href={`${base}blog/`}
        aria-current={current === 'blog' ? 'page' : undefined}
        data-i18n="nav_blog">Blog</a
      >
      <a
        href={`${base}contact/`}
        aria-current={current === 'contact' ? 'page' : undefined}
        data-i18n="nav_contact">Contact</a
      >
    </nav>
    <div class="lang-toggle" role="group" aria-label="Language">
      <button type="button" data-lang="fr" aria-pressed="true">FR</button>
      <button type="button" data-lang="ar" aria-pressed="false">AR</button>
    </div>
    <button
      type="button"
      class="nav-burger"
      data-nav-burger
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Menu"
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
  </div>

  <div id="mobile-nav" class="mobile-nav" data-mobile-nav aria-hidden="true">
    <nav class="mobile-nav__links" aria-label="Navigation mobile">
      <a href={base} aria-current={current === 'home' ? 'page' : undefined} data-i18n="nav_home"
        >Accueil</a
      >
      <a
        href={`${base}services/`}
        aria-current={current === 'services' ? 'page' : undefined}
        data-i18n="nav_services">Prestations</a
      >
      <a
        href={`${base}about/`}
        aria-current={current === 'about' ? 'page' : undefined}
        data-i18n="nav_about">À propos</a
      >
      <a
        href={`${base}blog/`}
        aria-current={current === 'blog' ? 'page' : undefined}
        data-i18n="nav_blog">Blog</a
      >
      <a
        href={`${base}contact/`}
        aria-current={current === 'contact' ? 'page' : undefined}
        data-i18n="nav_contact">Contact</a
      >
    </nav>
  </div>
</header>
