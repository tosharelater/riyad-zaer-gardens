---
interface Props {
  current?: 'home' | 'services' | 'contact';
}
const { current = 'home' } = Astro.props;
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
const home = current === 'home';
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href={home ? '#arrive' : base} aria-label="Riyad Zaer Gardens">
      <img src={`${base}logo.png`} alt="Riyad Zaer Gardens" width="160" height="64" />
    </a>
    <nav class="nav-links" aria-label="Parcours">
      <a href={home ? '#arrive' : `${base}#arrive`} data-chapter="arrive" data-i18n="nav_arrive"
        >Arriver</a
      >
      <a href={home ? '#live' : `${base}#live`} data-chapter="live" data-i18n="nav_live">Vivre</a>
      <a href={home ? '#choose' : `${base}#choose`} data-chapter="choose" data-i18n="nav_choose"
        >Choisir</a
      >
      <a href={home ? '#trust' : `${base}#trust`} data-chapter="trust" data-i18n="nav_trust"
        >Confiance</a
      >
      <a href={home ? '#talk' : `${base}#talk`} data-chapter="talk" data-i18n="nav_talk">Parler</a>
    </nav>
    <div class="lang-toggle" role="group" aria-label="Language">
      <button type="button" data-lang="fr" aria-pressed="true">FR</button>
      <button type="button" data-lang="ar" aria-pressed="false">AR</button>
    </div>
  </div>
</header>
