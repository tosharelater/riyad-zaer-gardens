---
interface Props {
  current?: 'home' | 'services' | 'contact';
}
const { current = 'home' } = Astro.props;
---

<header class="site-header">
  <div class="inner">
    <a class="brand" href="/" aria-label="Riyad Zaer Gardens">
      <img src="/logo.png" alt="Riyad Zaer Gardens" width="160" height="64" />
    </a>
    <nav class="nav-links" aria-label="Primary">
      <a href="/" aria-current={current === 'home' ? 'page' : undefined} data-i18n="nav_home">Accueil</a>
      <a href="/services" aria-current={current === 'services' ? 'page' : undefined} data-i18n="nav_services">Prestations</a>
      <a href="/contact" aria-current={current === 'contact' ? 'page' : undefined} data-i18n="nav_contact">Contact</a>
    </nav>
    <div class="lang-toggle" role="group" aria-label="Language">
      <button type="button" data-lang="fr" aria-pressed="true">FR</button>
      <button type="button" data-lang="ar" aria-pressed="false">AR</button>
    </div>
  </div>
</header>
