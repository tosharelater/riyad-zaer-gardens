---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<div
  id="rzg-splash"
  class="rzg-splash"
  role="presentation"
  aria-hidden="true"
>
  <div class="rzg-splash__stage">
    <img
      class="rzg-splash__logo"
      src={`${base}logo.png`}
      alt=""
      width="320"
      height="226"
      decoding="async"
    />
    <span class="rzg-splash__line"></span>
    <p class="rzg-splash__title">Riyad Zaer Gardens</p>
    <p class="rzg-splash__place">Aïn Aouda · Rabat</p>
  </div>
</div>
