---
const base = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : import.meta.env.BASE_URL + '/';
---

<footer class="site-footer">
  <div class="container inner">
    <div class="brand-mark">
      <img src={`${base}logo.png`} alt="" width="120" height="48" loading="lazy" />
      <div>
        <div class="label" style="margin-bottom:0.2rem">Riyad Zaer Gardens</div>
        <p style="margin:0; font-size:0.9rem" data-i18n="footer_tag"
          >Résidence mid-standing · Rabat / Aïn Aouda</p
        >
      </div>
    </div>
    <p style="margin:0; font-size:0.85rem" data-i18n="footer_rights"
      >© 2026 Riyad Zaer Gardens. Tous droits réservés.</p
    >
  </div>
</footer>
